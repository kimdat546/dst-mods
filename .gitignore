.DS_Store

# ── Không phải mod của mình / không thuộc monorepo ──────────────────
# _sources: mod gốc của tác giả khác (登仙 376MB, neverland, wiki PDF)
# _archive: bản trùng & build cũ, sinh lại được
# _infra:   dst-server-docker — repo riêng, dùng branch làm cấu hình world
_sources/
_archive/
_infra/

# ── Source game gốc của Klei (giải nén từ scripts.zip) ──────────────
# Nặng 234MB + là code có bản quyền của Klei → không đẩy lên repo public.
# Sinh lại: giải nén .../Don't Starve Together/data/databundles/scripts.zip
translations/dst-tieng-viet/game_source/
settings.local.json là cấu hình riêng từng máy
.claude/settings.local.json

# Debug dump của browser automation
.playwright-mcp/

# ── Mod của tác giả khác, chép về để học ────────────────────────────────
# learning/ chứa source mod người khác kèm chú thích của mình. Repo public
# nên không redistribute code của họ — cùng lý do _sources/ bị loại.
learning/

# ── Mod mẫu: đang mượn tài nguyên của tác giả khác ──────────────────────
# originals/mod-mau/ dùng anim + ảnh của mod 景熹家居 (Workshop 3597024951)
# để kiểm thử khung. Bỏ dòng này khi đã thay hết bằng tài nguyên tự làm.
originals/mod-mau/

# Thần Binh Phù Ấn: build/ sinh lại được từ vendor/ + strings_source.json.
# vendor/ CÓ trong git — cần bản gốc để diff khi vá lỗi và khi mod cập nhật.
translations/than-binh-phu-an-viet/build/
translations/than-binh-phu-an-viet/upload/
# ảnh nguồn 2048px (5,5 MB) — bản 512px trong assets/preview.png đã đủ để dựng
translations/than-binh-phu-an-viet/assets/preview_source.png

# ── Rác phiên làm việc ──────────────────────────────────────────────
# Ảnh chụp màn hình để soi layout UI, xong việc là bỏ.
image.png
# Log server lúc gỡ lỗi — 1,3 MB, sinh lại được bằng tools/giu_log_dst.sh.
translations/than-binh-phu-an-viet/logs-crash/

# ── Server test cục bộ của Thần Binh ────────────────────────────────
