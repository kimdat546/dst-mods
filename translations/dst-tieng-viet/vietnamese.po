#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.SOAKIN.NOSPACE
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.SOAKIN.NOSPACE"
msgid "That portion of the broth is claimed."
msgstr "Phần nước dùng đó đã có người chiếm rồi."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.START_CARRAT_RACE.NO_RACERS
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.START_CARRAT_RACE.NO_RACERS"
msgid "Pardonnez-moi, I was so excited I forgot to find a racer!"
msgstr "Pardonnez-moi, tôi phấn khích quá nên quên mất việc tìm một tay đua!"

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.STORE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.STORE.GENERIC"
msgid "It is too full."
msgstr "Đầy quá rồi."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.STORE.INUSE
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.STORE.INUSE"
msgid "Pardonnez-moi, I'll let you finish."
msgstr "Pardonnez-moi, tôi sẽ đợi bạn xong đã."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.STORE.NOTALLOWED
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.STORE.NOTALLOWED"
msgid "This is not the place for it."
msgstr "Đây không phải là nơi dành cho nó."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.STORE.NOTMASTERCHEF
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.STORE.NOTMASTERCHEF"
msgid "unused_by_warly"
msgstr "chưa sử dụng_by_warly"

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.STORE.NOTSOULJARHANDLER
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.STORE.NOTSOULJARHANDLER"
msgid "How do souls taste? I guess I'll never know."
msgstr "Linh hồn có mùi vị như thế nào? Tôi đoán tôi sẽ không bao giờ biết."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.STORE.RESTRICTED
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.STORE.RESTRICTED"
msgid "This is not for me!"
msgstr "Điều này không dành cho tôi!"

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.TEACH.CANTLEARN
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.TEACH.CANTLEARN"
msgid "That might be a bit beyond me."
msgstr "Điều đó có thể vượt xa tôi một chút."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.TEACH.KNOWN
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.TEACH.KNOWN"
msgid "Ah. I already knew that."
msgstr "À. Tôi biết cái đó rồi."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.TEACH.MESSAGEBOTTLEMANAGER_NOT_FOUND
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.TEACH.MESSAGEBOTTLEMANAGER_NOT_FOUND"
msgid "I think that can wait until I'm back outside."
msgstr "Tôi nghĩ việc đó có thể đợi cho đến khi tôi quay lại bên ngoài."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.TEACH.STASH_MAP_NOT_FOUND
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.TEACH.STASH_MAP_NOT_FOUND"
msgid "Ah. It seems they forgot to mark the hiding place."
msgstr "Ah. Có vẻ như họ đã quên đánh dấu nơi ẩn náu."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.TEACH.WRONGWORLD
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.TEACH.WRONGWORLD"
msgid "That doesn't belong in this world, much like myself."
msgstr "Thứ đó không thuộc về thế giới này, giống như tôi vậy."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.TELLSTORY.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.TELLSTORY.GENERIC"
msgid "only_used_by_walter"
msgstr "only_used_by_walter"

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.USEITEMON.BEEF_BELL_ALREADY_USED
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.USEITEMON.BEEF_BELL_ALREADY_USED"
msgid "It seems quite attached to someone else."
msgstr "Nó có vẻ khá gắn bó với người khác."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.USEITEMON.BEEF_BELL_HAS_BEEF_ALREADY
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.USEITEMON.BEEF_BELL_HAS_BEEF_ALREADY"
msgid "I've already found my perfect cut of beef."
msgstr "Tôi đã tìm được miếng thịt bò hoàn hảo cho mình rồi."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.USEITEMON.BEEF_BELL_INVALID_TARGET
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.USEITEMON.BEEF_BELL_INVALID_TARGET"
msgid "That will not work."
msgstr "Cái đó không được đâu."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.USEITEMON.CANNOT_FIX_DRONE
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.USEITEMON.CANNOT_FIX_DRONE"
msgid "It is not salvageable."
msgstr "Nó không thể cứu vãn được."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.USEITEMON.NOT_MINE
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.USEITEMON.NOT_MINE"
msgid "That is not mine."
msgstr "Đó không phải là của tôi."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.USEKLAUSSACKKEY.KLAUS
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.USEKLAUSSACKKEY.KLAUS"
msgid "I'd like to get to safety first!"
msgstr "Tôi muốn đến nơi an toàn trước tiên!"

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY"
msgid "There must be another key somewhere."
msgstr "Chắc chắn phải có một chiếc chìa khóa khác ở đâu đó."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.USEKLAUSSACKKEY.WRONGKEY
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.USEKLAUSSACKKEY.WRONGKEY"
msgid "This key doesn't fit here."
msgstr "Chìa khóa này không vừa ở đây."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.WRAPBUNDLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.WRAPBUNDLE.EMPTY"
msgid "There's nothing to wrap."
msgstr "Chẳng có gì để bọc cả."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.WRITE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.WRITE.GENERIC"
msgid "Maybe later. My hands are covered in cooking oil."
msgstr "Để sau nhé. Tay tôi dính đầy dầu ăn."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.WRITE.INUSE
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.WRITE.INUSE"
msgid "Oh, excusez-moi."
msgstr "Ồ, excusez-moi."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.YOTB_STARTCONTEST.ALREADYACTIVE
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.YOTB_STARTCONTEST.ALREADYACTIVE"
msgid "Perhaps there's another contest somewhere else."
msgstr "Có lẽ có một cuộc thi khác ở nơi khác."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.YOTB_STARTCONTEST.DOESNTWORK
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.YOTB_STARTCONTEST.DOESNTWORK"
msgid "Nobody there? C'est la vie."
msgstr "Không có ai ở đó? Đó là cuộc sống."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.YOTB_STARTCONTEST.NORESPONSE
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.YOTB_STARTCONTEST.NORESPONSE"
msgid "He has gone for a walk, perhaps."
msgstr "Có lẽ anh ấy đã đi dạo rồi."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.YOTB_STARTCONTEST.RIGHTTHERE
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.YOTB_STARTCONTEST.RIGHTTHERE"
msgid "He is presently busy."
msgstr "Hiện tại anh ấy đang bận."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.YOTB_UNLOCKSKIN.ALREADYKNOWN
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.YOTB_UNLOCKSKIN.ALREADYKNOWN"
msgid "Quel dommage, I already knew that one."
msgstr "Quel Dommage, tôi đã biết điều đó rồi."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL_GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL_GENERIC"
msgid "I cannot do that."
msgstr "Tôi không thể làm được điều đó."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ACCOMPLISHMENT
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ACCOMPLISHMENT"
msgid "I am triumphant!"
msgstr "Tôi đã chiến thắng!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ACCOMPLISHMENT_DONE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ACCOMPLISHMENT_DONE"
msgid "I hope this feeling lasts forever..."
msgstr "Mong rằng cảm giác này sẽ kéo dài mãi mãi..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ACIDBATS
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ACIDBATS"
msgid "That sound turns my stomach."
msgstr "Âm thanh đó khiến bụng tôi quặn thắt."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ADVENTUREFAIL
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ADVENTUREFAIL"
msgid "I shall have to attempt that again."
msgstr "Tôi sẽ phải thử lại lần nữa."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ANTLION_SINKHOLE.1
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ANTLION_SINKHOLE.1"
msgid "My soufflé!"
msgstr "Món soufflé của tôi!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ANTLION_SINKHOLE.2
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ANTLION_SINKHOLE.2"
msgid "Was that my stomach rumbling?"
msgstr "Đó có phải là bụng tôi đang kêu ầm ĩ không?"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ANTLION_SINKHOLE.3
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ANTLION_SINKHOLE.3"
msgid "The earth must be very hungry."
msgstr "Trái đất chắc hẳn đang đói lắm."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ANTLION_TRIBUTE.1
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ANTLION_TRIBUTE.1"
msgid "Pour vous."
msgstr "Pour vous. Tặng bạn đấy."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ANTLION_TRIBUTE.2
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ANTLION_TRIBUTE.2"
msgid "I hope you like it."
msgstr "Tôi hy vọng bạn thích nó."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ANTLION_TRIBUTE.3
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ANTLION_TRIBUTE.3"
msgid "For you, mon amie."
msgstr "Tặng bạn đấy, mon amie."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ARCHIVE_NEW_KNOWLEDGE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ARCHIVE_NEW_KNOWLEDGE"
msgid "Oh! It's teaching me a new recipe for a machine!"
msgstr "Ồ! Nó đang dạy tôi một công thức mới cho một cỗ máy!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ARCHIVE_NO_POWER
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ARCHIVE_NO_POWER"
msgid "If only there was a way to get it working again..."
msgstr "Giá như có cách nào đó để nó hoạt động trở lại ..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ARCHIVE_OLD_KNOWLEDGE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ARCHIVE_OLD_KNOWLEDGE"
msgid "I believe I already knew that one."
msgstr "Tôi tin rằng tôi đã biết điều đó rồi."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ATRIUM_DESTABILIZING.1
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ATRIUM_DESTABILIZING.1"
msgid "I should like to head for the surface now!"
msgstr "Tôi muốn lên mặt đất ngay bây giờ!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ATRIUM_DESTABILIZING.2
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ATRIUM_DESTABILIZING.2"
msgid "I think it's about time we left!"
msgstr "Tôi nghĩ đã đến lúc chúng ta rời đi!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ATRIUM_DESTABILIZING.3
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ATRIUM_DESTABILIZING.3"
msgid "Time to pack up and go."
msgstr "Đã đến lúc thu dọn đồ đạc và đi."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ATTACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ATTACH_BUFF_ATTACK"
msgid "Try my new specialty - an open-faced knuckle sandwich!"
msgstr "Nếm thử món đặc sản mới của tôi đi - bánh mì kẹp nắm đấm!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ATTACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ATTACH_BUFF_ELECTRICATTACK"
msgid "I'll zap you to a nice, even crisp!"
msgstr "Tôi sẽ chích điện cho ngươi giòn đều tăm tắp!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ATTACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ATTACH_BUFF_MOISTUREIMMUNITY"
msgid "Ah, nice and dry!"
msgstr "À, khô ráo dễ chịu!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ATTACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ATTACH_BUFF_PLAYERABSORPTION"
msgid "I feel très formidable!"
msgstr "Tôi thấy mình très mạnh mẽ!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ATTACH_BUFF_SLEEPRESISTANCE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ATTACH_BUFF_SLEEPRESISTANCE"
msgid "Fresh and awake!"
msgstr "Tươi mới và tỉnh táo!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ATTACH_BUFF_WORKEFFECTIVENESS
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ATTACH_BUFF_WORKEFFECTIVENESS"
msgid "Now we're cooking!"
msgstr "Giờ thì bếp đã đỏ lửa rồi!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_BECOMEGHOST
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_BECOMEGHOST"
msgid "oOooOooo!!"
msgstr "oOooOooo!!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_BEES
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_BEES"
msgid "The honeymakers are upon me!"
msgstr "Lũ thợ làm mật đang tấn công tôi!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_BOAT_LEAK"
msgid "Mon dieu! She is sinking!"
msgstr "Mon dieu! Thuyền đang chìm!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_BOAT_SINK
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_BOAT_SINK"
msgid "I don't want to be brined!"
msgstr "Tôi không muốn bị ngâm nước muối!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_BOOMERANG
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_BOOMERANG"
msgid "Ouch! Damnable thing!"
msgstr "Ôi! Thứ chết tiệt!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_BRAVERY_POTION
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_BRAVERY_POTION"
msgid "I feel bold as a sharp cheddar!"
msgstr "Tôi thấy mình gan dạ như phô mai cheddar đậm vị!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_BURNT"
msgid "Charred..."
msgstr "Cháy khét..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_CALL_BEEF
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_CALL_BEEF"
msgid "Over here, my mignon filet!"
msgstr "Lại đây nào, miếng thăn bò của tôi!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_CANFIX
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_CANFIX"
msgid "\nI believe I could repair that."
msgstr "\nTôi tin rằng tôi có thể sửa chữa được điều đó."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_CANNOT_BUILD.NO_INGREDIENTS
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_CANNOT_BUILD.NO_INGREDIENTS"
msgid "Ah non, I'm missing some ingredients!"
msgstr "À không, tôi đang thiếu một số nguyên liệu!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_CANNOT_BUILD.NO_STATION
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_CANNOT_BUILD.NO_STATION"
msgid "If I had a station with the right tools I could cook that right up..."
msgstr "Nếu tôi có một trạm với các công cụ đúng, tôi có thể nấu nó ngay..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_CANNOT_BUILD.NO_TECH
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_CANNOT_BUILD.NO_TECH"
msgid "I don't know the recipe for that one yet."
msgstr "Tôi vẫn chưa biết công thức món đó."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_CANTBUILDHERE_YOTB_POST
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_CANTBUILDHERE_YOTB_POST"
msgid "I should build this within the judge's view, non?"
msgstr "Tôi nên dựng cái này trong tầm nhìn của giám khảo, non?"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_CANT_ESCAPE_CURSE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_CANT_ESCAPE_CURSE"
msgid "What is this? It keeps returning to me!"
msgstr "Cái này là cái gì? Nó cứ quay trở lại với tôi!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_CARRAT_ERROR_FELL_ASLEEP
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_CARRAT_ERROR_FELL_ASLEEP"
msgid "Mon dieu! Has it fallen into a food coma?"
msgstr "Mon dieu! Nó ăn no quá nên ngủ gục rồi sao?"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_CARRAT_ERROR_STUNNED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_CARRAT_ERROR_STUNNED"
msgid "My carrat is frozen!"
msgstr "Cà ruột của tôi đứng hình rồi!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_CARRAT_ERROR_WALKING
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_CARRAT_ERROR_WALKING"
msgid "You must move faster!"
msgstr "Bạn phải di chuyển nhanh hơn!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.1
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.1"
msgid "Non, mon ami! You're going the wrong way!"
msgstr "Không, anh bạn ạ! Bạn đang đi sai đường!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2"
msgid "The other way, mon ami!"
msgstr "Đi hướng kia, mon ami!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_CARRAT_START_RACE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_CARRAT_START_RACE"
msgid "Ready? Go!"
msgstr "Sẵn sàng? Đi!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_CAVEIN
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_CAVEIN"
msgid "This place is crumbling like a dry cookie!"
msgstr "Nơi này đang sụp đổ như một chiếc bánh quy khô!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_CHAIR_ON_FIRE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_CHAIR_ON_FIRE"
msgid "C'est bon."
msgstr "C'est bon. Ổn cả thôi."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_CHARLIE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_CHARLIE"
msgid "What the devil!"
msgstr "Cái quái gì vậy!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_CHARLIESAVE.1
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_CHARLIESAVE.1"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_CHARLIE_ATTACK
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_CHARLIE_ATTACK"
msgid "Gah! I do believe something bit me!"
msgstr "Á! Hình như có thứ gì đó vừa cắn tôi!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_COACH.1
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_COACH.1"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

