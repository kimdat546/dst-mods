msgstr "Ngược hẳn với bận rộn luôn."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BACKPACK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BACKPACK"
