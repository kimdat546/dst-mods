msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_HONEY"
msgid "Ah, now that might be interesting."
msgstr "À, cái này thì có thể thú vị đây."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_HORRORFUEL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_HORRORFUEL"
msgid "Ah, now that might be interesting."
msgstr "À, cái này thì có thể thú vị đây."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_LUNARPLANTHUSK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_LUNARPLANTHUSK"
msgid "Ah, now that might be interesting."
msgstr "À, cái này thì có thể thú vị đây."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_MARBLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_MARBLE"
msgid "Not particularly creative."
msgstr "Không đặc biệt sáng tạo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_MOONGLASS"
msgid "Ah, now that might be interesting."
msgstr "À, cái này thì có thể thú vị đây."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_POOP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_POOP"
msgid "Must he leave that lying around? I nearly ruined my shoes."
msgstr "Cậu ta cứ phải vứt thứ đó lung tung sao? Ta suýt hỏng cả đôi giày."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_PUREBRILLIANCE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_PUREBRILLIANCE"
msgid "Ah, now that might be interesting."
msgstr "À, cái này thì có thể thú vị đây."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_ROCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_ROCK"
msgid "Not particularly creative."
msgstr "Không đặc biệt sáng tạo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_SCRAPFEATHER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_SCRAPFEATHER"
msgid "Ah, now that might be interesting."
msgstr "À, cái này thì có thể thú vị đây."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_SLOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_SLOW"
msgid "Ah, now that might be interesting."
msgstr "À, cái này thì có thể thú vị đây."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_STINGER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_STINGER"
msgid "Ah, now that might be interesting."
msgstr "À, cái này thì có thể thú vị đây."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_THULECITE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_THULECITE"
msgid "Ah, now that might be interesting."
msgstr "À, cái này thì có thể thú vị đây."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTMODKIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTMODKIT"
msgid "He'll shoot his eye out if he's not careful."
msgstr "Anh ta sẽ bắn rơi mắt mình nếu không cẩn thận."

