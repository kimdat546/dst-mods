msgstr "Là chiến lợi phẩm từ kẻ thù hùng mạnh."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MITEGLAND.COLD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MITEGLAND.COLD"
msgid "Cold guts of bug."
msgstr "Ruột bọ lạnh ngắt."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MITEGLAND.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MITEGLAND.GENERIC"
