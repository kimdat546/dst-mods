msgstr "Nó nóng quá rồi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYSAUCE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYSAUCE"
