msgstr "Nghe bài này là muốn làm đổ mồ hôi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.REDGEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.REDGEM"
