msgstr "Nó quá cao."

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.DEPLOY.HERMITCRAB_RELOCATE
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.DEPLOY.HERMITCRAB_RELOCATE"
