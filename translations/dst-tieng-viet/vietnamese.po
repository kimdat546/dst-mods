msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CHANGEIN.NOTENOUGHHAIR"
msgid "Perhaps once its fur grows in."
msgstr "Có lẽ đợi khi lông nó mọc lại."

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CHARGE_FROM.CHARGE_FULL
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CHARGE_FROM.CHARGE_FULL"
