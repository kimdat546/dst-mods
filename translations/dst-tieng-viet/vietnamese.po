msgstr "Chúng tôi có thể cho nhiều hơn vào nhưng chúng tôi sợ chạm vào những thứ anh ấy để bên trong."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.LANTERN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.LANTERN"
