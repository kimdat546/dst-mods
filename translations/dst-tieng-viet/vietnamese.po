msgstr "Đúng là cây gậy tê cóng."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ICESTAFF3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ICESTAFF3"
