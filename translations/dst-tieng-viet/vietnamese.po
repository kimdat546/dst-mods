msgstr "Liệu quả bóng có đến được một nơi tốt đẹp hơn?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_GOLF_HOLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_GOLF_HOLE"
