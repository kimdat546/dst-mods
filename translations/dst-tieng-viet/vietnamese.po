msgstr "Warly khó chịu khi chúng tôi nghịch đồ của anh ấy."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.STORE.NOTSOULJARHANDLER
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.STORE.NOTSOULJARHANDLER"
msgid "We promised not to play with the souls."
msgstr "Chúng tôi đã hứa sẽ không chơi đùa với linh hồn."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.STORE.RESTRICTED
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.STORE.RESTRICTED"
msgid "We're not allowed."
msgstr "Chúng tôi không được phép."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.TEACH.CANTLEARN
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.TEACH.CANTLEARN"
msgid "Ms. Wickerbottom will have to explain this one."
msgstr "Cô Wickerbottom sẽ phải giải thích điều này."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.TEACH.KNOWN
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.TEACH.KNOWN"
