msgstr "Để quả bóng không trốn thoát được."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_GOLFPROP_MOVINGWALL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_GOLFPROP_MOVINGWALL"
