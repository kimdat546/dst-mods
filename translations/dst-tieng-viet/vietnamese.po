msgstr "Thôi được, thỉnh thoảaaang đồ lạnh cũng được."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICEHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICEHAT"
