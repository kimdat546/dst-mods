msgstr "Ồ, ừm... Tôi nghĩ họ đang bận. Bận chết."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVETOPLAYER.FULL
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.GIVETOPLAYER.FULL"
