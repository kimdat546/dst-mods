msgstr "only_used_by_willow"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CASTSPELL.TERRAFORM_TOO_SOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CASTSPELL.TERRAFORM_TOO_SOON"
msgid "only_used_by_wurt"
msgstr "only_used_by_wurt"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CAST_SPELLBOOK.NO_TOPHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CAST_SPELLBOOK.NO_TOPHAT"
msgid "I'll need a top hat for this trick to work."
msgstr "Tôi sẽ cần một chiếc Nón Chóp Cao thì trò ảo thuật này mới thành."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CHANGEIN.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CHANGEIN.BURNING"
msgid "Oh. There go all my good pocket squares."
msgstr "Ồ. Thế là tiêu hết mấy chiếc khăn cài túi đẹp của tôi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CHANGEIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CHANGEIN.GENERIC"
msgid "How could you improve on perfection?"
msgstr "Bạn có thể cải thiện sự hoàn hảo bằng cách nào?"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CHANGEIN.INUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CHANGEIN.INUSE"
msgid "They're in much more dire need of it."
msgstr "Họ đang cần nó gấp nhiều lần."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CHANGEIN.NOOCCUPANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CHANGEIN.NOOCCUPANT"
msgid "I think you're forgetting something, pal..."
msgstr "Tôi nghĩ anh đang quên điều gì đó, anh bạn..."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CHANGEIN.NOTENOUGHHAIR
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CHANGEIN.NOTENOUGHHAIR"
msgid "There's nothing for me to work with."
msgstr "Chẳng có gì để tôi làm việc cả."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CHARGE_FROM.CHARGE_FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CHARGE_FROM.CHARGE_FULL"
msgid "Full charge!"
msgstr "Sạc đầy!"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CHARGE_FROM.NOT_ENOUGH_CHARGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CHARGE_FROM.NOT_ENOUGH_CHARGE"
msgid "Who left it uncharged?"
msgstr "Ai để nó hết điện thế này?"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.COMPARE_WEIGHABLE.FISH_TOO_SMALL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.COMPARE_WEIGHABLE.FISH_TOO_SMALL"
msgid "It's not worth my time."
msgstr "Nó không đáng để tôi tốn thời gian."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.COMPARE_WEIGHABLE.OVERSIZEDVEGGIES_TOO_SMALL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.COMPARE_WEIGHABLE.OVERSIZEDVEGGIES_TOO_SMALL"
msgid "This one is insignificant in comparison."
msgstr "Cái này chẳng đáng kể gì khi so sánh."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CONSTRUCT.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CONSTRUCT.EMPTY"
msgid "Well I need something to build with."
msgstr "Chà, tôi cần thứ gì đó để xây chứ."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CONSTRUCT.INUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CONSTRUCT.INUSE"
msgid "I don't like sharing."
msgstr "Tôi không thích chia sẻ."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CONSTRUCT.MISMATCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CONSTRUCT.MISMATCH"
msgid "It needs completely different plans."
msgstr "Nó cần một bản thiết kế hoàn toàn khác."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CONSTRUCT.NOTALLOWED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CONSTRUCT.NOTALLOWED"
msgid "That's the wrong part."
msgstr "Sai bộ phận rồi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CONSTRUCT.NOTREADY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CONSTRUCT.NOTREADY"
msgid "I'll give an offering once the imminent danger has passed."
msgstr "Tôi sẽ dâng lễ vật khi mối nguy trước mắt đã qua."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.COOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.COOK.GENERIC"
msgid "Nothing ever goes as planned."
msgstr "Không có gì diễn ra như kế hoạch."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.COOK.INUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.COOK.INUSE"
msgid "Hmph. You're adding too much salt."
msgstr "Hừm. Bạn đang thêm quá nhiều muối."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.COOK.TOOFAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.COOK.TOOFAR"
msgid "I must get closer."
msgstr "Tôi phải đến gần hơn."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.DECORATESNOWMAN.HASHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.DECORATESNOWMAN.HASHAT"
msgid "There's a stupid hat in the way."
msgstr "Có một chiếc mũ ngu ngốc chắn đường."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.DECORATESNOWMAN.INUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.DECORATESNOWMAN.INUSE"
msgid "Someone's hogging it."
msgstr "Có ai đó đang cướp nó."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.DECORATESNOWMAN.MELTING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.DECORATESNOWMAN.MELTING"
msgid "It's about to melt."
msgstr "Nó sắp tan chảy."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.DECORATESNOWMAN.STACKEDTOOHIGH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.DECORATESNOWMAN.STACKEDTOOHIGH"
msgid "I'm not stacking it any higher."
msgstr "Tôi không xếp nó cao hơn nữa."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.DEPLOY.HERMITCRAB_RELOCATE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.DEPLOY.HERMITCRAB_RELOCATE"
msgid "Ugh, empty! I'll do it later."
msgstr "Ờ, trống rỗng! Tôi sẽ làm việc đó sau."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.DISMANTLE.COOKING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.DISMANTLE.COOKING"
msgid "I'd rather not lay my hands on a hot stove, thank you very much."
msgstr "Tôi thà không đặt tay lên bếp nóng còn hơn, cảm ơn bạn rất nhiều."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.DISMANTLE.INUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.DISMANTLE.INUSE"
msgid "It's occupied."
msgstr "Có người đang dùng rồi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.DISMANTLE.NOTEMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.DISMANTLE.NOTEMPTY"
msgid "First I must remove its contents."
msgstr "Trước hết tôi phải lấy hết đồ bên trong ra."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.DIVEGRAB.MISSED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.DIVEGRAB.MISSED"
msgid "Quit moving!"
msgstr "Đừng di chuyển nữa!"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.DRAW.NOIMAGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.DRAW.NOIMAGE"
msgid "My memory isn't good enough to draw from it."
msgstr "Trí nhớ của tôi không đủ tốt để vẽ theo."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.FILL_OCEAN.UNSUITABLE_FOR_PLANTS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.FILL_OCEAN.UNSUITABLE_FOR_PLANTS"
msgid "Why must the plants be so picky?"
msgstr "Tại sao thực vật phải kén chọn như vậy?"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.FISH_OCEAN.TOODEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.FISH_OCEAN.TOODEEP"
msgid "Blast! This is hopeless."
msgstr "Chết tiệt! Vô vọng rồi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GENERIC.ITEMMIMIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GENERIC.ITEMMIMIC"
msgid "I'm losing my touch."
msgstr "Tay nghề của tôi đang sa sút."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.ABIGAILHEART
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.ABIGAILHEART"
msgid "I had to try."
msgstr "Tôi phải thử."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.BUSY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.BUSY"
msgid "It's busy, currently."
msgstr "Hiện tại đang bận."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.CANTSHADOWREVIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.CANTSHADOWREVIVE"
msgid "It refuses to bend to my will."
msgstr "Nó không chịu khuất phục trước ý chí của tôi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.CARNIVALGAME_ALREADY_PLAYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.CARNIVALGAME_ALREADY_PLAYING"
msgid "It seems I'll have to bide my time."
msgstr "Có vẻ như tôi sẽ phải chờ đợi thời cơ của mình."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.CARNIVALGAME_GOLFGAME_NOTREADY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.CARNIVALGAME_GOLFGAME_NOTREADY"
msgid "Ugh! The course is unfinished!"
msgstr "Chậc! Sân còn chưa làm xong!"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.CARNIVALGAME_INVALID_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.CARNIVALGAME_INVALID_ITEM"
msgid "Hmph. Picky."
msgstr "Hừm. Kén chọn, khó tính."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.DEAD"
msgid "The dead have no need of such things."
msgstr "Người chết không cần những thứ đó."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.DUPLICATE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.DUPLICATE"
msgid "That can already be made here."
msgstr "Thứ đó đã chế tạo được ở đây rồi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.FOODFULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.FOODFULL"
msgid "We've already placed something on the altar."
msgstr "Chúng tôi đã đặt một cái gì đó trên bàn thờ."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.GENERIC"
msgid "I should think not."
msgstr "Tôi nghĩ là không."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.GHOSTHEART
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.GHOSTHEART"
msgid "I don't think so. They might still be mad."
msgstr "Tôi nghĩ là không. Có khi họ vẫn còn giận."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSLOG
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSLOG"
msgid "A living log would be more suited to this."
msgstr "Gỗ sống sẽ hợp với việc này hơn."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSSHROOM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSSHROOM"
msgid "A mushroom would be more suited to this."
msgstr "Một loại nấm sẽ phù hợp hơn với điều này."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.MUSHROOMFARM_NOMOONALLOWED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.MUSHROOMFARM_NOMOONALLOWED"
msgid "The blasted thing refuses to grow!"
msgstr "Thứ chết tiệt này không chịu lớn!"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOGENERATORSKILL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOGENERATORSKILL"
msgid "That would be an amateurish misuse of its magic."
msgstr "Đó sẽ là một sự lạm dụng nghiệp dư phép thuật của nó."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOMOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOMOON"
msgid "It's not going to work in here."
msgstr "Nó sẽ không hoạt động ở đây."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOTAMONKEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOTAMONKEY"
msgid "I'm not wasting my time with this monkey business."
msgstr "Tôi không phí thời gian cho mấy trò khỉ này."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOTDISH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOTDISH"
msgid "That wouldn't be a very good sacrifice, now would it?"
msgstr "Đó đâu phải lễ vật tốt, phải không nào?"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOTGEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOTGEM"
msgid "Even The Amazing Maxwell couldn't wring magic from that."
msgstr "Ngay cả Maxwell Kì nhân vĩ đại ta cũng không thể tạo ra phép thuật từ điều đó."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOTSCULPTABLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOTSCULPTABLE"
msgid "That is certainly not for sculpting with."
msgstr "Thứ đó chắc chắn không dùng để điêu khắc."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOTSTAFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOTSTAFF"
msgid "Hm. No, that's not right."
msgstr "Ừm. Không, điều đó không đúng."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.PIGKINGGAME_DANGER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.PIGKINGGAME_DANGER"
msgid "I have bigger things to worry about right now."
msgstr "Tôi có những điều lớn hơn để lo lắng ngay bây giờ."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.PIGKINGGAME_MESSY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.PIGKINGGAME_MESSY"
msgid "Ugh. I'm not doing anything in that mess."
msgstr "Ờ. Tôi không làm gì trong mớ hỗn độn đó cả."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.PIGKINGGAME_TOOLATE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.PIGKINGGAME_TOOLATE"
msgid "It's much too late for that."
msgstr "Đã quá muộn cho việc đó rồi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.QUEENBUSY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.QUEENBUSY"
msgid "She's ignoring me... the nerve!"
msgstr "Bà ta phớt lờ tôi... thật láo xược!"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.SLEEPING"
msgid "It's thoroughly unconscious."
msgstr "Nó hoàn toàn vô thức."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.SLOTFULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.SLOTFULL"
msgid "Occupied."
msgstr "Đã có thứ ở đó rồi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.SPIDERNOHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.SPIDERNOHAT"
msgid "Its dapperness would be wasted in my pocket."
msgstr "Sự bảnh bao của nó sẽ bị lãng phí trong túi của tôi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.TERRARIUM_COOLDOWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.TERRARIUM_COOLDOWN"
msgid "There's nothing in there to receive our offering. Yet."
msgstr "Chưa có gì ở đó để nhận lễ vật của chúng ta cả."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.TERRARIUM_REFUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.TERRARIUM_REFUSE"
msgid "Nothing. I wonder how it might respond to the fuel..."
msgstr "Chẳng có gì. Không biết nó sẽ phản ứng thế nào với nhiên liệu..."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.WRONGGEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.WRONGGEM"
msgid "That would be an amateurish misuse of its magic."
msgstr "Đó sẽ là một sự lạm dụng nghiệp dư phép thuật của nó."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.WRONGSHADOWFORM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.WRONGSHADOWFORM"
msgid "The bones were too amateurishly assembled."
msgstr "Những chiếc xương được lắp ráp quá nghiệp dư."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVEALLTOPLAYER.BUSY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVEALLTOPLAYER.BUSY"
msgid "When you have a moment."
msgstr "Khi nào anh rảnh nhé."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVEALLTOPLAYER.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVEALLTOPLAYER.DEAD"
msgid "The dead have no need of such things."
msgstr "Người chết không cần những thứ đó."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVEALLTOPLAYER.FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVEALLTOPLAYER.FULL"
msgid "No sense giving them more than they can carry."
msgstr "Chẳng có lý gì đưa họ nhiều hơn sức họ mang."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVEALLTOPLAYER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVEALLTOPLAYER.SLEEPING"
msgid "Err... I'll let you rest."
msgstr "Ờ... tôi sẽ để cậu nghỉ ngơi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVETOPLAYER.BUSY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVETOPLAYER.BUSY"
msgid "When you have a moment."
msgstr "Khi nào anh rảnh nhé."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVETOPLAYER.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVETOPLAYER.DEAD"
msgid "The dead have no need of such things."
msgstr "Người chết không cần những thứ đó."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVETOPLAYER.FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVETOPLAYER.FULL"
msgid "No sense giving them more than they can carry."
msgstr "Chẳng có lý gì đưa họ nhiều hơn sức họ mang."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVETOPLAYER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVETOPLAYER.SLEEPING"
msgid "Err... I'll let you rest."
msgstr "Ờ... tôi sẽ để cậu nghỉ ngơi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE_TACKLESKETCH.DUPLICATE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE_TACKLESKETCH.DUPLICATE"
msgid "That can already be made here."
msgstr "Thứ đó đã chế tạo được ở đây rồi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.HARVEST.DOER_ISNT_MODULE_OWNER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.HARVEST.DOER_ISNT_MODULE_OWNER"
msgid "Hmph. It's not worth my time."
msgstr "Hừm. Nó không đáng để tôi tốn thời gian."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.HEAL.NOT_MERM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.HEAL.NOT_MERM"
msgid "Well of course it only works on merms."
msgstr "Tất nhiên nó chỉ có tác dụng với Người cá."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.HERD_FOLLOWERS.WEBBERONLY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.HERD_FOLLOWERS.WEBBERONLY"
msgid "I don't hold any power over them."
msgstr "Tôi không có bất kỳ quyền lực nào đối với họ."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.HITCHUP.BEEF_HITCHED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.HITCHUP.BEEF_HITCHED"
msgid "The beast is ready to be judged."
msgstr "Con thú đã sẵn sàng để bị phán xét."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.HITCHUP.INMOOD
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.HITCHUP.INMOOD"
msgid "Perhaps once the beast has settled down and is willing to be reasonable."
msgstr "Có lẽ để khi con thú đã bình tĩnh và chịu nghe lời."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.HITCHUP.NEEDBEEF
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.HITCHUP.NEEDBEEF"
msgid "Here's the hitch pal, I'm going to need a beefalo."
msgstr "Vướng mỗi chỗ này, anh bạn: tôi cần một con Bò Lai."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.HITCHUP.NEEDBEEF_CLOSER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.HITCHUP.NEEDBEEF_CLOSER"
msgid "Get over here, you hairy imbecile!"
msgstr "Hãy đến đây, đồ ngu ngốc lông lá!"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.LOWER_SAIL_FAIL.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.LOWER_SAIL_FAIL.1"
msgid "Well, that didn't quite work as I planned."
msgstr "Chà, điều đó không hoàn toàn diễn ra như tôi dự định."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.LOWER_SAIL_FAIL.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.LOWER_SAIL_FAIL.2"
msgid "How inconvenient."
msgstr "Thật bất tiện."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.LOWER_SAIL_FAIL.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.LOWER_SAIL_FAIL.3"
msgid "Blast it!"
msgstr "Chết tiệt!"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MARK.ALREADY_MARKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MARK.ALREADY_MARKED"
msgid "My choice has been made. No going back."
msgstr "Tôi đã chọn rồi. Không quay lại được."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MARK.NOT_PARTICIPANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MARK.NOT_PARTICIPANT"
msgid "I'll bide my time until the next competition."
msgstr "Tôi sẽ chờ đến cuộc thi tiếp theo."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MOUNT.INUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MOUNT.INUSE"
msgid "Once again the seat of power is stolen from me!"
msgstr "Một lần nữa chiếc ghế quyền lực lại bị cướp khỏi tay tôi!"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MOUNT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MOUNT.SLEEPING"
msgid "Get up, you lazy beast."
msgstr "Đứng dậy đi, con vật lười biếng."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MOUNT.TARGETINCOMBAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MOUNT.TARGETINCOMBAT"
msgid "Perhaps I should take a step back."
msgstr "Có lẽ tôi nên lùi lại một bước."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MUTATE.CAVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MUTATE.CAVE"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MUTATE.NOFULLMOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MUTATE.NOFULLMOON"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MUTATE.NOGHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MUTATE.NOGHOST"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MUTATE.NONEWMOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MUTATE.NONEWMOON"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MUTATE.NOTNIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MUTATE.NOTNIGHT"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.OCEAN_FISHING_POND.WRONGGEAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.OCEAN_FISHING_POND.WRONGGEAR"
msgid "I won't use my good fishing rod in this stagnant pond."
msgstr "Tôi sẽ không sử dụng chiếc cần câu tốt của mình trong cái ao tù đọng này."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.OPEN_CRAFTING.PROFESSIONALCHEF
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.OPEN_CRAFTING.PROFESSIONALCHEF"
msgid "I have more important things to do than that."
msgstr "Tôi có những việc quan trọng hơn phải làm."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.OPEN_CRAFTING.SHADOWMAGIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.OPEN_CRAFTING.SHADOWMAGIC"
msgid "unused_by_waxwell"
msgstr "không sử dụng_by_waxwell"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICK.NOTHING_INSIDE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICK.NOTHING_INSIDE"
msgid "Empty. I knew it."
msgstr "Trống rỗng. Ta biết mà."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICK.STUCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICK.STUCK"
msgid "Ugh! Stuck."
msgstr "Ờ! Mắc kẹt."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.FULL_OF_CURSES
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.FULL_OF_CURSES"
msgid "I will not fall for that again."
msgstr "Tôi sẽ không mắc bẫy đó lần nữa."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.INUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.INUSE"
msgid "It's unavailable."
msgstr "Hiện không lấy được."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.NOTMINE_YOTC.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.NOTMINE_YOTC.1"
msgid "Say, pal, why don't you come work for me?"
msgstr "Này anh bạn, sao anh không đến làm việc cho tôi?"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.NOTMINE_YOTC.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.NOTMINE_YOTC.2"
msgid "Its allegiance lies elsewhere."
msgstr "Lòng trung thành của nó nằm ở nơi khác."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.RESTRICTION
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.RESTRICTION"
msgid "I have no use of such things."
msgstr "Tôi chẳng cần dùng mấy thứ như vậy."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.FERTILIZER"
msgid "I think I know quite enough."
msgstr "Tôi nghĩ tôi biết khá đủ."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.GENERIC"
msgid "I have the information I need."
msgstr "Tôi có thông tin tôi cần."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.POUNCECAPTURE.MISSED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.POUNCECAPTURE.MISSED"
msgid "Quit moving!"
msgstr "Đừng di chuyển nữa!"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.POUR_WATER.OUT_OF_WATER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.POUR_WATER.OUT_OF_WATER"
msgid "I've run out."
msgstr "Tôi đã hết."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.POUR_WATER_GROUNDTILE.OUT_OF_WATER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.POUR_WATER_GROUNDTILE.OUT_OF_WATER"
msgid "There's no more water."
msgstr "Không còn nước nữa."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.ALREADYFULLMOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.ALREADYFULLMOON"
msgid "For once, magic is not needed."
msgstr "Hiếm hoi thay, lần này chẳng cần đến phép thuật."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.BIRDSBLOCKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.BIRDSBLOCKED"
msgid "He even stops the birds from coming and going?"
msgstr "Anh ta thậm chí còn ngăn cản những con chim đến và đi?"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.DEADBIRDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.DEADBIRDS"
msgid "It's bad luck now... for the birds."
msgstr "Bây giờ thật là xui xẻo... cho lũ chim."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.GENERIC"
msgid "I must deal with this first."
msgstr "Tôi phải giải quyết chuyện này trước."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOBIRDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOBIRDS"
msgid "There are plenty of birds here already."
msgstr "Ở đây có rất nhiều chim rồi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOFIRES
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOFIRES"
msgid "For once, nothing is on fire."
msgstr "Hiếm hoi thay, chẳng có gì đang cháy."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOHORTICULTURE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOHORTICULTURE"
msgid "There's nothing worth growing here."
msgstr "Chẳng có gì đáng trồng ở đây cả."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOMOONINCAVES
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOMOONINCAVES"
msgid "Its power can't reach the \"moon\" from here."
msgstr "Sức mạnh của nó không thể chạm tới \"mặt trăng\" từ đây."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOSILVICULTURE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOSILVICULTURE"
msgid "Making invisible trees grow? Now that'd be a trick."
msgstr "Làm cây vô hình mọc lên? Thế mới gọi là ảo thuật."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOSLEEPTARGETS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOSLEEPTARGETS"
msgid "Nobody wants a bedtime story from the bogeyman, is that it?"
msgstr "Không ai muốn nghe một câu chuyện trước khi đi ngủ từ ông Kẹ, phải không?"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOTENTACLEGROUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOTENTACLEGROUND"
msgid "Tentacles are ill-suited to this place."
msgstr "Các xúc tu không phù hợp với nơi này."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOWATERNEARBY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.NOWATERNEARBY"
msgid "I can't just conjure up fish without water."
msgstr "Tôi không thể triệu hồi cá mà không có nước."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.TOOMANYBEES
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.TOOMANYBEES"
msgid "There's such a thing as too many bees, pal."
msgstr "Ong nhiều quá cũng không tốt đâu, anh bạn."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.TOOMANYBIRDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.TOOMANYBIRDS"
msgid "There are plenty of birds here already."
msgstr "Ở đây có rất nhiều chim rồi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.WAYTOOMANYBIRDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.READ.WAYTOOMANYBIRDS"
msgid "I must wait before I summon the birds again."
msgstr "Tôi phải đợi trước khi triệu hồi lũ chim lần nữa."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REMOTE_TELEPORT.NODEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REMOTE_TELEPORT.NODEST"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REMOTE_TELEPORT.NOSKILL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REMOTE_TELEPORT.NOSKILL"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REMOVEMODULES.NO_MODULES
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REMOVEMODULES.NO_MODULES"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REPAIR.WRONGPIECE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REPAIR.WRONGPIECE"
msgid "I could have told you that wouldn't fit."
msgstr "Tôi đã có thể nói trước là nó không vừa."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REPLATE.MISMATCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REPLATE.MISMATCH"
msgid "Clearly this is the wrong dish."
msgstr "Rõ ràng là nhầm đĩa rồi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REPLATE.SAMEDISH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REPLATE.SAMEDISH"
msgid "I've already put this on a dish."
msgstr "Tôi đã đặt cái này lên đĩa rồi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.ROW_FAIL.BAD_TIMING0
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.ROW_FAIL.BAD_TIMING0"
msgid "I must time this perfectly if I'm to succeed."
msgstr "Tôi phải căn thời gian thật hoàn hảo nếu muốn thành công."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.ROW_FAIL.BAD_TIMING1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.ROW_FAIL.BAD_TIMING1"
msgid "This isn't exactly my forte."
msgstr "Đây không hẳn là sở trường của tôi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.ROW_FAIL.BAD_TIMING2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.ROW_FAIL.BAD_TIMING2"
msgid "Hmph. Physical labor is more suited to underlings."
msgstr "Hừm. Lao động chân tay phù hợp hơn với cấp dưới."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.GENERIC"
msgid "Curses."
msgstr "Khỉ thật."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.INUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.INUSE"
msgid "I'm quite adept at waiting. I've had a lot of practice."
msgstr "Tôi khá giỏi trong việc chờ đợi. Tôi đã thực hành rất nhiều."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.NOTAMERM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.NOTAMERM"
msgid "Even I won't stoop so low as to steal from these wretches."
msgstr "Ngay cả ta cũng không hạ mình đến mức trộm từ đám khốn khổ này."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.NOTMASTERCHEF
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.NOTMASTERCHEF"
msgid "I have more important things to do than that."
msgstr "Tôi có những việc quan trọng hơn phải làm."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.NOTSOULJARHANDLER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.NOTSOULJARHANDLER"
msgid "Souls are a different thing altogether."
msgstr "Linh hồn là một thứ hoàn toàn khác."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.RESTRICTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.RESTRICTED"
msgid "I don't have the magic word."
msgstr "Tôi không biết câu thần chú."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SADDLE.TARGETINCOMBAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SADDLE.TARGETINCOMBAT"
msgid "Perhaps I should take a step back."
msgstr "Có lẽ tôi nên lùi lại một bước."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SHAVE.AWAKEBEEFALO
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SHAVE.AWAKEBEEFALO"
msgid "I don't think she'd take kindly to that."
msgstr "Tôi không nghĩ cô ấy sẽ vui vẻ với điều đó."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SHAVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SHAVE.GENERIC"
msgid "To what end?"
msgstr "Để làm gì chứ?"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SHAVE.NOBITS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SHAVE.NOBITS"
msgid "But it's already as smooth as a baby's rear end."
msgstr "Nhưng mà nó đã mượt như mông trẻ con rồi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SHAVE.SOMEONEELSESBEEFALO
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SHAVE.SOMEONEELSESBEEFALO"
msgid "Let someone else do it."
msgstr "Hãy để người khác làm việc đó."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SLAUGHTER.TOOFAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SLAUGHTER.TOOFAR"
msgid "It has escaped my clutches."
msgstr "Nó đã thoát khỏi nanh vuốt của tôi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SOAKIN.NOSPACE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SOAKIN.NOSPACE"
msgid "There's an inconsiderate wretch taking up that space."
msgstr "Có một kẻ khốn nạn vô tâm đang chiếm giữ không gian đó."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.START_CARRAT_RACE.NO_RACERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.START_CARRAT_RACE.NO_RACERS"
msgid "This race seems to be decidedly lacking in racers."
msgstr "Cuộc đua này dường như đang thiếu vắng tay đua."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.GENERIC"
msgid "It wouldn't fit."
msgstr "Không vừa đâu."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.INUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.INUSE"
msgid "Worry not, pal. I've the patience of a saint."
msgstr "Đừng lo lắng, anh bạn. Tôi có sự kiên nhẫn của một vị thánh."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.NOTALLOWED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.NOTALLOWED"
msgid "That can't go in there."
msgstr "Không nhét vào đấy được."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.NOTMASTERCHEF
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.NOTMASTERCHEF"
msgid "I have more important things to do than that."
msgstr "Tôi có những việc quan trọng hơn phải làm."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.NOTSOULJARHANDLER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.NOTSOULJARHANDLER"
msgid "Souls are a different thing altogether."
msgstr "Linh hồn là một thứ hoàn toàn khác."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.RESTRICTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.RESTRICTED"
msgid "I don't have the magic word."
msgstr "Tôi không biết câu thần chú."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.CANTLEARN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.CANTLEARN"
msgid "There's a lesson to be learned about tampering with secret knowledge."
msgstr "Đây là bài học về việc táy máy với tri thức bí mật."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.KNOWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.KNOWN"
msgid "I am far too advanced for this."
msgstr "Tôi quá tiến bộ cho việc này."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.MESSAGEBOTTLEMANAGER_NOT_FOUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.MESSAGEBOTTLEMANAGER_NOT_FOUND"
msgid "I'll extract its secrets once I find some suitable lighting."
msgstr "Tôi sẽ tìm ra bí mật của nó khi tôi tìm được nguồn sáng phù hợp."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.STASH_MAP_NOT_FOUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.STASH_MAP_NOT_FOUND"
msgid "It's nothing but scribbles."
msgstr "Chẳng có gì ngoài những nét vẽ nguệch ngoạc."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.WRONGWORLD
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.WRONGWORLD"
msgid "I seem to be in the wrong place to use this."
msgstr "Có vẻ tôi đang ở sai chỗ để dùng thứ này."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TELLSTORY.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TELLSTORY.GENERIC"
msgid "only_used_by_walter"
msgstr "only_used_by_walter"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEITEMON.BEEF_BELL_ALREADY_USED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEITEMON.BEEF_BELL_ALREADY_USED"
msgid "This one's already been claimed."
msgstr "Con này đã có chủ rồi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEITEMON.BEEF_BELL_HAS_BEEF_ALREADY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEITEMON.BEEF_BELL_HAS_BEEF_ALREADY"
msgid "One smelly beast following me around is more than enough."
msgstr "Một con thú hôi hám bám theo tôi khắp nơi là quá đủ."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEITEMON.BEEF_BELL_INVALID_TARGET
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEITEMON.BEEF_BELL_INVALID_TARGET"
msgid "I think not."
msgstr "Tôi nghĩ là không."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEITEMON.CANNOT_FIX_DRONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEITEMON.CANNOT_FIX_DRONE"
msgid "There's no fixing it."
msgstr "Không có cách nào sửa nó được."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEITEMON.NOT_MINE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEITEMON.NOT_MINE"
msgid "Someone's rubbish."
msgstr "Đồ rác rưởi của ai đó."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEKLAUSSACKKEY.KLAUS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEKLAUSSACKKEY.KLAUS"
msgid "I'll not be done in by an overgrown Krampus."
msgstr "Tôi sẽ không bị hạ gục bởi một Krampus to lớn đâu."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY"
msgid "It appears there's another key around here."
msgstr "Có vẻ như có một chiếc chìa khóa khác quanh đây."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEKLAUSSACKKEY.WRONGKEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEKLAUSSACKKEY.WRONGKEY"
msgid "Blast! Wrong key."
msgstr "Chết tiệt! Sai chìa rồi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.WRAPBUNDLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.WRAPBUNDLE.EMPTY"
msgid "I don't know what to wrap."
msgstr "Tôi không biết phải bọc gì."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.WRITE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.WRITE.GENERIC"
msgid "I'm unable to do that right now."
msgstr "Tôi không thể làm điều đó ngay bây giờ."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.WRITE.INUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.WRITE.INUSE"
msgid "I can wait... it's the courteous thing to do."
msgstr "Tôi có thể đợi... đó là điều lịch sự nên làm."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.YOTB_STARTCONTEST.ALREADYACTIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.YOTB_STARTCONTEST.ALREADYACTIVE"
msgid "There must be a competition going on elsewhere..."
msgstr "Chắc hẳn đang có một cuộc thi diễn ra ở nơi khác..."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.YOTB_STARTCONTEST.DOESNTWORK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.YOTB_STARTCONTEST.DOESNTWORK"
msgid "Where is that incompetent judge?"
msgstr "Tên giám khảo bất tài đó đâu rồi?"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.YOTB_STARTCONTEST.NORESPONSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.YOTB_STARTCONTEST.NORESPONSE"
msgid "Where did he wander off to now?"
msgstr "Bây giờ anh ấy đã lang thang đi đâu?"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.YOTB_STARTCONTEST.RIGHTTHERE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.YOTB_STARTCONTEST.RIGHTTHERE"
msgid "How rude!"
msgstr "Thật thô lỗ!"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.YOTB_UNLOCKSKIN.ALREADYKNOWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.YOTB_UNLOCKSKIN.ALREADYKNOWN"
msgid "An old pattern. I've no use for it."
msgstr "Một mẫu cũ. Tôi chẳng cần đến nó."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL_GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL_GENERIC"
msgid "That didn't work."
msgstr "Làm thế không được."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ACCOMPLISHMENT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ACCOMPLISHMENT"
msgid "I need to pass the time somehow."
msgstr "Tôi cần giết thời gian bằng cách nào đó."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ACCOMPLISHMENT_DONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ACCOMPLISHMENT_DONE"
msgid "Ah. The satisfaction of a job well done."
msgstr "À. Niềm thỏa mãn khi hoàn thành tốt công việc."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ACIDBATS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ACIDBATS"
msgid "What now?"
msgstr "Lại gì nữa đây?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ADVENTUREFAIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ADVENTUREFAIL"
msgid "I of all people should be able to do this."
msgstr "Tôi, hơn ai hết, lẽ ra phải làm được việc này."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_SINKHOLE.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_SINKHOLE.1"
msgid "My world is crumbling!"
msgstr "Thế giới của tôi đang đổ nát!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_SINKHOLE.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_SINKHOLE.2"
msgid "I am attacked by my own world!"
msgstr "Tôi bị tấn công bởi thế giới của chính mình!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_SINKHOLE.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_SINKHOLE.3"
msgid "An earthquake!"
msgstr "Một trận động đất!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_TRIBUTE.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_TRIBUTE.1"
msgid "May this tribute sate the beast."
msgstr "Cầu mong sự cống nạp này có thể thỏa mãn được con thú."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_TRIBUTE.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_TRIBUTE.2"
msgid "Does this entertain you, beast?"
msgstr "Điều này có làm bạn thích thú không, con quái vật?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_TRIBUTE.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_TRIBUTE.3"
msgid "What a chore."
msgstr "Phiền phức thật."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ARCHIVE_NEW_KNOWLEDGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ARCHIVE_NEW_KNOWLEDGE"
msgid "This knowledge... it was hidden even from me."
msgstr "Kiến thức này... nó thậm chí còn bị giấu kín với tôi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ARCHIVE_NO_POWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ARCHIVE_NO_POWER"
msgid "It doesn't respond to shadow magic. Perhaps another power source..."
msgstr "Nó không phản ứng với ma thuật bóng tối. Có lẽ là một nguồn năng lượng khác..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ARCHIVE_OLD_KNOWLEDGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ARCHIVE_OLD_KNOWLEDGE"
msgid "A waste of my time. This knowledge is already mine."
msgstr "Một sự lãng phí thời gian của tôi. Kiến thức này đã là của tôi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATRIUM_DESTABILIZING.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATRIUM_DESTABILIZING.1"
msgid "Dark magics are returning."
msgstr "Ma thuật hắc ám đang quay trở lại."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATRIUM_DESTABILIZING.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATRIUM_DESTABILIZING.2"
msgid "Here we go again."
msgstr "Lại nữa rồi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATRIUM_DESTABILIZING.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATRIUM_DESTABILIZING.3"
msgid "The power's growing."
msgstr "Sức mạnh đang lớn dần."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_ATTACK"
msgid "I'm not afraid of some fisticuffs!"
msgstr "Tôi không ngại choảng nhau đâu!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_ELECTRICATTACK"
msgid "Unlimited power!"
msgstr "Sức mạnh vô hạn!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_MOISTUREIMMUNITY"
msgid "Finally, some respite from the dampness."
msgstr "Cuối cùng, một chút thời gian nghỉ ngơi khỏi sự ẩm ướt."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_PLAYERABSORPTION"
msgid "I feel protected by an unseen force."
msgstr "Tôi cảm thấy được bảo vệ bởi một thế lực vô hình."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_SLEEPRESISTANCE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_SLEEPRESISTANCE"
msgid "This will serve as a suitable ward against drowsiness."
msgstr "Thứ này sẽ là lá bùa chống buồn ngủ thích hợp."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_WORKEFFECTIVENESS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_WORKEFFECTIVENESS"
msgid "My focus feels heightened!"
msgstr "Tôi thấy mình tập trung hơn hẳn!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BECOMEGHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BECOMEGHOST"
msgid "oOooooOO!!"
msgstr "oOooooOO!!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BEES
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BEES"
msgid "Killing me won't bring back your honey!"
msgstr "Giết tôi cũng không mang mật ong của các ngươi về được đâu!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BOAT_LEAK"
msgid "We've sprung a leak!"
msgstr "Thuyền thủng rồi!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BOAT_SINK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BOAT_SINK"
msgid "Oh dear."
msgstr "Ôi trời ơi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BOOK_MOON_DAYTIME
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BOOK_MOON_DAYTIME"
msgid "We'll know if it worked once night falls."
msgstr "Chúng ta sẽ biết nếu nó hiệu quả khi màn đêm buông xuống."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BOOMERANG
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BOOMERANG"
msgid "Ow! Blasted... clumsy hands!"
msgstr "Ái! Cái tay... vụng về chết tiệt!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BRAVERY_POTION
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BRAVERY_POTION"
msgid "I was never really scared of those trees anyhow."
msgstr "Dù sao thì tôi cũng chưa bao giờ thực sự sợ những cái cây đó."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BURNT"
msgid "It burns!"
msgstr "Bỏng quá!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CALL_BEEF
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CALL_BEEF"
msgid "And here comes my... er, \"beautiful\" assistant."
msgstr "Và đây là... ờ, trợ lý \"xinh đẹp\" của tôi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CANFIX
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CANFIX"
msgid "\nI think I can fix this!"
msgstr "\nTôi nghĩ tôi có thể khắc phục được điều này!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CANNOT_BUILD.NO_INGREDIENTS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CANNOT_BUILD.NO_INGREDIENTS"
msgid "I don't have everything I need."
msgstr "Tôi không có mọi thứ tôi cần."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CANNOT_BUILD.NO_STATION
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CANNOT_BUILD.NO_STATION"
msgid "I can't make that here, pal."
msgstr "Tôi không thể làm được việc đó ở đây, anh bạn."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CANNOT_BUILD.NO_TECH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CANNOT_BUILD.NO_TECH"
msgid "Don't look at me, I've never made one before in my life."
msgstr "Đừng nhìn tôi, cả đời tôi chưa từng làm cái đó."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CANTBUILDHERE_YOTB_POST
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CANTBUILDHERE_YOTB_POST"
msgid "This seems a bit far from the festivities, don't you think?"
msgstr "Chỗ này có vẻ hơi xa lễ hội, anh không nghĩ vậy sao?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CANT_ESCAPE_CURSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CANT_ESCAPE_CURSE"
msgid "Odd... what kind of magic is this?"
msgstr "Kỳ lạ... đây là loại phép thuật gì vậy?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_ERROR_FELL_ASLEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_ERROR_FELL_ASLEEP"
msgid "Wake up, you useless vermin!"
msgstr "Thức dậy đi, đồ sâu bọ vô dụng!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_ERROR_STUNNED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_ERROR_STUNNED"
msgid "What's the matter? Get going!"
msgstr "Có chuyện gì vậy? Đi đi!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_ERROR_WALKING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_ERROR_WALKING"
msgid "Faster! Faster I say!"
msgstr "Nhanh nữa! Ta bảo nhanh nữa!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.1"
msgid "You fool! You're going the wrong way!"
msgstr "Đồ ngốc! Bạn đang đi sai đường!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2"
msgid "No! The other way!"
msgstr "Không! Hướng kia!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_START_RACE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_START_RACE"
msgid "Begin!"
msgstr "Bắt đầu!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CAVEIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CAVEIN"
msgid "The ceiling is going to collapse!"
msgstr "Trần nhà sắp sụp đổ!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CHAIR_ON_FIRE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CHAIR_ON_FIRE"
msgid "This is fine."
msgstr "Không sao đâu."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CHARLIE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CHARLIE"
msgid "I suppose it's best to keep up appearances..."
msgstr "Tôi cho rằng tốt nhất là cứ giữ nguyên vẻ bề ngoài..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CHARLIESAVE.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CHARLIESAVE.1"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CHARLIE_ATTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CHARLIE_ATTACK"
msgid "Ow! Be gentle, Charlie!"
msgstr "Ôi! Hãy nhẹ nhàng, Charlie!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COACH.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COACH.1"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COACH.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COACH.2"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

