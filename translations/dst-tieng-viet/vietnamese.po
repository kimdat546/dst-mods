msgstr "Thứ này sẽ thành một bữa ngon."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PONDFISH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PONDFISH"
