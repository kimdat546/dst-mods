msgstr "Nó trông mơ hồ có hình củ khoai tây... hoặc có lẽ tôi chỉ đói thôi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_SCANNER.HUNTING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_SCANNER.HUNTING"
