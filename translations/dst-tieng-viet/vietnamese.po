msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78.ATTACKER"
msgid "Is... something wrong with %s?"
msgstr "Có... có vấn đề gì với %s không?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78.FIRESTARTER"
msgid "Hey! You'll burn down the camp!"
msgstr "Này! Bạn sẽ đốt cháy trại lên!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78.GENERIC"
msgid "Hey %s!"
msgstr "Xin chào %s!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78.GHOST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78.GHOST"
msgid "See, you do have a soul! Now all you need is a heart."
msgstr "Thấy không, bạn thực sự có một linh hồn! Bây giờ bạn chỉ cần một trái tim."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78.MURDERER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78.MURDERER"
msgid "You're a killer robot? Amazing! Wait, no Walter, not amazing!"
msgstr "Cậu là robot sát thủ à? Tuyệt quá! Khoan, không được Walter, không tuyệt!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78.REVIVER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78.REVIVER"
msgid "Aw, you do care about us \"meatsacks\"!"
msgstr "Ồ, hóa ra cậu cũng quan tâm tới đám \"bao thịt\" bọn tôi!"

