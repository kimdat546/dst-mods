msgstr "Nó tồn tại chỉ để cản trở."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_GOLFPROP_SPRING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_GOLFPROP_SPRING"
