msgstr "Chúng tôi không thể sửa nó."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.USEITEMON.NOT_MINE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.USEITEMON.NOT_MINE"
