msgstr "Kho lưu trữ chống cháy, très grand!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
