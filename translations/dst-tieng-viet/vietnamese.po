msgstr "Tốt hơn là tôi nên chuẩn bị xong cái đó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTB_SEWINGMACHINE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTB_SEWINGMACHINE"
msgid "Sewing can't be that hard... can it?"
msgstr "Việc may vá chắc không khó đến thế... nhỉ?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTB_SEWINGMACHINE_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTB_SEWINGMACHINE_ITEM"
msgid "There looks to be a bit of assembly required."
msgstr "Có vẻ như cần một chút lắp ráp."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTB_STAGE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTB_STAGE"
msgid "Strange, I never see him enter or leave..."
msgstr "Lạ lùng, tôi chưa bao giờ thấy anh ta vào hoặc ra..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTB_STAGE_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTB_STAGE_ITEM"
msgid "It looks like a bit of building is in order."
msgstr "Có vẻ như cần xây dựng một chút."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRATSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRATSHRINE.BURNT"
msgid "Smells like roasted carrots."
msgstr "Mùi như cà rốt nướng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRATSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRATSHRINE.EMPTY"
msgid "Hm... what does a carrat like to eat?"
msgstr "Hm... cà ruột thích ăn gì?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRATSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRATSHRINE.GENERIC"
msgid "What to make..."
msgstr "Nên làm gì đây..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.BURNT"
msgid "My training regimen crashed and burned."
msgstr "Chế độ tập luyện của tôi đổ vỡ và cháy rụi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.GENERIC"
msgid "This'll get things moving in the right direction."
msgstr "Điều này sẽ khiến mọi thứ đi đúng hướng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.RAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.RAT"
msgid "You would make an excellent lab rat."
msgstr "Bạn sẽ trở thành một con chuột thí nghiệm xuất sắc."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION_ITEM"
msgid "I'd better get training!"
msgstr "Tôi nên bắt đầu tập luyện thôi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_REACTION.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_REACTION.BURNT"
msgid "A small loss to take in the pursuit of science."
msgstr "Một mất mát nhỏ trong việc theo đuổi khoa học."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC"
msgid "Let's train those carrat-like reflexes!"
msgstr "Hãy rèn luyện những phản xạ giống cà ruột đó!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_REACTION.RAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_REACTION.RAT"
msgid "The subject's response time is steadily improving!"
msgstr "Thời gian phản hồi của đối tượng đang dần được cải thiện!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM"
msgid "This should improve my carrat's reaction time considerably."
msgstr "Điều này sẽ cải thiện đáng kể thời gian phản ứng của cà ruột của tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_SPEED.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_SPEED.BURNT"
msgid "I may have overdone it."
msgstr "Tôi có thể đã làm quá mức."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_SPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_SPEED.GENERIC"
msgid "I need to get my carrat up to speed."
msgstr "Tôi cần giúp Cà Ruột của mình tăng tốc."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_SPEED.RAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_SPEED.RAT"
msgid "Faster... faster!"
msgstr "Nhanh hơn ... nhanh hơn!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_SPEED_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_SPEED_ITEM"
msgid "I'd better get this assembled."
msgstr "Tốt hơn tôi nên lắp ráp cái này."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.BURNT"
msgid "You can't stop progress! But this will delay it..."
msgstr "Bạn không thể ngừng tiến bộ! Nhưng điều này sẽ trì hoãn nó ..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.GENERIC"
msgid "Getting strong now!"
msgstr "Đang khỏe lên rồi đây!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.RAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.RAT"
msgid "This carrat... will be unstoppable!!"
msgstr "Cà Ruột này ... sẽ không thể ngăn cản !!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM"
msgid "This should help improve my carrat's stamina"
msgstr "Thứ này sẽ giúp cải thiện sức bền của Cà Ruột của tôi"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT"
msgid "You've made your point."
msgstr "Bạn đã đưa ra quan điểm của mình."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT_ITEM"
msgid "That checks out."
msgstr "Hợp lý đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_FINISH.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_FINISH.BURNT"
msgid "It's all gone up in flames!"
msgstr "Tất cả đã chìm trong biển lửa!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC"
msgid "It's really more of a finish circle than a line."
msgstr "Thật ra nó là vòng tròn đích hơn là vạch đích."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_FINISH.I_WON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_FINISH.I_WON"
msgid "Ha HA! Science prevails!"
msgstr "Ha ha! Khoa học chiếm ưu thế!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_FINISH.SOMEONE_ELSE_WON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_FINISH.SOMEONE_ELSE_WON"
msgid "Sigh... congratulations, {winner}."
msgstr "Thở dài ... Xin chúc mừng, {winner}."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_FINISH_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_FINISH_ITEM"
msgid "The end's in sight."
msgstr "Đích đến đã trong tầm mắt."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_START
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_START"
msgid "It's a good enough place to start."
msgstr "Đó là một nơi đủ tốt để bắt đầu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM"
msgid "Well, it's a start."
msgstr "Chà, cũng là một khởi đầu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_SCALE.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_SCALE.BURNT"
msgid "What a mess."
msgstr "Thật là một mớ hỗn độn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT"
msgid "I suppose no matter what, it's still just a sentient vegetable."
msgstr "Tôi cho rằng dù thế nào thì nó vẫn chỉ là một loại rau có tri giác."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD"
msgid "This carrat looks ripe for racing!"
msgstr "Cà Ruột này trông đã sẵn sàng để đua!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC"
msgid "Hopefully the scales tip in my favor."
msgstr "Hy vọng cán cân nghiêng về phía tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_SCALE_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_SCALE_ITEM"
msgid "This will help car-rate my car-rat."
msgstr "Thứ này sẽ giúp chấm điểm Cà Ruột của tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_SEEDPACKET"
msgid "Looks pretty seedy, if you ask me."
msgstr "Trông khá mờ ám, nếu bạn hỏi tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_SEEDPACKET_RARE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_SEEDPACKET_RARE"
msgid "Hey there, fancy-plants!"
msgstr "Này, những cây lạ mắt!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_ANCHOR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_ANCHOR"
msgid "I wouldn't want my boat to fly away."
msgstr "Tôi không muốn thuyền tôi bay mất đâu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_ANCHOR_ITEM"
msgid "Now I can build an anchor."
msgstr "Bây giờ tôi có thể xây dựng một mỏ neo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_DRAGONSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_DRAGONSHRINE.BURNT"
msgid "Things got a little heated."
msgstr "Mọi thứ hơi nóng lên một chút."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_DRAGONSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_DRAGONSHRINE.EMPTY"
msgid "It might like a piece of charcoal."
msgstr "Có lẽ nó thích một mẩu than củi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_DRAGONSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_DRAGONSHRINE.GENERIC"
msgid "I'm burning with curiosity to see what's on offer."
msgstr "Tôi bùng cháy với sự tò mò để xem những gì được mang đến."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_OAR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_OAR"
msgid "It's a really handy paddle."
msgstr "Nó là một chiếc mái chèo tiện dụng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_STEERINGWHEEL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_STEERINGWHEEL"
msgid "That'll steer me in the right direction. And the left direction."
msgstr "Nó sẽ lái tôi đi đúng hướng. Cả hướng trái nữa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_STEERINGWHEEL_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_STEERINGWHEEL_ITEM"
msgid "That's going to be the steering wheel."
msgstr "Nó sẽ là bánh lái."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTH_CHAIR_ROCKING_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTH_CHAIR_ROCKING_ITEM"
msgid "It's a rocky ride!"
msgstr "Đó là một chuyến đi đầy đá!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTH_KNIGHTHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTH_KNIGHTHAT"
msgid "Will I look like a foal?"
msgstr "Liệu tôi có trông giống một chú ngựa con không?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTH_KNIGHTSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTH_KNIGHTSHRINE.BURNT"
msgid "It's not a donkey, but it's definitely an ash."
msgstr "Đó không phải là con lừa, nhưng chắc chắn là tro."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTH_KNIGHTSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTH_KNIGHTSHRINE.EMPTY"
msgid "It gives the colt shoulder unless I offer it something."
msgstr "Nó sẽ lạnh nhạt với tôi trừ khi tôi dâng thứ gì đó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTH_KNIGHTSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTH_KNIGHTSHRINE.GENERIC"
msgid "I was shrine my best."
msgstr "Tôi đã cố gắng hết sức rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTH_KNIGHTSTICK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTH_KNIGHTSTICK"
msgid "I'm hot to trot!"
msgstr "Tôi nóng lòng muốn trót lọt!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTH_LANCE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTH_LANCE"
msgid "Hm, can't say I lance-a-lot."
msgstr "Hừm, không thể nói là tôi giỏi đâm thương lắm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTP_FOOD1
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTP_FOOD1"
msgid "A feast fit for me."
msgstr "Một bữa tiệc phù hợp với tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTP_FOOD2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTP_FOOD2"
msgid "A meal only a beast would love."
msgstr "Một bữa ăn chỉ có dã thú mới thích."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTP_FOOD3
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTP_FOOD3"
msgid "Nothing fancy."
msgstr "Chẳng có gì cầu kỳ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_DECOR_1.GENERAL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_DECOR_1.GENERAL"
msgid "That rabbit can really light up a room."
msgstr "Thỏ đó thực sự có thể thắp sáng một căn phòng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_DECOR_1.OUT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_DECOR_1.OUT"
msgid "That rabbit isn't lighting up anything."
msgstr "Con thỏ đó không thắp sáng bất cứ thứ gì."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_DECOR_1_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_DECOR_1_ITEM"
msgid "I know just the place for it."
msgstr "Tôi biết chính xác chỗ dành cho nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_DECOR_2.GENERAL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_DECOR_2.GENERAL"
msgid "That rabbit can really light up a room."
msgstr "Thỏ đó thực sự có thể thắp sáng một căn phòng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_DECOR_2.OUT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_DECOR_2.OUT"
msgid "That rabbit isn't lighting up anything."
msgstr "Con thỏ đó không thắp sáng bất cứ thứ gì."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_DECOR_2_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_DECOR_2_ITEM"
msgid "I know just the place for it."
msgstr "Tôi biết chính xác chỗ dành cho nó."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_FIGHTRING_BELL.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_FIGHTRING_BELL.GENERIC"
msgid "It's peaceful, for now."
msgstr "Bây giờ nó yên bình."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_FIGHTRING_BELL.PLAYING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_FIGHTRING_BELL.PLAYING"
msgid "I think we've all learned a lot here today."
msgstr "Tôi nghĩ rằng tất cả chúng ta đã học được rất nhiều ở đây ngày hôm nay."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_FIGHTRING_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_FIGHTRING_KIT"
msgid "It must be built, for science!"
msgstr "Phải dựng nó lên, vì khoa học!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_FOOD1
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_FOOD1"
msgid "It's made with carrots, so science says it must be healthy."
msgstr "Nó làm từ cà rốt, nên khoa học bảo nó hẳn là tốt cho sức khỏe."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_FOOD2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_FOOD2"
msgid "Blue is the most scientific flavor."
msgstr "Màu xanh là hương vị khoa học nhất."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_FOOD3
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_FOOD3"
msgid "A jiggly treat."
msgstr "Một món ngon rung rinh."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_FOOD4
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_FOOD4"
msgid "Bunny-hop right into my mouth!"
msgstr "Nhảy tót ngay vào miệng tôi nào!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_RABBITSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_RABBITSHRINE.BURNT"
msgid "Smells like veggie barbecue."
msgstr "Mùi như thịt nướng chay."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_RABBITSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_RABBITSHRINE.EMPTY"
msgid "That rabbit looks hungry."
msgstr "Con thỏ đó trông đói."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_RABBITSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_RABBITSHRINE.GENERIC"
msgid "What to make..."
msgstr "Nên làm gì đây..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_TOKEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_TOKEN"
msgid "I should be careful who I hand this out to."
msgstr "Tôi nên cẩn thận khi trao thứ này cho ai."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTS_LANTERN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTS_LANTERN_POST.BURNT"
msgid "It's post post"
msgstr "Hết còn là cột nữa rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTS_LANTERN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTS_LANTERN_POST.GENERIC"
msgid "It's post to be there."
msgstr "Nó được cắm ở đó là phải rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTS_LANTERN_POST_ITEM
