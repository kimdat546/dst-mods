msgid "'Tis cowardly to hide one's face behind a mask!"
msgstr "Thật hèn nhát khi giấu mặt sau một chiếc mặt nạ!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAST"
msgid "T'will harness Njord's mighty breath."
msgstr "Nó sẽ chế ngự hơi thở hùng mạnh của Njord."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MASTUPGRADE_LAMP_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MASTUPGRADE_LAMP_ITEM"
msgid "We shall keep the flame burning bright!"
msgstr "Chúng ta sẽ giữ cho ngọn lửa luôn cháy sáng!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MASTUPGRADE_LAMP_ITEM_YOTD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MASTUPGRADE_LAMP_ITEM_YOTD"
msgid "We shall keep the flame burning bright!"
msgstr "Chúng ta sẽ giữ lấy ngọn lửa cháy sáng!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MASTUPGRADE_LAMP_YOTD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MASTUPGRADE_LAMP_YOTD"
msgid "It watches over me."
msgstr "Nó trông chừng tôi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MASTUPGRADE_LIGHTNINGROD_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MASTUPGRADE_LIGHTNINGROD_ITEM"
msgid "You may do your worst, oh mighty Thor!"
msgstr "Cứ việc ra tay hết sức, hỡi Thor hùng mạnh!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAST_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAST_ITEM"
msgid "To harness the winds upon mine vessel!"
msgstr "Để khai thác gió trên tàu của tôi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAST_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAST_MALBATROSS"
msgid "Let us be off, with the speed of the Valkyrie!"
msgstr "Chúng ta hãy khởi hành với tốc độ của Valkyrie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAST_MALBATROSS_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAST_MALBATROSS_ITEM"
msgid "A winged sail for my vessel."
msgstr "Một cánh buồm có cánh cho con tàu của tôi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAST_YOTD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAST_YOTD"
msgid "May it catch the wind as well as a dragon's wing."
msgstr "Có thể nó sẽ cuỗm lấy gió như sải cánh của rồng."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAST_YOTD_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAST_YOTD_ITEM"
msgid "To harness the winds upon mine vessel!"
msgstr "Để khai thác những cơn gió trên tàu của tôi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELL"
msgid "Arrg! Is that the antagonist to my saga?!"
msgstr "Arrg! Đó có phải kẻ phản diện trong bản anh hùng ca của tôi?!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELLHEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELLHEAD"
msgid "I can see into his pores."
msgstr "Tôi nhìn thấy cả lỗ chân lông của hắn."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELLLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELLLIGHT"
msgid "Dark magic lives here."
msgstr "Ma thuật hắc ám ngự ở đây."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELLLOCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELLLOCK"
msgid "Shall I unlock it?"
msgstr "Ta có nên mở nó không?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELLPHONOGRAPH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELLPHONOGRAPH"
msgid "A mechanical songstress."
msgstr "Một nữ ca sĩ cơ khí."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELLTHRONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELLTHRONE"
msgid "I prefer to roam free, my unicorn and I."
msgstr "Tôi thích đi lang thang tự do, kỳ lân của tôi và tôi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEAT"
msgid "The true fruit of the earth!"
msgstr "Trái ngọt thật sự của đất trời!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATBALLS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATBALLS"
msgid "Tiny feast balls."
msgstr "Những viên tiệc tí hon."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.BURNT"
msgid "Such a shame."
msgstr "Thật đáng tiếc."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.DONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.DONE"
msgid "Let's eat!"
msgstr "Ăn thôi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.DONE_NOTMEAT"
msgid "Tis as dry as an empty well!"
msgstr "Nó khô như cái giếng rỗng!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.DRYING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.DRYING"
msgid "It's being prepared just the way I like it."
msgstr "Nó đang được chuẩn bị theo cách tôi thích."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.DRYINGINRAIN"
msgid "All this rain isn't helping."
msgstr "Tất cả cơn mưa này không giúp ích."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT"
msgid "All this rain isn't helping."
msgstr "Tất cả cơn mưa này không giúp ích."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.DRYING_NOTMEAT"
msgid "It's drying out nicely."
msgstr "Nó đang khô dần."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.GENERIC"
msgid "Ah! A dangly rack for my meats!"
msgstr "A! Một cái giá treo lủng lẳng cho thịt của tôi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT.BURNT"
msgid "Such a shame."
msgstr "Thật đáng tiếc."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT.DONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT.DONE"
msgid "The moisture has been vanquished!"
msgstr "Độ ẩm đã bị đánh bại!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT.DONE_NOTMEAT"
