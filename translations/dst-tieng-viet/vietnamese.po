msgid "I'd like to use that after you. If you don't mind, I mean."
msgstr "Tôi muốn sử dụng nó sau bạn. Ý tôi là nếu bạn không phiền."

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CHANGEIN.NOOCCUPANT
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CHANGEIN.NOOCCUPANT"
msgid "There's nothing here for me to groom..."
msgstr "Ở đây chẳng có gì để tôi phải chải chuốt cả..."

