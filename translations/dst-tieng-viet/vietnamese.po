msgstr "Ôi dễ thương quá, như một vực thẳm tí hon vậy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_GOLF_HOLE_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_GOLF_HOLE_KIT"
