msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FUMAROLEPICKAXE.HOT"
msgid "It still bears the heat of the forge!"
msgstr "Nó vẫn còn hơi nóng của lò rèn!"

