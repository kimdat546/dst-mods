#. STRINGS.SKIN_DESCRIPTIONS.profileflair_waterballoon_insect
msgctxt "STRINGS.SKIN_DESCRIPTIONS.profileflair_waterballoon_insect"
msgid "Set your profile icon to a Bugburst Waterballoon."
msgstr "Đặt biểu tượng hồ sơ của bạn thành Bóng Nước Bọ Nổ."

#. STRINGS.SKIN_DESCRIPTIONS.profileflair_watermelonhat_pumpkin
msgctxt "STRINGS.SKIN_DESCRIPTIONS.profileflair_watermelonhat_pumpkin"
msgid "Set your profile icon to a fashionable way to wander this world."
msgstr "Đặt biểu tượng hồ sơ của bạn thành một cách lang thang thế giới này thật thời thượng."

#. STRINGS.SKIN_DESCRIPTIONS.profileflair_werepig_howl
msgctxt "STRINGS.SKIN_DESCRIPTIONS.profileflair_werepig_howl"
msgid "Set your profile icon to a howling werepig."
msgstr "Đặt biểu tượng hồ sơ của bạn thành một con Lợn Sói đang tru."

#. STRINGS.SKIN_DESCRIPTIONS.profileflair_wererabbit
msgctxt "STRINGS.SKIN_DESCRIPTIONS.profileflair_wererabbit"
msgid "Set your profile icon to a grinning bunnyman.\n\nBunnymen make their homes deep in the caverns of The Constant."
msgstr "Đặt biểu tượng hồ sơ của bạn thành một Thỏ Người đang cười nhăn nhở.\n\nThỏ Người dựng nhà sâu trong các hang động của The Constant."

#. STRINGS.SKIN_DESCRIPTIONS.profileflair_winterometer_circus
msgctxt "STRINGS.SKIN_DESCRIPTIONS.profileflair_winterometer_circus"
msgid "Set your profile icon to a Thermal Strength Measurer."
msgstr "Đặt biểu tượng hồ sơ của bạn thành một Nhiệt Kế Đo Sức Mạnh."

#. STRINGS.SKIN_DESCRIPTIONS.profileflair_yule_bearger
msgctxt "STRINGS.SKIN_DESCRIPTIONS.profileflair_yule_bearger"
msgid "Set your profile icon to a grumpy Bearger, recently roused from deep hibernation.\n\nHappy Winter's Feast!"
msgstr "Đặt biểu tượng hồ sơ của bạn thành một con Gấu Lửng cáu bẳn vừa bị đánh thức khỏi giấc ngủ đông.\n\nChúc mừng Lễ Hội Mùa Đông!"

#. STRINGS.SKIN_DESCRIPTIONS.profileflair_yule_candycane
msgctxt "STRINGS.SKIN_DESCRIPTIONS.profileflair_yule_candycane"
msgid "Set your profile icon to a sweet Candy Cane."
msgstr "Đặt biểu tượng hồ sơ của bạn thành một cây Kẹo Gậy ngọt ngào."

#. STRINGS.SKIN_DESCRIPTIONS.profileflair_yule_chocolatelog
msgctxt "STRINGS.SKIN_DESCRIPTIONS.profileflair_yule_chocolatelog"
msgid "Set your profile icon to some decadent Chocolate Log Cake."
msgstr "Đặt biểu tượng hồ sơ của bạn thành một chiếc Bánh Gỗ Sô-cô-la ngon đến tội lỗi."

#. STRINGS.SKIN_DESCRIPTIONS.profileflair_yule_claus
msgctxt "STRINGS.SKIN_DESCRIPTIONS.profileflair_yule_claus"
msgid "Set your profile icon to the fearsome Klaus.\n\nThe Constant always seems to have an odd effect on Klaus this time of year; although we all tend to show our holiday spirit in different ways. Happy Winter's Feast!"
msgstr "Đặt biểu tượng hồ sơ của bạn thành Klaus đáng sợ.\n\nThe Constant dường như luôn tác động kỳ lạ lên Klaus vào dịp này mỗi năm; mà thôi, ai cũng có cách đón lễ của riêng mình. Chúc mừng Lễ Hội Mùa Đông!"

#. STRINGS.SKIN_DESCRIPTIONS.profileflair_yule_deer
msgctxt "STRINGS.SKIN_DESCRIPTIONS.profileflair_yule_deer"
msgid "Set your profile icon to a fuzzy No-Eyed Deer.\n\nHappy Winter's Feast!"
msgstr "Đặt biểu tượng hồ sơ của bạn thành một chú Hươu Không Mắt lông xù.\n\nChúc mừng Lễ Hội Mùa Đông!"

#. STRINGS.SKIN_DESCRIPTIONS.profileflair_yule_deerclops
msgctxt "STRINGS.SKIN_DESCRIPTIONS.profileflair_yule_deerclops"
msgid "Set your profile icon to a hungry holiday Deerclops.\n\nHappy Winter's Feast!"
msgstr "Đặt biểu tượng hồ sơ của bạn thành một con Deerclops háu ăn mùa lễ.\n\nChúc mừng Lễ Hội Mùa Đông!"

#. STRINGS.SKIN_DESCRIPTIONS.profileflair_yule_doorgategingerbread
