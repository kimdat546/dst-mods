msgstr "Có vẻ như vận mệnh của tôi đang thay đổi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RED_CAP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RED_CAP"
