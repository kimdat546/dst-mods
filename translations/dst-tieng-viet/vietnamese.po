msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POTATOSACK"
msgid "It's either filled with potato-shaped rocks or rock-shaped potatoes."
msgstr "Nó chứa đầy những tảng đá hình củ khoai tây hoặc những củ khoai tây hình đá."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POTATOSOUFFLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POTATOSOUFFLE"
msgid "I forgot what good food tasted like."
msgstr "Tôi quên mất thức ăn ngon có vị như thế nào."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POTATOTORNADO
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POTATOTORNADO"
msgid "Potato, scientifically infused with the power of a tornado!"
msgstr "Khoai tây, được khoa học hòa trộn với sức mạnh của một cơn lốc xoáy!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POTATO_COOKED"
msgid "A successful temperature experiment."
msgstr "Một thí nghiệm thành công về nhiệt độ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POTATO_OVERSIZED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POTATO_OVERSIZED"
msgid "That's a tater lot."
msgstr "Đó là một củ khoai tây to vật vã."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POTATO_SEEDS"
msgid "A handful of odd seeds."
msgstr "Một nắm hạt kỳ lạ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POTTEDFERN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POTTEDFERN"
msgid "A fern in a pot."
msgstr "Một cây dương xỉ trong chậu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POWCAKE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POWCAKE"
msgid "Science help us."
msgstr "Khoa học giúp chúng ta với."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POWDER_MONKEY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POWDER_MONKEY"
msgid "Don't you dare monkey around with my boat!"
msgstr "Đừng có mà dám đùa giỡn với thuyền của tôi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PREMIUMWATERINGCAN.EMPTY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PREMIUMWATERINGCAN.EMPTY"
msgid "It won't do me much good without water."
msgstr "Sẽ chẳng có ích gì nếu không có nước."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PREMIUMWATERINGCAN.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PREMIUMWATERINGCAN.GENERIC"
msgid "It's been improved with science... and bird parts!"
msgstr "Nó đã được cải tiến nhờ khoa học... và các bộ phận của chim!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PRIME_MATE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PRIME_MATE"
msgid "A nice hat is always a clear indicator of who's in charge."
msgstr "Một chiếc mũ đẹp luôn là dấu hiệu rõ ràng để biết ai là người chủ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUFFIN.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUFFIN.GENERIC"
msgid "I've never seen a live puffin before!"
msgstr "Tôi chưa từng thấy một con hải âu cổ rụt sống!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUFFIN.HELD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUFFIN.HELD"
msgid "Catching one ain't puffin to brag about."
msgstr "Bắt được một con không phải là chuyện để khoe khoang."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUFFIN.SLEEPING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUFFIN.SLEEPING"
msgid "Peacefully huffin' and puffin'."
msgstr "Ngủ yên, thở phì phò."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKIN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKIN"
msgid "It's as big as my head!"
msgstr "Nó to như đầu của tôi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKINCARVER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKINCARVER"
msgid "Who's up for a gourd time?"
msgstr "Ai muốn vui cùng bí ngô nào?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKINCOOKIE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKINCOOKIE"
msgid "That's a pretty gourd cookie!"
msgstr "Bánh quy bí ngô ngon ra trò!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKINHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKINHAT.GENERIC"
msgid "That's a hollow expression."
msgstr "Đó là một biểu hiện trống rỗng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKINHAT.UNCARVED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKINHAT.UNCARVED"
msgid "It's no gourd to wear without a face."
msgstr "Không có mặt thì đội chẳng hay gì."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKINPIE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKINPIE"
msgid "I should probably just eat the whole thing... for science."
msgstr "Có lẽ tôi nên ăn hết... vì khoa học."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKIN_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKIN_COOKED"
msgid "How did it not turn into a pie?"
msgstr "Làm thế nào mà nó không biến thành một chiếc bánh?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKIN_LANTERN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKIN_LANTERN"
msgid "Spooky!"
msgstr "Rùng rợn quá!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKIN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKIN_OVERSIZED"
msgid "A rather pumped up pumpkin."
msgstr "Một quả bí ngô khá căng mọng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKIN_SEEDS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKIN_SEEDS"
msgid "It's a seed."
msgstr "Đó là một hạt giống."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUNCHINGBAG
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUNCHINGBAG"
msgid "It comes with a finely calibrated ouch-o-meter."
msgstr "Nó có kèm đồng hồ đo độ-đau được hiệu chỉnh tinh vi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUREBRILLIANCE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUREBRILLIANCE"
msgid "It's blinding me with science!"
msgstr "Nó làm tôi lóa mắt bằng khoa học!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PURPLEAMULET
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PURPLEAMULET"
msgid "It's whispering to me."
msgstr "Nó thì thầm với tôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PURPLEGEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PURPLEGEM"
msgid "It contains the mysteries of the universe."
msgstr "Nó chứa những bí ẩn của vũ trụ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PURPLEMOONEYE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PURPLEMOONEYE"
msgid "Makes a good marker, but I wish it'd stop looking at me."
msgstr "Dùng làm mốc thì tốt, nhưng ước gì nó đừng nhìn tôi nữa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_ALTAR.FULL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_ALTAR.FULL"
msgid "It's in the process of digestinating."
msgstr "Nó đang trong quá trình tiêu hóa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_ALTAR.GENERIC"
msgid "We'd better start cooking some offerings."
msgstr "Tốt nhất chúng ta nên bắt đầu nấu vài đồ tế lễ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD"
msgid "As far as posts go, this one is adequate."
msgstr "Xét về cột thì cái này cũng tạm được."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_ALTAR_IVY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_ALTAR_IVY"
msgid "Kind of clingy."
msgstr "Bám dai phết nhỉ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_ALTAR_QUEEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_ALTAR_QUEEN"
msgid "A monumental monument."
msgstr "Một bức tượng vĩ đại."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_ALTAR_STATUE1
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_ALTAR_STATUE1"
msgid "It's an old statue."
msgstr "Đó là một bức tượng cũ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_ALTAR_STATUE2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_ALTAR_STATUE2"
msgid "What are you looking at?"
msgstr "Nhìn gì đấy?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_BEEFALO
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_BEEFALO"
msgid "Science says it should have died by now."
msgstr "Theo như khoa học chứng minh thì đáng lẽ chúng phải chết rồi chứ nhỉ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_BERRYBUSH"
msgid "Those berries are all gone."
msgstr "Những quả mọng đó mất tiêu hết rồi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_BOWL_SILVER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_BOWL_SILVER"
msgid "A bright bowl."
msgstr "Một cái bát sáng bóng"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_CARROT_SEEDS"
msgid "A handful of odd seeds."
msgstr "Một nắm hạt kỳ lạ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_CASSEROLEDISH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_CASSEROLEDISH"
msgid "A dish for all seasonings."
msgstr "Một cái nồi có thể chứa hết các nguyên liệu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL"
msgid "For making minuscule motleys."
msgstr "Cái này để làm mấy món nho nhỏ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_COIN1
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_COIN1"
msgid "I'd like more than a penny for my thoughts."
msgstr "Tôi muốn hơn một xu cho suy nghĩ của mình."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_COIN2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_COIN2"
msgid "A decent amount of coin."
msgstr "Một lượng kha khá tiền xu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_COIN3
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_COIN3"
msgid "Seems valuable."
msgstr "Trông có vẻ khá là giá trị."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_COIN4
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_COIN4"
msgid "We can use these to reopen the Gateway."
msgstr "Chúng ta có thể sử dụng đống xu này để mở lại Cánh Cổng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_CRABMEAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_CRABMEAT"
msgid "No imitations here."
msgstr "Không phải hàng nhái đâu nhé."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED"
msgid "I can put a meal together in a pinch."
msgstr "Mình có thể nấu một bữa ăn ngay lập tức."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_CRABTRAP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_CRABTRAP"
msgid "A crabby trap."
msgstr "Một cái bẫy cua."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_CRATE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_CRATE"
msgid "Kitchen stuff."
msgstr "Công cụ nhà bếp."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_FERN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_FERN"
msgid "Probably chock full of vitamins."
msgstr "Chắc nó đầy vitamin."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_FLOUR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_FLOUR"
msgid "Ready for baking."
msgstr "Sẵn sàng để làm bánh."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED"
msgid "We cooked the foliage."
msgstr "Chúng tôi nấu mấy cái lá cây."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_FOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_FOOD.GENERIC"
msgid "I should offer it on the Altar of Gnaw."
msgstr "Tôi nên dâng nó lên Bệ Thờ Của Gnaw."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_FOOD.MATCH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_FOOD.MATCH"
msgid "Science says this will appease the sky God."
msgstr "Khoa học nói rằng món này sẽ làm thoả mãn Thần bầu trời."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK"
msgid "It's more of a light snack, really."
msgstr "Nó giống một món ăn vặt nhẹ hơn, thật đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_FOOD.MISMATCH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_FOOD.MISMATCH"
msgid "That's not what it wants."
msgstr "Đó không phải là những gì nó muốn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_FOOD_BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_FOOD_BURNT"
msgid "That one was an experiment."
msgstr "Món đó là một thí nghiệm."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_GARLIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_GARLIC"
msgid "The number one breath enhancer."
msgstr "Chất tăng cường hơi thở số một."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_GARLIC_COOKED"
msgid "Perfectly browned."
msgstr "Một màu nâu hoàn hảo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_GARLIC_SEEDS"
msgid "A handful of odd seeds."
msgstr "Một nắm hạt kỳ lạ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_GOATKID
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_GOATKID"
msgid "This goat's much smaller."
msgstr "Con dê này bé tí."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_GOATMILK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_GOATMILK"
msgid "Good if you don't think about where it came from."
msgstr "Khá ngon nếu như bạn không nghĩ đến nó được tạo ra từ đâu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_GOATMUM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_GOATMUM"
msgid "Reminds me of my old nanny."
msgstr "Làm tôi nhớ đến bà bảo mẫu già của tôi"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_GRILL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_GRILL"
msgid "Now all I need is a backyard to put it in."
msgstr "Giờ thì tôi chỉ cần một cái sân sau để đặt nó thôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_GRILL_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_GRILL_ITEM"
msgid "I'll have to grill someone about this."
msgstr "Mình sẽ phải hỏi thăm ai đó về chuyện này."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_GRILL_SMALL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_GRILL_SMALL"
msgid "Barbecurious."
msgstr "Tiệc nướng tí hon đây."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM"
msgid "For grilling small meats."
msgstr "Để nướng những miếng thịt nhỏ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_HOE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_HOE"
msgid "It's a farming instrument."
msgstr "Đó là một dụng cụ trồng cây."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_KEY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_KEY"
msgid "Safe bet this'll come in handy."
msgstr "Chắc chắn cái này sẽ có ích."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_KEY_PARK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_KEY_PARK"
msgid "I'll park it in my pocket until I get to the park."
msgstr "Tôi sẽ đặt nó trong túi cho đến khi tôi đến công viên."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_LAMP_POST
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_LAMP_POST"
msgid "Huh. Reminds me of home."
msgstr "Huh. Làm tôi nhớ đến quê nhà."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_LAMP_SHORT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_LAMP_SHORT"
msgid "Enlightening."
msgstr "Khai sáng."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_MEALINGSTONE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_MEALINGSTONE"
msgid "The daily grind."
msgstr "Chuyện xay xát thường ngày."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_MERMHOUSE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_MERMHOUSE"
msgid "What an ugly little house."
msgstr "Thật là một ngôi nhà nhỏ xấu xí."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_MERM_CART1
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_MERM_CART1"
msgid "Any science in there?"
msgstr "Trong đó có khoa học không?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_MERM_CART2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_MERM_CART2"
msgid "I could use some stuff."
msgstr "Tôi đang cần vài thứ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_MUSHROOMS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_MUSHROOMS"
msgid "These are edible mushrooms."
msgstr "Đây là những loại nấm ăn được."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC"
msgid "Are those mushrooms? I'm stumped."
msgstr "Đó có phải là nấm không? Tôi bối rối."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED"
msgid "I don't think it's growing back."
msgstr "Tôi không nghĩ nó sẽ mọc lại."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_ONION
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_ONION"
msgid "Looks crunchy."
msgstr "Trông giòn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_ONION_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_ONION_COOKED"
msgid "A successful chemical reaction."
msgstr "Một phản ứng hóa học thành công."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_ONION_SEEDS"
msgid "A handful of odd seeds."
msgstr "Một nắm hạt kỳ lạ."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_OVEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_OVEN"
