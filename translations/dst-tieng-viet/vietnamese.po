msgstr "À, tốt hơn rồi."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_SISTURN_FULL_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_SISTURN_FULL_BLOSSOM"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_SISTURN_FULL_EVIL
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_SISTURN_FULL_EVIL"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_SNARED
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_SNARED"
