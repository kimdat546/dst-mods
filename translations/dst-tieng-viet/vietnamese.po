msgstr "Nó đủ êm ái đối với tôi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HANDPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HANDPILLOW_KELP"
