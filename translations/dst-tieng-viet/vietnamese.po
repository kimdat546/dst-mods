msgstr "Một hình dáng không có sự sống."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_GOLFPROP_FAN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_GOLFPROP_FAN"
msgid "I love the wind, but not while I'm putting."
msgstr "Tôi yêu gió, nhưng không phải lúc đang gạt bóng."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_GOLFPROP_FENCE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_GOLFPROP_FENCE"
