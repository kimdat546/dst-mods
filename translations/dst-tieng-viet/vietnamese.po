msgstr "Chúng ta nên mang nó theo trong chuyến đi thuyền của mình."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BANANABUSH
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BANANABUSH"
