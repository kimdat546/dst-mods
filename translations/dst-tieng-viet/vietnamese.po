msgstr "Chúng xây mấy cái này kiểu gì khi không có ngón cái nhỉ?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RABBITKINGHORN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RABBITKINGHORN"
