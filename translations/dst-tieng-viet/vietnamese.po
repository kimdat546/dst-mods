msgstr "Lửa thanh tẩy, để chuyện tệ nhất khỏi xảy ra."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GENERIC_CORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GENERIC_CORPSE.GENERIC"
msgid "I'm not mistaken, its life's been taken."
msgstr "Tôi không nhầm, nó đã bị lấy đi mạng sống."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GENERIC_CORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GENERIC_CORPSE.REVIVING"
msgid "It's turning and returning."
msgstr "Nó đang biến đổi và quay về."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GESTALT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GESTALT"
msgid "Good evening, children!"
msgstr "Chào buổi tối các em!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GESTALT_CAGE.FILLED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GESTALT_CAGE.FILLED"
msgid "It hides insides!"
msgstr "Nó ẩn bên trong!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GESTALT_CAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GESTALT_CAGE.GENERIC"
msgid "Nothing worth noting."
msgstr "Không có gì đáng chú ý."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GESTALT_GUARD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GESTALT_GUARD"
msgid "They grow up so fast!"
msgstr "Chúng lớn lên nhanh quá!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GESTALT_GUARD_EVOLVED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GESTALT_GUARD_EVOLVED"
