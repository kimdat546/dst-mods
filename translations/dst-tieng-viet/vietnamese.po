msgstr "Tôi khuyên bạn không nên ăn những thứ đó."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DUG_SAPLING"
msgid "Should I bring it back to life?"
msgstr "Tôi có nên làm nó sống lại không?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DUG_TRAP_STARFISH
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DUG_TRAP_STARFISH"
