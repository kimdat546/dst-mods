msgstr "Những con thỏ đó thật tốt bụng."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RABBITKINGMINION_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RABBITKINGMINION_BUNNYMAN"
msgid "Must be somethin' in the carrots."
msgstr "Chắc là có gì đó trong mấy củ cà rốt."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RABBITKINGSPEAR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RABBITKINGSPEAR"
