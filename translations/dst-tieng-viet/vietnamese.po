msgstr "Giao"

#. STRINGS.WOBY_COMMANDS.FORAGING
msgctxt "STRINGS.WOBY_COMMANDS.FORAGING"
msgid "Foraging (on/off)"
msgstr "Tìm kiếm thức ăn (bật/tắt)"

#. STRINGS.WOBY_COMMANDS.PICKUP
msgctxt "STRINGS.WOBY_COMMANDS.PICKUP"
msgid "Retrieving (on/off)"
msgstr "Nhặt đồ (bật/tắt)"

#. STRINGS.WOBY_COMMANDS.REMEMBERCHEST
msgctxt "STRINGS.WOBY_COMMANDS.REMEMBERCHEST"
msgid "Mark Spot"
msgstr "Đánh dấu điểm"

#. STRINGS.WOBY_COMMANDS.SHADOWDASH
msgctxt "STRINGS.WOBY_COMMANDS.SHADOWDASH"
msgid "Umbral Dash (on/off)"
msgstr "Lướt Bóng Tối (bật/tắt)"

#. STRINGS.WOBY_COMMANDS.SHRINK
msgctxt "STRINGS.WOBY_COMMANDS.SHRINK"
msgid "Transform"
msgstr "Biến hình"

#. STRINGS.WOBY_COMMANDS.SIT
msgctxt "STRINGS.WOBY_COMMANDS.SIT"
msgid "Stay (on/off)"
msgstr "Ở lại (bật/tắt)"

#. STRINGS.WOBY_COMMANDS.SPRINTING
msgctxt "STRINGS.WOBY_COMMANDS.SPRINTING"
msgid "Sprinting (on/off)"
msgstr "Chạy nước rút (bật/tắt)"

#. STRINGS.WOBY_COMMANDS.WORKING
msgctxt "STRINGS.WOBY_COMMANDS.WORKING"
msgid "Helping Horns (on/off)"
msgstr "Sừng giúp việc (bật/tắt)"

#. STRINGS.YOTB_ALREADY_GOT_YOURS
msgctxt "STRINGS.YOTB_ALREADY_GOT_YOURS"
msgid "You already got yours. No double dipping."
msgstr "Bạn đã nhận rồi. Không được lấy hai lần."

#. STRINGS.YOTB_APPRAISE_END
msgctxt "STRINGS.YOTB_APPRAISE_END"
msgid "Wonderful item you've got there."
msgstr "Món đồ của bạn tuyệt thật đấy."

#. STRINGS.YOTB_APPRAISE_START
msgctxt "STRINGS.YOTB_APPRAISE_START"
msgid "Let's see what you have there."
msgstr "Hãy xem những gì bạn có ở đó."

#. STRINGS.YOTB_COLLECT_PRIZE_QUICK
msgctxt "STRINGS.YOTB_COLLECT_PRIZE_QUICK"
msgid "Things are getting out of hand, hurry up and collect your prizes!"
msgstr "Mọi thứ đang trở nên quá tầm, nhanh tay rinh giải về thôi nào!"

#. STRINGS.YOTB_CONGRATS_WINNER
msgctxt "STRINGS.YOTB_CONGRATS_WINNER"
msgid "Congrats little guy! You win!"
msgstr "Chúc mừng anh bạn nhỏ! Bạn thắng!"

#. STRINGS.YOTB_CONGRATS_WINNER_SECOND
msgctxt "STRINGS.YOTB_CONGRATS_WINNER_SECOND"
msgid "Congratulations!"
msgstr "Xin chúc mừng!"

#. STRINGS.YOTB_CONGRATS_WINNER_THIRD
msgctxt "STRINGS.YOTB_CONGRATS_WINNER_THIRD"
msgid "Take a bow!"
msgstr "Cúi chào đi!"

#. STRINGS.YOTB_CONSOLE_PRIZES
msgctxt "STRINGS.YOTB_CONSOLE_PRIZES"
msgid "Everyone gets to take something home."
msgstr "Mọi người có thể mang một thứ gì đó về nhà."

#. STRINGS.YOTB_CONTEST_BEGIN
msgctxt "STRINGS.YOTB_CONTEST_BEGIN"
msgid "OK, lets get this show going..."
msgstr "Được rồi, hãy bắt đầu chương trình này..."

#. STRINGS.YOTB_CONTEST_END
msgctxt "STRINGS.YOTB_CONTEST_END"
msgid "Very nice, I think we're done."
msgstr "Rất tuyệt, tôi nghĩ chúng ta đã hoàn thành."

#. STRINGS.YOTB_CONTEST_FEARSOME_EXTREMEHIGH.1
msgctxt "STRINGS.YOTB_CONTEST_FEARSOME_EXTREMEHIGH.1"
msgid "This one is much too fearsome."
msgstr "Con này dữ tợn quá mức."

#. STRINGS.YOTB_CONTEST_FEARSOME_EXTREMEHIGH.2
msgctxt "STRINGS.YOTB_CONTEST_FEARSOME_EXTREMEHIGH.2"
msgid "This beefalo's fierceness is well beyond my taste today."
msgstr "Độ dữ tợn của con Bò Lai này hôm nay vượt xa sở thích của tôi."

#. STRINGS.YOTB_CONTEST_FEARSOME_EXTREMELOW.1
msgctxt "STRINGS.YOTB_CONTEST_FEARSOME_EXTREMELOW.1"
msgid "Today's beefalo needs to be a lot more fierce than this teddy bear."
msgstr "Bò Lai hôm nay cần dữ tợn hơn nhiều so với con gấu bông này."

#. STRINGS.YOTB_CONTEST_FEARSOME_EXTREMELOW.2
msgctxt "STRINGS.YOTB_CONTEST_FEARSOME_EXTREMELOW.2"
msgid "I'm looking for something way more fearsome today."
msgstr "Hôm nay tôi đang tìm thứ gì đó dữ tợn hơn nhiều."

#. STRINGS.YOTB_CONTEST_FEARSOME_HIGH.1
msgctxt "STRINGS.YOTB_CONTEST_FEARSOME_HIGH.1"
msgid "This beefalo is just a little fiercer than I want."
msgstr "Con bò này dữ dội hơn tôi muốn một chút."

#. STRINGS.YOTB_CONTEST_FEARSOME_HIGH.2
msgctxt "STRINGS.YOTB_CONTEST_FEARSOME_HIGH.2"
msgid "Being a little too fierce can be good, but not today."
msgstr "Dữ tợn quá một chút cũng có thể tốt, nhưng không phải hôm nay."

#. STRINGS.YOTB_CONTEST_FEARSOME_LOW.1
msgctxt "STRINGS.YOTB_CONTEST_FEARSOME_LOW.1"
msgid "Maybe this beefalo could be a little more fierce."
msgstr "Có lẽ con bò này có thể dữ dằn hơn một chút."

#. STRINGS.YOTB_CONTEST_FEARSOME_LOW.2
msgctxt "STRINGS.YOTB_CONTEST_FEARSOME_LOW.2"
msgid "This beefalo is not as fierce as I'd like, but it's close."
msgstr "Con Bò Lai này chưa dữ tợn như tôi muốn, nhưng cũng gần rồi."

#. STRINGS.YOTB_CONTEST_FEARSOME_PERFECT.1
msgctxt "STRINGS.YOTB_CONTEST_FEARSOME_PERFECT.1"
msgid "I like this one's ferocity."
msgstr "Tôi thích độ hung dữ của con này."

#. STRINGS.YOTB_CONTEST_FEARSOME_PERFECT.2
msgctxt "STRINGS.YOTB_CONTEST_FEARSOME_PERFECT.2"
msgid "This beefalo fills me with just the right amount of fear."
msgstr "Con Bò Lai này khiến tôi sợ vừa đủ."

#. STRINGS.YOTB_CONTEST_FEARSOME_TARGET_EXTREMEHIGH.1
msgctxt "STRINGS.YOTB_CONTEST_FEARSOME_TARGET_EXTREMEHIGH.1"
msgid "Finally, I'm in the mood for a good scare. Let's see your most fearsome beefalo!"
msgstr "Cuối cùng, tôi đang muốn được dọa một phen ra trò. Cho tôi xem con Bò Lai đáng sợ nhất của bạn nào!"

#. STRINGS.YOTB_CONTEST_FEARSOME_TARGET_EXTREMELOW.1
msgctxt "STRINGS.YOTB_CONTEST_FEARSOME_TARGET_EXTREMELOW.1"
msgid "Finally, today's winner needs to be a teddy bear. My heart can't take a scare."
msgstr "Cuối cùng, người thắng hôm nay phải là một con gấu bông. Tim tôi không chịu nổi sợ hãi đâu."

#. STRINGS.YOTB_CONTEST_FEARSOME_TARGET_HIGH.1
msgctxt "STRINGS.YOTB_CONTEST_FEARSOME_TARGET_HIGH.1"
msgid "Finally, today's winner will be only mildly more fearsome than friendly."
msgstr "Cuối cùng, người thắng hôm nay chỉ nên đáng sợ hơn thân thiện một chút xíu."

#. STRINGS.YOTB_CONTEST_FEARSOME_TARGET_LOW.1
msgctxt "STRINGS.YOTB_CONTEST_FEARSOME_TARGET_LOW.1"
msgid "Finally, I'd like to see a beefalo that's just a bit more friendly than scary."
msgstr "Cuối cùng, tôi muốn thấy một con Bò Lai thân thiện hơn đáng sợ một chút."

#. STRINGS.YOTB_CONTEST_FEARSOME_TARGET_PERFECT.1
msgctxt "STRINGS.YOTB_CONTEST_FEARSOME_TARGET_PERFECT.1"
msgid "Finally, I can't quite decide. Show me a good balance of fearsome and friendly."
msgstr "Cuối cùng, tôi không quyết được. Cho tôi xem sự cân bằng giữa đáng sợ và thân thiện."

#. STRINGS.YOTB_CONTEST_FEARSOME_TARGET_VERYHIGH.1
msgctxt "STRINGS.YOTB_CONTEST_FEARSOME_TARGET_VERYHIGH.1"
msgid "Finally, I'm looking for something quite fierce."
msgstr "Cuối cùng, tôi đang tìm một con khá dữ tợn."

#. STRINGS.YOTB_CONTEST_FEARSOME_TARGET_VERYHIGH.2
msgctxt "STRINGS.YOTB_CONTEST_FEARSOME_TARGET_VERYHIGH.2"
msgid "Finally, I want something quite fearsome looking."
msgstr "Cuối cùng, tôi muốn một cái gì đó trông khá đáng sợ."

#. STRINGS.YOTB_CONTEST_FEARSOME_TARGET_VERYLOW.1
msgctxt "STRINGS.YOTB_CONTEST_FEARSOME_TARGET_VERYLOW.1"
msgid "Finally, I'm looking for only the tiniest hint of ferocity."
msgstr "Cuối cùng, tôi chỉ muốn một chút xíu hung dữ thôi."

#. STRINGS.YOTB_CONTEST_FEARSOME_TARGET_VERYLOW.2
msgctxt "STRINGS.YOTB_CONTEST_FEARSOME_TARGET_VERYLOW.2"
msgid "Finally, today I want to see a little ferocity, but just a touch."
msgstr "Cuối cùng, hôm nay tôi muốn thấy chút hung dữ, nhưng chỉ một chút thôi."

#. STRINGS.YOTB_CONTEST_FEARSOME_VERYHIGH.1
msgctxt "STRINGS.YOTB_CONTEST_FEARSOME_VERYHIGH.1"
msgid "This specimen is more fierce than I want."
msgstr "Con này dữ tợn hơn tôi muốn."

#. STRINGS.YOTB_CONTEST_FEARSOME_VERYHIGH.2
msgctxt "STRINGS.YOTB_CONTEST_FEARSOME_VERYHIGH.2"
msgid "I respect how fearsome this beefalo is, but it's more than I like."
msgstr "Tôi nể độ đáng sợ của con Bò Lai này, nhưng nó hơn mức tôi thích."

#. STRINGS.YOTB_CONTEST_FEARSOME_VERYLOW.1
msgctxt "STRINGS.YOTB_CONTEST_FEARSOME_VERYLOW.1"
msgid "I'd like my beefalo to be a fair bit more fearsome than this."
msgstr "Tôi muốn con bò của mình đáng sợ hơn thế này một chút."

#. STRINGS.YOTB_CONTEST_FEARSOME_VERYLOW.2
msgctxt "STRINGS.YOTB_CONTEST_FEARSOME_VERYLOW.2"
msgid "This one is not quite fierce enough, by a good margin."
msgstr "Con này chưa đủ dữ tợn, còn kém xa."

#. STRINGS.YOTB_CONTEST_FESTIVE_EXTREMEHIGH.1
msgctxt "STRINGS.YOTB_CONTEST_FESTIVE_EXTREMEHIGH.1"
msgid "This one is much too festive."
msgstr "Con này tiệc tùng quá mức."

#. STRINGS.YOTB_CONTEST_FESTIVE_EXTREMEHIGH.2
msgctxt "STRINGS.YOTB_CONTEST_FESTIVE_EXTREMEHIGH.2"
msgid "This beefalo's festiveness is well beyond my taste today."
msgstr "Vẻ tiệc tùng của con Bò Lai này hôm nay vượt xa sở thích của tôi."

#. STRINGS.YOTB_CONTEST_FESTIVE_EXTREMELOW.1
msgctxt "STRINGS.YOTB_CONTEST_FESTIVE_EXTREMELOW.1"
msgid "Today's beefalo needs to be a lot more festive than this curmudgeon."
msgstr "Bò Lai hôm nay cần tiệc tùng hơn nhiều so với con cau có này."

#. STRINGS.YOTB_CONTEST_FESTIVE_EXTREMELOW.2
msgctxt "STRINGS.YOTB_CONTEST_FESTIVE_EXTREMELOW.2"
msgid "I'm looking for something way more festive today."
msgstr "Hôm nay tôi đang tìm thứ gì đó tiệc tùng hơn nhiều."

#. STRINGS.YOTB_CONTEST_FESTIVE_HIGH.1
msgctxt "STRINGS.YOTB_CONTEST_FESTIVE_HIGH.1"
msgid "This beefalo is just a little more festive than I want."
msgstr "Con bò này chỉ mang tính lễ hội hơn tôi muốn một chút."

#. STRINGS.YOTB_CONTEST_FESTIVE_HIGH.2
msgctxt "STRINGS.YOTB_CONTEST_FESTIVE_HIGH.2"
msgid "Being a little too festive can be good, but not today."
msgstr "Tiệc tùng quá một chút cũng có thể tốt, nhưng không phải hôm nay."

#. STRINGS.YOTB_CONTEST_FESTIVE_LOW.1
msgctxt "STRINGS.YOTB_CONTEST_FESTIVE_LOW.1"
msgid "Maybe this beefalo could be a little more festive."
msgstr "Có lẽ con bò này có thể mang tính lễ hội hơn một chút."

#. STRINGS.YOTB_CONTEST_FESTIVE_LOW.2
msgctxt "STRINGS.YOTB_CONTEST_FESTIVE_LOW.2"
msgid "This beefalo is not as festive as I'd like, but it's close."
msgstr "Con Bò Lai này chưa tiệc tùng như tôi muốn, nhưng cũng gần rồi."

#. STRINGS.YOTB_CONTEST_FESTIVE_PERFECT.1
msgctxt "STRINGS.YOTB_CONTEST_FESTIVE_PERFECT.1"
msgid "I like this one's festivity."
msgstr "Tôi thích vẻ tiệc tùng của con này."

#. STRINGS.YOTB_CONTEST_FESTIVE_PERFECT.2
msgctxt "STRINGS.YOTB_CONTEST_FESTIVE_PERFECT.2"
msgid "This beefalo is just festive enough."
msgstr "Con Bò Lai này tiệc tùng vừa đủ."

#. STRINGS.YOTB_CONTEST_FESTIVE_TARGET_EXTREMEHIGH.1
msgctxt "STRINGS.YOTB_CONTEST_FESTIVE_TARGET_EXTREMEHIGH.1"
msgid "Also, the winner should be the most festive of beasts."
msgstr "Ngoài ra, người thắng phải là con thú tiệc tùng nhất."

#. STRINGS.YOTB_CONTEST_FESTIVE_TARGET_EXTREMELOW.1
msgctxt "STRINGS.YOTB_CONTEST_FESTIVE_TARGET_EXTREMELOW.1"
msgid "Also, I don't want to see even a hint of festivity in today's Champion."
msgstr "Ngoài ra, tôi không muốn thấy chút vẻ tiệc tùng nào ở nhà vô địch hôm nay."

#. STRINGS.YOTB_CONTEST_FESTIVE_TARGET_EXTREMELOW.2
msgctxt "STRINGS.YOTB_CONTEST_FESTIVE_TARGET_EXTREMELOW.2"
msgid "Also, I'm in no mood for festivity today. I'd better not see a trace of it!"
msgstr "Ngoài ra, hôm nay tôi chẳng có hứng tiệc tùng. Tốt nhất đừng để tôi thấy chút dấu vết nào của nó!"

#. STRINGS.YOTB_CONTEST_FESTIVE_TARGET_HIGH.1
msgctxt "STRINGS.YOTB_CONTEST_FESTIVE_TARGET_HIGH.1"
msgid "Also, there should be a lot of festivity, with just a dash of somberness."
msgstr "Ngoài ra, phải thật tiệc tùng, chỉ điểm chút trầm lặng."

#. STRINGS.YOTB_CONTEST_FESTIVE_TARGET_LOW.1
msgctxt "STRINGS.YOTB_CONTEST_FESTIVE_TARGET_LOW.1"
msgid "Also, today's winner will be a bit more somber than festive."
msgstr "Ngoài ra, người thắng hôm nay sẽ trầm lặng hơn tiệc tùng một chút."

#. STRINGS.YOTB_CONTEST_FESTIVE_TARGET_PERFECT.1
msgctxt "STRINGS.YOTB_CONTEST_FESTIVE_TARGET_PERFECT.1"
msgid "Also, I'm looking for a tasteful mix of festivity and somberness."
msgstr "Ngoài ra, tôi đang tìm sự pha trộn tinh tế giữa tiệc tùng và trầm lặng."

#. STRINGS.YOTB_CONTEST_FESTIVE_TARGET_PERFECT.2
msgctxt "STRINGS.YOTB_CONTEST_FESTIVE_TARGET_PERFECT.2"
msgid "Also, today's champion will be a perfect balance of somber and festive."
msgstr "Ngoài ra, nhà vô địch hôm nay sẽ cân bằng hoàn hảo giữa trầm lặng và tiệc tùng."

#. STRINGS.YOTB_CONTEST_FESTIVE_TARGET_VERYHIGH.1
msgctxt "STRINGS.YOTB_CONTEST_FESTIVE_TARGET_VERYHIGH.1"
msgid "Also, I'm looking for quite a lot of festivity today."
msgstr "Ngoài ra, hôm nay tôi muốn thấy thật nhiều vẻ tiệc tùng."

#. STRINGS.YOTB_CONTEST_FESTIVE_TARGET_VERYLOW.1
msgctxt "STRINGS.YOTB_CONTEST_FESTIVE_TARGET_VERYLOW.1"
msgid "Also, I only want to see the tiniest hint of festivity."
msgstr "Ngoài ra, tôi chỉ muốn thấy một chút xíu vẻ tiệc tùng."

#. STRINGS.YOTB_CONTEST_FESTIVE_VERYHIGH.1
msgctxt "STRINGS.YOTB_CONTEST_FESTIVE_VERYHIGH.1"
msgid "This fella is more festive than I want."
msgstr "Anh bạn này tiệc tùng hơn tôi muốn."

#. STRINGS.YOTB_CONTEST_FESTIVE_VERYHIGH.2
msgctxt "STRINGS.YOTB_CONTEST_FESTIVE_VERYHIGH.2"
msgid "I respect how festive this beefalo is, but it's more than I like."
msgstr "Tôi nể vẻ tiệc tùng của con Bò Lai này, nhưng nó hơn mức tôi thích."

#. STRINGS.YOTB_CONTEST_FESTIVE_VERYLOW.1
msgctxt "STRINGS.YOTB_CONTEST_FESTIVE_VERYLOW.1"
msgid "I'd like my beefalo to be a fair bit more festive than this."
msgstr "Tôi muốn con bò của mình sẽ mang tính lễ hội hơn thế này một chút."

#. STRINGS.YOTB_CONTEST_FESTIVE_VERYLOW.2
msgctxt "STRINGS.YOTB_CONTEST_FESTIVE_VERYLOW.2"
msgid "This one is not quite festive enough, by a good margin."
msgstr "Con này chưa đủ tiệc tùng, còn kém xa."

#. STRINGS.YOTB_CONTEST_FIGHT_END
msgctxt "STRINGS.YOTB_CONTEST_FIGHT_END"
msgid "Alright, contest over for now folks!"
msgstr "Được rồi, cuộc thi tạm kết thúc rồi mọi người!"

#. STRINGS.YOTB_CONTEST_FIRST_PLACE
msgctxt "STRINGS.YOTB_CONTEST_FIRST_PLACE"
msgid "Finally, my first place pick is..."
msgstr "Cuối cùng, lựa chọn cho giải nhất của tôi là..."

#. STRINGS.YOTB_CONTEST_FORMAL_EXTREMEHIGH.1
msgctxt "STRINGS.YOTB_CONTEST_FORMAL_EXTREMEHIGH.1"
msgid "This one is much too formal."
msgstr "Con này trang trọng quá mức."

#. STRINGS.YOTB_CONTEST_FORMAL_EXTREMEHIGH.2
msgctxt "STRINGS.YOTB_CONTEST_FORMAL_EXTREMEHIGH.2"
msgid "This beefalo's formalness is well beyond my taste today."
msgstr "Vẻ trang trọng của con Bò Lai này hôm nay vượt xa sở thích của tôi."

#. STRINGS.YOTB_CONTEST_FORMAL_EXTREMELOW.1
msgctxt "STRINGS.YOTB_CONTEST_FORMAL_EXTREMELOW.1"
msgid "Today's beefalo needs to be a lot more formal than this ragamuffin."
msgstr "Bò Lai hôm nay cần trang trọng hơn nhiều so với con nhếch nhác này."

#. STRINGS.YOTB_CONTEST_FORMAL_EXTREMELOW.2
msgctxt "STRINGS.YOTB_CONTEST_FORMAL_EXTREMELOW.2"
msgid "I'm looking for something way more formal today."
msgstr "Hôm nay tôi đang tìm kiếm một thứ gì đó trang trọng hơn."

#. STRINGS.YOTB_CONTEST_FORMAL_HIGH.1
msgctxt "STRINGS.YOTB_CONTEST_FORMAL_HIGH.1"
msgid "This beefalo is just a little more formal than I want."
msgstr "Con bò này chỉ trang trọng hơn một chút so với tôi muốn."

#. STRINGS.YOTB_CONTEST_FORMAL_HIGH.2
msgctxt "STRINGS.YOTB_CONTEST_FORMAL_HIGH.2"
msgid "Being a little too formal can be good, but not today."
msgstr "Quá trang trọng một chút có thể tốt, nhưng không phải hôm nay."

#. STRINGS.YOTB_CONTEST_FORMAL_LOW.1
msgctxt "STRINGS.YOTB_CONTEST_FORMAL_LOW.1"
msgid "Maybe this beefalo could be a little more formal."
msgstr "Có lẽ con bò này có thể trang trọng hơn một chút."

#. STRINGS.YOTB_CONTEST_FORMAL_LOW.2
msgctxt "STRINGS.YOTB_CONTEST_FORMAL_LOW.2"
msgid "This beefalo is not as formal as I'd like, but it's close."
msgstr "Con Bò Lai này chưa trang trọng như tôi muốn, nhưng cũng gần rồi."

#. STRINGS.YOTB_CONTEST_FORMAL_PERFECT.1
msgctxt "STRINGS.YOTB_CONTEST_FORMAL_PERFECT.1"
msgid "I like this one's formalness."
msgstr "Tôi thích vẻ trang trọng của con này."

#. STRINGS.YOTB_CONTEST_FORMAL_PERFECT.2
msgctxt "STRINGS.YOTB_CONTEST_FORMAL_PERFECT.2"
msgid "This beefalo is just formal enough."
msgstr "Con bò này vừa đủ trang trọng."

#. STRINGS.YOTB_CONTEST_FORMAL_TARGET_EXTREMEHIGH.1
msgctxt "STRINGS.YOTB_CONTEST_FORMAL_TARGET_EXTREMEHIGH.1"
msgid "Everything about today's winner should scream \"formality.\""
msgstr "Mọi thứ ở người thắng hôm nay phải toát lên vẻ \"trang trọng\"."

#. STRINGS.YOTB_CONTEST_FORMAL_TARGET_EXTREMELOW.1
msgctxt "STRINGS.YOTB_CONTEST_FORMAL_TARGET_EXTREMELOW.1"
msgid "My taste today is for a complete lack of formality."
msgstr "Sở thích của tôi hôm nay là hoàn toàn thiếu trang trọng."

#. STRINGS.YOTB_CONTEST_FORMAL_TARGET_HIGH.1
msgctxt "STRINGS.YOTB_CONTEST_FORMAL_TARGET_HIGH.1"
msgid "Today's beefalo should have a slight edge of formality."
msgstr "Con Bò Lai hôm nay nên nhỉnh hơn một chút về độ trang trọng."

#. STRINGS.YOTB_CONTEST_FORMAL_TARGET_LOW.1
msgctxt "STRINGS.YOTB_CONTEST_FORMAL_TARGET_LOW.1"
msgid "My pick for today will be a bit more unconventional than formal."
msgstr "Lựa chọn của tôi hôm nay sẽ phá cách hơn trang trọng một chút."

#. STRINGS.YOTB_CONTEST_FORMAL_TARGET_PERFECT.1
msgctxt "STRINGS.YOTB_CONTEST_FORMAL_TARGET_PERFECT.1"
msgid "I want to see a perfect blend of unconventional and formal."
msgstr "Tôi muốn thấy sự pha trộn hoàn hảo giữa phá cách và trang trọng."

#. STRINGS.YOTB_CONTEST_FORMAL_TARGET_VERYHIGH.1
msgctxt "STRINGS.YOTB_CONTEST_FORMAL_TARGET_VERYHIGH.1"
msgid "I'd like to see the high end of formality today, with just a dash of disorder."
msgstr "Hôm nay tôi muốn thấy độ trang trọng ở mức cao, chỉ điểm chút lộn xộn."

#. STRINGS.YOTB_CONTEST_FORMAL_TARGET_VERYLOW.1
msgctxt "STRINGS.YOTB_CONTEST_FORMAL_TARGET_VERYLOW.1"
msgid "I want to see something mostly unconventional, with just a whiff of formality."
msgstr "Tôi muốn thấy thứ gì đó chủ yếu phá cách, chỉ thoáng chút trang trọng."

#. STRINGS.YOTB_CONTEST_FORMAL_VERYHIGH.1
msgctxt "STRINGS.YOTB_CONTEST_FORMAL_VERYHIGH.1"
msgid "This specimen is more formal than I want."
msgstr "Mẫu vật này trang trọng hơn tôi muốn."

#. STRINGS.YOTB_CONTEST_FORMAL_VERYHIGH.2
msgctxt "STRINGS.YOTB_CONTEST_FORMAL_VERYHIGH.2"
msgid "I respect how formal this beefalo is, but it's more than I like."
msgstr "Tôi nể vẻ trang trọng của con Bò Lai này, nhưng nó hơn mức tôi thích."

#. STRINGS.YOTB_CONTEST_FORMAL_VERYLOW.1
msgctxt "STRINGS.YOTB_CONTEST_FORMAL_VERYLOW.1"
msgid "I'd like my beefalo to be a fair bit more formal than this."
msgstr "Tôi muốn con bò của mình phải trang trọng hơn thế này một chút."

#. STRINGS.YOTB_CONTEST_FORMAL_VERYLOW.2
msgctxt "STRINGS.YOTB_CONTEST_FORMAL_VERYLOW.2"
msgid "This one is not quite formal enough, by a good margin."
msgstr "Cái này không đủ trang trọng, với một khoảng cách khá xa."

#. STRINGS.YOTB_CONTEST_SECOND_PLACE
msgctxt "STRINGS.YOTB_CONTEST_SECOND_PLACE"
msgid "And In second place..."
msgstr "Và ở vị trí thứ hai..."

#. STRINGS.YOTB_CONTEST_START
msgctxt "STRINGS.YOTB_CONTEST_START"
msgid "Well well well, lemme get a look at the menagerie."
msgstr "Nào nào nào, để tôi xem qua bầy thú nào."

#. STRINGS.YOTB_CONTEST_TARGET_PARAMS
msgctxt "STRINGS.YOTB_CONTEST_TARGET_PARAMS"
msgid "My perfect beefalo changes from day to day..."
msgstr "Con bò hoàn hảo của tôi thay đổi theo từng ngày..."

#. STRINGS.YOTB_CONTEST_THIRD_PLACE
msgctxt "STRINGS.YOTB_CONTEST_THIRD_PLACE"
msgid "Alright, my pick for third place is..."
msgstr "Được rồi, lựa chọn của tôi cho vị trí thứ ba là..."

#. STRINGS.YOTB_DOLL_FEARSOME_TARGET_EXTREMEHIGH.1
msgctxt "STRINGS.YOTB_DOLL_FEARSOME_TARGET_EXTREMEHIGH.1"
msgid "Finally, this is the most fearsome of dolls!"
msgstr "Cuối cùng, đây là con búp bê đáng sợ nhất!"

#. STRINGS.YOTB_DOLL_FEARSOME_TARGET_EXTREMELOW.1
msgctxt "STRINGS.YOTB_DOLL_FEARSOME_TARGET_EXTREMELOW.1"
msgid "Finally, this is like a teddy bear. My heart is at ease."
msgstr "Cuối cùng, đây giống như một con gấu bông. Trái tim tôi thanh thản."

#. STRINGS.YOTB_DOLL_FEARSOME_TARGET_HIGH.1
msgctxt "STRINGS.YOTB_DOLL_FEARSOME_TARGET_HIGH.1"
msgid "Finally, it's only mildly more fearsome than friendly."
msgstr "Cuối cùng, nó chỉ đáng sợ hơn thân thiện một chút xíu."

#. STRINGS.YOTB_DOLL_FEARSOME_TARGET_LOW.1
msgctxt "STRINGS.YOTB_DOLL_FEARSOME_TARGET_LOW.1"
msgid "Finally, this is just a bit more friendly than scary."
msgstr "Cuối cùng, nó thân thiện hơn đáng sợ một chút."

#. STRINGS.YOTB_DOLL_FEARSOME_TARGET_PERFECT.1
msgctxt "STRINGS.YOTB_DOLL_FEARSOME_TARGET_PERFECT.1"
msgid "Finally, it has a good balance of fearsome and friendly."
msgstr "Cuối cùng, nó có sự cân bằng tốt giữa sự đáng sợ và thân thiện."

#. STRINGS.YOTB_DOLL_FEARSOME_TARGET_VERYHIGH.1
msgctxt "STRINGS.YOTB_DOLL_FEARSOME_TARGET_VERYHIGH.1"
msgid "Finally, it's quite fierce."
msgstr "Cuối cùng, nó khá khốc liệt."

#. STRINGS.YOTB_DOLL_FEARSOME_TARGET_VERYHIGH.2
msgctxt "STRINGS.YOTB_DOLL_FEARSOME_TARGET_VERYHIGH.2"
msgid "Finally, this is quite fearsome looking."
msgstr "Cuối cùng, trông nó khá đáng sợ."

#. STRINGS.YOTB_DOLL_FEARSOME_TARGET_VERYLOW.1
msgctxt "STRINGS.YOTB_DOLL_FEARSOME_TARGET_VERYLOW.1"
msgid "Finally, it has the tiniest hint of ferocity."
msgstr "Cuối cùng, nó chỉ có một chút xíu dữ tợn."

#. STRINGS.YOTB_DOLL_FEARSOME_TARGET_VERYLOW.2
msgctxt "STRINGS.YOTB_DOLL_FEARSOME_TARGET_VERYLOW.2"
msgid "Finally, I can see a little ferocity, but just a touch."
msgstr "Cuối cùng, tôi thấy chút hung dữ, nhưng chỉ một chút thôi."

#. STRINGS.YOTB_DOLL_FESTIVE_TARGET_EXTREMEHIGH.1
msgctxt "STRINGS.YOTB_DOLL_FESTIVE_TARGET_EXTREMEHIGH.1"
msgid "Also, it's the most festive of dolls."
msgstr "Ngoài ra, đây là con búp bê tiệc tùng nhất."

#. STRINGS.YOTB_DOLL_FESTIVE_TARGET_EXTREMELOW.1
msgctxt "STRINGS.YOTB_DOLL_FESTIVE_TARGET_EXTREMELOW.1"
msgid "Also, I don't see even a hint of festivity in this."
msgstr "Ngoài ra, tôi chẳng thấy chút vẻ tiệc tùng nào ở đây."

#. STRINGS.YOTB_DOLL_FESTIVE_TARGET_HIGH.1
msgctxt "STRINGS.YOTB_DOLL_FESTIVE_TARGET_HIGH.1"
msgid "Also, it has a lot of festivity, with just a dash of somberness."
msgstr "Ngoài ra, nó rất tiệc tùng, chỉ điểm chút trầm lặng."

#. STRINGS.YOTB_DOLL_FESTIVE_TARGET_LOW.1
msgctxt "STRINGS.YOTB_DOLL_FESTIVE_TARGET_LOW.1"
msgid "Also, this is a bit more somber than festive."
msgstr "Ngoài ra, nó trầm lặng hơn tiệc tùng một chút."

#. STRINGS.YOTB_DOLL_FESTIVE_TARGET_PERFECT.1
msgctxt "STRINGS.YOTB_DOLL_FESTIVE_TARGET_PERFECT.1"
msgid "Also, this is tasteful mix of festivity and somberness."
msgstr "Ngoài ra, đây là sự pha trộn tinh tế giữa tiệc tùng và trầm lặng."

#. STRINGS.YOTB_DOLL_FESTIVE_TARGET_PERFECT.2
msgctxt "STRINGS.YOTB_DOLL_FESTIVE_TARGET_PERFECT.2"
msgid "Also, it's a perfect balance of somber and festive."
msgstr "Ngoài ra, nó cân bằng hoàn hảo giữa trầm lặng và tiệc tùng."

#. STRINGS.YOTB_DOLL_FESTIVE_TARGET_VERYHIGH.1
msgctxt "STRINGS.YOTB_DOLL_FESTIVE_TARGET_VERYHIGH.1"
msgid "Also, it has quite a lot of festivity."
msgstr "Ngoài ra, nó có khá nhiều tiệc tùng."

#. STRINGS.YOTB_DOLL_FESTIVE_TARGET_VERYLOW.1
msgctxt "STRINGS.YOTB_DOLL_FESTIVE_TARGET_VERYLOW.1"
msgid "Also, it has only the tiniest hint of festivity."
msgstr "Ngoài ra, nó chỉ có một chút xíu vẻ tiệc tùng."

#. STRINGS.YOTB_DOLL_FORMAL_TARGET_EXTREMEHIGH.1
msgctxt "STRINGS.YOTB_DOLL_FORMAL_TARGET_EXTREMEHIGH.1"
msgid "Everything about this screams \"formality.\""
msgstr "Mọi thứ ở nó đều toát lên vẻ \"trang trọng\"."

#. STRINGS.YOTB_DOLL_FORMAL_TARGET_EXTREMELOW.1
msgctxt "STRINGS.YOTB_DOLL_FORMAL_TARGET_EXTREMELOW.1"
msgid "It has a complete lack of formality."
msgstr "Nó hoàn toàn chẳng trang trọng chút nào."

#. STRINGS.YOTB_DOLL_FORMAL_TARGET_HIGH.1
msgctxt "STRINGS.YOTB_DOLL_FORMAL_TARGET_HIGH.1"
msgid "This has a slight edge of formality."
msgstr "Nó nhỉnh hơn một chút về độ trang trọng."

#. STRINGS.YOTB_DOLL_FORMAL_TARGET_LOW.1
msgctxt "STRINGS.YOTB_DOLL_FORMAL_TARGET_LOW.1"
msgid "This a bit more unconventional than formal."
msgstr "Nó phá cách hơn trang trọng một chút."

#. STRINGS.YOTB_DOLL_FORMAL_TARGET_PERFECT.1
msgctxt "STRINGS.YOTB_DOLL_FORMAL_TARGET_PERFECT.1"
msgid "It's a perfect blend of unconventional and formal."
msgstr "Đó là sự pha trộn hoàn hảo giữa phá cách và trang trọng."

#. STRINGS.YOTB_DOLL_FORMAL_TARGET_VERYHIGH.1
msgctxt "STRINGS.YOTB_DOLL_FORMAL_TARGET_VERYHIGH.1"
msgid "This is the high end of formality, with just a dash of disorder."
msgstr "Đây là mức trang trọng cao, chỉ điểm chút lộn xộn."

#. STRINGS.YOTB_DOLL_FORMAL_TARGET_VERYLOW.1
msgctxt "STRINGS.YOTB_DOLL_FORMAL_TARGET_VERYLOW.1"
msgid "This is mostly unconventional, with just a whiff of formality."
msgstr "Nó chủ yếu phá cách, chỉ thoáng chút trang trọng."

#. STRINGS.YOTB_EXTRA_BEEF
msgctxt "STRINGS.YOTB_EXTRA_BEEF"
msgid "Let's round up some locals to make things interesting."
msgstr "Hãy lùa thêm vài con địa phương cho thêm phần thú vị."

#. STRINGS.YOTB_GIVE_PRIZE_BIG
msgctxt "STRINGS.YOTB_GIVE_PRIZE_BIG"
msgid "Congrats! Don't spend it all in once place."
msgstr "Chúc mừng! Đừng chi tiêu tất cả cho một thứ."

#. STRINGS.YOTB_GIVE_PRIZE_SMALL
msgctxt "STRINGS.YOTB_GIVE_PRIZE_SMALL"
msgid "Here you go, well done you."
msgstr "Của bạn đây, bạn làm tốt lắm."

#. STRINGS.YOTB_GUESS_WHO_1
msgctxt "STRINGS.YOTB_GUESS_WHO_1"
msgid "Alright, which of these beauties do you think is today's winner!?"
msgstr "Được rồi, bạn nghĩ người đẹp nào trong số này sẽ thắng hôm nay!?"

#. STRINGS.YOTB_GUESS_WHO_2
msgctxt "STRINGS.YOTB_GUESS_WHO_2"
msgid "Take your time, choose wisely."
msgstr "Cứ từ từ, chọn cho khôn ngoan."

#. STRINGS.YOTB_GUESS_WHO_3
msgctxt "STRINGS.YOTB_GUESS_WHO_3"
msgid "OK, now hurry up..."
msgstr "OK, bây giờ nhanh lên..."

#. STRINGS.YOTB_GUESS_WHO_4
msgctxt "STRINGS.YOTB_GUESS_WHO_4"
msgid "Time's up!"
msgstr "Hết giờ rồi!"

#. STRINGS.YOTB_GUESS_WHO_5
msgctxt "STRINGS.YOTB_GUESS_WHO_5"
msgid "Alright, my pick for today's contest is..."
msgstr "Được rồi, lựa chọn của tôi cho cuộc thi hôm nay là..."

#. STRINGS.YOTB_HEY.1
msgctxt "STRINGS.YOTB_HEY.1"
msgid "Hiya!"
msgstr "Chào nha!"

#. STRINGS.YOTB_HEY.2
msgctxt "STRINGS.YOTB_HEY.2"
msgid "Hey!"
msgstr "Hey!"

#. STRINGS.YOTB_HEY.3
msgctxt "STRINGS.YOTB_HEY.3"
msgid "Howdy!"
msgstr "Chàoooo!"

#. STRINGS.YOTB_HEY.4
msgctxt "STRINGS.YOTB_HEY.4"
msgid "Greetings!"
msgstr "Xin chàoooooo!"

#. STRINGS.YOTB_HURRY_PRIZE
msgctxt "STRINGS.YOTB_HURRY_PRIZE"
msgid "Come get your prize, I won't wait all day."
msgstr "Hãy đến nhận giải thưởng của bạn, tôi sẽ không đợi cả ngày."

#. STRINGS.YOTB_NOTHING_FOR_YOU
msgctxt "STRINGS.YOTB_NOTHING_FOR_YOU"
msgid "Sorry, you didn't win anything this time."
msgstr "Xin lỗi, lần này bạn không giành được bất cứ thứ gì."

#. STRINGS.YOTB_NO_EXTRA_BEEF
msgctxt "STRINGS.YOTB_NO_EXTRA_BEEF"
msgid "What an eclectic looking bunch."
msgstr "Đúng là một bầy trông đủ kiểu."

#. STRINGS.YOTB_NO_PRIZE
msgctxt "STRINGS.YOTB_NO_PRIZE"
msgid "No one guessed right today! There's always tomorrow."
msgstr "Hôm nay không ai đoán đúng! Luôn luôn có ngày mai."

#. STRINGS.YOTB_PATTERNS
msgctxt "STRINGS.YOTB_PATTERNS"
msgid "Everyone, enjoy some complimentary fashion scraps!"
msgstr "Mọi người, xin nhận vài mảnh mẫu thời trang miễn phí!"

#. STRINGS.YOTB_PRIZE
msgctxt "STRINGS.YOTB_PRIZE"
msgid "Only one winner! Don't spend it all in one place!"
msgstr "Chỉ có một người chiến thắng! Đừng chi tiêu tất cả ở một nơi!"

#. STRINGS.YOTB_PRIZES
msgctxt "STRINGS.YOTB_PRIZES"
msgid "Here's your prizes, winners!"
msgstr "Giải thưởng của các bạn đây, những người thắng cuộc!"

#. STRINGS.YOTB_START_FAIL_DANGER
msgctxt "STRINGS.YOTB_START_FAIL_DANGER"
msgid "Sorry, it's not safe enough around here!"
msgstr "Xin lỗi, ở đây không đủ an toàn!"

#. STRINGS.YOTB_START_FAIL_LATE
msgctxt "STRINGS.YOTB_START_FAIL_LATE"
msgid "Sorry, it's too late to start today."
msgstr "Xin lỗi, đã quá muộn để bắt đầu hôm nay."

#. STRINGS.YOTB_START_FAIL_NOT_ENOUGH_POSTS
msgctxt "STRINGS.YOTB_START_FAIL_NOT_ENOUGH_POSTS"
msgid "I don't see enough Stages out yet."
msgstr "Tôi chưa thấy đủ các Sân Khấu."

#. STRINGS.YOTB_START_FAIL_NO_CONTESTANTS
msgctxt "STRINGS.YOTB_START_FAIL_NO_CONTESTANTS"
msgid "I don't see any contestants to judge, do you?"
msgstr "Tôi không thấy thí sinh nào để chấm cả, bạn có thấy không?"

#. STRINGS.YOTB_TOO_LATE_PRIZE
msgctxt "STRINGS.YOTB_TOO_LATE_PRIZE"
msgid "Sorry, can't wait any longer. Bye now."
msgstr "Xin lỗi, không thể đợi thêm nữa. Tạm biệt."

#. STRINGS.ACTIONS.EAT.PROCESS
msgctxt "STRINGS.ACTIONS.EAT.PROCESS"
msgid "Process"
msgstr "Xử lý"

#. STRINGS.ACTIONS.EQUIPONBODY
msgctxt "STRINGS.ACTIONS.EQUIPONBODY"
msgid "Equip on"
msgstr "Trang bị lên"

#. STRINGS.ACTIONS.MAPSCOUTSELECT_MAP
msgctxt "STRINGS.ACTIONS.MAPSCOUTSELECT_MAP"
msgid "Explore"
msgstr "Khám phá"

#. STRINGS.ACTIONS.MAPSCOUT_MAP
msgctxt "STRINGS.ACTIONS.MAPSCOUT_MAP"
msgid "Send"
msgstr "Gửi đi"

#. STRINGS.ACTIONS.MAPSCOUT_MAP_TOOFAR
msgctxt "STRINGS.ACTIONS.MAPSCOUT_MAP_TOOFAR"
msgid "Out of Range"
msgstr "Ngoài tầm"

#. STRINGS.ACTIONS.STARTREMOVINGMODULE
msgctxt "STRINGS.ACTIONS.STARTREMOVINGMODULE"
msgid "Open Chassis"
msgstr "Mở khung máy"

#. STRINGS.ACTIONS.STARTVAULTORBTELEPORT
msgctxt "STRINGS.ACTIONS.STARTVAULTORBTELEPORT"
msgid "Focus On"
msgstr "Tập trung vào"

#. STRINGS.ACTIONS.STOPREMOVINGMODULE
msgctxt "STRINGS.ACTIONS.STOPREMOVINGMODULE"
msgid "Close Chassis"
msgstr "Đóng khung máy"

#. STRINGS.ACTIONS.STOPUSINGEQUIPPEDITEM.GENERIC
msgctxt "STRINGS.ACTIONS.STOPUSINGEQUIPPEDITEM.GENERIC"
msgid "Stop"
msgstr "Dừng"

#. STRINGS.ACTIONS.STOPUSINGEQUIPPEDITEM.WX78_DRONE_ZAP_REMOTE
msgctxt "STRINGS.ACTIONS.STOPUSINGEQUIPPEDITEM.WX78_DRONE_ZAP_REMOTE"
msgid "Deactivate"
msgstr "Tắt"

#. STRINGS.ACTIONS.SWAPBODIES_MAP
msgctxt "STRINGS.ACTIONS.SWAPBODIES_MAP"
msgid "Transfer Consciousness"
msgstr "Chuyển ý thức"

#. STRINGS.ACTIONS.TOGGLEWXSCREECH.GENERIC
msgctxt "STRINGS.ACTIONS.TOGGLEWXSCREECH.GENERIC"
msgid "Initiate Sonic Waves"
msgstr "Kích hoạt sóng âm"

#. STRINGS.ACTIONS.TOGGLEWXSCREECH.TURNOFF
msgctxt "STRINGS.ACTIONS.TOGGLEWXSCREECH.TURNOFF"
msgid "Terminate Sonic Waves"
msgstr "Ngắt sóng âm"

#. STRINGS.ACTIONS.TOGGLEWXSHIELDING.GENERIC
msgctxt "STRINGS.ACTIONS.TOGGLEWXSHIELDING.GENERIC"
msgid "Activate Block"
msgstr "Kích hoạt phòng thủ"

#. STRINGS.ACTIONS.TOGGLEWXSHIELDING.TURNOFF
msgctxt "STRINGS.ACTIONS.TOGGLEWXSHIELDING.TURNOFF"
msgid "Deactivate Block"
msgstr "Tắt phòng thủ"

#. STRINGS.ACTIONS.USEITEMON.GESTALT_POSSESS
msgctxt "STRINGS.ACTIONS.USEITEMON.GESTALT_POSSESS"
msgid "Transfer Gestalt"
msgstr "Chuyển Sinh Vật Vô Định"

#. STRINGS.ACTIONS.USEITEMON.SOCKET_SHADOW
msgctxt "STRINGS.ACTIONS.USEITEMON.SOCKET_SHADOW"
msgid "Implant"
msgstr "Cấy ghép"

#. STRINGS.ACTIONS.USEITEMON.TIE_ONTO
msgctxt "STRINGS.ACTIONS.USEITEMON.TIE_ONTO"
msgid "Tie Onto"
msgstr "Buộc vào"

#. STRINGS.CHARACTERS.GENERIC.ACTIONFAIL.STORE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.GENERIC.ACTIONFAIL.STORE.NOTAROBOT"
msgid "I'm not a bot to use it."
msgstr "Tôi không phải robot để dùng cái này."

#. STRINGS.CHARACTERS.GENERIC.ANNOUNCE_MAX_CLOCKWORKS
msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Hm, I suppose it makes sense I can only have a pair of these."
msgstr "Hừm, chắc hợp lý khi tôi chỉ được giữ một cặp thứ này."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRITTER_BULBIN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRITTER_BULBIN"
msgid "You'd never do anything rotten, would you?"
msgstr "Bạn sẽ không bao giờ làm điều gì xấu, phải không?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOW_HEART_VEIN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOW_HEART_VEIN"
msgid "A vein attempt to be useful."
msgstr "Một nỗ lực vô ích để trở nên hữu ích."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_DRONE_DELIVERY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "A freight it will get lost!"
msgstr "Sợ nó sẽ bị lạc mất thôi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_DRONE_SCOUT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_DRONE_SCOUT"
msgid "So far, so good."
msgstr "Đến giờ thì vẫn ổn."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_DRONE_ZAP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_DRONE_ZAP"
msgid "It uses current technology."
msgstr "Nó dùng công nghệ dòng-điện tiên tiến."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_DRONE_ZAP_REMOTE.CANUSE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_DRONE_ZAP_REMOTE.CANUSE"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "It controls remotely? It's a.... Detached Telecommand Apparatus!"
msgstr "Điều khiển từ xa ư? Đây là.... Thiết Bị Viễn Lệnh Tách Rời!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_FOODBRICK.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_FOODBRICK.GENERIC"
msgid "It's too hard to eat."
msgstr "Cứng quá, không ăn nổi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_FOODBRICK.WET
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_FOODBRICK.WET"
msgid "It's a moist try!"
msgstr "Một nỗ lực ẩm ướt!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_GESTALTTRAPPER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "What possessed WX to do this?"
msgstr "Cái gì đã ám WX để làm cái này nhỉ?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "Finite like that."
msgstr "Có hạn như thế đấy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_INVENTORYCONTAINER.HELD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_INVENTORYCONTAINER.HELD"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_INVENTORYCONTAINER.NOPOWER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_INVENTORYCONTAINER.NOPOWER"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_POSSESSEDBODY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_POSSESSEDBODY"
msgid "You're not yourself lately!"
msgstr "Dạo này bạn không phải là chính mình rồi!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.W_RADIO
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.W_RADIO"
msgid "Hm. There's a lot of science here."
msgstr "Hm. Có rất nhiều khoa học ở đây."

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.STORE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.STORE.NOTAROBOT"
msgid "It's not for us, Woby."
msgstr "Cái này không dành cho chúng ta, Woby."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_MAX_CLOCKWORKS
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Ha! Of course we only get a pair, Woby! They're chess pieces!"
msgstr "Ha! Tất nhiên là chỉ được một cặp thôi, Woby! Chúng là quân cờ mà!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_BULBIN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_BULBIN"
msgid "I didn't know vegetables could be monsters too!"
msgstr "Mình không biết rau củ cũng có thể là quái vật nữa!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOW_HEART_VEIN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOW_HEART_VEIN"
msgid "Aw, it's so helpful!"
msgstr "Ồ, nó hữu ích quá!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78_DRONE_DELIVERY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "A hardworking delivery buddy!"
msgstr "Một bạn giao hàng chăm chỉ!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78_DRONE_SCOUT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78_DRONE_SCOUT"
msgid "Scott sure likes to explore!"
msgstr "Scott chắc chắn thích khám phá lắm!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78_DRONE_ZAP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78_DRONE_ZAP"
msgid "Stay out of its way, Woby!"
msgstr "Tránh xa nó ra, Woby!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "That's not a toy apparently."
msgstr "Có vẻ đó không phải đồ chơi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78_FOODBRICK.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78_FOODBRICK.GENERIC"
msgid "It's harder than a stale dog biscuit, Woby!"
msgstr "Nó cứng hơn cả bánh quy chó cũ, Woby!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78_FOODBRICK.WET
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78_FOODBRICK.WET"
msgid "Kinda mushy now, but that's okay!"
msgstr "Hơi nhão rồi, nhưng không sao!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78_GESTALTTRAPPER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "This must do something reaaally neat, Woby."
msgstr "Cái này chắc làm được điều gì đó thật tuyệt, Woby."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "Wonder if WX wants all this stuff back."
msgstr "Không biết WX có muốn lấy lại mấy thứ này không."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78_INVENTORYCONTAINER.HELD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78_INVENTORYCONTAINER.HELD"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78_POSSESSEDBODY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78_POSSESSEDBODY"
msgid "Is that a ghost in there, Woby! Amazing!"
msgstr "Có phải có ma ở trong đó không, Woby! Tuyệt vời!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.W_RADIO
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.W_RADIO"
msgid "What do you think it does, Woby?"
msgstr "Theo Woby thì nó làm gì nhỉ?"

#. STRINGS.CHARACTERS.WANDA.ACTIONFAIL.STORE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.WANDA.ACTIONFAIL.STORE.NOTAROBOT"
msgid "It belongs to the automaton."
msgstr "Nó thuộc về cái máy tự động."

#. STRINGS.CHARACTERS.WANDA.ANNOUNCE_MAX_CLOCKWORKS
msgctxt "STRINGS.CHARACTERS.WANDA.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Maybe you'll join me next time."
msgstr "Có lẽ lần sau ngươi sẽ đi cùng ta."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CRITTER_BULBIN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CRITTER_BULBIN"
msgid "Aren't you a little far from home?"
msgstr "Ngươi có hơi xa nhà không?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.SHADOW_HEART_VEIN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.SHADOW_HEART_VEIN"
msgid "It's growing..."
msgstr "Nó đang lớn lên..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_DRONE_DELIVERY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "Nothing beats a speedy delivery."
msgstr "Không gì bằng giao hàng nhanh."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_DRONE_SCOUT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_DRONE_SCOUT"
msgid "And where are we off to next?"
msgstr "Và tiếp theo ta đi đâu nhỉ?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_DRONE_ZAP
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_DRONE_ZAP"
msgid "Mind where you're zapping!"
msgstr "Chú ý hướng bắn đi!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "In the wrong hands... nevermind."
msgstr "Nếu vào tay kẻ xấu... thôi bỏ đi."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_FOODBRICK.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_FOODBRICK.GENERIC"
msgid "It's too hard to eat."
msgstr "Cứng quá không ăn được."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_FOODBRICK.WET
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_FOODBRICK.WET"
msgid "WX, how kind of you..."
msgstr "WX, ngươi tốt bụng quá..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_GESTALTTRAPPER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "Madness..."
msgstr "Điên rồ..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "I know better than to question the physics."
msgstr "Tôi đủ khôn để không thắc mắc về vật lý."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_INVENTORYCONTAINER.HELD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_INVENTORYCONTAINER.HELD"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_POSSESSEDBODY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_POSSESSEDBODY"
msgid "That will never not give me the creeps."
msgstr "Cái đó luôn làm ta rùng mình."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.STORE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.STORE.NOTAROBOT"
msgid "Property of our metal friend."
msgstr "Tài sản của người bạn kim loại."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_MAX_CLOCKWORKS
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Perhaps it is shy."
msgstr "Có lẽ nó nhút nhát."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CRITTER_BULBIN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CRITTER_BULBIN"
msgid "It never hurts to have a little onion on hand."
msgstr "Có sẵn một ít hành tây cũng không bao giờ thừa."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOW_HEART_VEIN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOW_HEART_VEIN"
msgid "It has roots and grows in the dirt, but that is no vegetable."
msgstr "Nó có rễ và mọc trong đất, nhưng đó không phải rau."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_DRONE_DELIVERY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "A flying pantry! Wonderful!"
msgstr "Một tủ thức ăn biết bay! Tuyệt vời!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_DRONE_SCOUT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_DRONE_SCOUT"
msgid "Where will you go next?"
msgstr "Tiếp theo bạn sẽ đi đâu?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_DRONE_ZAP
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_DRONE_ZAP"
msgid "But can it fry an egg?"
msgstr "Nhưng liệu nó có chiên được trứng không?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "It is too fancy for me!"
msgstr "Nó quá cao cấp với tôi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_FOODBRICK.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_FOODBRICK.GENERIC"
msgid "Adding water will not make it less horrible."
msgstr "Thêm nước cũng không làm nó bớt kinh khủng."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_FOODBRICK.WET
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_FOODBRICK.WET"
msgid "It is most appalling."
msgstr "Thật là kinh tởm."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_GESTALTTRAPPER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "I don't even want to know."
msgstr "Tôi thậm chí không muốn biết."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "What did our metal friend leave here?"
msgstr "Người bạn kim loại để lại gì ở đây?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_INVENTORYCONTAINER.HELD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_INVENTORYCONTAINER.HELD"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_POSSESSEDBODY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_POSSESSEDBODY"
msgid "Oh non, this is too much!"
msgstr "Oh non, quá sức chịu đựng rồi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.W_RADIO
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.W_RADIO"
msgid "What appliance is this?"
msgstr "Đây là thiết bị gì thế?"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.STORE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.STORE.NOTAROBOT"
msgid "It belongs to the metal warrior."
msgstr "Nó thuộc về chiến binh kim loại."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MAX_CLOCKWORKS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Fret not, faithful warrior. I shall return for thee."
msgstr "Đừng lo, chiến binh trung thành. Ta sẽ quay lại vì ngươi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRITTER_BULBIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRITTER_BULBIN"
msgid "I forgive her vegetable ways."
msgstr "Ta tha thứ cho bản tính rau củ của nàng."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOW_HEART_VEIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOW_HEART_VEIN"
msgid "Such gifts bear ill fortune."
msgstr "Những món quà như vậy mang theo vận xui."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78_DRONE_DELIVERY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "Loyal courier! Provision thy Iron Lord!"
msgstr "Sứ giả trung thành! Tiếp tế cho Lãnh Chúa Sắt!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78_DRONE_SCOUT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78_DRONE_SCOUT"
msgid "Go forth, valiant scoutling!"
msgstr "Tiến lên, trinh sát dũng cảm bé nhỏ!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78_DRONE_ZAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78_DRONE_ZAP"
msgid "Rain lightening upon thy foes!"
msgstr "Trút sấm sét lên kẻ thù của ngươi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "By this, the Iron Lord calls a Valkyrie from the heavens!"
msgstr "Qua đây, Lãnh Chúa Sắt triệu hồi Valkyrie từ thiên đường!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78_FOODBRICK.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78_FOODBRICK.GENERIC"
msgid "Even Mjolnir could not crack this foul brick!"
msgstr "Ngay cả Mjolnir cũng không thể đập vỡ viên gạch ghê tởm này!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78_FOODBRICK.WET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78_FOODBRICK.WET"
msgid "A cursed loaf, born from the very innards of the metal warrior!"
msgstr "Ổ bánh bị nguyền rủa, sinh ra từ ruột gan của chiến binh kim loại!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78_GESTALTTRAPPER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "There is sorcery at work here."
msgstr "Có phép thuật đang hoạt động ở đây."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "What spoils hath our metal warrior bestowed?"
msgstr "Chiến lợi phẩm nào mà chiến binh kim loại ban tặng?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78_INVENTORYCONTAINER.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78_INVENTORYCONTAINER.HELD"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78_POSSESSEDBODY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78_POSSESSEDBODY"
msgid "The metal warrior is truly possessed!"
msgstr "Chiến binh kim loại thực sự bị chiếm hữu rồi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.W_RADIO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.W_RADIO"
msgid "What infernal device is this?"
msgstr "Đây là thiết bị quỷ quái gì thế?"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.NOTAROBOT"
msgid "Robot junk."
msgstr "Đồ phế liệu robot."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.NOTAROBOT"
msgid "Robot junk"
msgstr "Đồ phế liệu robot"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MAX_CLOCKWORKS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Too many of this piece on the board already, I suppose."
msgstr "Chắc trên bàn cờ đã có quá nhiều quân cờ loại này rồi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_BULBIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_BULBIN"
msgid "You're not from around here, are you pal?"
msgstr "Cậu không phải dân ở đây, đúng không anh bạn?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOW_HEART_VEIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOW_HEART_VEIN"
msgid "And yet it offers gifts from below."
msgstr "Thế mà nó vẫn ban tặng từ bên dưới."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78_DRONE_DELIVERY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "Nice trash hauler."
msgstr "Xe chở rác đẹp đấy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78_DRONE_SCOUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78_DRONE_SCOUT"
msgid "Oh, get lost already!"
msgstr "Ôi, biến đi!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78_DRONE_ZAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78_DRONE_ZAP"
msgid "I've got my eye on you!"
msgstr "Ta đang để mắt tới ngươi đấy!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "I didn't want to play with it anyway."
msgstr "Dù sao ta cũng không muốn chơi với nó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78_FOODBRICK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78_FOODBRICK.GENERIC"
msgid "Not that I'd want to, but it's too dry to eat."
msgstr "Không phải ta muốn ăn, nhưng mà nó khô quá."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78_FOODBRICK.WET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78_FOODBRICK.WET"
msgid "Of all the things I've eaten here, this takes the cake."
msgstr "Trong tất cả những thứ ta ăn ở đây, cái này đoạt giải."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78_GESTALTTRAPPER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "I hope that's not what I think it is."
msgstr "Ta hy vọng đó không phải thứ ta đang nghĩ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "What do you mean it held more than my hat?!"
msgstr "Ý ngươi là nó chứa được nhiều hơn cái mũ của ta?!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78_INVENTORYCONTAINER.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78_INVENTORYCONTAINER.HELD"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78_POSSESSEDBODY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78_POSSESSEDBODY"
msgid "Stay back, you abomination!"
msgstr "Lùi lại, đồ quái vật!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.STORE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.STORE.NOTAROBOT"
msgid "We can't. The robot will get mad."
msgstr "Chúng ta không được. Con robot sẽ giận đấy."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MAX_CLOCKWORKS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Maybe it's not allowed to play with us."
msgstr "Có lẽ nó không được phép chơi với chúng ta."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CRITTER_BULBIN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CRITTER_BULBIN"
msgid "It's our little onion friend!"
msgstr "Đây là bạn hành tây nhỏ của chúng ta!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHADOW_HEART_VEIN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHADOW_HEART_VEIN"
msgid "We don't like being around that."
msgstr "Chúng ta không thích ở gần cái đó."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78_DRONE_DELIVERY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "Are there surprises inside?"
msgstr "Bên trong có bất ngờ gì không?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78_DRONE_SCOUT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78_DRONE_SCOUT"
msgid "How come it's allowed to wander off?"
msgstr "Sao nó được phép đi lang thang vậy?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78_DRONE_ZAP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78_DRONE_ZAP"
msgid "We don't like zaps."
msgstr "Chúng ta không thích bị giật điện."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "Can we have a turn?"
msgstr "Cho chúng ta chơi một lượt được không?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78_FOODBRICK.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78_FOODBRICK.GENERIC"
msgid "It's sooooo dry!"
msgstr "Nó khôôôô quá!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78_FOODBRICK.WET
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78_FOODBRICK.WET"
msgid "A robot cake?"
msgstr "Bánh robot ư?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78_GESTALTTRAPPER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "Is it because they have no one to play with?"
msgstr "Có phải vì chúng không có ai để chơi cùng không?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "It was forever in there."
msgstr "Nó ở trong đó lâu lắm rồi."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78_INVENTORYCONTAINER.HELD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78_INVENTORYCONTAINER.HELD"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78_POSSESSEDBODY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78_POSSESSEDBODY"
msgid "Who's inside the robot?"
msgstr "Ai ở bên trong con robot vậy?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.W_RADIO
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.W_RADIO"
msgid "Yay! New toy!"
msgstr "Yay! Đồ chơi mới!"

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.STORE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.STORE.NOTAROBOT"
msgid "I shouldn't touch the machine's things."
msgstr "Tôi không nên chạm vào đồ của cỗ máy."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MAX_CLOCKWORKS
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MAX_CLOCKWORKS"
msgid "This one will be left behind."
msgstr "Cái này sẽ bị bỏ lại phía sau."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_BULBIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_BULBIN"
msgid "Its adorable face nearly brings me to tears."
msgstr "Khuôn mặt đáng yêu của nó suýt khiến tôi khóc."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOW_HEART_VEIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOW_HEART_VEIN"
msgid "From a heart that knows no peace."
msgstr "Từ trái tim không bao giờ được yên."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_DRONE_DELIVERY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "And they say you can't take it with you."
msgstr "Người ta bảo không thể mang theo đồ khi ra đi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_DRONE_SCOUT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_DRONE_SCOUT"
msgid "Are you ever afraid?"
msgstr "Bạn có bao giờ sợ không?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_DRONE_ZAP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_DRONE_ZAP"
msgid "Feels impersonal."
msgstr "Cảm thấy thật vô cảm."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "Are we all just being controlled?"
msgstr "Phải chăng tất cả chúng ta đều đang bị điều khiển?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_FOODBRICK.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_FOODBRICK.GENERIC"
msgid "It's impossible to eat like that."
msgstr "Không thể ăn được nó như thế."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_FOODBRICK.WET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_FOODBRICK.WET"
msgid "I've eaten worse."
msgstr "Tôi đã từng ăn thứ tệ hơn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_GESTALTTRAPPER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "I've thought about it too, Abby."
msgstr "Tôi cũng đã nghĩ về điều đó, Abby."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "I wonder what remains."
msgstr "Không biết còn lại gì."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_INVENTORYCONTAINER.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_INVENTORYCONTAINER.HELD"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_POSSESSEDBODY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_POSSESSEDBODY"
msgid "Too bad Abby can't do the same."
msgstr "Tiếc là Abby không thể làm như vậy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.W_RADIO
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.W_RADIO"
msgid "What does it do?"
msgstr "Nó làm được gì?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.STORE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.STORE.NOTAROBOT"
msgid "It is the property of the automaton."
msgstr "Nó là tài sản của cỗ máy tự động."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MAX_CLOCKWORKS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Well, yes. The rules of chess are simple. One may have no more than a pair of these pieces."
msgstr "Phải rồi. Luật cờ vua rất đơn giản. Mỗi người chỉ được có tối đa một cặp quân này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTER_BULBIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTER_BULBIN"
msgid "Are you animal or vegetable, dear?"
msgstr "Con là động vật hay thực vật, bé yêu?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOW_HEART_VEIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOW_HEART_VEIN"
msgid "This is dark magic indeed."
msgstr "Đây thực sự là ma thuật đen."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78_DRONE_DELIVERY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "The automaton demonstrates an unusual attachment to their belongings."
msgstr "Cỗ máy tự động thể hiện sự gắn bó bất thường với đồ đạc của mình."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78_DRONE_SCOUT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78_DRONE_SCOUT"
msgid "We are indebted to this intrepid little scout."
msgstr "Chúng ta mang ơn trinh sát nhỏ dũng cảm này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78_DRONE_ZAP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78_DRONE_ZAP"
msgid "It permits the automaton to engage their foes from a distance."
msgstr "Nó cho phép cỗ máy tự động tấn công kẻ thù từ xa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "Through signal transmission, the automaton may maneuver the aerial device and discharge electrical shocks."
msgstr "Thông qua truyền tín hiệu, cỗ máy tự động có thể điều khiển thiết bị trên không và phóng sốc điện."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78_FOODBRICK.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78_FOODBRICK.GENERIC"
msgid "The nutrient brick is inedible in its desiccated form."
msgstr "Viên gạch dinh dưỡng không thể ăn được ở dạng khô."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78_FOODBRICK.WET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78_FOODBRICK.WET"
msgid "The automaton has reconstituted spoiled food matter into a compact edible brick."
msgstr "Cỗ máy tự động đã tái tạo thức ăn hỏng thành viên gạch ăn được nhỏ gọn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78_GESTALTTRAPPER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "It's been reconfigured to permit direct transfer of the entity into the chassis."
msgstr "Nó đã được cấu hình lại để cho phép chuyển trực tiếp thực thể vào khung máy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "Once a repository whose capacity challenged the very laws of physics."
msgstr "Từng là kho chứa có dung lượng thách thức chính quy luật vật lý."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78_INVENTORYCONTAINER.HELD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78_INVENTORYCONTAINER.HELD"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78_POSSESSEDBODY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78_POSSESSEDBODY"
msgid "It's a straightforward instance of spectral machina possession, nothing more."
msgstr "Đây chỉ đơn giản là trường hợp chiếm hữu máy móc bởi phổ linh, không hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.W_RADIO
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.W_RADIO"
msgid "Interesting... I conclude it requires further study."
msgstr "Thú vị... Tôi kết luận nó cần nghiên cứu thêm."

#. STRINGS.CHARACTERS.WILLOW.ACTIONFAIL.STORE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.WILLOW.ACTIONFAIL.STORE.NOTAROBOT"
msgid "Just some robot stuff."
msgstr "Chỉ là mấy thứ của robot thôi."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MAX_CLOCKWORKS
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Whatever, I didn't need you anyway."
msgstr "Kệ, dù sao tôi cũng không cần bạn."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_BULBIN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_BULBIN"
msgid "My bulbous little buddy."
msgstr "Bạn nhỏ phình phình của tôi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SHADOW_HEART_VEIN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SHADOW_HEART_VEIN"
msgid "Disgusting! I don't care what it's got!"
msgstr "Ghê quá! Nó có gì tôi cũng không quan tâm!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78_DRONE_DELIVERY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "WX gets free delivery? No fair!"
msgstr "WX được giao hàng miễn phí á? Không công bằng!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78_DRONE_SCOUT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78_DRONE_SCOUT"
msgid "Get lost, Scott!"
msgstr "Biến đi, Scott!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78_DRONE_ZAP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78_DRONE_ZAP"
msgid "I got my eye on you, zappy."
msgstr "Tôi đang để mắt tới mày đấy, đồ giật điện."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "I don't trust WX with this thing."
msgstr "Giao thứ này cho WX tôi không yên tâm."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78_FOODBRICK.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78_FOODBRICK.GENERIC"
msgid "It would be like trying to eat an actual brick."
msgstr "Giống như đang cố ăn một viên gạch thật vậy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78_FOODBRICK.WET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78_FOODBRICK.WET"
msgid "Gee thanks, WX."
msgstr "Ơ cảm ơn nhé, WX."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78_GESTALTTRAPPER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "That WX is always up to something."
msgstr "Cái WX đó lúc nào cũng bày trò gì đó."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "What do I care about WX's old stuff?"
msgstr "Tôi quan tâm gì mấy thứ cũ của WX?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78_INVENTORYCONTAINER.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78_INVENTORYCONTAINER.HELD"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78_POSSESSEDBODY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78_POSSESSEDBODY"
msgid "What's gotten into you?!"
msgstr "Cái gì đã chui vào bạn vậy?!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.W_RADIO
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.W_RADIO"
msgid "Ten seconds to make it work before I burn it."
msgstr "Cho nó mười giây để chạy, không thì tôi đốt."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.STORE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.STORE.NOTAROBOT"
msgid "I ain't messin' with WX's things."
msgstr "Tôi không đụng vào đồ của WX đâu."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_MAX_CLOCKWORKS
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Darnit! A pair only? I hate chess."
msgstr "Chán thật! Chỉ được một cặp thôi à? Tôi ghét cờ vua."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CRITTER_BULBIN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CRITTER_BULBIN"
msgid "You're a sweet little fella, but your breath is terrible."
msgstr "Nhóc dễ thương lắm, nhưng hơi thở thì kinh khủng."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SHADOW_HEART_VEIN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SHADOW_HEART_VEIN"
msgid "It was creepin' and crawlin' underground."
msgstr "Nó đang bò và trườn dưới đất."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78_DRONE_DELIVERY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "Wish I had me a flyin' toolkit."
msgstr "Ước gì tôi có một bộ đồ nghề biết bay."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78_DRONE_SCOUT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78_DRONE_SCOUT"
msgid "Careful out there, lil' fella."
msgstr "Cẩn thận ngoài kia nhé, nhóc."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78_DRONE_ZAP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78_DRONE_ZAP"
msgid "I know who's really in control!"
msgstr "Tôi biết ai mới thực sự đang điều khiển!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "WX don't like sharin'."
msgstr "WX không thích chia sẻ."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78_FOODBRICK.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78_FOODBRICK.GENERIC"
msgid "Now that's a jawbreaker."
msgstr "Cái này đúng là đồ gãy hàm."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78_FOODBRICK.WET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78_FOODBRICK.WET"
msgid "Machine processed food?"
msgstr "Thức ăn chế biến bằng máy à?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78_GESTALTTRAPPER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "Looks like WX repurposed the bossman's contraption."
msgstr "Có vẻ WX đã tái sử dụng đồ nghề của ông chủ."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "Wonder what WX left behind."
msgstr "Không biết WX bỏ lại gì."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78_INVENTORYCONTAINER.HELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78_INVENTORYCONTAINER.HELD"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78_POSSESSEDBODY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78_POSSESSEDBODY"
msgid "WX is getting into some weird stuff. Or it's the other way around."
msgstr "WX đang dính vào mấy thứ kỳ lạ. Hoặc ngược lại."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.W_RADIO
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.W_RADIO"
msgid "I think I recognize this handywork..."
msgstr "Hình như tôi nhận ra tay nghề này..."

#. STRINGS.CHARACTERS.WOLFGANG.ACTIONFAIL.STORE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ACTIONFAIL.STORE.NOTAROBOT"
msgid "Is robot things."
msgstr "Là đồ của robot."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_MAX_CLOCKWORKS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Why? Is something Wolfgang said?"
msgstr "Tại sao? Có phải Wolfgang nói gì sai không?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_BULBIN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_BULBIN"
msgid "Onions are Wolfgang's best friend! Second to potato!"
msgstr "Hành tây là bạn thân nhất của Wolfgang! Chỉ sau khoai tây!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOW_HEART_VEIN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOW_HEART_VEIN"
msgid "Haha! Not as mighty as Wolfgang biceps vein!"
msgstr "Haha! Không mạnh mẽ bằng gân bắp tay của Wolfgang!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78_DRONE_DELIVERY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "Wolfgang carry more things."
msgstr "Wolfgang mang được nhiều hơn."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78_DRONE_SCOUT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78_DRONE_SCOUT"
msgid "Brave little exploring machine!"
msgstr "Cỗ máy khám phá nhỏ dũng cảm!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78_DRONE_ZAP
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78_DRONE_ZAP"
msgid "Be careful not zap Wolfgang!"
msgstr "Cẩn thận không giật điện Wolfgang!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "Robot have all the fun toy."
msgstr "Robot có đủ đồ chơi vui."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78_FOODBRICK.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78_FOODBRICK.GENERIC"
msgid "It is too hard for even Wolfgang mighty teeth."
msgstr "Cứng quá, ngay cả hàm răng hùng mạnh của Wolfgang cũng không nổi."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78_FOODBRICK.WET
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78_FOODBRICK.WET"
msgid "Thank you for snack, robot!"
msgstr "Cảm ơn đồ ăn vặt, robot!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78_GESTALTTRAPPER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "Robot is tamper with powerful forces."
msgstr "Robot đang nghịch với sức mạnh ghê gớm."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "Any goodie for Wolfgang?"
msgstr "Có gì ngon cho Wolfgang không?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78_INVENTORYCONTAINER.HELD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78_INVENTORYCONTAINER.HELD"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78_POSSESSEDBODY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78_POSSESSEDBODY"
msgid "Something extra creepy about robot."
msgstr "Robot có gì đó rùng rợn hơn thường ngày."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.W_RADIO
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.W_RADIO"
msgid "Hello little... what are you?"
msgstr "Xin chào bạn nhỏ... bạn là cái gì?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.STORE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.STORE.NOTAROBOT"
msgid "Only for robots."
msgstr "Chỉ dành cho robot thôi."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MAX_CLOCKWORKS
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Maybe I've got enough."
msgstr "Có lẽ tôi đã có đủ rồi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_BULBIN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_BULBIN"
msgid "Sure got a spring in your step, eh?"
msgstr "Bước chân vui vẻ nhỉ, hả?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SHADOW_HEART_VEIN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SHADOW_HEART_VEIN"
msgid "Don't worry, Luce. I won't let it grab you."
msgstr "Đừng lo, Luce. Tôi sẽ không để nó tóm được cô đâu."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78_DRONE_DELIVERY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "To think I carried all my stuff to the cabin."
msgstr "Nghĩ lại hồi đó tôi tự vác hết đồ về căn nhà gỗ."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78_DRONE_SCOUT
