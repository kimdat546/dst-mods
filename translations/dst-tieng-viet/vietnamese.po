msgstr "Một sinh vật nhỏ thân thiện, phải không?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RAINCOAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RAINCOAT"
msgid "Very practical."
msgstr "Rất thiết thực."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RAINHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RAINHAT"
msgid "Dry as a daisy. That's the phrase, right?"
msgstr "Khô như một bông hoa cúc. Đó là cụm từ, phải không?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RAINOMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RAINOMETER.BURNT"
msgid "Must fire take everything I love?"
msgstr "Sao lửa cứ phải cướp đi mọi thứ tôi yêu thế?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RAINOMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RAINOMETER.GENERIC"
