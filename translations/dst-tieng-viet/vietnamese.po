msgstr "Tôi nghe thấy một cái bụng nhỏ đang sôi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_PET.STARVING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_PET.STARVING"
