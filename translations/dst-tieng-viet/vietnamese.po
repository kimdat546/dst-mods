msgstr "Thế là xong."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TROPHYSCALE_FISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TROPHYSCALE_FISH.GENERIC"
