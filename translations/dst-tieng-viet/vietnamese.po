msgstr "Chắc chắn có một cuộc thi đang diễn ra ở đâu đó."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.YOTB_STARTCONTEST.DOESNTWORK
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.YOTB_STARTCONTEST.DOESNTWORK"
msgid "This judge is slackin' on the job!"
msgstr "Ông giám khảo này làm việc lười quá!"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.YOTB_STARTCONTEST.NORESPONSE
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.YOTB_STARTCONTEST.NORESPONSE"
msgid "Probably wandered off."
msgstr "Có lẽ đã đi lạc."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.YOTB_STARTCONTEST.RIGHTTHERE
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.YOTB_STARTCONTEST.RIGHTTHERE"
msgid "He's workin'."
msgstr "Anh ấy đang làm việc."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.YOTB_UNLOCKSKIN.ALREADYKNOWN
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.YOTB_UNLOCKSKIN.ALREADYKNOWN"
msgid "I've already got this one down pat."
msgstr "Tôi đã có cái này rồi."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL_GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL_GENERIC"
msgid "I sure gummed the works there."
msgstr "Tôi làm hỏng việc rồi."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ACCOMPLISHMENT
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ACCOMPLISHMENT"
msgid "I can do ANYTHING!"
msgstr "Tôi có thể làm bất cứ điều gì!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ACCOMPLISHMENT_DONE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ACCOMPLISHMENT_DONE"
msgid "Mitt me, kid!"
msgstr "Bắt tay nào, nhóc!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ACIDBATS
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ACIDBATS"
msgid "I don't like the sound of that."
msgstr "Tôi không thích âm thanh đó."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ADVENTUREFAIL
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ADVENTUREFAIL"
msgid "Yeow. Don't make me come back in there!"
msgstr "Ui da. Đừng bắt tôi quay lại đó!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ANTLION_SINKHOLE.1
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ANTLION_SINKHOLE.1"
msgid "Earthquake! I think?"
msgstr "Động đất! Tôi nghĩ?"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ANTLION_SINKHOLE.2
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ANTLION_SINKHOLE.2"
msgid "What's that?!"
msgstr "Cái gì vậy?!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ANTLION_SINKHOLE.3
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ANTLION_SINKHOLE.3"
msgid "What on earth? The earth!"
msgstr "Chuyện quái gì dưới đất thế? Chính là đất!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ANTLION_TRIBUTE.1
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ANTLION_TRIBUTE.1"
msgid "Get a load of this!"
msgstr "Nhìn cái này đi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ANTLION_TRIBUTE.2
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ANTLION_TRIBUTE.2"
msgid "Hope it's to your likin'!"
msgstr "Mong là hợp ý ngài!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ANTLION_TRIBUTE.3
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ANTLION_TRIBUTE.3"
msgid "Here ya go!"
msgstr "Đây nhé!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ARCHIVE_NEW_KNOWLEDGE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ARCHIVE_NEW_KNOWLEDGE"
msgid "It's showin' me how to build... a machine!"
msgstr "Nó chỉ cho tôi cách chế tạo... một cỗ máy!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ARCHIVE_NO_POWER
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ARCHIVE_NO_POWER"
msgid "Maybe I should poke around, see if I can't get it workin' again."
msgstr "Có lẽ tôi nên tìm hiểu xung quanh, xem liệu tôi có thể làm nó hoạt động trở lại không."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ARCHIVE_OLD_KNOWLEDGE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ARCHIVE_OLD_KNOWLEDGE"
msgid "I've already got that one stored in my noggin'."
msgstr "Tôi đã cất sẵn cái đó trong đầu rồi."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ATRIUM_DESTABILIZING.1
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ATRIUM_DESTABILIZING.1"
msgid "Better skedaddle!"
msgstr "Chuồn thôi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ATRIUM_DESTABILIZING.2
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ATRIUM_DESTABILIZING.2"
msgid "Somethin's going haywire!"
msgstr "Có gì đó đang rối tung lên!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ATRIUM_DESTABILIZING.3
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ATRIUM_DESTABILIZING.3"
msgid "Time to go!"
msgstr "Đến lúc đi rồi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ATTACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ATTACH_BUFF_ATTACK"
msgid "Time to give 'em the old one-two!"
msgstr "Đến lúc tung cú đấm một-hai rồi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ATTACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ATTACH_BUFF_ELECTRICATTACK"
msgid "I ain't no electrician, but what the heck!"
msgstr "Tôi đâu phải thợ điện, nhưng kệ đi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ATTACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ATTACH_BUFF_MOISTUREIMMUNITY"
msgid "I've been waterproofed!"
msgstr "Tôi đã được chống thấm!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ATTACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ATTACH_BUFF_PLAYERABSORPTION"
msgid "I'm tough as nails!"
msgstr "Tôi cứng như đinh đóng cột!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ATTACH_BUFF_SLEEPRESISTANCE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ATTACH_BUFF_SLEEPRESISTANCE"
msgid "Whew, wish I had some of this back when I was working night shifts."
msgstr "Ôi, ước gì tôi có lại được một ít thứ này khi làm ca đêm."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ATTACH_BUFF_WORKEFFECTIVENESS
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ATTACH_BUFF_WORKEFFECTIVENESS"
msgid "Let's turn up the elbow grease!"
msgstr "Xắn tay áo lên làm hăng nào!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_BECOMEGHOST
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_BECOMEGHOST"
msgid "ooOooooO!"
msgstr "uuUuuuU!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_BEES
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_BEES"
msgid "BEEEES!"
msgstr "ONGGGG!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_BOAT_LEAK"
msgid "We gotta repair this ol'girl!"
msgstr "Phải sửa con thuyền già này thôi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_BOAT_SINK
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_BOAT_SINK"
msgid "We're goin' down!"
msgstr "Chúng ta chìm mất!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_BOOMERANG
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_BOOMERANG"
msgid "I'll catch you next time! Ow..."
msgstr "Tôi sẽ bắt bạn lần sau! Ôi..."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_BRAVERY_POTION
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_BRAVERY_POTION"
msgid "I got my moxie back. Now to tackle those trees."
msgstr "Tôi lấy lại can đảm rồi. Giờ xử lý mấy cái cây đó thôi."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_BURNT"
msgid "Ow! Ow! Ow!"
msgstr "Ôi! Ôi! Ôi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_CALL_BEEF
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_CALL_BEEF"
msgid "Come over here, we've got work to do!"
msgstr "Hãy đến đây, chúng ta có việc phải làm!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_CANFIX
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_CANFIX"
msgid "\nIt'd be a pleasure to fix it."
msgstr "\nRất vui được sửa nó."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_CANNOT_BUILD.NO_INGREDIENTS
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_CANNOT_BUILD.NO_INGREDIENTS"
msgid "Looks like I need some parts."
msgstr "Có vẻ như tôi cần một số bộ phận."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_CANNOT_BUILD.NO_STATION
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_CANNOT_BUILD.NO_STATION"
msgid "I'll be needing a station made for this kinda work."
msgstr "Tôi sẽ cần một trạm được thiết kế cho công việc này."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_CANNOT_BUILD.NO_TECH
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_CANNOT_BUILD.NO_TECH"
msgid "Can't say I ever learned how to make one of those."
msgstr "Không thể nói rằng tôi đã từng học cách làm một trong những thứ đó."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_CANTBUILDHERE_YOTB_POST
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_CANTBUILDHERE_YOTB_POST"
msgid "I should build it closer to the judging area."
msgstr "Tôi nên xây nó gần khu vực đánh giá hơn."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_CANT_ESCAPE_CURSE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_CANT_ESCAPE_CURSE"
msgid "I'm not one for knickknacks, but for some reason I just can't let 'em go..."
msgstr "Tôi không phải là người thích đồ lặt vặt, nhưng vì lý do nào đó tôi không thể buông bỏ..."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_CARRAT_ERROR_FELL_ASLEEP
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_CARRAT_ERROR_FELL_ASLEEP"
msgid "Now's no time to be sleeping on the job!"
msgstr "Giờ không phải lúc ngủ gật trong giờ làm!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_CARRAT_ERROR_STUNNED
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_CARRAT_ERROR_STUNNED"
msgid "What's with the lollygagging? Hop to it!"
msgstr "Lề mề gì thế? Nhanh lên!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_CARRAT_ERROR_WALKING
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_CARRAT_ERROR_WALKING"
msgid "Hey! Let's get a move on!"
msgstr "Này! Đi tiếp nào!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.1
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.1"
msgid "Hey, you're getting off-track!"
msgstr "Này, bạn đang đi chệch hướng rồi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2"
msgid "No, not that way!"
msgstr "Không, không phải hướng đó!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_CARRAT_START_RACE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_CARRAT_START_RACE"
msgid "And they're off!"
msgstr "Xuất phát rồi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_CAVEIN
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_CAVEIN"
msgid "Uh... I hope everyone brought hardhats."
msgstr "Ờ... mong là ai cũng mang mũ bảo hộ."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_CHAIR_ON_FIRE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_CHAIR_ON_FIRE"
msgid "This is fine."
msgstr "Không sao đâu."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_CHARLIE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_CHARLIE"
msgid "C-Charlie?"
msgstr "C-Charlie?"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_CHARLIESAVE.1
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_CHARLIESAVE.1"
msgid "Yeesh! I can't tell if she's tryin' to help me or kill me."
msgstr "Eo ơi! Chẳng biết con bé đang giúp hay định giết tôi nữa."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_CHARLIE_ATTACK
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_CHARLIE_ATTACK"
msgid "Yeow! Rude!"
msgstr "Ui da! Vô lễ!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_CHARLIE_MISSED
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_CHARLIE_MISSED"
msgid "Ha! I know all your moves!"
msgstr "Ha! Chị biết hết chiêu của em rồi!"

