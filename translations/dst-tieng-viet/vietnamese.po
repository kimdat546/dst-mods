msgstr "Thật hả?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICE_BLUEPRINT"
msgid "Don't beefalo already have hairy winter coats?"
msgstr "Chẳng phải Bò Lai đã có sẵn áo lông mùa đông rồi sao?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.INSANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.INSANITYROCK.ACTIVE"
msgid "Am I seeing things?"
msgstr "Tôi có bị hoa mắt không?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.INSANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.INSANITYROCK.INACTIVE"
msgid "Doesn't look flammable. How boring."
msgstr "Trông chẳng dễ cháy. Chán thật."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.INSPECTACLESBOX
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.INSPECTACLESBOX"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.INSPECTACLESBOX2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.INSPECTACLESBOX2"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.INSPECTACLESHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.INSPECTACLESHAT.GENERIC"
msgid "I wasn't paying attention when Winona told me how it works."
msgstr "Tôi đã không chú ý khi Winona giải thích cách nó hoạt động."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.INSPECTACLESHAT.MISSINGSKILL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.INSPECTACLESHAT.MISSINGSKILL"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.INSPECTSELF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.INSPECTSELF"
