msgstr "Hãy làm một cái khác."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RESEARCHLAB3.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RESEARCHLAB3.GENERIC"
