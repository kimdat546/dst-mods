msgstr "Ôi trời, có thứ gì đó đang khuấy động."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ATRIUM_DESTABILIZING.3
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ATRIUM_DESTABILIZING.3"
