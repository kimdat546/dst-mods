msgstr "Hãy đặt điểm kết thúc xa hơn một chút..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_GOLF_TEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_GOLF_TEE.GENERIC"
