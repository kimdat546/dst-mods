msgstr "Là ruột nóng của con bọ đầy hơi."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MITEGLAND_COOKED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MITEGLAND_COOKED"
msgid "Little cooked guts has powerful spice smell..."
msgstr "Ruột nhỏ nấu chín có mùi gia vị cực mạnh..."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOLE.ABOVEGROUND
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOLE.ABOVEGROUND"
