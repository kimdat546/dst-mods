msgstr "Chẳng hứng thú thử cái đó lắm."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RED_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RED_MUSHROOM.GENERIC"
