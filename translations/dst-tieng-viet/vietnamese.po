msgstr "À, tôi tình cờ thấy vài quả chuối tươi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DUG_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DUG_BERRYBUSH"
