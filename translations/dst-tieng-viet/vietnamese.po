msgstr "Ở giữa vẫn còn màu tím."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKEDSMALLMEAT"
