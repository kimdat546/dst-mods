msgstr "Có vẻ có thứ gì bị kẹt bên trong."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GELBLOB_BOTTLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GELBLOB_BOTTLE"
