msgstr "Một bất ngờ lắm chân đang chờ bên trong!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDERDEN_BEDAZZLER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDERDEN_BEDAZZLER"
