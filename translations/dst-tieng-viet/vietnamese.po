msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATOR_HIDER"
msgid "I don't think I'll be takin' a bite out of that."
msgstr "Tôi sẽ không cắn thử miếng nào đâu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATOR_MOON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATOR_MOON"
