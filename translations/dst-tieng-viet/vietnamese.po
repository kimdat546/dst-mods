msgstr "Đúng là thứ làm cụt hứng."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICEHOUND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICEHOUND"
msgid "Gross! Cold!"
msgstr "Ghê! Lạnh!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICEPACK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICEPACK"
msgid "Fuzzy backpack!"
msgstr "Ba lô lông xù!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICESTAFF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICESTAFF"
msgid "Booooring."
msgstr "Chááán."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICESTAFF2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICESTAFF2"
msgid "I prefer the opposite of this."
msgstr "Tôi thích thứ ngược lại với cái này hơn."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICESTAFF3
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICESTAFF3"
