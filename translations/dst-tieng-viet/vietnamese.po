msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.YOTB_PATTERN_FRAGMENT_1"
msgid "Merely a single piece of a larger costuming pattern."
msgstr "Chỉ là một phần của một mẫu trang phục lớn hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.YOTB_PATTERN_FRAGMENT_2
