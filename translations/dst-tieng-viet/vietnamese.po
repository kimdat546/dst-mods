msgstr "Nó trông mơ hồ có hình củ khoai tây... hoặc có lẽ tôi chỉ đói thôi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_SCANNER_SUCCEEDED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_SCANNER_SUCCEEDED"
msgid "Voilà, it is done!"
msgstr "Thế là xong!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_SHADOWDRONE_DEBUFFER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_SHADOWDRONE_DEBUFFER"
msgid "What do you see, mon ami?"
msgstr "Bạn thấy gì vậy, mon ami?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_SHADOWDRONE_HARVESTER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_SHADOWDRONE_HARVESTER"
msgid "Have a happy harvest!"
msgstr "Chúc một mùa thu hoạch vui vẻ!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YELLOWAMULET
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YELLOWAMULET"
msgid "Puts some pep in my step!"
msgstr "Làm bước chân tôi thêm hăng hái!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YELLOWGEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YELLOWGEM"
msgid "I miss lemons..."
msgstr "Tôi nhớ chanh..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YELLOWMOONEYE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YELLOWMOONEYE"
msgid "Keep an eye out for me, oui?"
msgstr "Để mắt tới tôi nhé, được chứ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YELLOWSTAFF
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YELLOWSTAFF"
msgid "I could stir a huge pot with this thing!"
msgstr "Tôi có thể khuấy một cái nồi lớn với thứ này!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTB_BEEFALOSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTB_BEEFALOSHRINE.BURNT"
msgid "Far too well done."
msgstr "Chín quá kỹ rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTB_BEEFALOSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTB_BEEFALOSHRINE.EMPTY"
msgid "It needs a special ingredient."
msgstr "Nó cần một thành phần đặc biệt."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTB_BEEFALOSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTB_BEEFALOSHRINE.GENERIC"
msgid "I wonder what I can cook up with this?"
msgstr "Tôi tự hỏi tôi có thể nấu món gì với thứ này?"

