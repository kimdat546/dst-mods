msgstr "Très géant! To khổng lồ!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.BERNIE_INACTIVE.BROKEN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.BERNIE_INACTIVE.BROKEN"
msgid "Poor little fellow."
msgstr "Tội nghiệp đứa nhỏ."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.BERNIE_INACTIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.BERNIE_INACTIVE.GENERIC"
msgid "I've been told his name is \"Bernie\"."
msgstr "Tôi được biết tên anh ấy là \"Bernie\"."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.BERRIES
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.BERRIES"
msgid "Fresh fruit!"
msgstr "Hoa quả tươi!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.BERRIES_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.BERRIES_COOKED"
msgid "Could use a pinch of sugar..."
msgstr "Cần thêm chút đường..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.BERRIES_JUICY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.BERRIES_JUICY"
msgid "What a unique, tangy flavor."
msgstr "Vị chua chua độc đáo thật."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.BERRIES_JUICY_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.BERRIES_JUICY_COOKED"
msgid "I'd have preferred to cook them into a proper dish."
msgstr "Tôi muốn nấu chúng thành một món ra hồn hơn."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.BERRYBUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.BERRYBUSH.BARREN"
msgid "They require care and fertilizer."
msgstr "Chúng cần được chăm sóc và bón phân."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.BERRYBUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.BERRYBUSH.BURNING"
