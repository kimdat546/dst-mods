msgstr "Bây giờ tôi có thể có quả mọng tươi ở bất cứ đâu tôi muốn!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DUG_GRASS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DUG_GRASS"
msgid "Should I bring it back to life?"
msgstr "Tôi có nên làm nó sống lại không?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DUG_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DUG_MARSH_BUSH"
msgid "Should I bring it back to life?"
msgstr "Tôi có nên làm nó sống lại không?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DUG_MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DUG_MONKEYTAIL"
