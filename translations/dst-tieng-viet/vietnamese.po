msgstr "Đó là một mảnh đất cát."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TURF_SINKHOLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TURF_SINKHOLE"
msgid "That's a chunk of ground."
msgstr "Đó là một mảnh đất."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TURF_UNDERROCK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TURF_UNDERROCK"
msgid "That's a chunk of ground."
msgstr "Đó là một mảnh đất."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TURF_VAULT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TURF_VAULT"
msgid "That's a well made chunk of ground."
msgstr "Đó là một mảnh đất được làm tốt."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TURF_VENT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TURF_VENT"
msgid "That's a chunk of ground."
msgstr "Đó là một mảnh đất."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TURF_WOODFLOOR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TURF_WOODFLOOR"
msgid "That's a chunk of ground."
msgstr "Đó là một mảnh đất."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TURKEYDINNER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TURKEYDINNER"
msgid "We're eatin' well tonight!"
msgstr "Tối nay chúng ta ăn ngon lắm!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TURNIP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TURNIP"
msgid "A fresh, ripe turnip."
msgstr "Một củ cải tươi, chín."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TURNIP_COOKED"
msgid "I'd rather not eat them on their own."
msgstr "Tôi chẳng muốn ăn không món này."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TURNIP_SEEDS"
msgid "I got no idea what they'd grow into."
msgstr "Tôi không biết chúng sẽ phát triển thành gì."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TURTILLUS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TURTILLUS"
msgid "Steel yourself, turtle."
msgstr "Cứng rắn lên, rùa thép."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TWIGGYTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TWIGGYTREE.BURNING"
msgid "That's an impressive blaze."
msgstr "Đó là một ngọn lửa ấn tượng."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TWIGGYTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TWIGGYTREE.BURNT"
msgid "Completely charred."
msgstr "Cháy hoàn toàn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TWIGGYTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TWIGGYTREE.CHOPPED"
msgid "Won't have to do that again for awhile."
msgstr "Một thời gian nữa mới phải chặt lại."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TWIGGYTREE.DISEASED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TWIGGYTREE.DISEASED"
msgid "Doesn't look great."
msgstr "Trông không tuyệt lắm."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TWIGGYTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TWIGGYTREE.GENERIC"
msgid "That's one skinny tree."
msgstr "Đó là một cái cây gầy gò."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TWIGGY_NUT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TWIGGY_NUT"
msgid "Belongs in the ground."
msgstr "Nên đem trồng xuống đất."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TWIGGY_NUT_SAPLING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TWIGGY_NUT_SAPLING"
msgid "Not even worth chopping."
msgstr "Thậm chí không đáng để chặt."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TWIGGY_OLD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TWIGGY_OLD"
msgid "Looks like that two-bit magician."
msgstr "Trông như gã ảo thuật gia hạng xoàng đó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TWIGS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TWIGS"
msgid "I could snap these like twigs! Ha!"
msgstr "Tôi có thể bẻ gãy chúng như cành cây! Hà!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TWINOFTERROR1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TWINOFTERROR1"
msgid "You really can't help but admire the craftsmanship."
msgstr "Bạn thực sự không thể không ngưỡng mộ sự khéo léo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TWINOFTERROR2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TWINOFTERROR2"
msgid "C'mon, I only want to take you apart a little!"
msgstr "Thôi nào, tôi chỉ muốn tháo cậu ra một chút thôi!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.UMBRELLA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.UMBRELLA"
msgid "It serves its purpose."
msgstr "Nó phục vụ mục đích của nó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.UNAGI
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.UNAGI"
msgid "Fancy eats."
msgstr "Món ăn sang chảnh."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.UNIMPLEMENTED"
msgid "What kind of bonehead leaves stuff half-built?!"
msgstr "Đồ đầu đất nào lại để thứ này xây dở dang thế?!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_CHANDELIER_BROKEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_CHANDELIER_BROKEN"
msgid "Well that's unsafe."
msgstr "Chà, thế này thì không an toàn rồi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_COMPASS.GENERIC"
msgid "I like havin' clear instructions to work off of."
msgstr "Tôi thích làm việc theo chỉ dẫn rõ ràng."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_COMPASS.KEYROOM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_COMPASS.KEYROOM"
msgid "Worked like a charm!"
msgstr "Chạy ngon lành!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_COMPASS.NOTVAULT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_COMPASS.NOTVAULT"
msgid "Seems like it only works in one place..."
msgstr "Hình như nó chỉ hoạt động ở một chỗ thôi..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_CRAWLER.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_CRAWLER.GENERIC"
msgid "Hey, I think you're the missing piece I need!"
msgstr "Này, chắc mày chính là mảnh ghép tao đang thiếu!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_CRAWLER.SOCKETED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_CRAWLER.SOCKETED"
msgid "In ya go!"
msgstr "Vào đi nào!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_CRAWLER_LEVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_CRAWLER_LEVER"
msgid "Here goes nothin'!"
msgstr "Liều một phen xem sao!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_DECON_DOOR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_DECON_DOOR"
msgid "Pretty heavy-duty. They must've really wanted to keep this place secure."
msgstr "Chắc chắn ghê. Họ hẳn rất muốn giữ nơi này an toàn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_DECON_MISTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_DECON_MISTER"
msgid "Seems like a pretty fancy setup."
msgstr "Có vẻ là một hệ thống khá xịn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_KEY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_KEY"
msgid "Maybe I'll finally get some answers."
msgstr "Có lẽ cuối cùng tôi cũng tìm được câu trả lời."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_KEY_ACTIVATOR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_KEY_ACTIVATOR"
msgid "Huh. Looks like it's meant to hold some kind of power source."
msgstr "Hử. Trông như nó dùng để chứa một loại nguồn năng lượng nào đó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_KEY_EXIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_KEY_EXIT"
msgid "Well, looks like it's exit only."
msgstr "Chà, có vẻ chỉ có đường ra thôi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_KEY_PEDESTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_KEY_PEDESTAL.GENERIC"
msgid "I've got an uneasy feeling about this."
msgstr "Tôi thấy bất an về chuyện này."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_KEY_PEDESTAL.PICKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_KEY_PEDESTAL.PICKED"
msgid "Yup, it's empty."
msgstr "Ừ, trống trơn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_LOBBY_EXIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_LOBBY_EXIT"
msgid "Better let down a rope in case I ever wanna come back this way."
msgstr "Tốt nhất nên thả một sợi dây xuống, lỡ sau này muốn quay lại lối này."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_ORB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_ORB"
msgid "Think I know where this goes."
msgstr "Tôi nghĩ tôi biết cái này đặt vào đâu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_ORB_REFINED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_ORB_REFINED"
msgid "I've seen something like this before."
msgstr "Tôi từng thấy thứ giống vầy rồi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_PILLAR_GUARD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_PILLAR_GUARD"
msgid "C'mon you pile of bricks!"
msgstr "Lên đi, đồ đống gạch!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR"
msgid "I can see it already."
msgstr "Tôi hình dung ra nó rồi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR_PLANS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR_PLANS"
msgid "Where's a good spot for it?"
msgstr "Đặt nó ở đâu thì hợp nhỉ?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_PILLAR_GUARD_CRAFTED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_PILLAR_GUARD_CRAFTED"
msgid "Now that's impressive."
msgstr "Giờ thì ấn tượng thật."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT"
msgid "They sure built 'em to last back then."
msgstr "Hồi đó người ta xây bền thật."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT_CRAFTED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT_CRAFTED"
msgid "Needs juice to run it."
msgstr "Cần nạp điện mới chạy được."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_PILLAR_GUARD_PIECE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_PILLAR_GUARD_PIECE"
msgid "Looks like that lumbering tower of bricks needs this to lumber."
msgstr "Có vẻ cái tháp gạch lù đù kia cần thứ này mới lù đù đi được."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_REFINER_PEDESTAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_REFINER_PEDESTAL"
msgid "Never seen anything like it, but I'll make it work."
msgstr "Chưa thấy thứ gì giống vậy bao giờ, nhưng tôi sẽ làm cho nó chạy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_RUNE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_RUNE"
msgid "Ain't a chance I can read that!"
msgstr "Tôi đời nào đọc nổi thứ đó!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_STATUE.LORE1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_STATUE.LORE1"
msgid "It's like he sprung some sorta demonic oil leak."
msgstr "Giống như anh ta đã tạo ra một vết rò rỉ dầu ma quỷ nào đó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_STATUE.LORE2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_STATUE.LORE2"
msgid "Someone used up the whole can of bug spray."
msgstr "Có người đã dùng hết lọ thuốc xịt côn trùng."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_STATUE.LORE3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_STATUE.LORE3"
msgid "They sure don't want nobody leavin'."
msgstr "Họ chắc chắn không muốn ai rời đi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_TELEPORTER.BROKEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_TELEPORTER.BROKEN"
msgid "It's missin' a part."
msgstr "Nó đang thiếu một phần."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_TELEPORTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_TELEPORTER.GENERIC"
msgid "That's magic for ya."
msgstr "Phép thuật là vậy đấy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_TELEPORTER.UNPOWERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_TELEPORTER.UNPOWERED"
msgid "Where's the dang ON switch?"
msgstr "Cái công tắc BẬT chết tiệt ở đâu rồi?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_TORCH.BROKEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_TORCH.BROKEN"
msgid "The switch is busted."
msgstr "Công tắc bị hỏng."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_TORCH.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VAULT_TORCH.GENERIC"
msgid "A fine lookin' torch."
msgstr "Một ngọn đuốc trông đẹp đấy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VEGGIEOMLET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VEGGIEOMLET"
msgid "Less dishes to wash if you leave it in the pan."
msgstr "Ít bát đĩa phải rửa hơn nếu bạn để nó trong chảo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VEGGIE_OVERSIZED_ROTTEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VEGGIE_OVERSIZED_ROTTEN"
msgid "Such a waste."
msgstr "Thật lãng phí."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VEGSTINGER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VEGSTINGER"
msgid "I could use one of these after a long day."
msgstr "Sau một ngày dài mà có ly này thì tuyệt."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VICTORIAN_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VICTORIAN_BLUEPRINT"
msgid "This looks like it involves a lotta fancy needlework..."
msgstr "Điều này có vẻ như liên quan đến rất nhiều công việc may vá lạ mắt..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VOIDCLOTH"
msgid "I can work with any material."
msgstr "Tôi có thể làm việc với bất kỳ vật liệu nào."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VOIDCLOTHHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VOIDCLOTHHAT"
msgid "Some folks think it's safer to be kept in the dark."
msgstr "Một số người cho rằng ở trong bóng tối sẽ an toàn hơn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VOIDCLOTH_BOOMERANG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VOIDCLOTH_BOOMERANG"
msgid "Round trip included!"
msgstr "Bao gồm cả chuyến đi khứ hồi!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VOIDCLOTH_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VOIDCLOTH_KIT"
msgid "Never hurts to keep a repair kit handy."
msgstr "Có sẵn bộ đồ sửa trong tay thì chẳng bao giờ thừa."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VOIDCLOTH_SCYTHE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VOIDCLOTH_SCYTHE"
msgid "It gives me the creeps, but it sure works like a charm."
msgstr "Nó làm tôi rùng mình, nhưng chắc chắn hoạt động rất tốt."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VOIDCLOTH_UMBRELLA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VOIDCLOTH_UMBRELLA"
msgid "It sure provides plenty of shade."
msgstr "Nó chắc chắn cung cấp nhiều bóng râm."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.VOLTGOATJELLY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.VOLTGOATJELLY"
msgid "You can really taste the electricity."
msgstr "Bạn thực sự có thể nếm được mùi điện."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAFFLES
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAFFLES"
msgid "Bet I can fit them all in my mouth."
msgstr "Cá là tôi có thể nhét tất cả chúng vào miệng."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGBOSS_ROBOT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGBOSS_ROBOT"
msgid "That is one fancy forklift."
msgstr "Đúng là chiếc xe nâng sang chảnh."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE"
msgid "It's comin' along..."
msgstr "Đang dần thành hình..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE_KIT"
msgid "I know I can build this thing, but should I?"
msgstr "Tôi biết tôi có thể xây dựng thứ này, nhưng tôi có nên làm không?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGBOSS_ROBOT_CREATION_PARTS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGBOSS_ROBOT_CREATION_PARTS"
msgid "The bossman sure built one mean machine."
msgstr "Ông chủ đúng là chế ra một cỗ máy đáng gờm."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGBOSS_ROBOT_LEG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGBOSS_ROBOT_LEG"
msgid "Now that is one solidly built robo-leg."
msgstr "Giờ thì đây mới là cái chân robot chế tạo chắc chắn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGBOSS_ROBOT_POSSESSED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGBOSS_ROBOT_POSSESSED"
msgid "Where's the dang OFF switch?!"
msgstr "Cái công tắc TẮT chết tiệt ở đâu rồi?!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGBOSS_ROBOT_SECRET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGBOSS_ROBOT_SECRET"
msgid "Bossman's up to somethin' alright."
msgstr "Ông chủ chắc chắn đang giở trò gì đó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGDRONE_BEACON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGDRONE_BEACON"
msgid "The bossman thought of everything. Well, almost."
msgstr "Ông chủ tính trước mọi thứ. À, gần như thế."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGDRONE_FLYING.DAMAGED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGDRONE_FLYING.DAMAGED"
msgid "Ain't nothin' but spare parts here."
msgstr "Ở đây không có gì ngoài phụ tùng thay thế."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGDRONE_FLYING.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGDRONE_FLYING.GENERIC"
msgid "Dang mechanical buzzards!"
msgstr "Lũ kền kền máy chết tiệt!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGDRONE_FLYING.INACTIVE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGDRONE_FLYING.INACTIVE"
msgid "Think it's turned off."
msgstr "Chắc nó tắt rồi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGDRONE_PARTS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGDRONE_PARTS"
msgid "Love me some spare parts!"
msgstr "Tôi mê phụ tùng lắm!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGDRONE_ROLLING.DAMAGED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGDRONE_ROLLING.DAMAGED"
msgid "I can definitely fix it, or salvage it for parts."
msgstr "Tôi chắc chắn có thể sửa chữa nó hoặc trục vớt nó để lấy các bộ phận."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGDRONE_ROLLING.FRIENDLY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGDRONE_ROLLING.FRIENDLY"
msgid "I'll never fully trust it."
msgstr "Tôi sẽ không bao giờ hoàn toàn tin tưởng nó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGDRONE_ROLLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGDRONE_ROLLING.GENERIC"
msgid "Hey, stay away from my kneecaps!"
msgstr "Này, tránh xa xương bánh chè của tôi ra!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGDRONE_ROLLING.INACTIVE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGDRONE_ROLLING.INACTIVE"
msgid "Think it's turned off."
msgstr "Chắc nó tắt rồi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGPUNKBITS_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGPUNKBITS_KIT"
msgid "Nifty!"
msgstr "Tiện lợi!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGPUNKHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGPUNKHAT"
msgid "Love me a steam-powered murder helmet as much as the next gal but clunky much?"
msgstr "Mũ giết người chạy hơi nước thì tôi cũng mê như ai, nhưng có hơi cồng kềnh không?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGPUNK_BITS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGPUNK_BITS"
msgid "Don't let its looks fool you, these are some high-quality parts!"
msgstr "Đừng để vẻ ngoài đánh lừa bạn, đây là một số bộ phận chất lượng cao!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGPUNK_CAGEWALL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGPUNK_CAGEWALL"
msgid "So, a fence post?"
msgstr "Vậy ra là một cái cọc rào?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGPUNK_FLOOR_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGPUNK_FLOOR_KIT"
msgid "Real estate is at a premium these days."
msgstr "Dạo này đất đai quý như vàng."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGPUNK_LEVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGPUNK_LEVER"
msgid "What could go wrong?"
msgstr "Thì có gì sai được chứ?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGPUNK_WORKSTATION
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGPUNK_WORKSTATION"
msgid "That's a fine tinkerin' table."
msgstr "Đó là một cái bàn mày mò tốt đấy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGSTAFF_ITEM_1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGSTAFF_ITEM_1"
msgid "Hm, bossman's glove... it's real."
msgstr "Hừm, găng tay của ông chủ... nó có thật đấy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGSTAFF_ITEM_2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGSTAFF_ITEM_2"
msgid "I can't believe those are his actual notes."
msgstr "Tôi không thể tin được đó là những ghi chú thực sự của anh ấy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGSTAFF_MACHINERY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGSTAFF_MACHINERY"
msgid "I bet I could break this stuff down for parts."
msgstr "Tôi cá là có thể tháo thứ này ra lấy phụ tùng."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGSTAFF_MUTATIONS_NOTE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGSTAFF_MUTATIONS_NOTE"
msgid "Some interestin' theories here..."
msgstr "Một số lý thuyết thú vị ở đây..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGSTAFF_NPC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGSTAFF_NPC"
msgid "Mr. Wagstaff! Is that really you?"
msgstr "Ông Wagstaff! Có thật là ông không?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGSTAFF_NPC_MUTATIONS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGSTAFF_NPC_MUTATIONS"
msgid "Er, will I be gettin' overtime for this?"
msgstr "Ơ, việc này tôi có được tính tiền làm thêm giờ không?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGSTAFF_NPC_WAGPUNK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGSTAFF_NPC_WAGPUNK"
msgid "Hey! Wait up!"
msgstr "Này! Đợi đã!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGSTAFF_TOOL_1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGSTAFF_TOOL_1"
msgid "Found the Reticulating Buffer! Better get it back to the bossman."
msgstr "Tìm thấy Bộ Đệm Lưới Hóa rồi! Phải mang về cho sếp mới được."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGSTAFF_TOOL_2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGSTAFF_TOOL_2"
msgid "There's the boss' Widget Deflubber!"
msgstr "Đây rồi, Máy Khử Rung Linh Kiện của sếp!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGSTAFF_TOOL_3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGSTAFF_TOOL_3"
msgid "Hey, that looks like a Grommet Scriber!"
msgstr "Này, trông như Bút Khắc Khoen kìa!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGSTAFF_TOOL_4
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGSTAFF_TOOL_4"
msgid "Ha! Found you, you sneaky old Conceptual Scrubber!"
msgstr "Ha! Tìm thấy mày rồi, cái Máy Chà Khái Niệm lén lút!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGSTAFF_TOOL_5
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAGSTAFF_TOOL_5"
msgid "There's the Calibrated Perceiver! Almost missed it."
msgstr "Bộ Cảm Nhận Hiệu Chuẩn đây rồi! Suýt thì bỏ sót."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALKINGPLANK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALKINGPLANK"
msgid "That thing don't look stable."
msgstr "Thứ đó có vẻ không ổn định."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALKINGPLANK_ANCIENT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALKINGPLANK_ANCIENT"
msgid "That thing don't look stable."
msgstr "Thứ đó có vẻ không ổn định."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALKINGPLANK_GRASS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALKINGPLANK_GRASS"
msgid "That thing don't look stable."
msgstr "Thứ đó có vẻ không ổn định."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALKINGPLANK_YOTD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALKINGPLANK_YOTD"
msgid "Sure it looks nice, but I ain't keen on using it anytime soon."
msgstr "Chắc chắn là nó trông đẹp, nhưng tôi không muốn sử dụng nó sớm."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALKING_STICK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALKING_STICK"
msgid "Woodie and Lucy really stick together, huh?"
msgstr "Woodie và Lucy thực sự gắn bó với nhau phải không?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_DREADSTONE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_DREADSTONE"
msgid "Well, at least it's sturdy."
msgstr "Chà, ít nhất thì nó cũng cứng cáp."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_DREADSTONE_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_DREADSTONE_ITEM"
msgid "Assembly time."
msgstr "Thời gian lắp ráp."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_HAY.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_HAY.BURNT"
msgid "Guess we should've seen that coming."
msgstr "Có lẽ chúng ta nên thấy điều đó sắp xảy ra."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_HAY.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_HAY.GENERIC"
msgid "It's just a hay bale, really."
msgstr "Thực ra nó chỉ là một kiện cỏ khô thôi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_HAY_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_HAY_ITEM"
msgid "Assembly time."
msgstr "Thời gian lắp ráp."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_MOONROCK"
msgid "It's already been built. Sigh."
msgstr "Nó đã được xây dựng rồi. Thở dài."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_MOONROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_MOONROCK_ITEM"
msgid "Assembly time."
msgstr "Thời gian lắp ráp."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_RUINS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_RUINS"
msgid "If I break it, I'll get to build it again."
msgstr "Nếu tôi phá vỡ nó, tôi sẽ có thể xây dựng lại nó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_RUINS_2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_RUINS_2"
msgid "If I break it, I'll get to build it again."
msgstr "Nếu tôi phá vỡ nó, tôi sẽ có thể xây dựng lại nó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_RUINS_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_RUINS_ITEM"
msgid "Assembly time."
msgstr "Thời gian lắp ráp."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_SCRAP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_SCRAP"
msgid "A wall's a wall, I suppose."
msgstr "Tôi cho rằng một bức tường là một bức tường."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_SCRAP_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_SCRAP_ITEM"
msgid "A wall's a wall, I suppose."
msgstr "Tôi cho rằng một bức tường là một bức tường."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_STONE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_STONE"
msgid "The building part is over."
msgstr "Phần xây dựng đã xong."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_STONE_2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_STONE_2"
msgid "The building part is over."
msgstr "Phần xây dựng đã xong."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_STONE_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_STONE_ITEM"
msgid "Assembly time."
msgstr "Thời gian lắp ráp."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_WOOD.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_WOOD.BURNT"
msgid "Just means we gotta build more."
msgstr "Chỉ có nghĩa là chúng ta phải xây dựng nhiều hơn nữa."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_WOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_WOOD.GENERIC"
msgid "Built nice and sturdy."
msgstr "Xây đẹp và chắc chắn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_WOOD_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALL_WOOD_ITEM"
msgid "Assembly time."
msgstr "Thời gian lắp ráp."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALRUS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALRUS"
msgid "Maybe you oughta retire."
msgstr "Có lẽ bạn nên nghỉ hưu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALRUSHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALRUSHAT"
msgid "Oddly comforting."
msgstr "Dễ chịu lạ thường."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALRUS_CAMP.EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALRUS_CAMP.EMPTY"
msgid "Just a mud pit."
msgstr "Chỉ là một hố bùn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALRUS_CAMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALRUS_CAMP.GENERIC"
msgid "I wonder how long that took to build?"
msgstr "Tôi tự hỏi việc xây dựng đó mất bao lâu?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALRUS_TUSK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALRUS_TUSK"
msgid "He was gettin' a bit long in the tooth. Ha!"
msgstr "Lão này cũng già răng rồi. Hà!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALTER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALTER.ATTACKER"
msgid "You better simmer down, %s!"
msgstr "Tốt nhất là bạn nên bình tĩnh lại, %s!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALTER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALTER.FIRESTARTER"
msgid "That ain't safe, %s."
msgstr "Điều đó không an toàn, %s."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALTER.GENERIC"
msgid "Hey, %s! Caught any interestin' bugs lately?"
msgstr "Này, %s! Dạo này bắt được con bọ nào hay ho không?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALTER.GHOST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALTER.GHOST"
msgid "Hey %s, no slacking! We've got lots to do!"
msgstr "Này %s, không được lười biếng! Chúng ta có rất nhiều việc phải làm!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALTER.MURDERER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALTER.MURDERER"
msgid "No murderer's gettin' away on my watch!"
msgstr "Không có tên sát nhân nào thoát khỏi tầm mắt của tôi!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALTER.REVIVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALTER.REVIVER"
msgid "Thanks kid, you really got the helpfulness thing down pat!"
msgstr "Cảm ơn nhóc, cậu đúng là rành chuyện giúp người!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WALTERHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WALTERHAT"
msgid "I'll stick to my hardhat."
msgstr "Tôi cứ dùng mũ bảo hộ của tôi thôi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WANDA.ATTACKER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WANDA.ATTACKER"
msgid "Hey, what's got you so riled up, %s?"
msgstr "Này, điều gì khiến bạn nổi cáu vậy, %s?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WANDA.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WANDA.FIRESTARTER"
msgid "Mind letting me in on why you're doin' that, %s?"
msgstr "Hãy cho tôi biết lý do tại sao bạn làm điều đó, %s?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WANDA.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WANDA.GENERIC"
msgid "Hey, %s! Keepin' busy?"
msgstr "Này, %s! Đang bận à?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WANDA.GHOST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WANDA.GHOST"
msgid "Oh yikes, that's no good."
msgstr "Ôi ôi, điều đó không tốt chút nào."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WANDA.MURDERER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WANDA.MURDERER"
msgid "Don't think I'll pull my punches just cause you're an old lady sometimes!"
msgstr "Đừng nghĩ tôi sẽ nương tay chỉ vì bạn đôi khi là một bà già!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WANDA.REVIVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WANDA.REVIVER"
msgid "Thanks for givin' me a hand, %s!"
msgstr "Cảm ơn đã giúp tôi một tay, %s!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WANDERINGTRADER.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WANDERINGTRADER.GENERIC"
msgid "That thing don't look right."
msgstr "Thứ đó có vẻ không ổn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WANDERINGTRADER.REVEALED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WANDERINGTRADER.REVEALED"
msgid "Good day for a trade."
msgstr "Một ngày tốt lành để giao dịch."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WARDROBE.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WARDROBE.BURNING"
msgid "And up it goes."
msgstr "Và cháy luôn rồi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WARDROBE.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WARDROBE.BURNT"
msgid "So who wants to build another one?"
msgstr "Vậy ai muốn xây dựng một cái khác?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WARDROBE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WARDROBE.GENERIC"
msgid "I could build a million of these."
msgstr "Tôi có thể tạo ra hàng triệu thứ như thế này."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WARG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WARG"
msgid "Quite the set of chompers on that one."
msgstr "Bộ răng của con đó ghê thật."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WARGCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WARGCORPSE.BURNING"
msgid "Is that really necessary?"
msgstr "Điều đó có thực sự cần thiết không?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WARGCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WARGCORPSE.GENERIC"
msgid "I'm sure someone loved this monstrous mutt."
msgstr "Tôi chắc chắn có ai đó yêu thích con chó lai quái dị này."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WARGCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WARGCORPSE.REVIVING"
msgid "There's nothing in the manual about this."
msgstr "Sách hướng dẫn chẳng hề nói gì về chuyện này."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WARGLET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WARGLET"
msgid "I don't think we're gonna get along."
msgstr "Tôi không nghĩ chúng ta sẽ hợp nhau."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WARGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WARGSHRINE.BURNT"
msgid "Burned right up."
msgstr "Bị đốt cháy ngay."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WARGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WARGSHRINE.EMPTY"
msgid "Needs a little something extra."
msgstr "Cần thêm một chút gì đó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WARGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WARGSHRINE.GENERIC"
msgid "I should build something with it!"
msgstr "Tôi nên xây dựng một cái gì đó với nó!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WARLY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WARLY.ATTACKER"
msgid "Watch where you're throwin' them oven mitts!"
msgstr "Coi chừng chỗ cậu vung găng tay lò nướng đấy!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WARLY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WARLY.FIRESTARTER"
msgid "I'm sure %s knows how to handle grease fires."
msgstr "Tôi chắc chắn %s biết cách xử lý đám cháy do dầu mỡ."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WARLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WARLY.GENERIC"
msgid "Hey, %s! Got anything tasty for me?"
msgstr "Này, %s! Có gì ngon cho tôi không?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WARLY.GHOST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WARLY.GHOST"
msgid "Missed your snack break, didja %s?"
msgstr "Bạn đã bỏ lỡ giờ nghỉ ăn nhẹ, phải không %s?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WARLY.MURDERER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WARLY.MURDERER"
msgid "Killer chef! Get'em!"
msgstr "Đầu bếp sát thủ! Bắt hắn!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WARLY.REVIVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WARLY.REVIVER"
msgid "You're a real pal, %s."
msgstr "Bạn là một người bạn thực sự, %s."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAR_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAR_BLUEPRINT"
msgid "I don't know if I want to encourage my beefalo's ornery side."
msgstr "Không biết tôi có muốn khơi dậy tính khí cục cằn của con bò lai nhà mình không."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WASPHIVE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WASPHIVE"
msgid "Wouldn't mess with that without good reason."
msgstr "Sẽ không gây rối với điều đó mà không có lý do chính đáng."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERBALLOON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERBALLOON"
msgid "I throw a killer curveball."
msgstr "Tôi ném bóng xoáy đỉnh lắm đấy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERINGCAN.EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERINGCAN.EMPTY"
msgid "Looks like I'll have to find some water."
msgstr "Có vẻ như tôi phải tìm chút nước."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERINGCAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERINGCAN.GENERIC"
msgid "Pretty straightforward."
msgstr "Khá đơn giản."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERMELON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERMELON"
msgid "We used to slice these up on hot summer days."
msgstr "Chúng tôi thường cắt những thứ này vào những ngày hè nóng bức."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERMELONHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERMELONHAT"
msgid "A melon for your melon."
msgstr "Một quả dưa để đội lên cái đầu dưa của cậu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERMELONICLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERMELONICLE"
msgid "A good treat for work breaks."
msgstr "Món ăn vặt ngon cho giờ nghỉ."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERMELON_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERMELON_COOKED"
msgid "This was an odd choice."
msgstr "Đây là một sự lựa chọn kỳ lạ."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERMELON_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERMELON_OVERSIZED"
msgid "There's enough here to feed a whole work crew!"
msgstr "Ở đây có đủ thức ăn cho cả một đội làm việc!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERMELON_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERMELON_SEEDS"
msgid "A handful of seeds."
msgstr "Một nắm hạt."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERPLANT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERPLANT"
msgid "Look at the size of it!"
msgstr "Nhìn nó to chưa kìa!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERPLANT_BABY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERPLANT_BABY"
msgid "The spittin' image of its parents."
msgstr "Giống bố mẹ nó như đúc."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERPLANT_BOMB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERPLANT_BOMB"
msgid "Seems determined to ruin the structural integrity of our boat."
msgstr "Có vẻ quyết tâm phá nát kết cấu con thuyền của chúng ta."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERPLANT_PLANTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERPLANT_PLANTER"
msgid "Let's find a good rock to plant you on."
msgstr "Đi tìm một tảng đá tốt để trồng nhóc lên nào."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERPUMP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERPUMP"
msgid "Why do I get the feeling this is that funny-haired scientist's handiwork..."
msgstr "Tại sao tôi lại có cảm giác đây là tác phẩm của nhà khoa học có mái tóc ngộ nghĩnh đó..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERTREE_PILLAR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERTREE_PILLAR"
msgid "Yeesh, look at the size of that thing!"
msgstr "Chà, nhìn cái thứ đó to chưa kìa!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERTREE_ROOT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WATERTREE_ROOT"
msgid "Let's get to the root of this problem. Ha!"
msgstr "Chúng ta hãy đi vào gốc rễ của vấn đề này. Hà!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WATHGRITHR.ATTACKER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WATHGRITHR.ATTACKER"
msgid "Woah! Watch that right hook, %s!"
msgstr "Ối! Cẩn thận cú móc phải đó, %s!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WATHGRITHR.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WATHGRITHR.FIRESTARTER"
msgid "Quit startin' fires, %s!"
msgstr "Đừng châm lửa nữa, %s!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WATHGRITHR.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WATHGRITHR.GENERIC"
msgid "Hey, %s! Arm wrestle rematch later?"
msgstr "Này, %s! Lát nữa tái đấu vật tay nhé?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WATHGRITHR.GHOST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WATHGRITHR.GHOST"
msgid "Well that just won't do at all!"
msgstr "Chà, thế này thì không ổn chút nào!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WATHGRITHR.MURDERER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WATHGRITHR.MURDERER"
msgid "Takin' the warrior thing too far, %s!"
msgstr "Cậu làm chiến binh hơi quá tay rồi đấy, %s!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WATHGRITHR.REVIVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WATHGRITHR.REVIVER"
msgid "That was good work there, %s."
msgstr "Làm tốt lắm, %s."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WATHGRITHRHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WATHGRITHRHAT"
msgid "Surprisingly practical."
msgstr "Thiết thực đến bất ngờ."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WATHGRITHR_IMPROVEDHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WATHGRITHR_IMPROVEDHAT"
msgid "Wonder if it's made from real unicorn..."
msgstr "Tự hỏi liệu nó có được làm từ kỳ lân thật không..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WATHGRITHR_SHIELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WATHGRITHR_SHIELD"
msgid "Nothin' more practical than a good sturdy shield."
msgstr "Không có gì thiết thực hơn một tấm khiên tốt và chắc chắn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAXED_PLANT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAXED_PLANT"
msgid "It'll stay fresh as a daisy forever."
msgstr "Nó sẽ tươi như hoa cúc mãi mãi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAXPAPER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAXPAPER"
msgid "So waxy."
msgstr "Toàn sáp là sáp."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAXWELL.ATTACKER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAXWELL.ATTACKER"
msgid "Don't make me noogie you, %s."
msgstr "Đừng để tôi phải cốc đầu ông, %s."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAXWELL.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAXWELL.FIRESTARTER"
msgid "Mysterious fires follow you like a plague, %s."
msgstr "Những đám cháy bí ẩn theo bạn như một bệnh dịch, %s."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAXWELL.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAXWELL.GENERIC"
msgid "So... %s."
msgstr "Vậy... %s."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAXWELL.GHOST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAXWELL.GHOST"
msgid "I could just leave you like this, hey?"
msgstr "Tôi cứ để ông thế này cũng được nhỉ?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAXWELL.MURDERER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAXWELL.MURDERER"
msgid "How many lives you plannin' on ruinin', %s?"
msgstr "Bạn định hủy hoại bao nhiêu mạng sống, %s?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAXWELL.REVIVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAXWELL.REVIVER"
msgid "Nice job, ya big walnut."
msgstr "Làm tốt lắm, đồ gàn dở to xác."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WAXWELLJOURNAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WAXWELLJOURNAL.GENERIC"
msgid "I don't trust that thing one bit."
msgstr "Tôi chẳng tin thứ đó chút nào."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WEBBER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WEBBER.ATTACKER"
msgid "Yeesh, kid, dial it back!"
msgstr "Chà, nhóc, bớt lại chút đi!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WEBBER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WEBBER.FIRESTARTER"
msgid "Alright, %s. Why'd ya set the fire?"
msgstr "Được rồi, %s. Tại sao cậu lại đốt lửa?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WEBBER.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WEBBER.GENERIC"
msgid "How's life treating ya, kiddo?"
msgstr "Cuộc sống đối xử với cậu thế nào rồi nhóc?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WEBBER.GHOST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WEBBER.GHOST"
msgid "You'll be fine, kid, yer a boxer."
msgstr "Cậu sẽ ổn thôi nhóc, cậu dẻo dai lắm."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WEBBER.MURDERER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WEBBER.MURDERER"
msgid "Killer spider! Get it!"
msgstr "Nhện sát thủ! Bắt nó!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WEBBER.REVIVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WEBBER.REVIVER"
msgid "You did good, kid."
msgstr "Cậu đã làm tốt, nhóc."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WEBBERSKULL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WEBBERSKULL"
msgid "I swear the kid'd lose his head if it weren't... wait."
msgstr "Tôi thề là thằng bé sẽ mất đầu nếu không... chờ đã."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WEBBER_SPIDER_MINION
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WEBBER_SPIDER_MINION"
msgid "Can you tell your friends not to get so close to me, kid?"
msgstr "Cậu có thể bảo bạn bè cậu đừng đến gần tôi như vậy không, nhóc?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WEED_IVY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WEED_IVY"
msgid "I don't like the look of that one."
msgstr "Tôi không ưa vẻ ngoài của cái cây đó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WENDY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WENDY.ATTACKER"
msgid "Woah there, slugger!"
msgstr "Bình tĩnh nào, nhóc võ sĩ!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WENDY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WENDY.FIRESTARTER"
msgid "Anythin' you wanna tell me about that fire, kiddo?"
msgstr "Cậu có muốn nói gì với tôi về vụ cháy đó không, nhóc?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WENDY.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WENDY.GENERIC"
msgid "Hey there, %s."
msgstr "Này, %s."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WENDY.GHOST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WENDY.GHOST"
msgid "I hope you left the other guy lookin' worse."
msgstr "Tôi hy vọng bạn đã để anh chàng kia trông tệ hơn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WENDY.MURDERER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WENDY.MURDERER"
msgid "She's not playin'! Murderer!"
msgstr "Cô ấy không chơi đâu! Kẻ giết người!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WENDY.REVIVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WENDY.REVIVER"
msgid "You got a sharp mind in that noggin, %s."
msgstr "Bạn có đầu óc sắc bén đấy, %s."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WENDY_RESURRECTIONGRAVE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WENDY_RESURRECTIONGRAVE"
msgid "Here lies... another crack at it."
msgstr "Nơi đây yên nghỉ... một lần thử nữa."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WEREITEM_BEAVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WEREITEM_BEAVER"
msgid "Huh. The craftsmanship ain't half bad."
msgstr "Hừm. Tay nghề cũng không tệ lắm."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WEREITEM_GOOSE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WEREITEM_GOOSE"
msgid "Does he hafta leave these creepy things lyin' around?"
msgstr "Anh ta cứ phải vứt mấy thứ rùng rợn này lung tung thế à?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WEREITEM_MOOSE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WEREITEM_MOOSE"
msgid "I ain't one for er... decorations."
msgstr "Tôi không phải là người thích... đồ trang trí."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WES.ATTACKER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WES.ATTACKER"
msgid "Didn't know ya had it in ya, %s!"
msgstr "Không ngờ cậu cũng máu chiến thế, %s!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WES.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WES.FIRESTARTER"
msgid "You responsible for that fire there, %s?"
msgstr "Bạn chịu trách nhiệm về vụ cháy đó, %s?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WES.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WES.GENERIC"
msgid "Don't worry %s, I can talk enough for two. Ha!"
msgstr "Đừng lo lắng %s, tôi có thể nói đủ cho hai người. Hà!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WES.GHOST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WES.GHOST"
msgid "Let's getcha back on your feet, %s."
msgstr "Để tôi giúp cậu đứng dậy nào, %s."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WES.MURDERER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WES.MURDERER"
msgid "Killer mime! I'll have nightmares tonight!"
msgstr "Kịch câm sát nhân! Tối nay tôi sẽ gặp ác mộng!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WES.REVIVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WES.REVIVER"
msgid "Thanks for the assist, %s."
msgstr "Cảm ơn sự hỗ trợ, %s."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WETGOOP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WETGOOP"
msgid "Yuck."
msgstr "Kinh quá."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WETPAPER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WETPAPER"
msgid "Is something written on it?"
msgstr "Có cái gì đó được viết trên đó?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WETPOUCH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WETPOUCH"
msgid "Hefty."
msgstr "Nặng nề."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WHIP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WHIP"
msgid "The preferred tool of the foreman."
msgstr "Công cụ ưa thích của quản đốc."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WICKERBOTTOM.ATTACKER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WICKERBOTTOM.ATTACKER"
msgid "Yeesh, that ol' librarian packs a punch!"
msgstr "Chà, bà thủ thư già đó ra đòn mạnh thật!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WICKERBOTTOM.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WICKERBOTTOM.FIRESTARTER"
msgid "A fire? Here I thought you were responsible, grams."
msgstr "Một đám cháy? Tôi cứ tưởng bà là người đứng đắn chứ, bà ơi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WICKERBOTTOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WICKERBOTTOM.GENERIC"
msgid "How's life treatin' ya, grams?"
msgstr "Dạo này thế nào rồi, bà?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WICKERBOTTOM.GHOST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WICKERBOTTOM.GHOST"
msgid "You're a tough one, %s, I'll give ya that."
msgstr "Bà cứng cỏi thật đấy, %s, phải công nhận."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WICKERBOTTOM.MURDERER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WICKERBOTTOM.MURDERER"
msgid "Watch out! Grams is on a rampage!"
msgstr "Coi chừng! Bà già đang nổi điên!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WICKERBOTTOM.REVIVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WICKERBOTTOM.REVIVER"
msgid "Don't worry grams, I won't read too much into it. Ha!"
msgstr "Đừng lo bà ơi, tôi không đọc vị gì nhiều đâu. Hà!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WILLOW.ATTACKER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WILLOW.ATTACKER"
msgid "Yer a workplace hazard, %s."
msgstr "Bạn là mối nguy hiểm ở nơi làm việc, %s."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WILLOW.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WILLOW.FIRESTARTER"
msgid "Business as usual."
msgstr "Vẫn như mọi khi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WILLOW.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WILLOW.GENERIC"
msgid "Good ta see ya, %s!"
msgstr "Gặp cậu vui quá, %s!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WILLOW.GHOST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WILLOW.GHOST"
msgid "Ha! You're a disaster, %s."
msgstr "Hà! Bạn là một thảm họa, %s."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WILLOW.MURDERER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WILLOW.MURDERER"
msgid "She's mad! Get'er!"
msgstr "Cô ta điên rồi! Bắt cô ta!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WILLOW.REVIVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WILLOW.REVIVER"
msgid "Knew I could count on you, %s."
msgstr "Tôi biết tôi có thể trông cậy vào bạn, %s."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WILLOW_EMBER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WILLOW_EMBER"
msgid "only_used_by_willow"
msgstr "only_used_by_willow"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WILSON.ATTACKER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WILSON.ATTACKER"
msgid "Hands to yourself, bucko!"
msgstr "Giữ tay cho yên, anh bạn!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WILSON.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WILSON.FIRESTARTER"
msgid "You better not have singed any of my projects, scientist."
msgstr "Tốt hơn là anh không nên đốt cháy những dự án của tôi, nhà khoa học."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WILSON.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WILSON.GENERIC"
msgid "Hey %s! How ya doin'?"
msgstr "Chào %s! Khỏe không?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WILSON.GHOST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WILSON.GHOST"
msgid "Stop whinin', %s, it's just a scratch!"
msgstr "Đừng than vãn nữa, %s, chỉ là vết xước thôi!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WILSON.MURDERER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WILSON.MURDERER"
msgid "Mad scientist! Get'em!"
msgstr "Nhà khoa học điên! Bắt hắn!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WILSON.REVIVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WILSON.REVIVER"
msgid "You're good people, scientist."
msgstr "Anh là người tốt, nhà khoa học."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINCH.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINCH.GENERIC"
msgid "Now that's a handy bit of machinery!"
msgstr "Đây đúng là món máy móc tiện dụng!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINCH.HOLDING_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINCH.HOLDING_ITEM"
msgid "All in a day's work."
msgstr "Chuyện thường ngày thôi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINCH.RETRIEVING_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINCH.RETRIEVING_ITEM"
msgid "Time to haul up the goods!"
msgstr "Đến lúc kéo hàng lên rồi!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA.ATTACKER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA.ATTACKER"
msgid "Ooo, I'm gonna disassemble you."
msgstr "Ồ, tôi sẽ tháo rời bạn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA.FIRESTARTER"
msgid "Haven't we lost enough to fires, %s?"
msgstr "Chúng ta chưa đủ tổn thất vì hỏa hoạn sao, %s?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA.GENERIC"
msgid "That's a good lookin' gal!"
msgstr "Đó là một cô gái xinh đẹp!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA.GHOST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA.GHOST"
msgid "That is not a good look on you, %s."
msgstr "Bộ dạng này không hợp với cậu đâu, %s."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA.MURDERER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA.MURDERER"
msgid "Pfft! I'd never murder so openly!"
msgstr "Pfft! Tôi sẽ không bao giờ giết người một cách công khai như vậy!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA.REVIVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA.REVIVER"
msgid "I owe ya one, %s."
msgstr "Tôi nợ bạn một lần, %s."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_BATTERY_HIGH.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_BATTERY_HIGH.BURNING"
msgid "Quick! Put it out!"
msgstr "Nhanh! Dập lửa đi!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_BATTERY_HIGH.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_BATTERY_HIGH.BURNT"
msgid "Criminy! My machine!"
msgstr "Trời đất ơi! Máy của tôi!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_BATTERY_HIGH.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_BATTERY_HIGH.GENERIC"
msgid "I don't get how gems work, I just know they do."
msgstr "Tôi không hiểu đá quý hoạt động thế nào, chỉ biết là chúng chạy được."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_BATTERY_HIGH.LOWPOWER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_BATTERY_HIGH.LOWPOWER"
msgid "Gonna need a top up soon."
msgstr "Sắp phải nạp thêm rồi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_BATTERY_HIGH.OFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_BATTERY_HIGH.OFF"
msgid "Needs a few more'a those gem thingies."
msgstr "Cần thêm vài viên đá quý nữa."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_BATTERY_HIGH.OVERLOADED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_BATTERY_HIGH.OVERLOADED"
msgid "Yikes! Better give it a minute to cool off!"
msgstr "Úi! Tốt nhất cho nó nghỉ một chút để nguội đã!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_BATTERY_LOW.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_BATTERY_LOW.BURNING"
msgid "Quick! Put it out!"
msgstr "Nhanh! Dập lửa đi!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_BATTERY_LOW.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_BATTERY_LOW.BURNT"
msgid "Aw, nuts and bolts!"
msgstr "Ôi, hỏng bét rồi!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_BATTERY_LOW.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_BATTERY_LOW.GENERIC"
msgid "That oughta do it."
msgstr "Thế là ổn rồi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_BATTERY_LOW.LOWPOWER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_BATTERY_LOW.LOWPOWER"
msgid "Just about out of juice."
msgstr "Sắp cạn điện rồi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_BATTERY_LOW.OFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_BATTERY_LOW.OFF"
msgid "Needs some more nitre."
msgstr "Cần thêm chút Diêm Tiêu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_CATAPULT.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_CATAPULT.BURNING"
msgid "Quick! Put it out!"
msgstr "Nhanh! Dập lửa đi!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_CATAPULT.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_CATAPULT.BURNT"
msgid "Aw, nuts and bolts!"
msgstr "Ôi, hỏng bét rồi!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_CATAPULT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_CATAPULT.GENERIC"
msgid "Not a bad result considering the materials."
msgstr "Một kết quả không tồi nếu xét đến chất liệu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_CATAPULT.OFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_CATAPULT.OFF"
msgid "Gotta hook it up to the generator."
msgstr "Phải nối nó với máy phát điện."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_CATAPULT.SLEEP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_CATAPULT.SLEEP"
msgid "Not a bad result considering the materials."
msgstr "Một kết quả không tồi nếu xét đến chất liệu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_HOLOTELEBRELLA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_HOLOTELEBRELLA"
msgid "I should give it a scan with the ol' Calibrated Perceiver."
msgstr "Tôi nên quét nó bằng cái Bộ Thu Nhận Hiệu Chỉnh cũ."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_HOLOTELEPAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_HOLOTELEPAD"
msgid "Looks like one of the boss's old designs. I should give it a scan."
msgstr "Trông giống như một trong những thiết kế cũ của ông chủ. Tôi nên quét nó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_MACHINEPARTS_1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_MACHINEPARTS_1"
msgid "You just can't get quality manufactured parts like this out here!"
msgstr "Bạn không thể có được những bộ phận được sản xuất chất lượng như thế này ở đây!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_MACHINEPARTS_2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_MACHINEPARTS_2"
msgid "Oh, I've got big plans for this."
msgstr "Ồ, tôi có kế hoạch lớn cho điều này."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_RECIPESCANNER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_RECIPESCANNER"
msgid "One scan with this Calibrated Perceiver, and I'll know how somethin's built!"
msgstr "Chỉ cần quét một lần bằng Bộ thu nhận đã hiệu chỉnh này và tôi sẽ biết thứ gì đó được tạo ra như thế nào!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_REMOTE.CHARGED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_REMOTE.CHARGED"
msgid "Charged and ready to go."
msgstr "Đã sạc và sẵn sàng."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_REMOTE.CHARGING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_REMOTE.CHARGING"
msgid "Needs some more time to charge."
msgstr "Cần thêm thời gian để sạc."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_REMOTE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_REMOTE.GENERIC"
msgid "It ain't magic, just some good engineering!"
msgstr "Chẳng phải phép thuật, chỉ là kỹ thuật giỏi thôi!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_REMOTE.OFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_REMOTE.OFF"
msgid "Gotta hook it up to the generator."
msgstr "Phải nối nó với máy phát điện."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_SPOTLIGHT.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_SPOTLIGHT.BURNING"
msgid "Quick! Put it out!"
msgstr "Nhanh! Dập lửa đi!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_SPOTLIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_SPOTLIGHT.BURNT"
msgid "Criminy! My machine!"
msgstr "Trời đất ơi! Máy của tôi!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_SPOTLIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_SPOTLIGHT.GENERIC"
msgid "Sorry, Charlie."
msgstr "Xin lỗi, Charlie."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_SPOTLIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_SPOTLIGHT.OFF"
msgid "Gotta hook it up to the generator."
msgstr "Phải nối nó với máy phát điện."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_SPOTLIGHT.SLEEP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_SPOTLIGHT.SLEEP"
msgid "Ready to go."
msgstr "Sẵn sàng đi thôi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_STORAGE_ROBOT.CHARGED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_STORAGE_ROBOT.CHARGED"
msgid "Charged and ready to go."
msgstr "Đã sạc và sẵn sàng."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_STORAGE_ROBOT.CHARGING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_STORAGE_ROBOT.CHARGING"
msgid "Needs some more time to charge."
msgstr "Cần thêm thời gian để sạc."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_STORAGE_ROBOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_STORAGE_ROBOT.GENERIC"
msgid "Nice to have a helpin' hand around here!"
msgstr "Thật tuyệt khi có một bàn tay giúp đỡ quanh đây!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_STORAGE_ROBOT.OFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_STORAGE_ROBOT.OFF"
msgid "Poor little guy, let's get you hooked up to some power."
msgstr "Tội nghiệp anh bạn nhỏ, để tôi cắm điện cho cậu nào."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_STORAGE_ROBOT.SLEEP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_STORAGE_ROBOT.SLEEP"
msgid "Take five, little guy!"
msgstr "Nghỉ tay chút đi, anh bạn nhỏ!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_TELEBRELLA.CHARGED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_TELEBRELLA.CHARGED"
msgid "Charged and ready to go."
msgstr "Đã sạc và sẵn sàng."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_TELEBRELLA.CHARGING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_TELEBRELLA.CHARGING"
msgid "Needs some more time to charge."
msgstr "Cần thêm thời gian để sạc."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_TELEBRELLA.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_TELEBRELLA.GENERIC"
msgid "I made a few adjustments to the bossman's design."
msgstr "Tôi đã thực hiện một số điều chỉnh đối với thiết kế của ông chủ."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_TELEBRELLA.MISSINGSKILL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_TELEBRELLA.MISSINGSKILL"
msgid "Interesting design, but above my pay grade..."
msgstr "Thiết kế thú vị, nhưng vượt quá mức lương của tôi..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_TELEBRELLA.OFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_TELEBRELLA.OFF"
msgid "Gotta hook it up to the generator."
msgstr "Phải nối nó với máy phát điện."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.BURNING"
msgid "Quick! Put it out!"
msgstr "Nhanh! Dập lửa đi!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.BURNT"
msgid "Aw, nuts and bolts!"
msgstr "Ôi, hỏng bét rồi!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.GENERIC"
msgid "Sure beats luggin' stuff around!"
msgstr "Đỡ hơn hẳn việc khuân vác đồ đạc khắp nơi!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.MISSINGSKILL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.MISSINGSKILL"
msgid "Interesting design, but above my pay grade..."
msgstr "Thiết kế thú vị, nhưng vượt quá mức lương của tôi..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.OFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.OFF"
msgid "I'd better hook it up to some power."
msgstr "Tôi nên kết nối nó với nguồn điện."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTERHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTERHAT"
msgid "Perfect for winters in the tenement house."
msgstr "Hoàn hảo cho mùa đông trong ngôi nhà chung cư."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTEROMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTEROMETER.BURNT"
msgid "Rest in peace, sweet gizmo."
msgstr "Yên nghỉ nhé, món đồ nghề thân yêu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTEROMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTEROMETER.GENERIC"
msgid "Assembling gadgets is so fulfilling."
msgstr "Việc lắp ráp các tiện ích thật là thỏa mãn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTERSFEASTFUEL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTERSFEASTFUEL"
msgid "This season always makes me think of Charlie."
msgstr "Mùa này luôn khiến tôi nghĩ đến Charlie."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTERSFEASTOVEN.ALMOST_DONE_COOKING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTERSFEASTOVEN.ALMOST_DONE_COOKING"
msgid "Smells like it's almost done."
msgstr "Có mùi như sắp xong rồi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTERSFEASTOVEN.COOKING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTERSFEASTOVEN.COOKING"
msgid "What's cookin', oven?"
msgstr "Đang nấu gì thế, lò nướng à?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTERSFEASTOVEN.DISH_READY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTERSFEASTOVEN.DISH_READY"
msgid "Mmmm mmmm! Good eatin'!"
msgstr "Ừm ừm ừm! Ăn ngon lắm!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTERSFEASTOVEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTERSFEASTOVEN.GENERIC"
msgid "A nice sturdy oven."
msgstr "Lò nướng đẹp chắc chắn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_FOOD1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_FOOD1"
msgid "I love these things!"
msgstr "Tôi mê món này lắm!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_FOOD2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_FOOD2"
msgid "No thanks, I'm sweet enough."
msgstr "Không, cảm ơn, tôi đủ ngọt ngào rồi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_FOOD3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_FOOD3"
msgid "Homemade. What a waste of time!"
msgstr "Tự chế. Thật là lãng phí thời gian!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_FOOD4
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_FOOD4"
msgid "Just terrible."
msgstr "Thật khủng khiếp."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_FOOD5
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_FOOD5"
msgid "Chocolatey."
msgstr "Đậm vị sô-cô-la."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_FOOD6
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_FOOD6"
msgid "Not my favorite thing."
msgstr "Không phải thứ tôi yêu thích"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_FOOD7
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_FOOD7"
msgid "That's the good stuff."
msgstr "Đúng là đồ ngon."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_FOOD8
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_FOOD8"
msgid "Don't burn your mouth."
msgstr "Cẩn thận bỏng miệng đấy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_FOOD9
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_FOOD9"
msgid "I know what eggs are, but what's a \"nog\"?"
msgstr "Tôi biết trứng là gì, nhưng \"nog\" là gì?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_ORNAMENT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_ORNAMENT"
msgid "Gotta be careful not to break it."
msgstr "Phải cẩn thận kẻo làm vỡ nó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_ORNAMENTBOSS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_ORNAMENTBOSS"
msgid "Fancy lil ornament."
msgstr "Món đồ trang trí nhỏ xinh sang chảnh."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_ORNAMENTFORGE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_ORNAMENTFORGE"
msgid "Reminds me of somthin'."
msgstr "Làm tôi nhớ đến điều gì đó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_ORNAMENTGORGE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_ORNAMENTGORGE"
msgid "Look at that fancy pants decoration."
msgstr "Nhìn món đồ trang trí điệu đà kìa."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_ORNAMENTLIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_ORNAMENTLIGHT"
msgid "Finally, something with wiring."
msgstr "Cuối cùng cũng có thứ có dây điện."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_ORNAMENTPEARL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_ORNAMENTPEARL"
msgid "Hope she's doin' alright."
msgstr "Hy vọng cô ấy ổn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_TREE.BURNING"
msgid "Such a shame."
msgstr "Tiếc thật."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_TREE.BURNT"
msgid "No reason we can't make another."
msgstr "Không có lý do gì chúng ta không thể làm một cái khác."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_TREE.CANDECORATE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_TREE.CANDECORATE"
msgid "Now that's a job well done."
msgstr "Thế này mới là làm việc đến nơi đến chốn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_TREE.YOUNG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_TREE.YOUNG"
msgid "Still a bit on the small side."
msgstr "Vẫn còn hơi nhỏ."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_TREESTAND.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_TREESTAND.BURNT"
msgid "Burnt."
msgstr "Cháy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_TREESTAND.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WINTER_TREESTAND.GENERIC"
msgid "Just needs a tree."
msgstr "Chỉ cần một cái cây."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOBSTER_DEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOBSTER_DEN"
msgid "Anyone home?"
msgstr "Có ai ở nhà không?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOBSTER_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOBSTER_MOONGLASS"
msgid "I don't trust those glassy eyes."
msgstr "Tôi không tin vào đôi mắt thủy tinh đó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOBSTER_SHELLER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOBSTER_SHELLER"
msgid "Hey little guy, you look like dinner!"
msgstr "Này anh bạn nhỏ, trông cậu giống bữa tối quá!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOBSTER_SHELLER_DEAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOBSTER_SHELLER_DEAD"
msgid "I think we got 'em."
msgstr "Tôi nghĩ ta tóm được nó rồi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOBSTER_SHELLER_DEAD_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOBSTER_SHELLER_DEAD_COOKED"
msgid "That's some good eatin'!"
msgstr "Ăn ngon lắm đó!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOBYBIG.1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOBYBIG.1"
msgid "Awful skittish for such a big gal."
msgstr "Đô con thế mà nhát ghê."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOBYBIG.2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOBYBIG.2"
msgid "Awful skittish for such a big gal."
msgstr "Đô con thế mà nhát ghê."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOBYSMALL.1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOBYSMALL.1"
msgid "Well, ain't you sweet!"
msgstr "Chà, bạn thật ngọt ngào phải không!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOBYSMALL.2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOBYSMALL.2"
msgid "Well, ain't you sweet!"
msgstr "Chà, bạn thật ngọt ngào phải không!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOBY_TREAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOBY_TREAT"
msgid "Aww, Miss Woby wanna biscuit?"
msgstr "Ôi, cô Woby muốn ăn bánh quy không?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOLFGANG.ATTACKER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOLFGANG.ATTACKER"
msgid "I wouldn't wanna catch the business end of those mitts!"
msgstr "Tôi chẳng muốn lãnh cú đấm từ đôi tay đó đâu!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOLFGANG.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOLFGANG.FIRESTARTER"
msgid "Was that fire an accident, %s?"
msgstr "Vụ cháy đó có phải là một tai nạn không, %s?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOLFGANG.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOLFGANG.GENERIC"
msgid "How you doin', big guy?"
msgstr "Anh khỏe không, anh chàng to lớn?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOLFGANG.GHOST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOLFGANG.GHOST"
msgid "Walk it off, big guy!"
msgstr "Rũ đi mà đứng dậy, anh bạn to xác!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOLFGANG.MURDERER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOLFGANG.MURDERER"
msgid "Watch out! He's got a taste fer blood now!"
msgstr "Coi chừng! Giờ anh ta đã nếm mùi máu rồi!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOLFGANG.REVIVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOLFGANG.REVIVER"
msgid "You're just a big softie, aintcha?"
msgstr "Anh đúng là to xác mà mềm lòng, nhỉ?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOLFGANG_WHISTLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOLFGANG_WHISTLE"
msgid "Whatcha need, coach?"
msgstr "Bạn cần gì vậy, huấn luyện viên?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WONKEY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WONKEY.ATTACKER"
msgid "Yeesh, calm down there fella!"
msgstr "Chà, bình tĩnh nào anh bạn!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WONKEY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WONKEY.FIRESTARTER"
msgid "How'd that monkey manage to start a fire?!"
msgstr "Làm sao con khỉ đó có thể nhóm lửa được?!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WONKEY.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WONKEY.GENERIC"
msgid "What a sweet lil monkey."
msgstr "Thật là một con khỉ nhỏ ngọt ngào."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WONKEY.GHOST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WONKEY.GHOST"
msgid "Got yourself in quite the mess now didn'tcha?"
msgstr "Bây giờ bạn đang gặp rắc rối lớn phải không?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WONKEY.MURDERER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WONKEY.MURDERER"
msgid "Yikes, guess yer a wild animal after all."
msgstr "Úi, hóa ra cậu vẫn là thú hoang."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WONKEY.REVIVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WONKEY.REVIVER"
msgid "You're a helpful monkey aren'tcha?"
msgstr "Cậu đúng là một con khỉ hữu ích phải không?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOODCARVEDHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOODCARVEDHAT"
msgid "Gotta keep the old noggin' safe on the work site."
msgstr "Phải giữ cái đầu an toàn ở công trường."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOODIE.ATTACKER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOODIE.ATTACKER"
msgid "Watch where you're swingin' that thing, %s!"
msgstr "Coi chừng chỗ cậu vung thứ đó, %s!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOODIE.BEAVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOODIE.BEAVER"
msgid "Well ain't that somethin'."
msgstr "Chà, ghê thật đấy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOODIE.BEAVERGHOST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOODIE.BEAVERGHOST"
msgid "You're just a walkin' disaster, ain'tcha, %s?"
msgstr "Cậu đúng là thảm họa biết đi, nhỉ %s?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOODIE.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOODIE.FIRESTARTER"
msgid "You're gonna start a forest fire, %s!"
msgstr "Bạn sắp gây cháy rừng, %s!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOODIE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOODIE.GENERIC"
msgid "You down ta chop some trees for me later, %s?"
msgstr "Lát nữa chặt ít cây giúp tôi nhé, %s?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOODIE.GHOST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOODIE.GHOST"
msgid "You're fine, %s, I've seen worse."
msgstr "Bạn ổn, %s, tôi đã thấy tệ hơn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOODIE.GOOSE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOODIE.GOOSE"
msgid "Don't even think about goosin' me!"
msgstr "Đừng có nghĩ đến việc chọc ghẹo tôi!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOODIE.GOOSEGHOST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOODIE.GOOSEGHOST"
msgid "Well if this ain't a fine feathered mess."
msgstr "Chà, đúng là một mớ lông lá hỗn độn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOODIE.MOOSE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOODIE.MOOSE"
msgid "Is this normal for you folks up North?"
msgstr "Điều này có bình thường đối với các bạn ở miền Bắc không?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOODIE.MOOSEGHOST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOODIE.MOOSEGHOST"
msgid "I'll getcha a heart, hold yer horses... er, mooses?"
msgstr "Tôi sẽ kiếm tim cho cậu, ghìm cương lại nào... ờ, ghìm sừng lại?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOODIE.MURDERER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOODIE.MURDERER"
msgid "Yikes! Axe murderer!"
msgstr "Úi! Sát nhân cầm rìu!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOODIE.REVIVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOODIE.REVIVER"
msgid "You're a good, honest guy, %s."
msgstr "Bạn là một chàng trai tốt, trung thực, %s."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOOD_CHAIR.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOOD_CHAIR.BURNT"
msgid "I ain't one to sit around anyway."
msgstr "Dù sao thì tôi cũng không phải là người ngồi yên một chỗ."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOOD_CHAIR.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOOD_CHAIR.GENERIC"
msgid "Looks sturdy enough."
msgstr "Nhìn đủ chắc chắn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOOD_CHAIR.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOOD_CHAIR.OCCUPIED"
msgid "Looks like that seat's spoken for."
msgstr "Có vẻ cái ghế đó có người ngồi rồi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOOD_TABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOOD_TABLE.BURNT"
msgid "A shame to see that craftsmanship go to waste."
msgstr "Tiếc thật khi thấy tay nghề như thế bị phí hoài."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOOD_TABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOOD_TABLE.GENERIC"
msgid "I don't care if it's fancy, just solidly built."
msgstr "Tôi không quan tâm nó có sang trọng hay không, chỉ cần được xây dựng kiên cố."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOOD_TABLE.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOOD_TABLE.HAS_ITEM"
msgid "It's doin' what tables do."
msgstr "Nó đang làm đúng việc của một cái bàn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORM.DIRT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORM.DIRT"
msgid "Mhm. That's dirt!"
msgstr "Ừm. Đất đấy!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORM.PLANT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORM.PLANT"
msgid "Nothing out of the ordinary."
msgstr "Không có gì khác thường."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORM.WORM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORM.WORM"
msgid "That's a huge worm!"
msgstr "Đó là một con sâu khổng lồ!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMHOLE.GENERIC"
msgid "I'm not one to shy away from a dirty job."
msgstr "Tôi không phải là người né tránh một công việc bẩn thỉu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMHOLE.OPEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMHOLE.OPEN"
msgid "Here we go!"
msgstr "Chúng ta đi đây!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMHOLE_LIMITED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMHOLE_LIMITED"
msgid "That thing can't take much more."
msgstr "Thứ đó chịu không nổi thêm bao lâu nữa đâu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMLIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMLIGHT"
msgid "It glows just as much on the way out, lemme tell you."
msgstr "Để tôi nói cho mà biết, lúc ra nó cũng sáng y như thế."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMLIGHT_LESSER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMLIGHT_LESSER"
msgid "This one's a bit shrivelly."
msgstr "Cái này hơi nhăn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMLIGHT_PLANT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMLIGHT_PLANT"
msgid "Nothing out of the ordinary."
msgstr "Không có gì khác thường."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMWOOD.ATTACKER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMWOOD.ATTACKER"
msgid "Yer on thin ice there, %s."
msgstr "Cậu đang đi trên băng mỏng đấy, %s."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMWOOD.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMWOOD.FIRESTARTER"
msgid "Watch where you're lightin' them fires!"
msgstr "Coi chừng chỗ cậu đốt lửa đấy!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMWOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMWOOD.GENERIC"
msgid "%s! How ya doin', ya big bean sprout?"
msgstr "%s! Khỏe không, cái giá đỗ to xác?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMWOOD.GHOST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMWOOD.GHOST"
msgid "You're not slackin' off, are ya?"
msgstr "Cậu không định lười biếng đấy chứ?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMWOOD.MURDERER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMWOOD.MURDERER"
msgid "Time to roll up my sleeves and pluck a few weeds!"
msgstr "Đã đến lúc xắn tay áo lên và nhổ một ít cỏ dại!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMWOOD.REVIVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMWOOD.REVIVER"
msgid "Keep up the good work there, bucko."
msgstr "Cứ tiếp tục làm tốt nhé, anh bạn."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.DEAD"
msgid "That don't look good."
msgstr "Điều đó có vẻ không tốt."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.GENERIC"
msgid "Yer an orange nuisance, aintcha?"
msgstr "Đồ màu cam phiền phức, nhỉ?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.HELD"
msgid "Aw, I can't stay mad at you."
msgstr "Ôi, tôi không thể giận bạn mãi được."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.SLEEPING"
msgid "Sleep tight."
msgstr "Ngủ ngon."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.GENERIC"
msgid "You play nice with the other lizards now, hey?"
msgstr "Chơi ngoan với mấy con thằn lằn khác nhé?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.RIPE"
msgid "Lookit you, all orange!"
msgstr "Nhìn kìa, toàn màu cam!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.SLEEPING"
msgid "I hope you earned that break."
msgstr "Mong là nhóc đã làm đủ việc để được nghỉ."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMWOOD_MUTANTPROXY_LIGHTFLIER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORMWOOD_MUTANTPROXY_LIGHTFLIER"
msgid "Doesn't even need a battery!"
msgstr "Thậm chí không cần pin!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORM_BOSS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORM_BOSS"
msgid "Now that's a big ol' worm."
msgstr "Đó là một con sâu to bự."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORTOX.ATTACKER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORTOX.ATTACKER"
msgid "Keep them claws to yourself, how about?!"
msgstr "Giữ móng vuốt cho riêng mình được không?!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORTOX.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORTOX.FIRESTARTER"
msgid "Were you plannin' on putting that fire out?"
msgstr "Bạn có định dập tắt đám cháy đó không?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORTOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORTOX.GENERIC"
msgid "Hey, %s! Heard any good jokes lately?"
msgstr "Này, %s! Dạo này nghe được chuyện cười nào hay không?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORTOX.GHOST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORTOX.GHOST"
msgid "Oof! You need a hand there, %s?"
msgstr "Ôi! Bạn cần giúp một tay, %s?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORTOX.MURDERER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORTOX.MURDERER"
msgid "Look out! %s is positively demonic!"
msgstr "Coi chừng! %s đúng là quỷ dữ!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORTOX.REVIVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORTOX.REVIVER"
msgid "Thanks for the assist there, %s."
msgstr "Cảm ơn sự hỗ trợ ở đó, %s."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORTOX_NABBAG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORTOX_NABBAG"
msgid "A lootin' he will go!"
msgstr "Anh ta sẽ đi cướp bóc!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORTOX_REVIVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORTOX_REVIVER"
msgid "Suppose he can just bring you right back if you croak."
msgstr "Chắc hắn có thể đưa cậu trở lại ngay nếu cậu ngỏm."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WORTOX_SOULJAR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WORTOX_SOULJAR"
msgid "Imagine gettin' your eternal soul stuffed into an imp's lunchbox. Yeesh."
msgstr "Tưởng tượng linh hồn vĩnh cửu của mình bị nhét vào hộp cơm trưa của một con quỷ. Eo ôi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WURT.ATTACKER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WURT.ATTACKER"
msgid "Sure you wanna do that, kiddo?"
msgstr "Chắc chắn cậu muốn làm điều đó phải không, nhóc?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WURT.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WURT.FIRESTARTER"
msgid "Hey, who let you play with that?!"
msgstr "Này, ai cho cậu chơi với cái đó thế?!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WURT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WURT.GENERIC"
