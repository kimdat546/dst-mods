#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MASK_MIRRORHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MASK_MIRRORHAT"
msgid "We can pretend to be somebody else!"
msgstr "Chúng ta có thể giả vờ là một người khác!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MASK_PRINCESSHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MASK_PRINCESSHAT"
msgid "That's a big party hat!"
msgstr "Đó là một chiếc mũ tiệc tùng lớn!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MASK_QUEENHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MASK_QUEENHAT"
msgid "We can pretend to be somebody else!"
msgstr "Chúng ta có thể giả vờ là một người khác!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MASK_SAGEHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MASK_SAGEHAT"
msgid "Ooooh, they'll never guess it's us!"
msgstr "Ooooh, họ sẽ không bao giờ đoán là chúng ta!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MASK_TOADYHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MASK_TOADYHAT"
msgid "We wanna try this one."
msgstr "Chúng tôi muốn thử cái này."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MASK_TREEHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MASK_TREEHAT"
msgid "We can pretend to be somebody else!"
msgstr "Chúng ta có thể giả vờ là một người khác!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAST
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAST"
msgid "Wow, it's MASTive!"
msgstr "Oa, cột buồm to vật vã!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MASTUPGRADE_LAMP_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MASTUPGRADE_LAMP_ITEM"
msgid "Now our boat has a light!"
msgstr "Bây giờ thuyền của chúng ta đã có đèn!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MASTUPGRADE_LAMP_ITEM_YOTD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MASTUPGRADE_LAMP_ITEM_YOTD"
msgid "Now our boat can have a light!"
msgstr "Bây giờ thuyền của chúng tôi có thể có một ánh sáng!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MASTUPGRADE_LAMP_YOTD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MASTUPGRADE_LAMP_YOTD"
msgid "We feel a lot better having a night light around."
msgstr "Chúng tôi cảm thấy tốt hơn rất nhiều khi có một ánh sáng ban đêm xung quanh."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MASTUPGRADE_LIGHTNINGROD_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MASTUPGRADE_LIGHTNINGROD_ITEM"
msgid "We feel safer already!"
msgstr "Chúng tôi cảm thấy an toàn hơn rồi!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAST_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAST_ITEM"
msgid "That's for building a mast."
msgstr "Đó là để xây dựng một cột buồm."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAST_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAST_MALBATROSS"
msgid "Our boat looks ready to fly away!"
msgstr "Thuyền của chúng ta có vẻ đã sẵn sàng bay đi!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAST_MALBATROSS_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAST_MALBATROSS_ITEM"
msgid "This will look great on our boat!"
msgstr "Điều này sẽ trông tuyệt vời trên thuyền của chúng tôi!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAST_YOTD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAST_YOTD"
msgid "We could look at those shimmery scales all day!"
msgstr "Chúng ta có thể ngắm những chiếc vảy lung linh kia cả ngày cũng được!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAST_YOTD_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAST_YOTD_ITEM"
msgid "That's for building a mast."
msgstr "Đó là để xây dựng một cột buồm."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAXWELL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAXWELL"
msgid "That jerk tricked us."
msgstr "Tên xấu xa đó đã lừa chúng tôi."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAXWELLHEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAXWELLHEAD"
msgid "Imagine the trouble he has buying hats!"
msgstr "Hãy tưởng tượng những rắc rối mà anh ấy gặp phải khi mua mũ!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAXWELLLIGHT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAXWELLLIGHT"
msgid "Well, these would've been handy before."
msgstr "Chà, giá mà có mấy cái này sớm hơn thì tiện rồi."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAXWELLLOCK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAXWELLLOCK"
msgid "It's missing something."
msgstr "Nó thiếu thứ gì đó."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAXWELLPHONOGRAPH
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAXWELLPHONOGRAPH"
msgid "We could listen to that forever!"
msgstr "Chúng ta có thể nghe điều đó mãi mãi!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAXWELLTHRONE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAXWELLTHRONE"
msgid "That throne makes our skin crawl."
msgstr "Cái ngai đó làm chúng tôi sởn gai ốc."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEAT"
msgid "Some fire would spice this up."
msgstr "Nướng lên thì ngon hơn."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATBALLS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATBALLS"
msgid "I used to make these with grandpa!"
msgstr "Tôi đã từng làm những món này với ông nội!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.BURNT"
msgid "Fire takes all."
msgstr "Lửa lấy đi tất cả."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.DONE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.DONE"
msgid "Food time!"
msgstr "Giờ ăn!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.DONE_NOTMEAT"
msgid "Food time!"
msgstr "Giờ ăn!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.DRYING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.DRYING"
msgid "Is it done yet? I'm hungry."
msgstr "Xong chưa? Tôi đói."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.DRYINGINRAIN"
msgid "It's hard to dry when it's raining."
msgstr "Thật khó để làm khô khi trời mưa."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT"
msgid "It's hard to dry when it's raining."
msgstr "Thật khó để làm khô khi trời mưa."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.DRYING_NOTMEAT"
msgid "Is it done yet? I'm hungry."
msgstr "Xong chưa? Tôi đói."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.GENERIC"
msgid "It's not doing us much good empty!"
msgstr "Để trống thì chẳng giúp gì được chúng tôi!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.BURNT"
msgid "It burned away."
msgstr "Nó cháy rụi."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.DONE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.DONE"
msgid "Ma'am! It's food time!"
msgstr "Thưa bà! Đã đến giờ ăn rồi!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.DONE_NOTMEAT"
msgid "Ma'am! It's food time!"
msgstr "Thưa bà! Đã đến giờ ăn rồi!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.DRYING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.DRYING"
msgid "Is it done yet?"
msgstr "Xong chưa?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN"
msgid "It's hard to dry when it's raining."
msgstr "Thật khó để làm khô khi trời mưa."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN_NOTMEAT"
msgid "It's hard to dry when it's raining."
msgstr "Thật khó để khô khi trời mưa."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.DRYING_NOTMEAT"
msgid "Is it done yet? I'm hungry."
msgstr "Xong chưa? Tôi đói."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.GENERIC"
msgid "Maybe we could share some meat?"
msgstr "Có lẽ chúng ta có thể chia sẻ một ít thịt?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT_MULTI.ABANDONED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT_MULTI.ABANDONED"
msgid "Aw, it's broken!"
msgstr "Ôi, nó hỏng rồi!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT_MULTI.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT_MULTI.BURNT"
msgid "It burned away."
msgstr "Nó cháy rụi."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE"
msgid "Ma'am! It's dry!"
msgstr "Thưa bà! Nó khô rồi!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_NOTMEAT"
msgid "Ma'am! It's dry!"
msgstr "Thưa bà! Nó khô rồi!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_SALT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_SALT"
msgid "We got salt!"
msgstr "Chúng tôi có muối!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING"
msgid "Is it done yet?"
msgstr "Thế là xong chưa?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN"
msgid "It's hard to dry when it's raining."
msgstr "Thật khó để khô khi trời mưa."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN_NOTMEAT"
msgid "It's hard to dry when it's raining."
msgstr "Thật khó để khô khi trời mưa."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING_NOTMEAT"
msgid "Is it done yet?"
msgstr "Thế là xong chưa?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT_MULTI.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT_MULTI.GENERIC"
msgid "We can dry so many things!"
msgstr "Chúng ta có thể sấy khô rất nhiều thứ!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATYSALAD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATYSALAD"
msgid "Is it meat or salad?"
msgstr "Đó là thịt hay salad?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEAT_DRIED"
msgid "That worked better than expected."
msgstr "Điều đó đã làm việc tốt hơn so với dự kiến."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEGAFLARE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEGAFLARE"
msgid "Ms. Wickerbottom says we shouldn't pick fights..."
msgstr "Cô Wickerbottom nói chúng ta không nên gây sự..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERM"
msgid "I would've thought they would bathe more often!"
msgstr "Tôi đã nghĩ rằng họ sẽ tắm rửa thường xuyên hơn!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMARMORHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMARMORHAT"
msgid "Merms only? No fair."
msgstr "Này! Thật không công bằng! Chỉ dành cho nhân ngư thôi sao?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMARMORUPGRADEDHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMARMORUPGRADEDHAT"
msgid "Merms only? No fair."
msgstr "Này! Thật không công bằng! Chỉ dành cho nhân ngư thôi sao?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMCORPSE.BURNING"
msgid "We know it's the right thing to do."
msgstr "Chúng tôi biết đó là điều đúng đắn để làm."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMCORPSE.GENERIC"
msgid "Maybe we could have been friends."
msgstr "Có lẽ chúng ta đã có thể là bạn bè."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMCORPSE.REVIVING"
msgid "Yikes!"
msgstr "Úi!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMGUARD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMGUARD"
msgid "They look pretty scary!"
msgstr "Chúng trông khá đáng sợ!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMGUARD_LUNAR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMGUARD_LUNAR"
msgid "Are the merms sick?"
msgstr "Người cá có bị bệnh không?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMGUARD_SHADOW
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMGUARD_SHADOW"
msgid "We've been starting to get a little worried about Wurt..."
msgstr "Chúng ta đã bắt đầu lo lắng về Wurt..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMHAT"
msgid "Hopefully they don't notice the extra legs."
msgstr "Hy vọng họ không chú ý đến những chiếc chân thừa."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMHEAD.BURNT"
