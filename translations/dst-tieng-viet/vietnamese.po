msgstr "Bây giờ bạn sẽ biết được sức mạnh của Wolfgang!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOLE.HELD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOLE.HELD"
