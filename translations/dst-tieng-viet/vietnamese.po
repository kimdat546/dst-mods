msgstr "Ít nhất chúng không phải là sâu thực sự."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT"
msgid "Can I... help set up the carnival?"
msgstr "Tôi có thể... giúp tổ chức lễ hội được không?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST"
msgid "It's a little door."
msgstr "Đó là một cánh cửa nhỏ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC"
msgid "It wants something first... something shiny."
msgstr "Nó muốn thứ gì đó trước... thứ gì đó lấp lánh."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING"
msgid "What a funny game."
msgstr "Thật là một trò chơi vui nhộn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_GOLFBALL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_GOLFBALL"
msgid "It never chooses where it goes. Few things do."
msgstr "Nó chẳng bao giờ được chọn nơi mình đi. Hiếm thứ gì được chọn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_GOLFCLUB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_GOLFCLUB"
msgid "This will do the job."
msgstr "Thứ này sẽ làm được việc."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_DIY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_DIY"
msgid "What should we do, Abigail?"
msgstr "Chúng ta nên làm gì đây, Abigail?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_EASY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_EASY"
msgid "We all start somewhere."
msgstr "Ai cũng phải bắt đầu từ đâu đó."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_HARD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_HARD"
msgid "Not for the faint of heart."
msgstr "Không dành cho kẻ yếu tim."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_MEDIUM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_GOLFGAME_KIT_MEDIUM"
