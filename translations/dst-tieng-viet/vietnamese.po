#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROBIN_WINTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROBIN_WINTER.GENERIC"
msgid "She ain't bothering no one."
msgstr "Cô ấy không làm phiền ai cả."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROBIN_WINTER.HELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROBIN_WINTER.HELD"
