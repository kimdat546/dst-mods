#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DREADSTONEHAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DREADSTONEHAT"
msgid "My head feels safer already."
msgstr "Đầu tôi cảm thấy an toàn hơn rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DREADSTONE_STACK
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DREADSTONE_STACK"
msgid "More of that curious stone."
msgstr "Thêm loại đá kỳ lạ đó."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRIFTWOOD_LOG
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRIFTWOOD_LOG"
msgid "It's surprisingly light."
msgstr "Nó nhẹ một cách đáng ngạc nhiên."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRIFTWOOD_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRIFTWOOD_TREE.BURNING"
msgid "Driftwood en flambé!"
msgstr "Gỗ trôi dạt en flambé!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRIFTWOOD_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRIFTWOOD_TREE.BURNT"
msgid "Charred to a crisp."
msgstr "Được nướng giòn."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRIFTWOOD_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRIFTWOOD_TREE.CHOPPED"
