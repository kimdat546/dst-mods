msgstr "Đó là một hạt giống."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.POND
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.POND"
msgid "I can't see the bottom!"
msgstr "Tôi không thấy đáy!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PONDEEL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PONDEEL"
