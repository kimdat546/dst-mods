msgstr "Bleh. Hôi quá."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.GENERIC"
msgid "Ready for picking!"
msgstr "Hái được rồi!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.PICKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.PICKED"
