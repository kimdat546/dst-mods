msgstr "Bài này chẳng thư giãn chút nào."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RECORD_DAWN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RECORD_DAWN"
