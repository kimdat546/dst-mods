msgstr "Ước gì trời mưa ra cá, chứ đừng chỉ mưa như trút."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_HERMIT_SNOW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_HERMIT_SNOW"
