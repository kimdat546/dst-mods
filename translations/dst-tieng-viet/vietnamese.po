msgstr "Nghe là muốn nhịp chân theo!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RECORD_DANGER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RECORD_DANGER"
