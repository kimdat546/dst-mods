msgstr "Nó quá ướt để có thể cháy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HUTCH_FISHBOWL.WAITING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HUTCH_FISHBOWL.WAITING"
msgid "It's still too wet to burn."
msgstr "Nó vẫn còn quá ướt để có thể cháy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICE"
