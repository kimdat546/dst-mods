msgstr "Tôi đã biết đến lúc chìm nhiều hơn lúc nổi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_GOLFPROP_SPINNER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_GOLFPROP_SPINNER"
