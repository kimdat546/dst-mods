msgstr "Chúng ta sắp hết thời gian rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR"
msgid "We don't think the kitcoons would go this far out..."
msgstr "Chúng tôi không nghĩ lũ mèo con sẽ đi xa đến thế..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN"
msgid "We're back in the kitcoon's playground."
msgstr "Chúng mình quay lại sân chơi của Mèo Trúc Con rồi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN"
msgid "Let's work together to find those kitcoons!"
msgstr "Hãy cùng nhau tìm kiếm những chú mèo con đó nhé!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDEANDSEEK_START
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDEANDSEEK_START"
msgid "Ready or not, here we come!"
msgstr "Sẵn sàng hay chưa, chúng tôi đến đây!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KLAUS_CALLFORHELP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KLAUS_CALLFORHELP"
msgid "Uh-oh, its got friends coming!"
msgstr "Ối, nó gọi bạn nó đến kìa!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KLAUS_ENRAGE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KLAUS_ENRAGE"
msgid "Ah! I'm sorry we killed your deer!!"
msgstr "Ah! Tôi xin lỗi vì chúng tôi đã giết con nai của bạn!!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KLAUS_UNCHAINED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KLAUS_UNCHAINED"
msgid "Its belly looks hungry!"
msgstr "Bụng nó trông đói quá!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KNOCKEDOUT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KNOCKEDOUT"
msgid "Ow, our head!"
msgstr "Ui, đầu của chúng mình!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED"
msgid "We're invincible!"
msgstr "Chúng tôi đang bất khả chiến bại!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LIGHTSOUT_SHADOWHAND
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LIGHTSOUT_SHADOWHAND"
msgid "Hey, no fair! Nobody invited that hand to play!"
msgstr "Này, không công bằng! Có ai mời tay đó chơi đâu!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LOWRESEARCH
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LOWRESEARCH"
msgid "That might've taught a toddler something."
msgstr "Cái đó chắc chỉ dạy được trẻ mới biết đi thôi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LUNARGUARDIAN_INCOMING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LUNARGUARDIAN_INCOMING"
msgid "The giant ball is back."
msgstr "Quả bóng khổng lồ đã trở lại."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LUNARHAIL_BIRD_CORPSES
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LUNARHAIL_BIRD_CORPSES"
msgid "Maybe they're coming down for a rest."
msgstr "Có lẽ họ đang xuống để nghỉ ngơi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS"
msgid "Those birds don't sound happy."
msgstr "Những con chim đó có vẻ không vui chút nào."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LUNAR_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LUNAR_RIFT_MAX"
msgid "We can see something glowing waaay over there!"
msgstr "Chúng ta có thể thấy thứ gì đó đang phát sáng ở đằng kia!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MEGA_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MEGA_FLARE_SEEN"
msgid "Uh-oh, that bright light's attracting a lot of attention..."
msgstr "Uh-oh, ánh sáng rực rỡ đó đang thu hút rất nhiều sự chú ý..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MITEGLAND_DEBUFF.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MITEGLAND_DEBUFF.1"
msgid "Our tummy's all burny!"
msgstr "Bụng chúng mình nóng rát hết cả!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MITEGLAND_DEBUFF.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MITEGLAND_DEBUFF.2"
msgid "We REALLY shouldn't have eaten that..."
msgstr "Chúng mình THẬT SỰ không nên ăn cái đó..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MITEGLAND_DEBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MITEGLAND_DEBUFF_DONE"
msgid "Our tummy is finally feeling better."
msgstr "Bụng chúng mình cuối cùng cũng đỡ rồi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MONKEY_CURSE_1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MONKEY_CURSE_1"
msgid "We feel weird... weirder than usual..."
msgstr "Chúng tôi cảm thấy kỳ lạ... kỳ lạ hơn bình thường..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MONKEY_CURSE_CHANGE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MONKEY_CURSE_CHANGE"
msgid "What? How...? Now we're really confused..."
msgstr "Cái gì? Làm sao...? Bây giờ chúng tôi thực sự bối rối..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MONKEY_CURSE_CHANGEBACK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MONKEY_CURSE_CHANGEBACK"
msgid "We're us again!"
msgstr "Chúng ta lại là chúng ta!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW"
msgid "Almost!"
msgstr "Sắp được rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.GLASS_MED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.GLASS_MED"
msgid "We'll get you out."
msgstr "Chúng tôi sẽ đưa bạn ra ngoài."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL"
msgid "You're free!"
msgstr "Bạn được tự do rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW"
msgid "Almost!"
msgstr "Sắp được rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.IDOL_MED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.IDOL_MED"
msgid "We'll get you out."
msgstr "Chúng tôi sẽ đưa bạn ra ngoài."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL"
msgid "You're free!"
msgstr "Bạn được tự do rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.SEED_LOW
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.SEED_LOW"
msgid "Almost!"
msgstr "Sắp được rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.SEED_MED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.SEED_MED"
msgid "We'll get you out."
msgstr "Chúng tôi sẽ đưa bạn ra ngoài."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL"
msgid "You're free!"
msgstr "Bạn được tự do rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONPOTION_FAILED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONPOTION_FAILED"
msgid "Whoops!"
msgstr "Úi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOSQUITOS"
msgid "Suck someone else's blood!"
msgstr "Đi hút máu người khác đi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "Our hairy friend is hurt!"
msgstr "Người bạn lông lá của chúng mình bị thương rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL"
msgid "Buzzards! Hey, they look strange."
msgstr "Chim ó! Này, chúng trông lạ quá."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERGIFT"
msgid "We'll open it later as a celebration of surviving this!"
msgstr "Chúng tôi sẽ mở nó sau để kỷ niệm việc sống sót sau chuyện này!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERSIESTA
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERSIESTA"
msgid "Can't nap with monsters nearby!"
msgstr "Có quái vật gần đây thì ngủ trưa sao được!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERSLEEP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERSLEEP"
msgid "Can't sleep with monsters nearby!"
msgstr "Có quái vật gần đây thì ngủ sao được!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODAYSLEEP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODAYSLEEP"
msgid "It's daytime, not bedtime."
msgstr "Đang là ban ngày, chưa phải giờ ngủ."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "We're not ready for bed."
msgstr "Chúng mình chưa muốn đi ngủ."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOHUNGERSIESTA"
msgid "Won't be able to nap with a rumbling tummy."
msgstr "Bụng sôi ùng ục thì ngủ trưa sao được."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOHUNGERSLEEP"
msgid "Our tummy is rumbling, we can't sleep."
msgstr "Bụng chúng tôi cồn cào, chúng tôi không thể ngủ được."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOMOUNTEDGIFT"
msgid "I promise I'll ride you again after I open my present!"
msgstr "Tôi hứa sẽ cưỡi bạn lần nữa sau khi tôi mở quà!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NONIGHTSIESTA"
msgid "We can't take a nap, it's nighttime!"
msgstr "Chúng mình không ngủ trưa được, trời tối rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "No naps til daybreak!"
msgstr "Không ngủ trưa cho tới sáng!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOPUMPKINCARVINGONFIRE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOPUMPKINCARVINGONFIRE"
msgid "Haha! Again!"
msgstr "Haha! Lại nữa rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT"
msgid "We can't sleep with such a bright nightlight..."
msgstr "Chúng ta không thể ngủ với ánh đèn đêm sáng như vậy..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOSLEEPONFIRE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOSLEEPONFIRE"
msgid "Mum always said \"Don't sleep in a burning building.\""
msgstr "Mẹ luôn nói \"Đừng ngủ trong tòa nhà đang cháy\"."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOWARDROBEONFIRE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOWARDROBEONFIRE"
msgid "I can't! It's all burny!"
msgstr "Tôi không làm được! Nó đang cháy hết rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NO_ABIGAIL_FLOWER
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NO_ABIGAIL_FLOWER"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NO_TRAP"
msgid "Easy peasy."
msgstr "Dễ ợt."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_BADCAST
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_BADCAST"
msgid "Whoops! Let's try that again."
msgstr "Rất tiếc! Hãy thử lại lần nữa."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_GOTAWAY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_GOTAWAY"
msgid "Aww, it got away..."
msgstr "Ối, nó chạy mất rồi..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1"
msgid "Was that a nibble? Nope."
msgstr "Đó có phải là một cú cắn không? Không."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2"
msgid "Come on out, fishies!"
msgstr "Hãy ra ngoài đi, các chú cá!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3"
msgid "This is getting kinda boring..."
msgstr "Chuyện này đang dần trở nên nhàm chán..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4"
msgid "I thought fishing would be a bit more exciting."
msgstr "Tôi nghĩ việc câu cá sẽ thú vị hơn một chút."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_LINESNAP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_LINESNAP"
msgid "Ah! Aww, our line snapped..."
msgstr "A! Ôi, dây câu của chúng mình đứt rồi..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_LINETOOLOOSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_LINETOOLOOSE"
msgid "Should we reel it in a bit?"
msgstr "Chúng ta có nên cuộn nó lại một chút không?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING"
msgid "Don't eat us!"
msgstr "Đừng ăn chúng tôi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OFF_SCRIPT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OFF_SCRIPT"
msgid "Is that how the play is supposed to go?"
msgstr "Đó có phải là cách mà vở kịch được cho là diễn ra?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OTTERBOAT_DENBROKEN
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OTTERBOAT_DENBROKEN"
msgid "We really shouldn't have broken that den!"
msgstr "Chúng ta thực sự không nên phá cái tổ đó!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS"
msgid "Uh-oh... maybe we shouldn't have rowed out so far."
msgstr "Uh-oh... có lẽ chúng ta không nên chèo xa đến thế."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PECKED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PECKED"
msgid "Bad bird!"
msgstr "Chim hư!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PETRIFED_TREES
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PETRIFED_TREES"
msgid "The trees are yelling at us!!"
msgstr "Cây đang hét lên với chúng tôi !!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PICK_DISEASE_WARNING"
msgid "Yuck!"
msgstr "Kinh quá!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PIRATES_ARRIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PIRATES_ARRIVE"
msgid "Uh oh... we're not sure we like the sound of that."
msgstr "Ối... chúng mình không thích tiếng đó chút nào."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PLANT_RANDOMSEED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PLANT_RANDOMSEED"
msgid "We can't wait to see what it is!"
msgstr "Chúng mình nóng lòng muốn xem nó là gì quá!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PLANT_RESEARCHED.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PLANT_RESEARCHED.1"
msgid "We're learning so much about this plant!"
msgstr "Chúng tôi đang tìm hiểu rất nhiều về loại cây này!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_POCKETWATCH_PORTAL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_POCKETWATCH_PORTAL"
msgid "Wheeeeee--OOF!"
msgstr "Wheeeee--OOF!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PREFALLINVOID
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PREFALLINVOID"
msgid "Let's get out of here!"
msgstr "Ra khỏi đây thôi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_QUAKE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_QUAKE"
msgid "I don't think that was our tummy."
msgstr "Tôi không nghĩ đó là âm thanh của dạ dày của chúng tôi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT"
msgid "Aw, wrong spot!"
msgstr "Ôi, sai chỗ rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_AGGRESSIVE"
msgid "We hear something coming! And it sounds grouchy!"
msgstr "Chúng ta nghe thấy gì đó đang đến! Và có vẻ khó chịu!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_LUCKY"
msgid "We see a weird rabbit!"
msgstr "Chúng ta nhìn thấy một con thỏ kỳ lạ!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_LUCKYCAUGHT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_LUCKYCAUGHT"
msgid "We caught it!"
msgstr "Bắt được nó rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_PASSIVE"
msgid "Something's burrowing around us!"
msgstr "Có gì đó đang đào quanh chúng ta!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REPELLED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REPELLED"
msgid "We can't hit it."
msgstr "Chúng ta không thể đánh nó."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RESEARCH
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RESEARCH"
msgid "It's almost like being back in school."
msgstr "Nó gần giống như được trở lại trường học."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVED_FROM_CORPSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVED_FROM_CORPSE"
msgid "All better!"
msgstr "Khỏe rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVED_OTHER_CORPSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVED_OTHER_CORPSE"
msgid "There you go!"
msgstr "Xong rồi đó!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVING_CORPSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVING_CORPSE"
msgid "Hold on, we'll help!"
msgstr "Đợi đã, chúng tôi sẽ giúp!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY.1"
msgid "Our Liege!"
msgstr "Bệ hạ của chúng mình!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY.2"
msgid "Nice crown!"
msgstr "Vương miện đẹp đấy!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY.3"
msgid "Your wish is our command!"
msgstr "Mong muốn của ngài là mệnh lệnh của chúng mình!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY_JOKER.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY_JOKER.1"
msgid "Our \"Liege\"!"
msgstr "\"Bệ hạ\" của chúng mình!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY_JOKER.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY_JOKER.2"
msgid "Nice \"crown\"!"
msgstr "\"Vương miện\" đẹp đấy!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY_JOKER.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY_JOKER.3"
msgid "Tell us a joke!"
msgstr "Hãy kể cho chúng tôi một câu chuyện cười!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RUINS_RESET
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RUINS_RESET"
msgid "Everything's back!"
msgstr "Mọi thứ đã trở lại!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SACREDCHEST_NO
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SACREDCHEST_NO"
msgid "But those were presents!"
msgstr "Nhưng đó là những món quà!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SACREDCHEST_YES
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SACREDCHEST_YES"
msgid "It likes us!"
msgstr "Nó thích chúng tôi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SCRAPBOOK_FULL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SCRAPBOOK_FULL"
msgid "We already filled up our scrapbook."
msgstr "Chúng mình đã dán đầy sổ lưu niệm rồi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SECURITY_PULSE_FOLLOWING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SECURITY_PULSE_FOLLOWING"
msgid "Hey! It's following us!"
msgstr "Ơ! Nó đang đi theo chúng mình!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHADOWTHRALL_STEALTH
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHADOWTHRALL_STEALTH"
msgid "Ouch! No fair! We can't see you!"
msgstr "Á! Không công bằng! Chúng ta không thể thấy bạn!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHADOW_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHADOW_RIFT_MAX"
msgid "What was that creepy light?"
msgstr "Ánh sáng đáng sợ đó là gì?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHELTER
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHELTER"
msgid "Protect us, tree!"
msgstr "Bảo vệ chúng ta, cây!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SISTURN_FULL_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SISTURN_FULL_BLOSSOM"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SISTURN_FULL_EVIL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SISTURN_FULL_EVIL"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNARED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNARED"
msgid "Hey! Meanie!"
msgstr "Này! Đồ xấu tính!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNARED_IVY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNARED_IVY"
msgid "Hey! Let go!"
msgstr "Này! Buông ra!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNOWBALL_NO_SNOW
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNOWBALL_NO_SNOW"
msgid "Where's more snow?"
msgstr "Tuyết đâu nữa rồi?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNOWBALL_TOO_BIG
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNOWBALL_TOO_BIG"
msgid "We can't roll it any bigger!"
msgstr "Chúng mình không lăn nó to hơn được nữa!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SOAKED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SOAKED"
msgid "We're drenched!"
msgstr "Chúng tôi đang ướt đẫm!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SPOOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SPOOKED"
msgid "Hey, that's not nice!"
msgstr "Này, điều đó không hay chút nào!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.1"
msgid "Hi plants! How do you do today?"
msgstr "Chào cây! Hôm nay bạn khoẻ không?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.2"
msgid "Aww, are you lonely? We'll keep you company!"
msgstr "Ôi, bạn có cô đơn không? Chúng mình sẽ ở bên bạn!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.3"
msgid "One day you're going to grow up big and strong... and then we'll eat you!"
msgstr "Một ngày nào đó bạn sẽ lớn lên to khỏe... và rồi chúng mình sẽ ăn bạn!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.4
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.4"
msgid "You are a very good plant."
msgstr "Bạn là một cây rất tốt."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.5
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.5"
msgid "We're always here when you need somebody to talk to!"
msgstr "Chúng tôi luôn ở đây khi bạn cần ai đó trò chuyện!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_THORNS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_THORNS"
msgid "Yowch!"
msgstr "Á đau!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_THURIBLE_OUT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_THURIBLE_OUT"
msgid "Aw, there goes our lure."
msgstr "Ôi, mồi nhử của chúng mình tắt mất rồi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_ABANDONED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_ABANDONED"
msgid "We felt like using him was a bit like cheating anyway."
msgstr "Dù sao thì chúng tôi cũng cảm thấy việc sử dụng anh ấy giống như gian lận."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_DEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_DEAD"
msgid "Oh no... where are we supposed to go now?"
msgstr "Ôi không... giờ chúng ta phải đi đâu đây?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_GET_LEADER_ATTENTION
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_GET_LEADER_ATTENTION"
msgid "They want to get back to finding the kitcoons."
msgstr "Nó muốn quay lại tìm Mèo Trúc Con."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_LOST_KITCOON
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_LOST_KITCOON"
msgid "Either someone else found them, or this one is a lot tinier."
msgstr "Hoặc là người khác đã tìm thấy chúng, hoặc cái này nhỏ hơn nhiều."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_NEAR_KITCOON
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_NEAR_KITCOON"
msgid "We must be getting close!"
msgstr "Chắc hẳn chúng ta đã đến gần rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_NOTHING_TO_TRACK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_NOTHING_TO_TRACK"
msgid "Doesn't look like he found any clues here."
msgstr "Có vẻ như anh ta không tìm thấy bất kỳ manh mối nào ở đây."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_START_TRACKING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_START_TRACKING"
msgid "Wow! He's leading us right to the kitcoons! ...Is that cheating?"
msgstr "Ồ! Anh ấy đang dẫn chúng ta tới chỗ lũ mèo con! ...Đó có phải là gian lận không?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_WAITING_FOR_LEADER
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_WAITING_FOR_LEADER"
msgid "We should stay close to him."
msgstr "Chúng ta nên ở gần anh ấy."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOADESCAPED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOADESCAPED"
msgid "Aww, the frog left!"
msgstr "Ôi, con ếch bỏ đi rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOADESCAPING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOADESCAPING"
msgid "It's looking around for a way out."
msgstr "Nó đang tìm lối thoát."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOOL_SLIP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOOL_SLIP"
msgid "Hey! We were using that!"
msgstr "Này! Chúng mình đang dùng mà!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOOL_TOOWEAK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOOL_TOOWEAK"
msgid "We don't think this tool's strong enough!"
msgstr "Chúng tôi không nghĩ công cụ này đủ mạnh!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TORCH_OUT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TORCH_OUT"
msgid "Waah, our light went out!"
msgstr "Oa, đèn của chúng mình tắt rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOWNPORTALTELEPORT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOWNPORTALTELEPORT"
msgid "We're here!"
msgstr "Tới nơi rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TRAP_WENT_OFF
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TRAP_WENT_OFF"
msgid "Eek!"
msgstr "Eek!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_UNIMPLEMENTED"
msgid "Gah! It needs more time."
msgstr "Gah! Nó cần nhiều thời gian hơn."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_VAULT_SHADOW_ASSIST
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_VAULT_SHADOW_ASSIST"
msgid "Aw, they're helping us!"
msgstr "Ô, họ đang giúp chúng mình kìa!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_VAULT_TELEPORTER_DOES_NOTHING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_VAULT_TELEPORTER_DOES_NOTHING"
msgid "Hey, we're still here!"
msgstr "Này, chúng ta vẫn ở đây!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WASHED_ASHORE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WASHED_ASHORE"
msgid "Our fur is soaking wet!"
msgstr "Lông của chúng tôi ướt sũng!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WEAK_RAT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WEAK_RAT"
msgid "We don't think it can race anymore..."
msgstr "Chúng tôi không nghĩ nó có thể đua được nữa..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WEAPON_TOOWEAK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WEAPON_TOOWEAK"
msgid "We need something stronger!"
msgstr "Chúng ta cần thứ gì đó mạnh mẽ hơn!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WEIGHT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WEIGHT"
msgid "Weight: {weight}"
msgstr "Trọng lượng: {weight}"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WEIGHT_HEAVY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WEIGHT_HEAVY"
msgid "Weight: {weight}\nWoah, that's heavy!"
msgstr "Trọng lượng: {weight}\nWoah, nặng quá!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WENDY_BABYSITTER_SET
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WENDY_BABYSITTER_SET"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WENDY_BABYSITTER_STOP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WENDY_BABYSITTER_STOP"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WET
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WET"
msgid "We're unpleasantly moist."
msgstr "Chúng tôi ẩm ướt một cách khó chịu."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WETTER
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WETTER"
msgid "Wet as a bathtub we can't crawl out of."
msgstr "Ướt như rơi vào bồn tắm mà không bò ra được."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WINCH_CLAW_MISS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WINCH_CLAW_MISS"
msgid "Oops! We missed it."
msgstr "Úi! Trượt mất rồi."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WINCH_CLAW_NO_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WINCH_CLAW_NO_ITEM"
msgid "Aww... nothing."
msgstr "À... không có gì."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WINTERS_FEAST_BUFF
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WINTERS_FEAST_BUFF"
msgid "Hey! Everything's all sparkly!"
msgstr "Này! Mọi thứ lấp lánh hết cả!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WINTERS_FEAST_BUFF_OVER
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WINTERS_FEAST_BUFF_OVER"
msgid "Aww, we were having fun!"
msgstr "Aww, chúng tôi đã rất vui vẻ!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_BEGIN_COACHING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_BEGIN_COACHING"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_END_COACHING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_END_COACHING"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_MIGHTY_COACHING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_MIGHTY_COACHING"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_NOTEAM.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_NOTEAM.1"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_NOTEAM.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_NOTEAM.2"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_NOTEAM.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_NOTEAM.3"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_WIMPY_COACHING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_WIMPY_COACHING"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORMHOLE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORMHOLE"
msgid "That was a scary hole!"
msgstr "Cái lỗ đó đáng sợ ghê!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORMS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORMS"
msgid "Ohhh nooo. We're not friends with worms!"
msgstr "Ôi không. Chúng ta không phải là bạn với sâu bọ!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORMS_BOSS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORMS_BOSS"
msgid "Yikes! Here comes a BIG worm!"
msgstr "Ối! Con sâu TO đang đến!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT"
msgid "Weeeee! Huh?"
msgstr "Úi chà! Hả?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WX_SCANNER_NEW_FOUND
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WX_SCANNER_NEW_FOUND"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_YOTB_LEARN_NEW_PATTERN
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_YOTB_LEARN_NEW_PATTERN"
msgid "We can't wait for our beefalo to try it on!"
msgstr "Chúng mình nóng lòng cho Bò Lai mặc thử quá!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_YOTD_NOBOATS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_YOTD_NOBOATS"
msgid "We're not close enough to the starting point!"
msgstr "Chúng ta không gần tới điểm xuất phát!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_YOTD_NOCHECKPOINTS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_YOTD_NOCHECKPOINTS"
msgid "Oops! We forgot to set up the checkpoints!"
msgstr "Úi! Chúng mình quên dựng các điểm kiểm soát rồi!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_YOTD_NOTENOUGHBOATS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_YOTD_NOTENOUGHBOATS"
msgid "We should make some room, in case somebody wants to join in!"
msgstr "Nên chừa chỗ, phòng khi có ai muốn tham gia!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_YOTH_ONCOOLDOWN
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_YOTH_ONCOOLDOWN"
msgid "Aw, those horses must be doing chores right now."
msgstr "Ôi, mấy con ngựa đó chắc chắn đang làm việc nhà."

#. STRINGS.CHARACTERS.WEBBER.ANOUNCE_MUTATED_BIRD_ATTACK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANOUNCE_MUTATED_BIRD_ATTACK"
msgid "Watch out for the birds!"
msgstr "Hãy cẩn thận với những con chim!"

#. STRINGS.CHARACTERS.WEBBER.BATTLECRY.DEER
msgctxt "STRINGS.CHARACTERS.WEBBER.BATTLECRY.DEER"
msgid "Hopefully we're venomous!"
msgstr "Hy vọng chúng ta có nọc độc!"

#. STRINGS.CHARACTERS.WEBBER.BATTLECRY.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.BATTLECRY.GENERIC"
msgid "En garde!"
msgstr "Xem chiêu!"

#. STRINGS.CHARACTERS.WEBBER.BATTLECRY.PIG
msgctxt "STRINGS.CHARACTERS.WEBBER.BATTLECRY.PIG"
msgid "We hate it! Horrible pig!"
msgstr "Chúng mình ghét nó! Con lợn đáng ghét!"

#. STRINGS.CHARACTERS.WEBBER.BATTLECRY.PREY
msgctxt "STRINGS.CHARACTERS.WEBBER.BATTLECRY.PREY"
msgid "We will put you in our web!"
msgstr "Chúng mình sẽ cuốn bạn vào mạng nhện!"

#. STRINGS.CHARACTERS.WEBBER.BATTLECRY.SPIDER
msgctxt "STRINGS.CHARACTERS.WEBBER.BATTLECRY.SPIDER"
msgid "Hey, wanna play?"
msgstr "Này, muốn chơi không?"

#. STRINGS.CHARACTERS.WEBBER.BATTLECRY.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WEBBER.BATTLECRY.SPIDER_WARRIOR"
msgid "Why can't we just get along?!"
msgstr "Sao chúng ta không thể hòa thuận với nhau chứ?!"

#. STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.GENERIC"
msgid "Well, we would have won!"
msgstr "Chà, lẽ ra chúng mình đã thắng!"

#. STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.PIG
msgctxt "STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.PIG"
msgid "Another day, pig."
msgstr "Hẹn hôm khác, lợn."

#. STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.PREY
msgctxt "STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.PREY"
msgid "Speedy thing!"
msgstr "Đồ chạy nhanh!"

#. STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.SPIDER
msgctxt "STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.SPIDER"
msgid "We didn't actually want to hurt you."
msgstr "Chúng tôi thực sự không muốn làm tổn thương bạn."

#. STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.SPIDER_WARRIOR"
msgid "Simmer down, friend."
msgstr "Bình tĩnh nào, bạn ơi."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL.LEVEL1.1
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL.LEVEL1.1"
msgid "We're a bit old for playing peek-a-boo."
msgstr "Chúng ta hơi già để chơi trò ú òa rồi."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL.LEVEL1.2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL.LEVEL1.2"
msgid "We're a bit old for playing peek-a-boo."
msgstr "Chúng ta hơi già để chơi trò ú òa rồi."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL.LEVEL2.1
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL.LEVEL2.1"
msgid "We're a bit old for playing peek-a-boo."
msgstr "Chúng ta hơi già để chơi trò ú òa rồi."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL.LEVEL2.2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL.LEVEL2.2"
msgid "We're a bit old for playing peek-a-boo."
msgstr "Chúng ta hơi già để chơi trò ú òa rồi."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL.LEVEL3.1
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL.LEVEL3.1"
msgid "We're a bit old for playing peek-a-boo."
msgstr "Chúng ta hơi già để chơi trò ú òa rồi."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL.LEVEL3.2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL.LEVEL3.2"
msgid "We're a bit old for playing peek-a-boo."
msgstr "Chúng ta hơi già để chơi trò ú òa rồi."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.GENERIC"
msgid "Pretty petals!"
msgstr "Cánh hoa xinh xắn!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND"
msgid "Scary blossoms!"
msgstr "Hoa nở đáng sợ!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET"
msgid "Put it down! Put it down!"
msgstr "Đặt nó xuống! Đặt nó xuống!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.LEVEL1
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.LEVEL1"
msgid "Can she hear us in there?"
msgstr "Cô ấy có thể nghe thấy chúng ta ở trong đó không?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.LEVEL2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.LEVEL2"
msgid "C'mon Abigail, Wendy misses you!"
msgstr "Thôi nào Abigail, Wendy nhớ bạn!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.LEVEL3
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.LEVEL3"
msgid "Helloooo? Do you want to come out now?"
msgstr "Xin chàooooo? Bạn có muốn ra ngoài bây giờ không?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.LONG
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.LONG"
msgid "I think it's listening to us!"
msgstr "Tôi nghĩ rằng nó đang lắng nghe chúng tôi!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.MEDIUM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.MEDIUM"
msgid "It's getting creepy!"
msgstr "Nó đang trở nên đáng sợ!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.SOON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.SOON"
msgid "It gives us itches and skritches up our spine!"
msgstr "Nó làm chúng mình ngứa ngáy rợn cả sống lưng!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABYSSPILLAR_MINION.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABYSSPILLAR_MINION.ACTIVATED"
msgid "Hey! No fair!"
msgstr "Này! Không công bằng!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABYSSPILLAR_MINION.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABYSSPILLAR_MINION.GENERIC"
msgid "We're glad it's just a statue!"
msgstr "Chúng tôi rất vui vì nó chỉ là một bức tượng!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABYSSPILLAR_TRIAL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABYSSPILLAR_TRIAL"
msgid "We'll pull it!"
msgstr "Chúng tôi sẽ kéo nó!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACCOMPLISHMENT_SHRINE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACCOMPLISHMENT_SHRINE"
msgid "It gives me a goal in life."
msgstr "Nó mang lại cho tôi một mục tiêu trong cuộc sống."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACORN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACORN"
msgid "Tree or food, there's something inside."
msgstr "Là cây hay đồ ăn thì bên trong cũng có gì đó."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACORN_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACORN_COOKED"
msgid "Roasted on an open fire."
msgstr "Rang trên lửa."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACORN_SAPLING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACORN_SAPLING"
msgid "May you have a long and free life."
msgstr "Chúc bạn có một cuộc sống lâu dài và tự do."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ADVENTURE_PORTAL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ADVENTURE_PORTAL"
msgid "Something wicked this way comes."
msgstr "Có thứ gì đó tà ác đang tới."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIANHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIANHAT"
msgid "We see things when we put it on..."
msgstr "Chúng mình thấy nhiều thứ lạ khi đội nó lên..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIANHATSHARD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIANHATSHARD"
msgid "Uh oh... maybe we can paste them back together?"
msgstr "Uh ồ... có lẽ chúng ta có thể dán chúng lại với nhau?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_CONTAINED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_CONTAINED"
msgid "It's sucking up all the glowy stuff!"
msgstr "Nó đang hút tất cả những thứ rực rỡ!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD"
msgid "Whew, that was scary!"
msgstr "Phù, đáng sợ thật!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC"
msgid "Aah! It looks mad!"
msgstr "Aaa! Nó trông giận dữ quá!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT"
msgid "It seems crankier than before!"
msgstr "Có vẻ cáu kỉnh hơn trước!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT"
msgid "So bright!"
msgstr "Sáng quá!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD"
msgid "Is it over now?"
msgstr "Bây giờ đã xong chưa?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC"
msgid "Uh oh... we think we just made it madder..."
msgstr "Ối... chúng mình nghĩ vừa làm nó giận hơn..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE"
msgid "Yikes, those are sharp!"
msgstr "Ối, chúng sắc quá!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE3
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE3"
msgid "We're sorry! We're sorry!"
msgstr "Chúng tôi xin lỗi! Chúng tôi xin lỗi!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD"
msgid "We're not sure what he did, but it doesn't look like it's getting up again!"
msgstr "Chúng mình không chắc anh ấy đã làm gì, nhưng có vẻ nó sẽ không đứng dậy nữa!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB"
msgid "Watch out! It might get back up!"
msgstr "Coi chừng! Nó có thể đứng dậy lại đấy!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP"
msgid "Now would be a really bad time to fall asleep."
msgstr "Bây giờ sẽ là thời điểm thực sự tồi tệ để chìm vào giấc ngủ."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT"
msgid "Three-legged space spider?"
msgstr "Nhện không gian ba chân?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.AMULET
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.AMULET"
msgid "It's a fine necklace, I suppose."
msgstr "Là một sợi dây chuyền đẹp, chắc vậy."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCHOR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCHOR"
msgid "It's really, really heavy."
msgstr "Nó thực sự rất nặng."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCHOR_ITEM"
msgid "That's for making an anchor."
msgstr "Đó là để làm mỏ neo."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTFRUIT_GEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTFRUIT_GEM"
msgid "It's too hard to take a bite out of."
msgstr "Cứng quá, không cắn nổi."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTFRUIT_NIGHTVISION
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTFRUIT_NIGHTVISION"
msgid "Um... are we sure it's not full of baby spiders?"
msgstr "Um... chúng ta có chắc là nó không đầy nhện con không?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED"
msgid "It doesn't help our eyes, but it also doesn't hurt our tummy as much."
msgstr "Nó không giúp mắt chúng ta, nhưng nó cũng không làm bụng chúng ta đau nhiều."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_GEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_GEM.GENERIC"
msgid "Aww, it's too hot to climb."
msgstr "Ôi, nó nóng quá không trèo được."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_GEM.STUMP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_GEM.STUMP"
msgid "Poor Mr. Tree."
msgstr "Tội nghiệp ông Cây."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC"
msgid "It looks scary, but that doesn't mean it's bad!"
msgstr "Nó trông đáng sợ, nhưng điều đó không có nghĩa là nó xấu!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP"
msgid "Poor Mr. Tree."
msgstr "Tội nghiệp ông Cây."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC"
msgid "We think it likes its new home."
msgstr "Chúng tôi nghĩ rằng nó thích ngôi nhà mới của mình."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON"
msgid "It's okay, you can grow when you're ready."
msgstr "Không sao đâu, bạn có thể lớn lên khi bạn sẵn sàng."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE"
msgid "What's wrong? Don't you like it there?"
msgstr "Có chuyện gì vậy? Bạn không thích ở đó à?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_SAPLING_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_SAPLING_ITEM"
msgid "We're going to find a good home for you!"
msgstr "Chúng tôi sẽ tìm một ngôi nhà tốt cho bạn!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_SEED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_SEED"
msgid "We want to see what it grows into!"
msgstr "Chúng tớ muốn xem nó sẽ lớn lên như thế nào!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENT_ALTAR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENT_ALTAR"
msgid "Old and full of mysteries."
msgstr "Cũ và đầy bí ẩn."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENT_ALTAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENT_ALTAR_BROKEN"
msgid "It's been busted up."
msgstr "Nó bị đập vỡ rồi."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENT_HUSK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENT_HUSK"
msgid "Were they mad at each other?"
msgstr "Họ có giận nhau không?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENT_STATUE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENT_STATUE"
msgid "It's throbbing strangely."
msgstr "Nó đập thình thịch kỳ lạ."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANIMAL_TRACK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANIMAL_TRACK"
msgid "Whatever it is, it travels single file."
msgstr "Dù là gì đi nữa, nó đi thành hàng một."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTCHOVIES
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTCHOVIES"
msgid "It's like peoplefood and spiderfood in one!"
msgstr "Nó giống như thức ăn cho người và thức ăn cho nhện trong một!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTLION.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTLION.GENERIC"
msgid "You're fuzzy. We like that."
msgstr "Bạn lông mềm mềm. Chúng mình thích lắm."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTLION.UNHAPPY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTLION.UNHAPPY"
msgid "I think it's upset."
msgstr "Tôi nghĩ nó đang bực."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTLION.VERYHAPPY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTLION.VERYHAPPY"
msgid "It's always nice to have more bug friends."
msgstr "Thật tuyệt khi có thêm nhiều bạn bè là côn trùng."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTLIONHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTLIONHAT"
msgid "We can pretend we're an Antlion!"
msgstr "Chúng mình có thể giả làm Kiến Sư Tử!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTLIONTRINKET
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTLIONTRINKET"
msgid "Sand castles!!"
msgstr "Lâu đài bằng cát!!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_CENTIPEDE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_CENTIPEDE"
msgid "We made it angry!"
msgstr "Chúng ta đã làm nó tức giận!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK"
msgid "Someone left these parts lying around."
msgstr "Ai đó đã để lại những phần này nằm xung quanh."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_COOKPOT.BURNT"
msgid "Someone must have left the fire going."
msgstr "Chắc ai đó quên tắt lửa."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG"
msgid "It won't be done for a while."
msgstr "Còn lâu mới xong."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT"
msgid "Almost ready!"
msgstr "Sắp xong rồi!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_COOKPOT.DONE"
msgid "Supper is served."
msgstr "Bữa tối đã sẵn sàng."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_COOKPOT.EMPTY"
msgid "Bugs get hungry too! We should know!"
msgstr "Bọ cũng biết đói mà! Chúng mình biết rõ lắm!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_LOCKBOX
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_LOCKBOX"
msgid "How will we get it open?"
msgstr "Chúng ta sẽ mở nó bằng cách nào?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC"
msgid "Can we press all the buttons?"
msgstr "Chúng ta có thể nhấn tất cả các nút không?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF"
msgid "We think it's broken."
msgstr "Chúng tôi nghĩ nó bị hỏng."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_MOON_STATUE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_MOON_STATUE"
msgid "Maybe the moon was important to them?"
msgstr "Có lẽ mặt trăng rất quan trọng với họ?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN"
msgid "We love puzzles!"
msgstr "Chúng tôi yêu thích các câu đố!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_PORTAL.GENERIC"
msgid "Aw, this one didn't turn back on."
msgstr "Ồ, cái này không bật lại được."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_PORTAL.POWEROFF
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_PORTAL.POWEROFF"
msgid "Maybe it used to go somewhere?"
msgstr "Có lẽ nó đã từng đi đâu đó?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_RESONATOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_RESONATOR.GENERIC"
msgid "It's taking us on a treasure hunt!"
msgstr "Nó đang đưa chúng ta đi săn tìm kho báu!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_RESONATOR.IDLE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_RESONATOR.IDLE"
msgid "Aw, I guess we found them all."
msgstr "Ồ, tôi đoán là chúng ta đã tìm thấy tất cả rồi."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_RESONATOR_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_RESONATOR_ITEM"
msgid "We think it's for finding something."
msgstr "Chúng tôi nghĩ đó là để tìm kiếm thứ gì đó."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1"
msgid "We sure wish we knew what it says!"
msgstr "Ước gì chúng mình biết nó viết gì!"

