msgstr "Tại sao tôi lại lãng phí thời gian nhìn chằm chằm xuống đất?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.TURF_RUINSTILES_GLOW
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.TURF_RUINSTILES_GLOW"
