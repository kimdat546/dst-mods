msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_BACKUPBODY.GENERIC"
msgid "Bonjour? WX?"
msgstr "Bonjour? WX?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_MODULEREMOVER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_MODULEREMOVER"
msgid "Ah, I believe this utensil belongs to our metal friend."
msgstr "À, tôi tin rằng dụng cụ này thuộc về người bạn kim loại của chúng ta."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_SCANNER.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_SCANNER.GENERIC"
