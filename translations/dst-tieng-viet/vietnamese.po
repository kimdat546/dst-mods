msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_SPOTLIGHT.OFF"
msgid "It requires a power source."
msgstr "Nó đòi hỏi một nguồn năng lượng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_SPOTLIGHT.SLEEP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_SPOTLIGHT.SLEEP"
msgid "A sensible safety precaution."
msgstr "Một biện pháp phòng ngừa an toàn hợp lý."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_STORAGE_ROBOT.CHARGED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_STORAGE_ROBOT.CHARGED"
msgid "It looks like it has sufficient power."
msgstr "Có vẻ như nó có đủ năng lượng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_STORAGE_ROBOT.CHARGING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_STORAGE_ROBOT.CHARGING"
msgid "It is connected to a power source."
msgstr "Nó được kết nối với một nguồn năng lượng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_STORAGE_ROBOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_STORAGE_ROBOT.GENERIC"
msgid "Winona's version is no less impressive."
msgstr "Phiên bản của Winona không kém phần ấn tượng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_STORAGE_ROBOT.OFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_STORAGE_ROBOT.OFF"
msgid "It requires a power source"
msgstr "Nó cần một nguồn năng lượng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_STORAGE_ROBOT.SLEEP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_STORAGE_ROBOT.SLEEP"
msgid "Winona's version is no less impressive."
msgstr "Phiên bản của Winona không kém phần ấn tượng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_TELEBRELLA.CHARGED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_TELEBRELLA.CHARGED"
msgid "What a whimsical appearance for a teleportation device."
msgstr "Thật là một vẻ ngoài kỳ quái của một thiết bị dịch chuyển tức thời."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_TELEBRELLA.CHARGING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_TELEBRELLA.CHARGING"
msgid "What a whimsical appearance for a teleportation device."
msgstr "Thật là một vẻ ngoài kỳ quái của một thiết bị dịch chuyển tức thời."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_TELEBRELLA.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_TELEBRELLA.GENERIC"
msgid "What a whimsical appearance for a teleportation device."
msgstr "Thật là một vẻ ngoài kỳ quái của một thiết bị dịch chuyển tức thời."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_TELEBRELLA.OFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_TELEBRELLA.OFF"
msgid "It requires a power source."
msgstr "Nó đòi hỏi một nguồn năng lượng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.BURNING"
msgid "Oh dear, who did this?"
msgstr "Ôi trời, ai đã làm điều này?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.BURNT"
msgid "I do hope she'll build another."
msgstr "Tôi hy vọng cô ấy sẽ xây dựng lại cái khác."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.GENERIC"
msgid "This is rather convenient."
msgstr "Điều này khá tiện lợi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.OFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.OFF"
msgid "It requires a power source."
msgstr "Nó đòi hỏi một nguồn năng lượng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTERHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTERHAT"
msgid "I ought to teach the children how to pick up a stitch."
msgstr "Tôi nên dạy bọn trẻ cách móc lại mũi đan."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTEROMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTEROMETER.BURNT"
msgid "I can't read any measurements from that husk."
msgstr "Tôi chẳng đọc được số đo nào từ cái xác cháy đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTEROMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTEROMETER.GENERIC"
msgid "Measure before you act."
msgstr "Đo trước khi hành động."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTERSFEASTFUEL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTERSFEASTFUEL"
msgid "It reminds me of reading holiday stories by the fire."
msgstr "Nó làm tôi nhớ những lúc đọc truyện ngày lễ bên lò sưởi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTERSFEASTOVEN.ALMOST_DONE_COOKING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTERSFEASTOVEN.ALMOST_DONE_COOKING"
msgid "It will be done, momentarily."
msgstr "Sắp xong rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTERSFEASTOVEN.COOKING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTERSFEASTOVEN.COOKING"
msgid "Roasting nicely."
msgstr "Nướng ngon lành."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTERSFEASTOVEN.DISH_READY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTERSFEASTOVEN.DISH_READY"
msgid "It is complete!"
msgstr "Xong rồi!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTERSFEASTOVEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTERSFEASTOVEN.GENERIC"
msgid "What sort of fuel does it run on?"
msgstr "Nó chạy bằng loại nhiên liệu nào?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_FOOD1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_FOOD1"
msgid "What a delightful little individual."
msgstr "Một anh bạn nhỏ thật dễ thương."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_FOOD2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_FOOD2"
msgid "Just like holidays at the library!"
msgstr "Giống như những ngày nghỉ ở thư viện!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_FOOD3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_FOOD3"
msgid "The perfect stir stick for hot cup of tea."
msgstr "Que khuấy hoàn hảo cho tách trà nóng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_FOOD4
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_FOOD4"
msgid "An object with negligible temporal drag."
msgstr "Một vật có lực cản thời gian không đáng kể."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_FOOD5
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_FOOD5"
msgid "Such expertly prepared raspberry filling!"
msgstr "Nhân mâm xôi được làm khéo quá!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_FOOD6
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_FOOD6"
msgid "\"Plum\" is a 17th century term for \"fruit\", dear."
msgstr "\"Plum\" là từ thế kỷ 17 dùng để chỉ \"trái cây\", cháu à."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_FOOD7
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_FOOD7"
msgid "Pair it with a good book and you've a cure for the winter blues."
msgstr "Hãy kết hợp nó với một cuốn sách hay và bạn sẽ có được phương pháp chữa trị nỗi buồn mùa đông."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_FOOD8
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_FOOD8"
msgid "A small enchantment keeps it a pleasant temperature."
msgstr "Một chút phép thuật nhỏ giữ cho nó ấm vừa phải."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_FOOD9
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_FOOD9"
msgid "I've always harbored a weakness for good 'nog."
msgstr "Tôi vẫn luôn mê món rượu trứng ngon."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_ORNAMENT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_ORNAMENT"
msgid "Careful with it now, dear."
msgstr "Cẩn thận với nó đấy, cháu à."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_ORNAMENTBOSS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_ORNAMENTBOSS"
msgid "I'm of the opinion that one can never overdecorate."
msgstr "Tôi cho rằng người ta không bao giờ có thể trang trí quá mức."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_ORNAMENTFORGE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_ORNAMENTFORGE"
msgid "A harrowing handicraft."
msgstr "Một món thủ công rợn người."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_ORNAMENTGORGE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_ORNAMENTGORGE"
msgid "The needlework on this is quite intricate."
msgstr "Đường kim mũi chỉ trên này khá tinh xảo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_ORNAMENTLIGHT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_ORNAMENTLIGHT"
msgid "Electrical currents do have a certain appeal, don't they?"
msgstr "Dòng điện quả có một sức hấp dẫn nhất định phải không?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_ORNAMENTPEARL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_ORNAMENTPEARL"
msgid "Rather intricate work performed with chelae."
msgstr "Công phu tỉ mỉ, được làm bằng càng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_TREE.BURNING"
msgid "Oh gracious, not again."
msgstr "Ôi trời đất, lại nữa rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_TREE.BURNT"
msgid "Not to worry. We can still celebrate."
msgstr "Đừng lo. Chúng ta vẫn có thể ăn mừng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_TREE.CANDECORATE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_TREE.CANDECORATE"
msgid "Lovely job on the tree, dears."
msgstr "Cây trang trí đẹp lắm, các cháu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_TREE.YOUNG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_TREE.YOUNG"
msgid "It'd surely snap under the weight of ornaments."
msgstr "Nó chắc chắn sẽ gãy dưới sức nặng của đồ trang trí."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_TREESTAND.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_TREESTAND.BURNT"
msgid "Not to worry. We can still celebrate."
msgstr "Đừng lo. Chúng ta vẫn có thể ăn mừng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_TREESTAND.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINTER_TREESTAND.GENERIC"
msgid "Let's grow a proper tree, shall we?"
msgstr "Chúng ta hãy trồng một cái cây cho ra hồn nhé?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOBSTER_DEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOBSTER_DEN"
msgid "Home to the arthropod."
msgstr "Nhà của động vật chân đốt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOBSTER_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOBSTER_MOONGLASS"
msgid "This arthropod seems to have evolved to suit its environment."
msgstr "Loài động vật chân đốt này dường như đã tiến hóa để phù hợp với môi trường của nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOBSTER_SHELLER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOBSTER_SHELLER"
msgid "A most interesting invertebrate."
msgstr "Một động vật không xương sống thú vị nhất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOBSTER_SHELLER_DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOBSTER_SHELLER_DEAD"
msgid "I might as well eat it now."
msgstr "Thôi thì ăn luôn bây giờ vậy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOBSTER_SHELLER_DEAD_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOBSTER_SHELLER_DEAD_COOKED"
msgid "Dinner is served!"
msgstr "Bữa tối đã dọn ra rồi!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOBYBIG.1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOBYBIG.1"
msgid "There must be a mutagen in monster meat that triggers her growth."
msgstr "Chắc chắn phải có chất gây đột biến trong thịt quái vật đã kích thích sự phát triển của cô ấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOBYBIG.2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOBYBIG.2"
msgid "There must be a mutagen in monster meat that triggers her growth."
msgstr "Chắc chắn phải có chất gây đột biến trong thịt quái vật đã kích thích sự phát triển của cô ấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOBYSMALL.1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOBYSMALL.1"
msgid "I was always more of a cat person, but she is very sweet."
msgstr "Tôi luôn thích mèo hơn, nhưng cô ấy rất ngọt ngào."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOBYSMALL.2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOBYSMALL.2"
msgid "I was always more of a cat person, but she is very sweet."
msgstr "Tôi luôn thích mèo hơn, nhưng cô ấy rất ngọt ngào."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOBY_TREAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOBY_TREAT"
msgid "These will make our dear Woby grow big and strong."
msgstr "Những thứ này sẽ giúp Woby yêu quý của chúng ta lớn nhanh và khỏe mạnh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOLFGANG.ATTACKER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOLFGANG.ATTACKER"
msgid "I will not tolerate such behavior, %s."
msgstr "Tôi sẽ không tha thứ cho hành vi như vậy, %s."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOLFGANG.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOLFGANG.FIRESTARTER"
msgid "Was that fire intentional, %s?"
msgstr "Vụ cháy đó có phải là cố ý không, %s?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOLFGANG.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOLFGANG.GENERIC"
msgid "Ah, greetings dear %s!"
msgstr "À, xin chào %s thân mến!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOLFGANG.GHOST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOLFGANG.GHOST"
msgid "%s acts tough, but he needs my help. A heart should do it."
msgstr "%s tỏ ra cứng rắn nhưng anh ấy cần tôi giúp. Một trái tim là được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOLFGANG.MURDERER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOLFGANG.MURDERER"
msgid "That's it, %s! I'm taking my glasses off!"
msgstr "Đủ rồi đấy, %s! Tôi tháo kính ra đây!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOLFGANG.REVIVER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOLFGANG.REVIVER"
msgid "Excellent work, %s. You're a fast learner."
msgstr "Làm tốt lắm, %s. Bạn là người học nhanh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOLFGANG_WHISTLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOLFGANG_WHISTLE"
msgid "Please try to keep the noise to a minimum, dear."
msgstr "Cố giữ yên lặng một chút nhé, cháu à."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WONKEY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WONKEY.ATTACKER"
msgid "Oh my, perhaps it's not as intelligent as I first thought."
msgstr "Ôi trời, có lẽ nó không thông minh như lúc đầu tôi nghĩ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WONKEY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WONKEY.FIRESTARTER"
msgid "I don't believe it's quite evolved enough to handle fire."
msgstr "Tôi không tin nó đủ tiến hóa để xử lý được lửa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WONKEY.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WONKEY.GENERIC"
msgid "It displays a higher level of intelligence than I'd expect from an ape."
msgstr "Nó thể hiện mức độ thông minh cao hơn tôi mong đợi ở loài vượn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WONKEY.GHOST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WONKEY.GHOST"
msgid "Oh dear... I'm quite inclined to help it."
msgstr "Ôi trời... tôi rất sẵn lòng giúp đỡ nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WONKEY.MURDERER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WONKEY.MURDERER"
msgid "That wild animal must be dealt with!"
msgstr "Con vật hoang dã đó phải bị xử lý!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WONKEY.REVIVER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WONKEY.REVIVER"
msgid "The creature seems rather attached to us. I wonder why?"
msgstr "Sinh vật này có vẻ khá gắn bó với chúng tôi. Tôi tự hỏi tại sao?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOODCARVEDHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOODCARVEDHAT"
msgid "A bit utilitarian, but sturdy enough."
msgstr "Một chút thực dụng, nhưng đủ chắc chắn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOODIE.ATTACKER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOODIE.ATTACKER"
msgid "Careful, %s. You know what paper pulp is made of, don't you?"
msgstr "Cẩn thận, %s. Bạn biết bột giấy được làm từ gì phải không?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOODIE.BEAVER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOODIE.BEAVER"
msgid "Poor dear never mentioned he was afflicted by Castorthropy."
msgstr "Tội nghiệp, cậu ấy chưa từng kể mình mắc chứng hóa hải ly."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOODIE.BEAVERGHOST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOODIE.BEAVERGHOST"
msgid "I'll add \"Castorthrope\" to my endangered species list."
msgstr "Tôi sẽ thêm \"người hóa hải ly\" vào danh sách loài nguy cấp của mình."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOODIE.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOODIE.FIRESTARTER"
msgid "Keep lighting fires if you want to get burnt, dear."
msgstr "Cứ đốt lửa nữa đi rồi bị bỏng cho xem, cháu à."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOODIE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOODIE.GENERIC"
msgid "Ah, greetings dear %s!"
msgstr "À, xin chào %s thân mến!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOODIE.GHOST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOODIE.GHOST"
msgid "What did I say about playing with axes? Let's get you a heart."
msgstr "Tôi đã dặn gì về chuyện nghịch rìu hả? Để tôi đi tìm cho cháu một trái tim."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOODIE.GOOSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOODIE.GOOSE"
msgid "My, what a silly goose!"
msgstr "Ôi, thật là một con ngỗng ngớ ngẩn!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOODIE.GOOSEGHOST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOODIE.GOOSEGHOST"
msgid "Poor dear, let's see about finding you a heart."
msgstr "Tội nghiệp cháu, để tôi xem tìm cho cháu một trái tim nào."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOODIE.MOOSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOODIE.MOOSE"
msgid "Oh deer, it looks like you've expanded your repertoire."
msgstr "Ôi hươu ơi, có vẻ cháu đã có thêm tiết mục mới rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOODIE.MOOSEGHOST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOODIE.MOOSEGHOST"
msgid "Don't you fret, I'll be back with a heart."
msgstr "Bạn đừng lo lắng, tôi sẽ quay lại với một trái tim."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOODIE.MURDERER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOODIE.MURDERER"
msgid "I will defend myself from you, foul cad!"
msgstr "Tôi sẽ tự bảo vệ mình khỏi anh, tên khốn!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOODIE.REVIVER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOODIE.REVIVER"
msgid "Excellent work, %s."
msgstr "Làm tốt lắm, %s."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOOD_CHAIR.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOOD_CHAIR.BURNT"
msgid "Can't we have any nice things?"
msgstr "Chúng ta không thể giữ được thứ gì đẹp đẽ sao?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOOD_CHAIR.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOOD_CHAIR.GENERIC"
msgid "Reminds me of the chair in my reading nook."
msgstr "Làm tôi nhớ đến chiếc ghế ở góc đọc sách của mình."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOOD_CHAIR.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOOD_CHAIR.OCCUPIED"
msgid "If you're going to sit, you might as well read."
msgstr "Nếu bạn định ngồi, bạn cũng có thể đọc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOOD_TABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOOD_TABLE.BURNT"
msgid "What a shame."
msgstr "Tiếc quá."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOOD_TABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOOD_TABLE.GENERIC"
msgid "Perfect for enjoying a cup of tea and a good book."
msgstr "Hoàn hảo để thưởng thức một tách trà và một cuốn sách hay."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOOD_TABLE.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WOOD_TABLE.HAS_ITEM"
msgid "Perfect for enjoying a cup of tea and a good book."
msgstr "Hoàn hảo để thưởng thức một tách trà và một cuốn sách hay."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORM.DIRT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORM.DIRT"
msgid "It would be best to stay away from that."
msgstr "Tốt nhất nên tránh xa thứ đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORM.PLANT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORM.PLANT"
msgid "Reminds me of the Anglerfish."
msgstr "Làm tôi nhớ đến loài cá cần câu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORM.WORM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORM.WORM"
msgid "Worm attack!"
msgstr "Giun tấn công!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMHOLE.GENERIC"
msgid "The sleeping Megadrilacea Oraduos."
msgstr "Một con Megadrilacea Oraduos đang ngủ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMHOLE.OPEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMHOLE.OPEN"
msgid "Concentric rings of teeth for rapid ingestion."
msgstr "Vòng răng đồng tâm giúp ăn uống nhanh chóng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMHOLE_LIMITED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMHOLE_LIMITED"
msgid "It will only last a few trips."
msgstr "Nó chỉ dùng được vài chuyến thôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMLIGHT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMLIGHT"
msgid "It's softer than I would've thought."
msgstr "Nó mềm hơn tôi tưởng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMLIGHT_LESSER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMLIGHT_LESSER"
msgid "This one is purely vegetable."
msgstr "Quả này thuần thực vật."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMLIGHT_PLANT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMLIGHT_PLANT"
msgid "Reminds me of the Anglerfish."
msgstr "Làm tôi nhớ đến loài cá cần câu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMWOOD.ATTACKER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMWOOD.ATTACKER"
msgid "%s is of the Urtica family, I suspect."
msgstr "Tôi nghi ngờ %s thuộc họ Urtica."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMWOOD.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMWOOD.FIRESTARTER"
msgid "Do you want to singe your leaves off, %s?"
msgstr "Cháu muốn cháy trụi lá à, %s?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMWOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMWOOD.GENERIC"
msgid "Ah, greetings, dear %s!"
msgstr "À, xin chào %s thân yêu!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMWOOD.GHOST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMWOOD.GHOST"
msgid "Tsk, well that's no good. No good at all."
msgstr "Chậc, thế thì không ổn rồi. Không tốt chút nào."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMWOOD.MURDERER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMWOOD.MURDERER"
msgid "%s is a deadly nightshade! Attack!"
msgstr "%s là cà độc dược chết người! Tấn công!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMWOOD.REVIVER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMWOOD.REVIVER"
msgid "You're a very good friend, %s."
msgstr "Bạn là một người bạn rất tốt, %s."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.DEAD"
msgid "Perhaps that was unnecessary."
msgstr "Có lẽ điều đó là không cần thiết."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.GENERIC"
msgid "My, another plant and animal hybrid. How odd."
msgstr "Ôi, một loài thực vật và động vật lai khác. Thật kỳ lạ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.HELD"
msgid "The plant and animal matter has fused in total harmony."
msgstr "Thực vật và động vật đã hợp nhất hoàn toàn hài hòa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.SLEEPING"
msgid "It's in a deep sleep."
msgstr "Nó đang trong giấc ngủ sâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.GENERIC"
msgid "Plant and animal have merged into one in this specimen."
msgstr "Thực vật và động vật đã hợp nhất thành một trong mẫu vật này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.RIPE"
msgid "It does smell quite delicious."
msgstr "Nó có mùi khá thơm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.SLEEPING"
msgid "It's in a deep sleep."
msgstr "Nó đang trong giấc ngủ sâu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMWOOD_MUTANTPROXY_LIGHTFLIER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORMWOOD_MUTANTPROXY_LIGHTFLIER"
msgid "If it could be convinced to stay still, it would make an excellent reading light."
msgstr "Nếu có thể thuyết phục được nó đứng yên thì nó sẽ trở thành một chiếc đèn đọc sách tuyệt vời."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORM_BOSS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORM_BOSS"
msgid "This one is older, larger... deadlier."
msgstr "Con này già hơn, to hơn… chết người hơn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORTOX.ATTACKER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORTOX.ATTACKER"
msgid "You'd best play nice now, %s."
msgstr "Tốt nhất bây giờ bạn nên chơi tử tế, %s."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORTOX.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORTOX.FIRESTARTER"
msgid "I'll not tolerate that behavior, %s!"
msgstr "Tôi sẽ không dung thứ cho hành vi đó, %s!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORTOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORTOX.GENERIC"
msgid "You must tell me more about your species sometime, dear."
msgstr "Lúc nào đó cậu phải kể thêm cho tôi về giống loài của cậu nhé."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORTOX.GHOST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORTOX.GHOST"
msgid "That's what you get for causing mischief, %s."
msgstr "Đó là kết quả bạn nhận được khi gây ra trò nghịch ngợm, %s."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORTOX.MURDERER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORTOX.MURDERER"
msgid "Enough tricks, %s! I'll finish you!"
msgstr "Đủ trò rồi, %s! Tôi sẽ kết liễu cậu!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORTOX.REVIVER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORTOX.REVIVER"
msgid "Thank-you for the assistance, %s."
msgstr "Cảm ơn bạn đã hỗ trợ, %s."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORTOX_NABBAG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORTOX_NABBAG"
msgid "I hope he won't take after that nasty Krampus."
msgstr "Tôi mong cậu ta sẽ không giống gã Krampus khó ưa đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORTOX_REVIVER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORTOX_REVIVER"
msgid "Be responsible and we'll never have to use it."
msgstr "Cẩn thận một chút thì chúng ta sẽ chẳng bao giờ phải dùng đến nó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORTOX_SOULJAR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WORTOX_SOULJAR"
msgid "A receptacle for souls."
msgstr "Vật chứa linh hồn."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WURT.ATTACKER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WURT.ATTACKER"
msgid "Settle down, now!"
msgstr "Bình tĩnh lại nào!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WURT.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WURT.FIRESTARTER"
msgid "Do you remember what I said about fire? I should say not!"
msgstr "Cháu có nhớ tôi đã dặn gì về lửa không? Chắc chắn là không rồi!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WURT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WURT.GENERIC"
msgid "Hello dear %s, are you ready for more lessons?"
msgstr "Xin chào %s thân mến, bạn đã sẵn sàng cho những bài học tiếp theo chưa?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WURT.GHOST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WURT.GHOST"
msgid "Oh that won't do at all, let's get you sorted out."
msgstr "Ồ, thế này không ổn chút nào, để tôi giúp cháu nào."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WURT.MURDERER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WURT.MURDERER"
msgid "I will not tolerate that kind of behavior, %s!"
msgstr "Tôi sẽ không tha thứ cho loại hành vi đó, %s!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WURT.REVIVER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WURT.REVIVER"
msgid "Why thank you, dear."
msgstr "Ồ, cảm ơn cháu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WURT_SWAMPITEM_LUNAR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WURT_SWAMPITEM_LUNAR"
msgid "Don't let the power go to your head, dear."
msgstr "Đừng để sức mạnh làm cháu kiêu ngạo nhé."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WURT_SWAMPITEM_SHADOW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WURT_SWAMPITEM_SHADOW"
msgid "Oh my. That looks like rather advanced magic for her reading level."
msgstr "Ôi trời. Có vẻ như phép thuật đó khá cao cấp so với trình độ đọc của cô ấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78.ATTACKER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78.ATTACKER"
msgid "What devilishness is that robot up to?"
msgstr "Con robot đó đang làm trò quỷ quái gì vậy?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78.FIRESTARTER"
msgid "Do be careful when trying to destroy all life, dear."
msgstr "Cẩn thận khi định tiêu diệt mọi sự sống nhé, cháu à."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78.GENERIC"
msgid "Ah, the automaton. Greetings, dear %s!"
msgstr "À, cỗ máy tự động. Xin chào %s thân mến!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78.GHOST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78.GHOST"
msgid "Fascinating. %s indeed has a specter, and it lingers still."
msgstr "Thú vị thật. %s quả thật có hồn ma, và nó vẫn còn lảng vảng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78.MURDERER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78.MURDERER"
msgid "The binary is simple, %s... On, or OFF."
msgstr "Hệ nhị phân rất đơn giản, %s... Bật hoặc TẮT."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78.REVIVER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78.REVIVER"
msgid "I appreciate your commitment to group survival, %s."
msgstr "Tôi đánh giá cao cam kết của bạn đối với sự tồn tại của nhóm, %s."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78MODULE_BEE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78MODULE_BEE"
msgid "They dislike organics, but don't seem opposed to taking inspiration from them."
msgstr "Họ không thích đồ hữu cơ nhưng dường như không phản đối việc lấy cảm hứng từ chúng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78MODULE_CHESS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78MODULE_CHESS"
msgid "They dislike organics, but don't seem opposed to taking inspiration from them."
msgstr "Nó ghét sinh vật hữu cơ, nhưng có vẻ chẳng ngại lấy cảm hứng từ chúng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78MODULE_COLD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78MODULE_COLD"
msgid "They dislike organics, but don't seem opposed to taking inspiration from them."
msgstr "Họ không thích đồ hữu cơ nhưng dường như không phản đối việc lấy cảm hứng từ chúng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78MODULE_DIGESTION
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78MODULE_DIGESTION"
msgid "They dislike organics, but don't seem opposed to taking inspiration from them."
msgstr "Nó ghét sinh vật hữu cơ, nhưng có vẻ chẳng ngại lấy cảm hứng từ chúng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78MODULE_HEAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78MODULE_HEAT"
msgid "They dislike organics, but don't seem opposed to taking inspiration from them."
msgstr "Họ không thích đồ hữu cơ nhưng dường như không phản đối việc lấy cảm hứng từ chúng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78MODULE_LIGHT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78MODULE_LIGHT"
msgid "They dislike organics, but don't seem opposed to taking inspiration from them."
msgstr "Họ không thích đồ hữu cơ nhưng dường như không phản đối việc lấy cảm hứng từ chúng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78MODULE_LIGHT2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78MODULE_LIGHT2"
msgid "They dislike organics, but don't seem opposed to taking inspiration from them."
msgstr "Nó ghét sinh vật hữu cơ, nhưng có vẻ chẳng ngại lấy cảm hứng từ chúng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78MODULE_MAXHEALTH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78MODULE_MAXHEALTH"
msgid "They dislike organics, but don't seem opposed to taking inspiration from them."
msgstr "Họ không thích đồ hữu cơ nhưng dường như không phản đối việc lấy cảm hứng từ chúng."

