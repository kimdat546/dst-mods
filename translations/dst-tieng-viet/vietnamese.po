msgid "Merely a lonely part of a completed whole."
msgstr "Chỉ là một phần cô đơn của một tổng thể hoàn chỉnh."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_POST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_POST"
msgid "Where my beefalo will await judgment."
msgstr "Nơi bò lai của tôi chờ đợi sự phán xét."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_POST_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_POST_ITEM"
msgid "Where should I lay it to rest, I wonder?"
msgstr "Tôi tự hỏi nên đặt nó ở đâu để nghỉ ngơi?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_SEWINGMACHINE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_SEWINGMACHINE"
msgid "Mother liked to sew matching outfits for Abigail and I."
msgstr "Mẹ thích may những bộ trang phục phù hợp cho Abigail và tôi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_SEWINGMACHINE_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_SEWINGMACHINE_ITEM"
msgid "It needs to be put together before it can be of any use."
msgstr "Nó cần được lắp ráp trước khi có thể dùng được."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_STAGE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_STAGE"
msgid "What a strange little booth."
msgstr "Thật là một gian hàng nhỏ kỳ lạ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_STAGE_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_STAGE_ITEM"
msgid "I suppose putting that together will distract me from my misery for a while."
msgstr "Tôi cho rằng việc lắp ráp thứ đó sẽ giúp tôi quên đi nỗi khổ trong chốc lát."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRATSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRATSHRINE.BURNT"
msgid "Ashes to ashes."
msgstr "Cát bụi về với cát bụi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRATSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRATSHRINE.EMPTY"
msgid "It hungers for a tribute."
msgstr "Nó khao khát một sự cống nạp."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRATSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRATSHRINE.GENERIC"
msgid "I must pay my respects."
msgstr "Tôi phải bày tỏ lòng kính trọng của mình."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.BURNT"
msgid "Returned to dust."
msgstr "Đã trở về cát bụi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.GENERIC"
msgid "If only my life could find some direction."
msgstr "Giá như cuộc đời tôi có thể tìm được hướng đi nào đó."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.RAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.RAT"
msgid "An exercise in futility."
msgstr "Một bài tập vô ích."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION_ITEM"
msgid "I suppose I'd better get started."
msgstr "Tôi cho rằng tốt hơn là tôi nên bắt đầu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_REACTION.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_REACTION.BURNT"
msgid "Returned to dust."
msgstr "Đã trở về cát bụi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC"
msgid "After all, one never knows when disaster will strike..."
msgstr "Suy cho cùng, không ai biết khi nào tai họa sẽ ập đến..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_REACTION.RAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_REACTION.RAT"
msgid "What a silly creature."
msgstr "Thật là một sinh vật ngớ ngẩn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM"
msgid "What a lot of trouble to go to."
msgstr "Thật là lắm công phiền phức."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_SPEED.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_SPEED.BURNT"
msgid "Returned to dust."
msgstr "Đã trở về cát bụi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_SPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_SPEED.GENERIC"
msgid "I had a hamster once. It died."
msgstr "Tôi đã từng có một con hamster. Nó chết."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_SPEED.RAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_SPEED.RAT"
msgid "Running, running, yet going nowhere."
msgstr "Chạy, chạy mãi mà chẳng đi đến đâu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_SPEED_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_SPEED_ITEM"
msgid "I'd rather not carry it any longer."
msgstr "Tôi thà không mang nó nữa còn hơn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.BURNT"
msgid "Returned to dust."
msgstr "Đã trở về cát bụi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.GENERIC"
msgid "Abigail would have enjoyed this."
msgstr "Abigail hẳn sẽ thích điều này."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.RAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.RAT"
msgid "You know you'll never get that berry, don't you?"
msgstr "Bạn biết bạn sẽ không bao giờ có được quả mọng đó phải không?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM"
msgid "Perhaps I could put it over here..."
msgstr "Có lẽ tôi có thể đặt nó ở đây..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT"
msgid "If only I had a signpost to guide me..."
msgstr "Giá như tôi có một biển chỉ đường dẫn đường cho mình..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT_ITEM"
msgid "I fear I've already lost my way."
msgstr "Tôi sợ mình đã lạc đường mất rồi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_FINISH.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_FINISH.BURNT"
msgid "I suppose this means the race is over."
msgstr "Tôi cho rằng điều này có nghĩa là cuộc đua đã kết thúc."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC"
msgid "Don't worry, the end is near."
msgstr "Đừng lo lắng, sự kết thúc đã gần kề."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_FINISH.I_WON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_FINISH.I_WON"
msgid "Oh. I won."
msgstr "Ồ. Tôi đã thắng."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_FINISH.SOMEONE_ELSE_WON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_FINISH.SOMEONE_ELSE_WON"
msgid "Enjoy your victory {winner}... good things never last."
msgstr "Hãy tận hưởng chiến thắng của bạn nhé {winner}... những điều tốt đẹp không bao giờ kéo dài."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_FINISH_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_FINISH_ITEM"
msgid "It's time to finish this... race track."
msgstr "Đã đến lúc phải kết thúc... đường đua này."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_START
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_START"
msgid "Why do I bother with such silly things."
msgstr "Tại sao tôi lại bận tâm với những điều ngớ ngẩn như vậy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM"
msgid "I should find a resting place for this."
msgstr "Tôi nên tìm một nơi an nghỉ cho thứ này."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_SCALE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_SCALE.BURNT"
msgid "\"Ashes, ashes, we all fall down.\""
msgstr "\"Tro tàn, tro tàn, chúng ta đều rơi xuống.\""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT"
msgid "I don't know what I expected, really."
msgstr "Tôi thực sự không biết mình mong đợi điều gì."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD"
msgid "Oh... that's actually pretty good."
msgstr "Ồ... điều đó thực sự khá tốt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC"
msgid "What is the measure of a Carrat?"
msgstr "Thước đo của một con Cà Ruột là gì?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_SCALE_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_CARRAT_SCALE_ITEM"
msgid "How do you measure one's worth?"
msgstr "Làm thế nào để bạn đo lường giá trị của một người?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_SEEDPACKET"
msgid "Nothing grows in the garden of my heart."
msgstr "Không có gì mọc lên trong khu vườn của trái tim tôi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_SEEDPACKET_RARE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTC_SEEDPACKET_RARE"
msgid "Everything that grows just dies eventually."
msgstr "Mọi thứ phát triển rồi cuối cùng cũng sẽ chết."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_ANCHOR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_ANCHOR"
msgid "Its golden luster will be lost beneath the sea."
msgstr "Ánh vàng của nó sẽ biến mất dưới đáy biển."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_ANCHOR_ITEM"
msgid "It's for a burdensome boat anchor."
msgstr "Dùng để làm một chiếc neo thuyền nặng nề."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_DRAGONSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_DRAGONSHRINE.BURNT"
msgid "And to dust you shall return."
msgstr "Và bạn sẽ trở về cát bụi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_DRAGONSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_DRAGONSHRINE.EMPTY"
msgid "It demands a burnt offering."
msgstr "Nó đòi hỏi một của lễ thiêu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_DRAGONSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_DRAGONSHRINE.GENERIC"
msgid "Let us remember this monster."
msgstr "Hãy cùng tưởng nhớ con quái vật này."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_OAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_OAR"
msgid "I can paddle and paddle, and still feel like I'm going nowhere."
msgstr "Tôi có thể chèo và chèo, và cảm giác như tôi vẫn đang đứng yên."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_STEERINGWHEEL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_STEERINGWHEEL"
msgid "Where would I even go?"
msgstr "Mà tôi biết đi đâu chứ?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_STEERINGWHEEL_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTD_STEERINGWHEEL_ITEM"
msgid "It would make a steering wheel..."
msgstr "Nó có thể làm thành một bánh lái..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTH_CHAIR_ROCKING_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTH_CHAIR_ROCKING_ITEM"
msgid "Ah, the innocence of childhood."
msgstr "Ôi, sự ngây thơ của tuổi thơ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTH_KNIGHTHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTH_KNIGHTHAT"
msgid "One may become the knight and save themselves."
msgstr "Một người có thể trở thành hiệp sĩ và tự cứu mình."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTH_KNIGHTSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTH_KNIGHTSHRINE.BURNT"
msgid "What a pity."
msgstr "Thật đáng tiếc."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTH_KNIGHTSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTH_KNIGHTSHRINE.EMPTY"
msgid "An offering must be made."
msgstr "Phải dâng một lễ vật."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTH_KNIGHTSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTH_KNIGHTSHRINE.GENERIC"
msgid "I wonder what I'll get?"
msgstr "Tôi tự hỏi tôi sẽ nhận được gì?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTH_KNIGHTSTICK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTH_KNIGHTSTICK"
msgid "Hmm. It does look kind of fun."
msgstr "Ừm. Nó trông có vẻ vui nhộn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTH_LANCE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTH_LANCE"
msgid "Death rides at its tip."
msgstr "Cái chết cưỡi trên đầu mũi thương."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTP_FOOD1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTP_FOOD1"
msgid "Something died for that feast."
msgstr "Một cái gì đó đã chết cho bữa tiệc đó."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTP_FOOD2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTP_FOOD2"
msgid "I don't want to eat that."
msgstr "Tôi không muốn ăn thứ đó."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTP_FOOD3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTP_FOOD3"
msgid "It'll keep me alive a little longer."
msgstr "Nó sẽ giúp tôi sống lâu hơn một chút."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_DECOR_1.GENERAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_DECOR_1.GENERAL"
msgid "The soft glow is... comforting."
msgstr "Ánh sáng dịu nhẹ thật... dễ chịu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_DECOR_1.OUT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_DECOR_1.OUT"
msgid "What little comfort it gave is now gone."
msgstr "Niềm an ủi nho nhỏ mà nó mang lại giờ đã không còn nữa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_DECOR_1_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_DECOR_1_ITEM"
msgid "I should find a place for it to belong."
msgstr "Tôi nên tìm một nơi cho nó thuộc về."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_DECOR_2.GENERAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_DECOR_2.GENERAL"
msgid "The soft glow is... comforting."
msgstr "Ánh sáng dịu nhẹ thật... dễ chịu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_DECOR_2.OUT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_DECOR_2.OUT"
msgid "What little comfort it gave is now gone."
msgstr "Niềm an ủi nho nhỏ mà nó mang lại giờ đã không còn nữa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_DECOR_2_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_DECOR_2_ITEM"
msgid "I should find a place for it to belong."
msgstr "Tôi nên tìm một nơi cho nó thuộc về."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_FIGHTRING_BELL.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_FIGHTRING_BELL.GENERIC"
msgid "The ring is silent and still, for now."
msgstr "Sàn đấu lúc này vẫn lặng im."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_FIGHTRING_BELL.PLAYING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_FIGHTRING_BELL.PLAYING"
msgid "Can I... play next?"
msgstr "Tôi có thể... chơi tiếp được không?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_FIGHTRING_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_FIGHTRING_KIT"
msgid "It might be... f-fun?"
msgstr "Có thể sẽ... v-vui?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_FOOD1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_FOOD1"
msgid "I think... I would like a bit of cake."
msgstr "Tôi nghĩ... tôi muốn một ít bánh ngọt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_FOOD2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_FOOD2"
msgid "Now my lips have turned blue..."
msgstr "Bây giờ môi tôi đã chuyển sang màu xanh..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_FOOD3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_FOOD3"
msgid "I'm sorry Abigail, I'd share if I could."
msgstr "Tôi xin lỗi Abigail, tôi sẽ chia sẻ nếu có thể."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_FOOD4
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_FOOD4"
msgid "It's sticky."
msgstr "Nó dính."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_RABBITSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_RABBITSHRINE.BURNT"
msgid "Poor Mr. Rabbit."
msgstr "Tội nghiệp ông Thỏ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_RABBITSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_RABBITSHRINE.EMPTY"
msgid "Are you hungry, Mr. Rabbit?"
msgstr "Bạn có đói không, ông Thỏ?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_RABBITSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_RABBITSHRINE.GENERIC"
msgid "I should pay my respects."
msgstr "Tôi nên bày tỏ lòng kính trọng của mình."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_TOKEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTR_TOKEN"
msgid "A duel to the death might help pass the time."
msgstr "Một cuộc đấu tay đôi đến chết có thể giúp giết thời gian."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTS_LANTERN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTS_LANTERN_POST.BURNT"
msgid "Shame, it was pretty."
msgstr "Thật đáng tiếc, nó từng rất đẹp."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTS_LANTERN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTS_LANTERN_POST.GENERIC"
msgid "It does seem to bring some cheer."
msgstr "Nó dường như mang lại một số niềm vui."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTS_LANTERN_POST_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTS_LANTERN_POST_ITEM"
msgid "Shall I cast some light upon the darkness?"
msgstr "Tôi có nên chiếu chút ánh sáng vào bóng tối không?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTS_SNAKESHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTS_SNAKESHRINE.BURNT"
msgid "Inevitable, really."
msgstr "Không thể tránh khỏi, thực sự."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTS_SNAKESHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTS_SNAKESHRINE.EMPTY"
msgid "Perhaps like consumes like."
msgstr "Có lẽ đồng loại ăn đồng loại."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTS_SNAKESHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTS_SNAKESHRINE.GENERIC"
msgid "Abigail loved surprises."
msgstr "Abigail thích sự ngạc nhiên."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTS_WORM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTS_WORM"
msgid "It's actually quite beautiful."
msgstr "Nó thực sự khá đẹp."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOT_CATCOONSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOT_CATCOONSHRINE.BURNT"
msgid "No more."
msgstr "Không còn nữa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOT_CATCOONSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOT_CATCOONSHRINE.EMPTY"
msgid "What shall I let go to please it?"
msgstr "Tôi phải cho đi điều gì để làm hài lòng nó?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOT_CATCOONSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOT_CATCOONSHRINE.GENERIC"
msgid "How do you know I'm mad?"
msgstr "Làm sao bạn biết tôi đang điên?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE_GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE_GENERIC"
msgid "Sigh... I don't know."
msgstr "Haiz... tôi không biết."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTHAPPY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTHAPPY"
msgid "The plant, at least, seems to be doing well."
msgstr "Ít nhất thì cái cây có vẻ tươi tốt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSED"
msgid "Something around is making its life quite difficult."
msgstr "Có gì đó xung quanh đang khiến cuộc sống của nó khá khó khăn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSORFAMILY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSORFAMILY"
msgid "It's lonely... it needs family..."
msgstr "Nó cô đơn... nó cần gia đình..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSORHAPPINESS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSORHAPPINESS"
msgid "Perhaps it just needs some reassurance."
msgstr "Có lẽ nó chỉ cần một chút trấn an."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSORKILLJOYS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSORKILLJOYS"
msgid "The garden is a bit untidy..."
msgstr "Khu vườn hơi bừa bộn..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSORMOISTURE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSORMOISTURE"
msgid "Perhaps it might need some water?"
msgstr "Có lẽ nó có thể cần một ít nước?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSORNUTRIENTS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSORNUTRIENTS"
msgid "It is starved for nutrients."
msgstr "Nó nghèo chất dinh dưỡng."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSOROVERCROWDING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSOROVERCROWDING"
msgid "It's too close to the other plants... it's suffocating..."
msgstr "Nó quá gần những cái cây khác... thật ngột ngạt..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSORSEASON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSORSEASON"
msgid "It was not made to withstand the harshness of this season."
msgstr "Nó không được tạo ra để chống chọi với sự khắc nghiệt của mùa này."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTVERYSTRESSED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTVERYSTRESSED"
msgid "It is positively miserable. A kindred spirit."
msgstr "Nó khổ sở vô cùng. Đúng là tri kỷ."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE_SMOLDERING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE_SMOLDERING"
msgid "It's about to be swallowed by flames."
msgstr "Nó sắp bị lửa nuốt chửng."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE_TOODARK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE_TOODARK"
msgid "The darkness! It is too dark!"
msgstr "Bóng tối! Tối quá!"

#. STRINGS.CHARACTERS.WENDY.EAT_FOOD.TALLBIRDEGG_CRACKED
msgctxt "STRINGS.CHARACTERS.WENDY.EAT_FOOD.TALLBIRDEGG_CRACKED"
msgid "I spared it the torment of living."
msgstr "Tôi đã giải thoát nó khỏi nỗi đau của sự sống."

#. STRINGS.CHARACTERS.WENDY.EAT_FOOD.WINTERSFEASTFUEL
msgctxt "STRINGS.CHARACTERS.WENDY.EAT_FOOD.WINTERSFEASTFUEL"
msgid "Abigail, it's like I can taste mother's cooking..."
msgstr "Abigail, cứ như thể tôi có thể nếm được món mẹ nấu vậy..."

#. STRINGS.CHARACTERS.WENDY.QUAGMIRE_ANNOUNCE_LOSE
msgctxt "STRINGS.CHARACTERS.WENDY.QUAGMIRE_ANNOUNCE_LOSE"
msgid "What a horrible place to have a curse."
msgstr "Thật là một nơi khủng khiếp để bị nguyền rủa."

#. STRINGS.CHARACTERS.WENDY.QUAGMIRE_ANNOUNCE_MEALBURNT
msgctxt "STRINGS.CHARACTERS.WENDY.QUAGMIRE_ANNOUNCE_MEALBURNT"
msgid "It's ruined."
msgstr "Nó bị hủy hoại."

#. STRINGS.CHARACTERS.WENDY.QUAGMIRE_ANNOUNCE_NOTRECIPE
msgctxt "STRINGS.CHARACTERS.WENDY.QUAGMIRE_ANNOUNCE_NOTRECIPE"
msgid "Those foods weren't meant to be together."
msgstr "Những món đó vốn không nên ở cùng nhau."

#. STRINGS.CHARACTERS.WENDY.QUAGMIRE_ANNOUNCE_WIN
msgctxt "STRINGS.CHARACTERS.WENDY.QUAGMIRE_ANNOUNCE_WIN"
msgid "Let us depart this terrible place."
msgstr "Chúng ta hãy rời khỏi nơi khủng khiếp này."

#. STRINGS.CHARACTERS.WENDY.WENDY_SKILLTREE_EASTEREGG
msgctxt "STRINGS.CHARACTERS.WENDY.WENDY_SKILLTREE_EASTEREGG"
msgid "Is that you, Abby?"
msgstr "Là em đó sao, Abby?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.CARNIVAL_HOST_HERE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.CARNIVAL_HOST_HERE"
msgid "I believe I saw our host somewhere in this direction."
msgstr "Tôi tin rằng tôi đã nhìn thấy chủ nhà của chúng ta ở đâu đó theo hướng này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.EMPTY_CATCOONDEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.EMPTY_CATCOONDEN"
msgid "Unfortunately, it appears the kittens are not present."
msgstr "Thật không may, có vẻ như mèo con không có mặt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.HOSTBUSY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.HOSTBUSY"
msgid "He seems to be attending to other matters at the moment."
msgstr "Có vẻ như lúc này ông ấy đang bận việc khác."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDERS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDERS"
msgid "It would seem the seekers outnumber the kittens."
msgstr "Có vẻ như số người tìm kiếm đông hơn số mèo con."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDING_SPOTS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDING_SPOTS"
msgid "I believe there are not enough locations for the kittens to hide."
msgstr "Tôi tin rằng không có đủ địa điểm để mèo con ẩn náu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_ONE_GAME_PER_DAY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_ONE_GAME_PER_DAY"
msgid "I believe I should take some time to rest."
msgstr "Tôi tin rằng tôi nên dành thời gian để nghỉ ngơi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.LOCKED_GATE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.LOCKED_GATE"
msgid "It appears to be locked."
msgstr "Có vẻ như nó đã bị khóa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.MANNEQUIN_EQUIPSWAPFAILED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.MANNEQUIN_EQUIPSWAPFAILED"
msgid "That does not belong on a mannequin."
msgstr "Cái đó không thuộc về ma-nơ-canh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.NOCARNIVAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.NOCARNIVAL"
msgid "How disappointing, the corvids seem to have migrated elsewhere."
msgstr "Thật đáng thất vọng, lũ quạ dường như đã di cư đi nơi khác."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.NOKELP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.NOKELP"
msgid "only_used_by_wurt"
msgstr "only_used_by_wurt"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.NOTAROBOT"
msgid "It is the property of the automaton."
msgstr "Đó là tài sản của cỗ máy tự động."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.NOTMERM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.NOTMERM"
msgid "It seems that piscean bipeds only heed the call of their own kind."
msgstr "Có vẻ như loài cá hai chân chỉ nghe theo tiếng gọi của đồng loại."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.NOTMYBERNIE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.NOTMYBERNIE"
msgid "This monstrous animated teddy bear is loyal only to our dear Willow."
msgstr "Con gấu bông sống dậy quái dị này chỉ trung thành với Willow thân yêu của chúng ta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.PILLOWFIGHT_NO_HANDPILLOW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.PILLOWFIGHT_NO_HANDPILLOW"
msgid "I will require a pillow to participate."
msgstr "Tôi cần một chiếc gối để tham gia."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.APPLYELIXIR.NO_ELIXIRABLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.APPLYELIXIR.NO_ELIXIRABLE"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.APPLYELIXIR.TOO_SUPER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.APPLYELIXIR.TOO_SUPER"
msgid "That is too strong."
msgstr "Điều đó quá mạnh mẽ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.APPLYMODULE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.APPLYMODULE.COOLDOWN"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.APPLYMODULE.NOTENOUGHSLOTS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.APPLYMODULE.NOTENOUGHSLOTS"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.APPRAISE.NOTNOW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.APPRAISE.NOTNOW"
msgid "Patience is a virtue."
msgstr "Kiên nhẫn là một đức tính tốt."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ATTUNE.NOHEALTH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ATTUNE.NOHEALTH"
msgid "I'm feeling too ill for that."
msgstr "Tôi thấy quá yếu để làm việc đó."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BATHBOMB.ALREADY_BOMBED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BATHBOMB.ALREADY_BOMBED"
msgid "No need to be excessive."
msgstr "Không cần phải quá mức."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BATHBOMB.GLASSED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BATHBOMB.GLASSED"
msgid "The surface of the spring has crystallized, unfortunately."
msgstr "Thật không may, bề mặt suối nước đã kết tinh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BEGIN_QUEST.ONEGHOST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BEGIN_QUEST.ONEGHOST"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BUILD.BUSY_STATION
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BUILD.BUSY_STATION"
msgid "Oh, botheration."
msgstr "Ôi, phiền phức quá."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BUILD.HASPET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BUILD.HASPET"
msgid "One domestic creature is enough for me."
msgstr "Một sinh vật trong nhà là đủ cho tôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BUILD.MOUNTED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BUILD.MOUNTED"
msgid "In this elevated position, I can't reach the ground."
msgstr "Ở vị trí trên cao này, tôi không thể chạm tới mặt đất."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BUILD.TICOON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BUILD.TICOON"
msgid "Having two trackers at once could possibly confuse them."
msgstr "Việc có hai thiết bị theo dõi cùng một lúc có thể khiến họ bối rối."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CARNIVALGAME_FEED.TOO_LATE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CARNIVALGAME_FEED.TOO_LATE"
msgid "Oh dear, I wasn't quite fast enough."
msgstr "Ôi trời, tôi chưa đủ nhanh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CARVEPUMPKIN.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CARVEPUMPKIN.BURNING"
msgid "It's hot!"
msgstr "Nóng quá!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CARVEPUMPKIN.INUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CARVEPUMPKIN.INUSE"
msgid "It's obviously being carved by someone else."
msgstr "Rõ ràng là nó được khắc bởi người khác."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CASTAOE.CANT_SPELL_MOUNTED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CASTAOE.CANT_SPELL_MOUNTED"
msgid "only_used_by_willow"
msgstr "only_used_by_willow"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CASTAOE.NOT_ENOUGH_EMBERS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CASTAOE.NOT_ENOUGH_EMBERS"
msgid "only_used_by_willow"
msgstr "only_used_by_willow"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CASTAOE.NO_BATTERY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CASTAOE.NO_BATTERY"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CASTAOE.NO_CATAPULTS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CASTAOE.NO_CATAPULTS"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CASTAOE.NO_TARGETS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CASTAOE.NO_TARGETS"
msgid "only_used_by_willow"
msgstr "only_used_by_willow"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CASTAOE.SPELL_ON_COOLDOWN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CASTAOE.SPELL_ON_COOLDOWN"
msgid "only_used_by_willow"
msgstr "only_used_by_willow"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CASTSPELL.TERRAFORM_TOO_SOON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CASTSPELL.TERRAFORM_TOO_SOON"
msgid "only_used_by_wurt"
msgstr "only_used_by_wurt"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHANGEIN.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHANGEIN.BURNING"
msgid "No more changes for me. It's gone up in flames."
msgstr "Không còn thay đổi nào đối với tôi nữa. Nó đã bốc cháy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHANGEIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHANGEIN.GENERIC"
msgid "I think I look pretty smart already."
msgstr "Tôi nghĩ trông tôi đã khá chỉnh tề rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHANGEIN.INUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHANGEIN.INUSE"
msgid "If I could use that after you, dear."
msgstr "Để tôi dùng sau nhé, cháu yêu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHANGEIN.NOOCCUPANT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHANGEIN.NOOCCUPANT"
msgid "This station requires a beefalo to be securely hitched before I can proceed any further."
msgstr "Trạm này cần một con bò lai được buộc chắc chắn trước khi tôi có thể làm tiếp."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHANGEIN.NOTENOUGHHAIR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHANGEIN.NOTENOUGHHAIR"
msgid "Perhaps once the hair has regrown."
msgstr "Có lẽ đợi khi lông mọc lại đã."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHARGE_FROM.CHARGE_FULL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHARGE_FROM.CHARGE_FULL"
msgid "Energy is at full capacity."
msgstr "Năng lượng đang ở mức tối đa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHARGE_FROM.NOT_ENOUGH_CHARGE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHARGE_FROM.NOT_ENOUGH_CHARGE"
msgid "There is insufficient charge."
msgstr "Không đủ điện năng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.COMPARE_WEIGHABLE.FISH_TOO_SMALL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.COMPARE_WEIGHABLE.FISH_TOO_SMALL"
msgid "This specimen is far too insubstantial."
msgstr "Mẫu vật này quá nhỏ bé."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.COMPARE_WEIGHABLE.OVERSIZEDVEGGIES_TOO_SMALL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.COMPARE_WEIGHABLE.OVERSIZEDVEGGIES_TOO_SMALL"
msgid "I'm afraid this specimen simply doesn't have enough mass to compete."
msgstr "Tôi e rằng mẫu vật này không đủ khối lượng để cạnh tranh."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CONSTRUCT.EMPTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CONSTRUCT.EMPTY"
msgid "I need something to build with first."
msgstr "Tôi cần một cái gì đó để xây dựng trước tiên."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CONSTRUCT.INUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CONSTRUCT.INUSE"
msgid "Someone's already using this."
msgstr "Đã có người sử dụng cái này rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CONSTRUCT.MISMATCH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CONSTRUCT.MISMATCH"
msgid "Those are the wrong plans."
msgstr "Đó không đúng bản thiết kế."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CONSTRUCT.NOTALLOWED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CONSTRUCT.NOTALLOWED"
msgid "That was erroneous."
msgstr "Điều đó thật sai lầm."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CONSTRUCT.NOTREADY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CONSTRUCT.NOTREADY"
msgid "Perhaps when the ground is more stable..."
msgstr "Có lẽ khi mặt đất ổn định hơn..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.COOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.COOK.GENERIC"
msgid "Perhaps later. Not all old ladies enjoy cooking, you know."
msgstr "Có lẽ sau này. Không phải tất cả các bà già đều thích nấu ăn, bạn biết đấy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.COOK.INUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.COOK.INUSE"
msgid "Mmm, smells lovely, dear."
msgstr "Mmm, mùi thơm quá, cháu yêu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.COOK.TOOFAR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.COOK.TOOFAR"
msgid "It is not within my reach."
msgstr "Nó không nằm trong tầm tay của tôi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DECORATESNOWMAN.HASHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DECORATESNOWMAN.HASHAT"
msgid "I can't put it on top of the hat."
msgstr "Tôi không thể đặt nó lên trên mũ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DECORATESNOWMAN.INUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DECORATESNOWMAN.INUSE"
msgid "There's obviously someone decorating it now."
msgstr "Rõ ràng là có ai đó đang trang trí nó bây giờ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DECORATESNOWMAN.MELTING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DECORATESNOWMAN.MELTING"
msgid "There's no use decorating a snowman that's about to melt."
msgstr "Chẳng ích gì khi trang trí một người tuyết sắp tan chảy."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DECORATESNOWMAN.STACKEDTOOHIGH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DECORATESNOWMAN.STACKEDTOOHIGH"
msgid "It's simply too tall for another."
msgstr "Nó đã quá cao để chồng thêm nữa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DEPLOY.HERMITCRAB_RELOCATE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DEPLOY.HERMITCRAB_RELOCATE"
msgid "A convenient way for the hermit crab to relocate her home."
msgstr "Một cách thuận tiện để con ốc mượn hồn chuyển nhà."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DISMANTLE.COOKING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DISMANTLE.COOKING"
msgid "I'm afraid I'll have to wait until it's finished cooking."
msgstr "Tôi e rằng tôi sẽ phải đợi cho đến khi nấu xong."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DISMANTLE.INUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DISMANTLE.INUSE"
msgid "It's already in use."
msgstr "Nó đã được sử dụng rồi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DISMANTLE.NOTEMPTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DISMANTLE.NOTEMPTY"
msgid "I'll have to remove its contents first."
msgstr "Tôi phải lấy hết đồ bên trong ra trước."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DIVEGRAB.MISSED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DIVEGRAB.MISSED"
msgid "Oh dear, I've missed!"
msgstr "Ôi trời, trượt mất rồi!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DRAW.NOIMAGE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DRAW.NOIMAGE"
msgid "An example of what I should diagram would be helpful."
msgstr "Một ví dụ về những gì tôi nên lập sơ đồ sẽ hữu ích."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.FILL_OCEAN.UNSUITABLE_FOR_PLANTS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.FILL_OCEAN.UNSUITABLE_FOR_PLANTS"
msgid "I'm afraid only freshwater will do."
msgstr "Tôi e rằng chỉ có nước ngọt mới làm được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.FISH_OCEAN.TOODEEP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.FISH_OCEAN.TOODEEP"
msgid "Those fish are far too deep."
msgstr "Những con cá đó sâu quá."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GENERIC.ITEMMIMIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GENERIC.ITEMMIMIC"
msgid "I knew it."
msgstr "Tôi đã biết rồi mà."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.ABIGAILHEART
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.ABIGAILHEART"
msgid "Her spirit is already bound to something in this world."
msgstr "Linh hồn của cô ấy đã bị ràng buộc với một cái gì đó trên thế giới này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.BUSY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.BUSY"
msgid "I'll try again when it's done."
msgstr "Tôi sẽ thử lại khi xong việc."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.CANTSHADOWREVIVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.CANTSHADOWREVIVE"
msgid "Conditions are not right."
msgstr "Điều kiện không đúng."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.CARNIVALGAME_ALREADY_PLAYING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.CARNIVALGAME_ALREADY_PLAYING"
msgid "I'm afraid I'll have to wait."
msgstr "Tôi sợ tôi sẽ phải đợi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.CARNIVALGAME_GOLFGAME_NOTREADY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.CARNIVALGAME_GOLFGAME_NOTREADY"
msgid "The mini-golf course requires at least a flaghole to be playable."
msgstr "Sân golf mini cần ít nhất một lỗ cờ mới có thể chơi được."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.CARNIVALGAME_INVALID_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.CARNIVALGAME_INVALID_ITEM"
msgid "That doesn't appear to be the correct form of payment."
msgstr "Có vẻ như đó không phải là hình thức thanh toán chính xác."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.DEAD"
msgid "That would be a waste."
msgstr "Đó sẽ là một sự lãng phí."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.DUPLICATE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.DUPLICATE"
msgid "We've already taken note of this recipe."
msgstr "Chúng tôi đã lưu ý đến công thức này."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.FOODFULL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.FOODFULL"
msgid "I'll be around when you're ready for seconds, dear."
msgstr "Khi nào muốn ăn thêm suất nữa thì tôi vẫn ở đây, cháu yêu."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.GENERIC"
