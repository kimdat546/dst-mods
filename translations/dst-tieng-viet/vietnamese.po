msgstr "Quá hạn sử dụng từ lâu rồi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DESERTHAT"
