msgstr "Hãy ra khỏi đây!"

#. STRINGS.CHARACTERS.WILLOW.WENDY_SKILLTREE_EASTEREGG
msgctxt "STRINGS.CHARACTERS.WILLOW.WENDY_SKILLTREE_EASTEREGG"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.ACTIVATE.CARNIVAL_HOST_HERE
