msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_GOT_DECON_MISTED
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_GOT_DECON_MISTED"
msgid "Hey! What's with this weird spray?!"
msgstr "Này! Cái thứ phun phun kỳ cục này là sao hả?!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE"
msgid "I think my Acid Repellent wore off, that's a kind of burn I DON'T like."
msgstr "Tôi nghĩ Chất chống axit của tôi đã hết, đó là loại vết bỏng mà tôi KHÔNG thích."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_HEALINGSALVE_FUMAROLEBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_HEALINGSALVE_FUMAROLEBUFF_DONE"
msgid "My Thermal Balm is wearing off. Oh well!"
msgstr "Cao Kháng Nhiệt của tôi hết tác dụng rồi. Kệ đi!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE"
msgid "Back at Pearl's!"
msgstr "Về lại nhà Pearl rồi!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_HERMITCRAB_SHELL_BADTELEPORTPOINT
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_HERMITCRAB_SHELL_BADTELEPORTPOINT"
msgid "What the heck?"
msgstr "Cái quái gì vậy?"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_HIGHRESEARCH
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_HIGHRESEARCH"
msgid "So much information!"
msgstr "Nhiều thông tin quá!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_HOT
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_HOT"
msgid "The heat is too intense!"
msgstr "Sức nóng quá gay gắt!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_HOUNDS
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_HOUNDS"
msgid "Show yourself!"
msgstr "Ra đây đi!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_HUNGRY
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_HUNGRY"
msgid "I need food!"
msgstr "Tôi cần thức ăn!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_HUNT_AVOID_FORK
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_HUNT_AVOID_FORK"
msgid "I'm not scared, I'd just... rather go this way!"
msgstr "Tôi không sợ, tôi chỉ... thà đi lối này còn hơn!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_HUNT_BEAST_NEARBY"
msgid "I'll find you!"
msgstr "Tôi sẽ tìm bạn!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_HUNT_LOST_TRAIL"
msgid "Ohh... he got away."
msgstr "Ohh... nó chạy mất rồi."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_HUNT_LOST_TRAIL_SPRING"
msgid "Boooo, I lost track of him in the mud."
msgstr "Xì, tôi mất dấu nó trong bùn rồi."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_HUNT_START_FORK
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_HUNT_START_FORK"
msgid "I don't like the look of those marks... not that I'm scared or anything!"
msgstr "Tôi không thích vẻ ngoài của những vết đó... không phải là tôi sợ hãi hay gì cả!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_HUNT_SUCCESSFUL_FORK
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_HUNT_SUCCESSFUL_FORK"
msgid "Heh... I've got the drop on 'em!"
msgstr "Heh... Tôi đã tìm thấy chúng rồi!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_HUNT_WRONG_FORK
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_HUNT_WRONG_FORK"
msgid "Did you hear something? Er... must be my imagination..."
msgstr "Bạn có nghe gì không? Ờ... chắc là do tôi tưởng tượng thôi..."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_INSUFFICIENTFERTILIZER
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_INSUFFICIENTFERTILIZER"
msgid "It looks slightly happier."
msgstr "Có vẻ hơi hạnh phúc hơn."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_INV_FULL
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_INV_FULL"
msgid "I can only carry so much!!"
msgstr "Tôi chỉ có thể mang được bấy nhiêu thôi!!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_IS_FEASTING
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_IS_FEASTING"
msgid "Can't talk, must eat."
msgstr "Không thể nói chuyện, phải ăn."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD"
msgid "Aww, what are you doing out here all alone?"
msgstr "Aww, cậu đang làm gì ở đây một mình vậy?"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1"
msgid "Found you!!"
msgstr "Đã tìm ra bạn!!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2"
msgid "Ha ha, your tail gave you away!"
msgstr "Ha ha, cái đuôi làm lộ bạn rồi!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3"
msgid "Spotted!"
msgstr "Phát hiện!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4"
msgid "Gotcha!"
msgstr "Bắt được rồi!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE"
msgid "That was the last of em'!"
msgstr "Đó là con cuối cùng rồi!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM"
msgid "Aw, {name} got to the last one before I did."
msgstr "Ồ, {name} tìm được con cuối cùng trước tôi rồi."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE"
msgid "One more to go!"
msgstr "Còn một con nữa!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME"
msgid "I want a rematch!"
msgstr "Tôi muốn một trận tái đấu!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP"
msgid "We're about to lose, we gotta find the rest!"
msgstr "Chúng ta sắp thua rồi, phải tìm mấy con còn lại!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR"
msgid "You really think those little guys would hide this far out?"
msgstr "Có vẻ lũ Mèo Trúc Con trốn quanh đây thì hợp lý hơn."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN"
msgid "Seems more likely there'd be kitcoons hiding around here."
msgstr "Có vẻ nhiều khả năng sẽ có lũ mèo con ẩn nấp quanh đây."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN"
msgid "Alright everyone, stand aside and watch the master work!"
msgstr "Được rồi mọi người, tránh ra và xem cao thủ ra tay đây!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KITCOON_HIDEANDSEEK_START
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KITCOON_HIDEANDSEEK_START"
msgid "Ready or not, here I come!!"
msgstr "Sẵn sàng hay chưa, tôi tới đây!!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KLAUS_CALLFORHELP
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KLAUS_CALLFORHELP"
msgid "Aww man, here come those weird goat things!"
msgstr "Ôi trời, lũ dê kỳ lạ đến đây!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KLAUS_ENRAGE
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KLAUS_ENRAGE"
msgid "I'm NOT fighting THAT."
msgstr "Tôi KHÔNG đánh với THỨ ĐÓ đâu."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KLAUS_UNCHAINED
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KLAUS_UNCHAINED"
msgid "Why couldn't it just stay dead?!"
msgstr "Tại sao nó không thể chết luôn?!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KNOCKEDOUT
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_KNOCKEDOUT"
msgid "Argh, my little head!"
msgstr "Argh, đầu nhỏ của tôi!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_LIGHTFIRE.1
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_LIGHTFIRE.1"
msgid "Tee hee!"
msgstr "Hí hí!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_LIGHTFIRE.2
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_LIGHTFIRE.2"
msgid "Pretty!"
msgstr "Đẹp!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_LIGHTFIRE.3
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_LIGHTFIRE.3"
msgid "Oops!"
msgstr "Ối!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_LIGHTFIRE.4
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_LIGHTFIRE.4"
msgid "I made a fire!"
msgstr "Tôi nhóm được lửa rồi!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_LIGHTFIRE.5
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_LIGHTFIRE.5"
msgid "Burn!"
msgstr "Đốt cháy!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_LIGHTFIRE.6
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_LIGHTFIRE.6"
msgid "I can't help myself!"
msgstr "Tôi không kiềm chế được!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED"
msgid "I'm safe from the sky-fire."
msgstr "Tôi an toàn trước lửa trời rồi."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_LIGHTSOUT_SHADOWHAND
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_LIGHTSOUT_SHADOWHAND"
msgid "Stupid hand! What is your problem?!"
msgstr "Bàn tay ngu ngốc! Vấn đề của bạn là gì?!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_LOWRESEARCH
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_LOWRESEARCH"
msgid "Boo, that was boring."
msgstr "Xì, chán ngắt."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_LUNARGUARDIAN_INCOMING
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_LUNARGUARDIAN_INCOMING"
msgid "Ugh, not again!"
msgstr "Ặc, lại nữa à!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_LUNARHAIL_BIRD_CORPSES
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_LUNARHAIL_BIRD_CORPSES"
msgid "That's not how they normally land."
msgstr "Chim đâu có hạ cánh kiểu đó."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS"
msgid "It's a bad day to be a bird."
msgstr "Thật là một ngày tồi tệ khi trở thành một con chim."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_LUNAR_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_LUNAR_RIFT_MAX"
msgid "Hey, what was that weird light?"
msgstr "Này, ánh sáng kì lạ đó là gì thế?"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MEGA_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MEGA_FLARE_SEEN"
msgid "Looks like someone wants to start a fight."
msgstr "Có vẻ như có người muốn gây chiến."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MITEGLAND_DEBUFF.1
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MITEGLAND_DEBUFF.1"
msgid "My stomach feels like it's on fire!"
msgstr "Bụng tôi như đang bốc cháy vậy!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MITEGLAND_DEBUFF.2
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MITEGLAND_DEBUFF.2"
msgid "Ugh... this kind of burning doesn't feel so good..."
msgstr "Ư... kiểu cháy này chẳng dễ chịu tí nào..."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MITEGLAND_DEBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MITEGLAND_DEBUFF_DONE"
msgid "The fire's gone out."
msgstr "Lửa tắt rồi."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MONKEY_CURSE_1
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MONKEY_CURSE_1"
msgid "Brrr, what was that? I just got goosebumps."
msgstr "Brrr, cái gì vậy? Tôi vừa nổi da gà."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MONKEY_CURSE_CHANGE
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MONKEY_CURSE_CHANGE"
msgid "What the... HEY! I don't want to be a monkey!"
msgstr "Cái gì...Này! Tôi không muốn trở thành một con khỉ!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MONKEY_CURSE_CHANGEBACK
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MONKEY_CURSE_CHANGEBACK"
msgid "Ugh, I still feel itchy all over..."
msgstr "Ặc, tôi vẫn thấy ngứa khắp người..."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW"
msgid "I can see you!"
msgstr "Tôi có thể thấy bạn!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MOONALTAR_MINE.GLASS_MED
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MOONALTAR_MINE.GLASS_MED"
msgid "Don't worry, I'll get you out."
msgstr "Đừng lo lắng, tôi sẽ đưa bạn ra ngoài."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL"
msgid "Gotcha!"
msgstr "Bắt được rồi!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW"
msgid "I can see you!"
msgstr "Tôi có thể thấy bạn!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MOONALTAR_MINE.IDOL_MED
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MOONALTAR_MINE.IDOL_MED"
msgid "Don't worry, I'll get you out."
msgstr "Đừng lo lắng, tôi sẽ đưa bạn ra ngoài."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL"
msgid "Gotcha!"
msgstr "Bắt được rồi!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MOONALTAR_MINE.SEED_LOW
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MOONALTAR_MINE.SEED_LOW"
msgid "I can see you!"
msgstr "Tôi có thể thấy bạn!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MOONALTAR_MINE.SEED_MED
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MOONALTAR_MINE.SEED_MED"
msgid "Don't worry, I'll get you out."
msgstr "Đừng lo lắng, tôi sẽ đưa bạn ra ngoài."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL"
msgid "Gotcha!"
msgstr "Bắt được rồi!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MOONPOTION_FAILED
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MOONPOTION_FAILED"
msgid "Huh. Alright then."
msgstr "Huh. Thôi được."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MOSQUITOS"
msgid "Get away, you bloodsucking jerks!"
msgstr "Cút đi, lũ hút máu đáng ghét!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "This beast is looking pretty bad."
msgstr "Con thú này trông khá tệ."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL"
msgid "Stupid buzzards. Hey, what's wrong with them?"
msgstr "Lũ chim ó ngu ngốc. Này, chúng bị làm sao thế?"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NODANGERGIFT"
msgid "That dumb box can wait!"
msgstr "Cái hộp ngu ngốc đó có thể đợi được!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NODANGERSIESTA
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NODANGERSIESTA"
msgid "It's not time for a siesta, it's time for fighting!"
msgstr "Không phải lúc để ngủ trưa, mà là lúc để chiến đấu!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NODANGERSLEEP
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NODANGERSLEEP"
msgid "No time for sleep, there's fighting to do!"
msgstr "Không có thời gian ngủ, còn phải chiến đấu!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NODAYSLEEP
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NODAYSLEEP"
msgid "Who would go inside when there's a great ball of fire in the sky?"
msgstr "Ai sẽ vào trong khi có một quả cầu lửa lớn trên bầu trời?"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "Too spooky down here to sleep."
msgstr "Dưới này rùng rợn quá, ngủ sao nổi."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NOHUNGERSIESTA"
msgid "I can't take a siesta while my tummy is grumbling!"
msgstr "Tôi không thể ngủ trưa trong khi bụng tôi đang kêu gào!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NOHUNGERSLEEP"
msgid "My tummy is grumbling, I can't sleep!"
msgstr "Bụng tôi đang cồn cào, tôi không thể ngủ được!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NOMOUNTEDGIFT"
msgid "I gotta get down from this big oaf before opening that!"
msgstr "Tôi phải xuống khỏi gã to xác này rồi mới mở cái đó được!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NONIGHTSIESTA"
msgid "I couldn't get comfortable there."
msgstr "Tôi không thấy thoải mái ở đó được."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "I'd really rather be inside."
msgstr "Tôi thà ở trong nhà hơn."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NOPUMPKINCARVINGONFIRE
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NOPUMPKINCARVINGONFIRE"
msgid "It's perfect."
msgstr "Hoàn hảo."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT"
