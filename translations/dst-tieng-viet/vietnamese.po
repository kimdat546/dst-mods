msgid "Each heart discarded\n+1 mult"
msgstr "Mỗi lá Cơ bị bỏ\n+1 hệ số"

#. STRINGS.BALATRO.JOKER_WALTER
msgctxt "STRINGS.BALATRO.JOKER_WALTER"
msgid "For each different suit\nin discard +15 chips"
msgstr "Mỗi chất khác nhau\ntrong bài bỏ +15 chip"

#. STRINGS.BALATRO.JOKER_WANDA
msgctxt "STRINGS.BALATRO.JOKER_WANDA"
msgid "Start with 80 chips\nEach discard -15 chips"
msgstr "Bắt đầu với 80 chip\nMỗi lá bỏ -15 chip"

#. STRINGS.BALATRO.JOKER_WARLY
msgctxt "STRINGS.BALATRO.JOKER_WARLY"
msgid "Hand contains a heart, a club\na diamond and a spade +4 mult"
msgstr "Tay bài có đủ Cơ, Chuồn,\nRô và Bích +4 hệ số"

#. STRINGS.BALATRO.JOKER_WEBBER
msgctxt "STRINGS.BALATRO.JOKER_WEBBER"
msgid "Each Heart or Diamond replaced\nby a club or spade +2 mult"
msgstr "Mỗi lá Cơ hoặc Rô được thay\nbằng Chuồn hoặc Bích +2 hệ số"

#. STRINGS.BALATRO.JOKER_WENDY
msgctxt "STRINGS.BALATRO.JOKER_WENDY"
msgid "Each discard that becomes\nthe same suit +5 chips +2 mult"
msgstr "Mỗi lá bỏ đổi được\ncùng chất +5 chip +2 hệ số"

#. STRINGS.BALATRO.JOKER_WES
msgctxt "STRINGS.BALATRO.JOKER_WES"
msgid "Hand is worse after discard\n+30 chips"
msgstr "Tay bài tệ hơn sau khi loại bỏ\n+30 chip"

#. STRINGS.BALATRO.JOKER_WICKERBOTTOM
msgctxt "STRINGS.BALATRO.JOKER_WICKERBOTTOM"
msgid "Each Queen in hand\n+1 mult"
msgstr "Mỗi quân Đầm trong tay\n+1 hệ số"

#. STRINGS.BALATRO.JOKER_WIGFRID
msgctxt "STRINGS.BALATRO.JOKER_WIGFRID"
msgid "Each Spade in hand\n+25 chips"
msgstr "Mỗi lá Bích trong tay\n+25 chip"

#. STRINGS.BALATRO.JOKER_WILLOW
msgctxt "STRINGS.BALATRO.JOKER_WILLOW"
msgid "Each face card discarded\n+20 chips"
msgstr "Mỗi lá hình bị bỏ\n+20 chip"

#. STRINGS.BALATRO.JOKER_WILSON
msgctxt "STRINGS.BALATRO.JOKER_WILSON"
msgid "Each pair in hand\n+3 mult"
msgstr "Mỗi đôi trong tay\n+3 hệ số"

#. STRINGS.BALATRO.JOKER_WINONA
msgctxt "STRINGS.BALATRO.JOKER_WINONA"
msgid "Each heart kept\n+1 mult"
msgstr "Mỗi lá Cơ được giữ\n+1 hệ số"

#. STRINGS.BALATRO.JOKER_WOLFGANG
msgctxt "STRINGS.BALATRO.JOKER_WOLFGANG"
msgid "Each King in hand\n+25 chips"
msgstr "Mỗi quân Vua trong tay\n+25 chip"

#. STRINGS.BALATRO.JOKER_WOODIE
msgctxt "STRINGS.BALATRO.JOKER_WOODIE"
msgid "Each card discarded\n+7 chips"
msgstr "Mỗi lá bài bị loại bỏ\n+7 chip"

#. STRINGS.BALATRO.JOKER_WORMWOOD
msgctxt "STRINGS.BALATRO.JOKER_WORMWOOD"
msgid "Each club kept\n+15 chips"
msgstr "Mỗi lá Chuồn được giữ\n+15 chip"

#. STRINGS.BALATRO.JOKER_WORTOX
msgctxt "STRINGS.BALATRO.JOKER_WORTOX"
msgid "Each heart discarded +15 chips\nEach heart in hand -11 chips +1 mult"
msgstr "Mỗi lá Cơ bị bỏ +15 chip\nMỗi lá Cơ trong tay -11 chip +1 hệ số"

#. STRINGS.BALATRO.JOKER_WURT
msgctxt "STRINGS.BALATRO.JOKER_WURT"
msgid "Each face card kept\n+10 chips per face card"
msgstr "Mỗi lá hình được giữ\n+10 chip cho mỗi lá hình"

#. STRINGS.BALATRO.JOKER_WX78
msgctxt "STRINGS.BALATRO.JOKER_WX78"
msgid "Each heart kept once\nthen discarded +2 mult"
msgstr "Mỗi lá Cơ giữ một lần\nrồi bỏ +2 hệ số"

