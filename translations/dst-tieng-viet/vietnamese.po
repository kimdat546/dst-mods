msgstr "Ối, cháy rồi. Heh heh."

#. STRINGS.CHARACTERS.WILLOW.QUAGMIRE_ANNOUNCE_NOTRECIPE
msgctxt "STRINGS.CHARACTERS.WILLOW.QUAGMIRE_ANNOUNCE_NOTRECIPE"
msgid "Okay, so that didn't work."
msgstr "Được rồi, vậy là nó không hiệu quả."

#. STRINGS.CHARACTERS.WILLOW.QUAGMIRE_ANNOUNCE_WIN
msgctxt "STRINGS.CHARACTERS.WILLOW.QUAGMIRE_ANNOUNCE_WIN"
