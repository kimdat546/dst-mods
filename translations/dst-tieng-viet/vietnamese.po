msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FUMAROLESHOVEL.GENERIC"
msgid "It shall not weather much further use."
msgstr "Nó sẽ không trụ được bao lâu nữa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FUMAROLESHOVEL.HOT
