msgstr "Nó như một cái bụng thứ hai để chúng mình cất đồ."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BACONEGGS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BACONEGGS"
