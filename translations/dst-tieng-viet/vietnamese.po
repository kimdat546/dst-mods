msgstr "Hãy để Max thử trước."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RED_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RED_CAP_COOKED"
