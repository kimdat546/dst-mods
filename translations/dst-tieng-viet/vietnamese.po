msgstr "Món đồ nghề xịn thật."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RATATOUILLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RATATOUILLE"
