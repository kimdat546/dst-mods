msgstr "Điều đó có vẻ quan trọng."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DOCK_KIT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DOCK_KIT"
