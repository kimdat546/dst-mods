msgstr "Cẩn tắc vô ưu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOUNDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOUNDCORPSE.GENERIC"
