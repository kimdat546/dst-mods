msgstr "Tất cả đều được cắt nhỏ đẹp mắt."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRIFTWOOD_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRIFTWOOD_TREE.GENERIC"
msgid "This tree's spent too much time at sea."
msgstr "Cái cây này đã trải qua quá nhiều thời gian trên biển."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRUMSTICK
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRUMSTICK"
msgid "Dark meat!"
msgstr "Thịt sẫm màu!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DRUMSTICK_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DRUMSTICK_COOKED"
