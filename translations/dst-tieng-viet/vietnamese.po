msgstr "Tôi nghe thấy tiếng lũ thú lông lá trong này."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HORRORFUEL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HORRORFUEL"
