#
# ============================================================
# CHARACTER SPEECH — GENERIC
# ============================================================
#

msgctxt "STRINGS.CHARACTERS.GENERIC.ACTIONFAIL.STORE.NOTAROBOT"
msgid "I'm not a bot to use it."
msgstr "Tôi không phải robot để dùng cái này."

msgctxt "STRINGS.CHARACTERS.GENERIC.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Why won't it follow me?"
msgstr "Sao nó không chịu đi theo tôi nhỉ?"

msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.CRITTER_BULBIN"
msgid "You'd never do anything rotten, would you?"
msgstr "Bạn sẽ không bao giờ làm điều gì xấu, phải không?"

msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SHADOW_HEART_VEIN"
msgid "A vein attempt to be useful."
msgstr "Một nỗ lực mạch-lạc để trở nên hữu ích."

msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "A freight it will get lost!"
msgstr "Sợ nó sẽ bị lạc mất thôi!"

msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_DRONE_SCOUT"
msgid "So far, so good."
msgstr "Đến giờ thì vẫn ổn."

msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_DRONE_ZAP"
msgid "It uses current technology."
msgstr "Nó dùng công nghệ dòng-điện tiên tiến."

msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "It controls remotely? It's a.... Detached Telecommand Apparatus!"
msgstr "Điều khiển từ xa ư? Đây là.... Thiết Bị Viễn Lệnh Tách Rời!"

msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_FOODBRICK.WET"
msgid "It's a moist try!"
msgstr "Một nỗ lực ẩm ướt!"

msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "What possessed WX to do this?"
msgstr "Cái gì đã ám WX để làm cái này nhỉ?"

msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "Finite like that."
msgstr "Có hạn như thế đấy."

msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WX78_POSSESSEDBODY"
msgid "You're not yourself lately!"
msgstr "Dạo này bạn không phải là chính mình rồi!"

msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.W_RADIO"
msgid "Hm. There's a lot of science here."
msgstr "Hm. Có rất nhiều khoa học ở đây."

#
# ============================================================
# CHARACTER SPEECH — WALTER
# ============================================================
#

msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.STORE.NOTAROBOT"
msgid "It's not for us, Woby."
msgstr "Cái này không dành cho chúng ta, Woby."

msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_MAX_CLOCKWORKS"
msgid "It doesn't wanna come with us, Woby."
msgstr "Nó không muốn đi cùng chúng ta, Woby."

msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_BULBIN"
msgid "I didn't know vegetables could be monsters too!"
msgstr "Mình không biết rau củ cũng có thể là quái vật nữa!"

msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.SHADOW_HEART_VEIN"
msgid "Aw, it's so helpful!"
msgstr "Ồ, nó hữu ích quá!"

msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "A hardworking delivery buddy!"
msgstr "Một bạn giao hàng chăm chỉ!"

msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78_DRONE_SCOUT"
msgid "Scott sure likes to explore!"
msgstr "Scott chắc chắn thích khám phá lắm!"

msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78_DRONE_ZAP"
msgid "Stay out of its way, Woby!"
msgstr "Tránh xa nó ra, Woby!"

msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "That's not a toy apparently."
msgstr "Có vẻ đó không phải đồ chơi."

msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78_FOODBRICK.GENERIC"
msgid "It's harder than a stale dog biscuit, Woby!"
msgstr "Nó cứng hơn cả bánh quy chó cũ, Woby!"

msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78_FOODBRICK.WET"
msgid "Kinda mushy now, but that's okay!"
msgstr "Hơi nhão rồi, nhưng không sao!"

msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "This must do something reaaally neat, Woby."
msgstr "Cái này chắc làm được điều gì đó thật tuyệt, Woby."

msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "Wonder if WX wants all this stuff back."
msgstr "Không biết WX có muốn lấy lại mấy thứ này không."

msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78_POSSESSEDBODY"
msgid "Is that a ghost in there, Woby! Amazing!"
msgstr "Có phải có ma ở trong đó không, Woby! Tuyệt vời!"

msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.W_RADIO"
msgid "What do you think it does, Woby?"
msgstr "Theo Woby thì nó làm gì nhỉ?"

#
# ============================================================
# CHARACTER SPEECH — WANDA
# ============================================================
#

msgctxt "STRINGS.CHARACTERS.WANDA.ACTIONFAIL.STORE.NOTAROBOT"
msgid "It belongs to the automaton."
msgstr "Nó thuộc về cái máy tự động."

msgctxt "STRINGS.CHARACTERS.WANDA.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Maybe you'll join me next time."
msgstr "Có lẽ lần sau ngươi sẽ đi cùng ta."

msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CRITTER_BULBIN"
msgid "Aren't you a little far from home?"
msgstr "Ngươi có hơi xa nhà không?"

msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.SHADOW_HEART_VEIN"
msgid "It's growing..."
msgstr "Nó đang lớn lên..."

msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "Nothing beats a speedy delivery."
msgstr "Không gì bằng giao hàng nhanh."

msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_DRONE_SCOUT"
msgid "And where are we off to next?"
msgstr "Và tiếp theo ta đi đâu nhỉ?"

msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_DRONE_ZAP"
msgid "Mind where you're zapping!"
msgstr "Chú ý hướng bắn đi!"

msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "In the wrong hands... nevermind."
msgstr "Nếu vào tay kẻ xấu... thôi bỏ đi."

msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_FOODBRICK.GENERIC"
msgid "It's too hard to eat."
msgstr "Cứng quá không ăn được."

msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_FOODBRICK.WET"
msgid "WX, how kind of you..."
msgstr "WX, ngươi tốt bụng quá..."

msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "Madness..."
msgstr "Điên rồ..."

msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "I know better than to question the physics."
msgstr "Ta biết rõ hơn là đừng thắc mắc vật lý."

msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_POSSESSEDBODY"
msgid "That will never not give me the creeps."
msgstr "Cái đó luôn làm ta rùng mình."

#
# ============================================================
# CHARACTER SPEECH — WARLY
# ============================================================
#

msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.STORE.NOTAROBOT"
msgid "Property of our metal friend."
msgstr "Tài sản của người bạn kim loại."

msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Perhaps it is shy."
msgstr "Có lẽ nó nhút nhát."

msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CRITTER_BULBIN"
msgid "It never hurts to have a little onion on hand."
msgstr "Có sẵn một ít hành tây cũng không bao giờ thừa."

msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SHADOW_HEART_VEIN"
msgid "It has roots and grows in the dirt, but that is no vegetable."
msgstr "Nó có rễ và mọc trong đất, nhưng đó không phải rau."

msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "A flying pantry! Wonderful!"
msgstr "Một tủ thức ăn biết bay! Tuyệt vời!"

msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_DRONE_SCOUT"
msgid "Where will you go next?"
msgstr "Tiếp theo bạn sẽ đi đâu?"

msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_DRONE_ZAP"
msgid "But can it fry an egg?"
msgstr "Nhưng liệu nó có chiên được trứng không?"

msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "It is too fancy for me!"
msgstr "Nó quá cao cấp với tôi!"

msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_FOODBRICK.GENERIC"
msgid "Adding water will not make it less horrible."
msgstr "Thêm nước cũng không làm nó bớt kinh khủng."

msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_FOODBRICK.WET"
msgid "It is most appalling."
msgstr "Thật là kinh tởm."

msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "I don't even want to know."
msgstr "Tôi thậm chí không muốn biết."

msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "What did our metal friend leave here?"
msgstr "Người bạn kim loại để lại gì ở đây?"

msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_POSSESSEDBODY"
msgid "Oh non, this is too much!"
msgstr "Oh non, quá sức chịu đựng rồi!"

msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.W_RADIO"
msgid "What appliance is this?"
msgstr "Đây là thiết bị gì thế?"

#
# ============================================================
# CHARACTER SPEECH — WATHGRITHR (Wigfrid - Viking style)
# ============================================================
#

msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.STORE.NOTAROBOT"
msgid "It belongs to the metal warrior."
msgstr "Nó thuộc về chiến binh kim loại."

msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Fret not, faithful warrior. I shall return for thee."
msgstr "Đừng lo, chiến binh trung thành. Ta sẽ quay lại vì ngươi."

msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRITTER_BULBIN"
msgid "I forgive her vegetable ways."
msgstr "Ta tha thứ cho bản tính rau củ của nàng."

msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOW_HEART_VEIN"
msgid "Such gifts bear ill fortune."
msgstr "Những món quà như vậy mang theo vận xui."

msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "Loyal courier! Provision thy Iron Lord!"
msgstr "Sứ giả trung thành! Tiếp tế cho Lãnh Chúa Sắt!"

msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78_DRONE_SCOUT"
msgid "Go forth, valiant scoutling!"
msgstr "Tiến lên, trinh sát dũng cảm bé nhỏ!"

msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78_DRONE_ZAP"
msgid "Rain lightening upon thy foes!"
msgstr "Trút sấm sét lên kẻ thù của ngươi!"

msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "By this, the Iron Lord calls a Valkyrie from the heavens!"
msgstr "Qua đây, Lãnh Chúa Sắt triệu hồi Valkyrie từ thiên đường!"

msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78_FOODBRICK.GENERIC"
msgid "Even Mjolnir could not crack this foul brick!"
msgstr "Ngay cả Mjolnir cũng không thể đập vỡ viên gạch ghê tởm này!"

msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78_FOODBRICK.WET"
msgid "A cursed loaf, born from the very innards of the metal warrior!"
msgstr "Ổ bánh bị nguyền rủa, sinh ra từ ruột gan của chiến binh kim loại!"

msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "There is sorcery at work here."
msgstr "Có phép thuật đang hoạt động ở đây."

msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "What spoils hath our metal warrior bestowed?"
msgstr "Chiến lợi phẩm nào mà chiến binh kim loại ban tặng?"

msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78_POSSESSEDBODY"
msgid "The metal warrior is truly possessed!"
msgstr "Chiến binh kim loại thực sự bị chiếm hữu rồi!"

msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.W_RADIO"
msgid "What infernal device is this?"
msgstr "Đây là thiết bị quỷ quái gì thế?"

#
# ============================================================
# CHARACTER SPEECH — WAXWELL (Maxwell)
# ============================================================
#

msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.NOTAROBOT"
msgid "Robot junk."
msgstr "Đồ phế liệu robot."

msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.NOTAROBOT"
msgid "Robot junk"
msgstr "Đồ phế liệu robot"

msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Too many of this piece on the board already, I suppose."
msgstr "Chắc trên bàn cờ đã có quá nhiều quân cờ loại này rồi."

msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_BULBIN"
msgid "You're not from around here, are you pal?"
msgstr "Cậu không phải ở đây, đúng không bạn?"

msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOW_HEART_VEIN"
msgid "And yet it offers gifts from below."
msgstr "Thế mà nó vẫn ban tặng từ bên dưới."

msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "Nice trash hauler."
msgstr "Xe chở rác đẹp đấy."

msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78_DRONE_SCOUT"
msgid "Oh, get lost already!"
msgstr "Ôi, biến đi!"

msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78_DRONE_ZAP"
msgid "I've got my eye on you!"
msgstr "Ta đang để mắt tới ngươi đấy!"

msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "I didn't want to play with it anyway."
msgstr "Dù sao ta cũng không muốn chơi với nó."

msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78_FOODBRICK.GENERIC"
msgid "Not that I'd want to, but it's too dry to eat."
msgstr "Không phải ta muốn ăn, nhưng mà nó khô quá."

msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78_FOODBRICK.WET"
msgid "Of all the things I've eaten here, this takes the cake."
msgstr "Trong tất cả những thứ ta ăn ở đây, cái này đoạt giải."

msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "I hope that's not what I think it is."
msgstr "Ta hy vọng đó không phải thứ ta đang nghĩ."

msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "What do you mean it held more than my hat?!"
msgstr "Ý ngươi là nó chứa được nhiều hơn cái mũ của ta?!"

msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78_POSSESSEDBODY"
msgid "Stay back, you abomination!"
msgstr "Lùi lại, đồ quái vật!"

#
# ============================================================
# CHARACTER SPEECH — WEBBER
# ============================================================
#

msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.STORE.NOTAROBOT"
msgid "We can't. The robot will get mad."
msgstr "Chúng ta không được. Con robot sẽ giận đấy."

msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Maybe it's not allowed to play with us."
msgstr "Có lẽ nó không được phép chơi với chúng ta."

msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CRITTER_BULBIN"
msgid "It's our little onion friend!"
msgstr "Đây là bạn hành tây nhỏ của chúng ta!"

msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHADOW_HEART_VEIN"
msgid "We don't like being around that."
msgstr "Chúng ta không thích ở gần cái đó."

msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "Are there surprises inside?"
msgstr "Bên trong có bất ngờ gì không?"

msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78_DRONE_SCOUT"
msgid "How come it's allowed to wander off?"
msgstr "Sao nó được phép đi lang thang vậy?"

msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78_DRONE_ZAP"
msgid "We don't like zaps."
msgstr "Chúng ta không thích bị giật điện."

msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "Can we have a turn?"
msgstr "Cho chúng ta chơi một lượt được không?"

msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78_FOODBRICK.GENERIC"
msgid "It's sooooo dry!"
msgstr "Nó khôôôô quá!"

msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78_FOODBRICK.WET"
msgid "A robot cake?"
msgstr "Bánh robot ư?"

msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "Is it because they have no one to play with?"
msgstr "Có phải vì chúng không có ai để chơi cùng không?"

msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "It was forever in there."
msgstr "Nó ở trong đó lâu lắm rồi."

msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78_POSSESSEDBODY"
msgid "Who's inside the robot?"
msgstr "Ai ở bên trong con robot vậy?"

msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.W_RADIO"
msgid "Yay! New toy!"
msgstr "Yay! Đồ chơi mới!"

#
# ============================================================
# CHARACTER SPEECH — WENDY
# ============================================================
#

msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.STORE.NOTAROBOT"
msgid "I shouldn't touch the machine's things."
msgstr "Tôi không nên chạm vào đồ của cỗ máy."

msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MAX_CLOCKWORKS"
msgid "This one will be left behind."
msgstr "Cái này sẽ bị bỏ lại phía sau."

msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_BULBIN"
msgid "Its adorable face nearly brings me to tears."
msgstr "Khuôn mặt đáng yêu của nó suýt khiến tôi khóc."

msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOW_HEART_VEIN"
msgid "From a heart that knows no peace."
msgstr "Từ trái tim không bao giờ được yên."

msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "And they say you can't take it with you."
msgstr "Người ta bảo không thể mang theo đồ khi ra đi."

msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_DRONE_SCOUT"
msgid "Are you ever afraid?"
msgstr "Bạn có bao giờ sợ không?"

msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_DRONE_ZAP"
msgid "Feels impersonal."
msgstr "Cảm thấy thật vô cảm."

msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "Are we all just being controlled?"
msgstr "Phải chăng tất cả chúng ta đều đang bị điều khiển?"

msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_FOODBRICK.GENERIC"
msgid "It's impossible to eat like that."
msgstr "Không thể ăn được nó như thế."

msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_FOODBRICK.WET"
msgid "I've eaten worse."
msgstr "Tôi đã từng ăn thứ tệ hơn."

msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "I've thought about it too, Abby."
msgstr "Tôi cũng đã nghĩ về điều đó, Abby."

msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "I wonder what remains."
msgstr "Không biết còn lại gì."

msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_POSSESSEDBODY"
msgid "Too bad Abby can't do the same."
msgstr "Tiếc là Abby không thể làm như vậy."

msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.W_RADIO"
msgid "What does it do?"
msgstr "Nó làm được gì?"

#
# ============================================================
# CHARACTER SPEECH — WICKERBOTTOM
# ============================================================
#

msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.STORE.NOTAROBOT"
msgid "It is the property of the automaton."
msgstr "Nó là tài sản của cỗ máy tự động."

msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HUNT_AVOID_FORK"
msgid "This trail will likely yield less dangerous results."
msgstr "Con đường này có thể sẽ cho kết quả ít nguy hiểm hơn."

msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MAX_CLOCKWORKS"
msgid "This stubborn piece refuses to follow me."
msgstr "Miếng cứng đầu này từ chối đi theo ta."

msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTER_BULBIN"
msgid "Are you animal or vegetable, dear?"
msgstr "Con là động vật hay thực vật, bé yêu?"

msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SHADOW_HEART_VEIN"
msgid "This is dark magic indeed."
msgstr "Đây thực sự là ma thuật đen."

msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "The automaton deomonstrates an unusual attachment to its belongings."
msgstr "Cỗ máy tự động thể hiện sự gắn bó bất thường với đồ đạc của mình."

msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78_DRONE_SCOUT"
msgid "We are indebted to this intrepid little scout."
msgstr "Chúng ta mang ơn trinh sát nhỏ dũng cảm này."

msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78_DRONE_ZAP"
msgid "It permits the automaton to engage its foes from a distance."
msgstr "Nó cho phép cỗ máy tự động tấn công kẻ thù từ xa."

msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "Through signal transmission, the automaton may maneuver the aerial device and discharge electrical shocks."
msgstr "Thông qua truyền tín hiệu, cỗ máy tự động có thể điều khiển thiết bị trên không và phóng sốc điện."

msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78_FOODBRICK.GENERIC"
msgid "The nutrient brick is inedible in its desicated form."
msgstr "Viên gạch dinh dưỡng không thể ăn được ở dạng khô."

msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78_FOODBRICK.WET"
msgid "The automaton has reconstituted spoiled food matter into a compact edible brick."
msgstr "Cỗ máy tự động đã tái tạo thức ăn hỏng thành viên gạch ăn được nhỏ gọn."

msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "It's been reconfigured to permit direct transfer of the entity into the chassis."
msgstr "Nó đã được cấu hình lại để cho phép chuyển trực tiếp thực thể vào khung máy."

msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "Once a repository whose capacity challenged the very laws of physics."
msgstr "Từng là kho chứa có dung lượng thách thức chính quy luật vật lý."

msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WX78_POSSESSEDBODY"
msgid "It's a straightforward instance of spectral machina possession, nothing more."
msgstr "Đây chỉ đơn giản là trường hợp chiếm hữu máy móc bởi phổ linh, không hơn."

msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.W_RADIO"
msgid "Interesting... I conclude it requires further study."
msgstr "Thú vị... Ta kết luận nó cần nghiên cứu thêm."

#
# ============================================================
# CHARACTER SPEECH — WILLOW
# ============================================================
#

msgctxt "STRINGS.CHARACTERS.WILLOW.ACTIONFAIL.STORE.NOTAROBOT"
msgid "Just some robot stuff."
msgstr "Chỉ là mấy thứ của robot thôi."

msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Whatever, I didn't need you anyway."
msgstr "Kệ, dù sao tôi cũng không cần bạn."

msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_BULBIN"
msgid "My bulbous little buddy."
msgstr "Bạn nhỏ phình phình của tôi."

msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SHADOW_HEART_VEIN"
msgid "Disgusting! I don't care what it's got!"
msgstr "Ghê quá! Tôi không quan tâm nó có gì!"

msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "WX gets free delivery? No fair!"
msgstr "WX được giao hàng miễn phí á? Không công bằng!"

msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78_DRONE_SCOUT"
msgid "Get lost, Scott!"
msgstr "Biến đi, Scott!"

msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78_DRONE_ZAP"
msgid "I got my eye on you, zappy."
msgstr "Tôi đang để mắt tới mày đấy, đồ giật điện."

msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "I don't trust WX with this thing."
msgstr "Tôi không tin WX với cái này."

msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78_FOODBRICK.GENERIC"
msgid "It would be like trying to eat an actual brick."
msgstr "Giống như đang cố ăn một viên gạch thật vậy."

msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78_FOODBRICK.WET"
msgid "Gee thanks, WX."
msgstr "Ơ cảm ơn nhé, WX."

msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "That WX is always up to something."
msgstr "Cái WX đó lúc nào cũng bày trò gì đó."

msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "What do I care about WX's old stuff?"
msgstr "Tôi quan tâm gì mấy thứ cũ của WX?"

msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78_POSSESSEDBODY"
msgid "What's gotten into you?!"
msgstr "Cái gì đã chui vào bạn vậy?!"

msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.W_RADIO"
msgid "Ten seconds to make it work before I burn it."
msgstr "Mười giây để nó hoạt động trước khi tôi đốt."

#
# ============================================================
# CHARACTER SPEECH — WINONA
# ============================================================
#

msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.STORE.NOTAROBOT"
msgid "I ain't messin' with WX's things."
msgstr "Tôi không đụng vào đồ của WX đâu."

msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Well fine then, don't follow me."
msgstr "Thôi được rồi, đừng đi theo tôi."

msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CRITTER_BULBIN"
msgid "You're a sweet little fella, but your breath is terrible."
msgstr "Mày dễ thương lắm, nhưng hơi thở thì kinh khủng."

msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SHADOW_HEART_VEIN"
msgid "It was creepin' and crawlin' underground."
msgstr "Nó đang bò và trườn dưới đất."

msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "Wish I had me a flyin' toolkit."
msgstr "Ước gì tôi có một bộ đồ nghề biết bay."

msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78_DRONE_SCOUT"
msgid "Careful out there, lil' fella."
msgstr "Cẩn thận ngoài kia nhé, nhóc."

msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78_DRONE_ZAP"
msgid "I know who's really in control!"
msgstr "Tôi biết ai mới thực sự đang điều khiển!"

msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "WX don't like sharin'."
msgstr "WX không thích chia sẻ."

msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78_FOODBRICK.GENERIC"
msgid "Now that's a jawbreaker."
msgstr "Cái này đúng là đồ gãy hàm."

msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78_FOODBRICK.WET"
msgid "Machine processed food?"
msgstr "Thức ăn chế biến bằng máy à?"

msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "Looks like WX repurposed the bossman's contraption."
msgstr "Có vẻ WX đã tái sử dụng đồ nghề của ông chủ."

msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "Wonder what WX left behind."
msgstr "Không biết WX bỏ lại gì."

msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78_POSSESSEDBODY"
msgid "WX is getting into some weird stuff. Or it's the other way around."
msgstr "WX đang dính vào mấy thứ kỳ lạ. Hoặc ngược lại."

msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.W_RADIO"
msgid "I think I recognize this handywork..."
msgstr "Hình như tôi nhận ra tay nghề này..."

#
# ============================================================
# CHARACTER SPEECH — WOLFGANG
# ============================================================
#

msgctxt "STRINGS.CHARACTERS.WOLFGANG.ACTIONFAIL.STORE.NOTAROBOT"
msgid "Is robot things."
msgstr "Là đồ của robot."

msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Why? Is something Wolfgang said?"
msgstr "Tại sao? Có phải Wolfgang nói gì sai không?"

msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_BULBIN"
msgid "Onions are Wolfgang's best friend! Second to potato!"
msgstr "Hành tây là bạn thân nhất của Wolfgang! Chỉ sau khoai tây!"

msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOW_HEART_VEIN"
msgid "Haha! Not as mighty as Wolfgang biceps vein!"
msgstr "Haha! Không mạnh mẽ bằng gân bắp tay của Wolfgang!"

msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "Wolfgang carry more things."
msgstr "Wolfgang mang được nhiều hơn."

msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78_DRONE_SCOUT"
msgid "Brave little exploring machine!"
msgstr "Cỗ máy khám phá nhỏ dũng cảm!"

msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78_DRONE_ZAP"
msgid "Be careful not zap Wolfgang!"
msgstr "Cẩn thận không giật điện Wolfgang!"

msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "Robot have all the fun toy."
msgstr "Robot có đủ đồ chơi vui."

msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78_FOODBRICK.GENERIC"
msgid "It is too hard for even Wolfgang mighty teeth."
msgstr "Cứng quá, ngay cả hàm răng hùng mạnh của Wolfgang cũng không nổi."

msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78_FOODBRICK.WET"
msgid "Thank you for snack, robot!"
msgstr "Cảm ơn đồ ăn vặt, robot!"

msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "Robot is tamper with powerful forces."
msgstr "Robot đang nghịch với sức mạnh ghê gớm."

msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "Any goodie for Wolfgang?"
msgstr "Có gì ngon cho Wolfgang không?"

msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78_POSSESSEDBODY"
msgid "Something extra creepy about robot."
msgstr "Có gì đó rùng rợn thêm về robot."

msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.W_RADIO"
msgid "Hello little... what are you?"
msgstr "Xin chào nhỏ... mày là cái gì?"

#
# ============================================================
# CHARACTER SPEECH — WOODIE
# ============================================================
#

msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.STORE.NOTAROBOT"
msgid "Only for robots."
msgstr "Chỉ dành cho robot thôi."

msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Maybe I've got enough."
msgstr "Có lẽ tôi đã có đủ rồi."

msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_BULBIN"
msgid "Sure got a spring in your step, eh?"
msgstr "Bước chân vui vẻ nhỉ, hả?"

msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SHADOW_HEART_VEIN"
msgid "Don't worry, Luce. I won't let it grab you."
msgstr "Đừng lo, Lucy. Tôi sẽ không để nó tóm được bạn đâu."

msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "To think I carried all my stuff to the cabin."
msgstr "Nghĩ mà xem, tôi đã vác hết đồ đến lều bằng tay."

msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78_DRONE_SCOUT"
msgid "Adventurous little guy, eh?"
msgstr "Thằng nhỏ thích phiêu lưu nhỉ?"

msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78_DRONE_ZAP"
msgid "Look at that airborne menace, Luce!"
msgstr "Nhìn cái mối đe dọa bay kia kìa, Lucy!"

msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "Some sort of robot toy."
msgstr "Một loại đồ chơi robot gì đó."

msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78_FOODBRICK.GENERIC"
msgid "I'd break my teeth on that!"
msgstr "Tôi sẽ gãy răng vì cái đó mất!"

msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "What is that robot up to now?"
msgstr "Con robot đó đang bày trò gì nữa đây?"

msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "Anything good in there, Lucy?"
msgstr "Có gì hay trong đó không, Lucy?"

msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78_POSSESSEDBODY"
msgid "Who are you?!"
msgstr "Mày là ai?!"

msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.W_RADIO"
msgid "Does it play any tunes?"
msgstr "Nó có phát nhạc không?"

#
# ============================================================
# CHARACTER SPEECH — WORMWOOD
# ============================================================
#

msgctxt "STRINGS.CHARACTERS.WORMWOOD.ACTIONFAIL.STORE.NOTAROBOT"
msgid "Only for robot friend."
msgstr "Chỉ cho bạn robot thôi."

msgctxt "STRINGS.CHARACTERS.WORMWOOD.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Why friend not follow?"
msgstr "Sao bạn không đi theo?"

msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.CRITTER_BULBIN"
msgid "Don't worry, friend! Safe now"
msgstr "Đừng lo, bạn ơi! An toàn rồi"

msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.SHADOW_HEART_VEIN"
msgid "Cold friend gift?"
msgstr "Quà bạn lạnh?"

msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "Helpful friend"
msgstr "Bạn giúp đỡ"

msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.WX78_DRONE_SCOUT"
msgid "Thanks, brave friend!"
msgstr "Cảm ơn, bạn dũng cảm!"

msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.WX78_DRONE_ZAP"
msgid "Flying zapper friend"
msgstr "Bạn giật điện biết bay"

msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "Only robot friend play"
msgstr "Chỉ bạn robot chơi thôi"

msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.WX78_FOODBRICK.GENERIC"
msgid "Too hard!"
msgstr "Cứng quá!"

msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.WX78_FOODBRICK.WET"
msgid "Food from robot friend!"
msgstr "Đồ ăn từ bạn robot!"

msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "Make more robot friend"
msgstr "Làm thêm bạn robot"

msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "Robot friend dropped"
msgstr "Bạn robot làm rơi"

msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.WX78_POSSESSEDBODY"
msgid "Not robot friend?"
msgstr "Không phải bạn robot?"

msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.W_RADIO"
msgid "What friend do?"
msgstr "Bạn làm gì?"

#
# ============================================================
# CHARACTER SPEECH — WORTOX
# ============================================================
#

msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.STORE.NOTAROBOT"
msgid "I'm a non-automaton."
msgstr "Ta là kẻ phi-tự-động."

msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Are you not allowed to join my crowd?"
msgstr "Ngươi không được phép gia nhập đám đông của ta sao?"

msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_BULBIN"
msgid "Once you dwelt in a rotten wood, now it seems you're here for good!"
msgstr "Từng sống trong gỗ mục, giờ có vẻ ngươi ở đây vĩnh viễn rồi!"

msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOW_HEART_VEIN"
msgid "And even there, it's a snare!"
msgstr "Và ngay cả ở đó, đây cũng là cái bẫy!"

msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "WX Express!"
msgstr "WX Chuyển phát nhanh!"

msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_DRONE_SCOUT"
msgid "It has flown to parts unknown!"
msgstr "Nó đã bay đến miền đất chưa biết!"

msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_DRONE_ZAP"
msgid "It shoots lightning? How frightening!"
msgstr "Nó bắn sét ư? Thật đáng sợ!"

msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "It won't respond to a non-automaton."
msgstr "Nó không phản hồi với kẻ phi-tự-động."

msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_FOODBRICK.GENERIC"
msgid "Not appetizing without first moisturizing."
msgstr "Không ngon nếu không làm ẩm trước."

msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_FOODBRICK.WET"
msgid "Moisturized, yet still not appetized."
msgstr "Đã làm ẩm, nhưng vẫn không thèm."

msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "They plan to host a ghost..."
msgstr "Chúng định chứa một bóng ma..."

msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "Once a case with endless space, dropped by ol' metal face!"
msgstr "Từng là hộp không gian vô tận, rớt từ mặt sắt già kia!"

msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_POSSESSEDBODY"
msgid "Is this what you wanted? That your body be haunted?"
msgstr "Đây là điều ngươi muốn sao? Để thân xác bị ám ư?"

msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.W_RADIO"
msgid "Oh dear, how'd that get here?"
msgstr "Ối giời, sao cái này lại ở đây?"

#
# ============================================================
# CHARACTER SPEECH — WURT
# ============================================================
#

msgctxt "STRINGS.CHARACTERS.WURT.ACTIONFAIL.STORE.NOTAROBOT"
msgid "Ironfolk only."
msgstr "Chỉ dành cho Người Sắt."

msgctxt "STRINGS.CHARACTERS.WURT.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Florp! What your problem?"
msgstr "Florp! Sao vậy hả?"

msgctxt "STRINGS.CHARACTERS.WURT.DESCRIBE.CRITTER_BULBIN"
msgid "Little, smelly and green. You perfect, florp."
