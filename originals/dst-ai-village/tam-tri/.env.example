# luat | gemini | cuc_bo
AILANG_NAO=luat

# Thư mục save của world — chỗ mod ghi ailang_hoi.json.
# Server thật:  /var/lib/game/server/general/Master/save  (trong container DST)
AILANG_SAVE=/duong/dan/toi/save

# Chỉ cần khi AILANG_NAO=gemini
GEMINI_API_KEY=
AILANG_GEMINI_MODEL=gemini-2.5-flash

# Chỉ cần khi AILANG_NAO=cuc_bo. ĐỪNG chạy model trên chính ThinkPad chạy
# server — xem chú thích đầu backends/cuc_bo.py.
AILANG_URL=http://100.64.0.2:11434/v1/chat/completions
AILANG_MODEL=qwen2.5:3b

# Bao lâu quét file một lần (giây)
AILANG_NHIP=2
